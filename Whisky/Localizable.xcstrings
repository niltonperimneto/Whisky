    "controller.bluetooth.warning": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0642\u062f \u062a\u0624\u062f\u064a \u0627\u0646\u0642\u0637\u0627\u0639\u0627\u062a Bluetooth \u0625\u0644\u0649 \u062a\u0639\u0637\u064a\u0644 \u0627\u0644\u0625\u062f\u062e\u0627\u0644\u060c \u0648USB \u0623\u0643\u062b\u0631 \u0645\u0648\u062b\u0648\u0642\u064a\u0629"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00fdpadky Bluetooth kaz\u00ed vstup; USB je spolehliv\u011bj\u0161\u00ed"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth-udfald kan \u00f8del\u00e6gge input; USB er mere p\u00e5lideligt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth-Aussetzer k\u00f6nnen die Eingabe st\u00f6ren; USB ist zuverl\u00e4ssiger"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth dropouts can break input; USB is more reliable"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth dropouts can break input; USB is more reliable"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cortes de Bluetooth pueden bloquear la entrada; el USB es m\u00e1s fiable"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth-katkokset voivat est\u00e4\u00e4 sy\u00f6tteen; USB on luotettavampi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coupures Bluetooth peuvent bloquer les entr\u00e9es ; l'USB est plus fiable"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le interruzioni Bluetooth possono bloccare l'input; l'USB \u00e8 pi\u00f9 affidabile"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth \u304c\u9014\u5207\u308c\u308b\u3068\u5165\u529b\u304c\u52b9\u304b\u306a\u304f\u306a\u308b\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u3002USB \u306e\u307b\u3046\u304c\u5b89\u5b9a\u3057\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth\uac00 \ub04a\uae30\uba74 \uc785\ub825\uc774 \uc548 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. USB\uac00 \ub354 \uc548\uc815\uc801\uc785\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth-uitval kan invoer verstoren; USB is betrouwbaarder"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrywanie Bluetooth psuje sterowanie; USB jest pewniejsze"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quedas de Bluetooth podem travar a entrada; o USB \u00e9 mais confi\u00e1vel"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As quebras de Bluetooth podem afetar a entrada; o USB \u00e9 mais fi\u00e1vel"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00centreruperile Bluetooth pot bloca intrarea; USB este mai fiabil"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0431\u0440\u044b\u0432\u044b Bluetooth \u043b\u043e\u043c\u0430\u044e\u0442 \u0432\u0432\u043e\u0434; \u043f\u043e USB \u043d\u0430\u0434\u0451\u0436\u043d\u0435\u0435"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth-avbrott kan st\u00f6ra inmatningen; USB \u00e4r mer tillf\u00f6rlitligt"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth kopmalar\u0131 giri\u015fi bozabilir; USB daha g\u00fcvenilirdir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0431\u0440\u0438\u0432\u0438 Bluetooth \u043b\u0430\u043c\u0430\u044e\u0442\u044c \u0432\u0432\u0456\u0434; \u0447\u0435\u0440\u0435\u0437 USB \u043d\u0430\u0434\u0456\u0439\u043d\u0456\u0448\u0435"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ng\u1eaft k\u1ebft n\u1ed1i Bluetooth c\u00f3 th\u1ec3 l\u00e0m m\u1ea5t t\u00edn hi\u1ec7u nh\u1eadp; USB \u0111\u00e1ng tin c\u1eady h\u01a1n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u84dd\u7259\u65ad\u8fde\u53ef\u80fd\u5bfc\u81f4\u8f93\u5165\u5931\u6548\uff1bUSB \u66f4\u53ef\u9760"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u85cd\u7259\u65b7\u7dda\u53ef\u80fd\u5c0e\u81f4\u8f38\u5165\u5931\u6548\uff1bUSB \u8f03\u70ba\u53ef\u9760"
          }
        }
      }
    },
