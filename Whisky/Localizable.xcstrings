            "value": "\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u043f\u043b\u044f\u0448\u043a\u0443"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1ea1o bottle th\u1ea5t b\u1ea1i"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bottle \u521b\u5efa\u5931\u8d25"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bottle \u5efa\u7acb\u5931\u6557"
          }
        }
      }
    },
