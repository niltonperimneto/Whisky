    "config.frameGeneration.info": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Off by default. Frame generation reaches MetalFX frame interpolation, which on current macOS can leave the GPU driver unresponsive and end the login session. DLSS upscaling above is unaffected."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
