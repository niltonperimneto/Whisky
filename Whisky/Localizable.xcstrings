    "troubleshooting.verify.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0647\u0644 \u0623\u0635\u0644\u062d \u0630\u0644\u0643 \u0627\u0644\u0645\u0634\u0643\u0644\u0629\u061f"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vy\u0159e\u0161ila to tato oprava?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00f8ste det problemet?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hat das das Problem behoben?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did this fix the problem?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Did this fix the problem?"
          }
        },
        "es": {
