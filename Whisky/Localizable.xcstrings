            "state": "translated",
            "value": "Prueba a conectarlo por USB o revisa Ajustes del Sistema"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeile USB-yhteytt\u00e4 tai tarkista J\u00e4rjestelm\u00e4asetukset"
