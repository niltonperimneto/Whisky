          }
        }
      }
    },
    "steam.client.timeout": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u064a\u0628\u062f\u0623 Steam \u062e\u0644\u0627\u0644 90 \u062b\u0627\u0646\u064a\u0629. \u0631\u0627\u062c\u0639 \u062f\u0644\u064a\u0644 \u0627\u0633\u062a\u0643\u0634\u0627\u0641 \u0623\u062e\u0637\u0627\u0621 \u0627\u0644\u0645\u0634\u063a\u0651\u0644\u0627\u062a."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam se nespustil do 90 sekund. Pod\u00edvejte se do pr\u016fvodce \u0159e\u0161en\u00edm pot\u00ed\u017e\u00ed s launchery."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam startede ikke inden for 90 sekunder. Se vejledningen til fejlfinding af launchere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam wurde nicht innerhalb von 90 Sekunden gestartet. Sieh in der Anleitung zur Launcher-Fehlerbehebung nach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam didn't start within 90 seconds. Check the launcher troubleshooting guide."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam didn't start within 90 seconds. Check the launcher troubleshooting guide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam no se ha iniciado en 90 segundos. Consulta la gu\u00eda de resoluci\u00f3n de problemas de lanzadores."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam ei k\u00e4ynnistynyt 90 sekunnissa. Katso k\u00e4ynnistimen vianm\u00e4\u00e4ritysopas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam n'a pas d\u00e9marr\u00e9 en 90 secondes. Consultez le guide de d\u00e9pannage des lanceurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam non si \u00e8 avviato entro 90 secondi. Consulta la guida alla risoluzione dei problemi dei launcher."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam \u304c 90 \u79d2\u4ee5\u5185\u306b\u8d77\u52d5\u3057\u307e\u305b\u3093\u3067\u3057\u305f\u3002\u30e9\u30f3\u30c1\u30e3\u30fc\u306e\u30c8\u30e9\u30d6\u30eb\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0\u30ac\u30a4\u30c9\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam\uc774 90\ucd08 \uc548\uc5d0 \uc2dc\uc791\ub418\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \ub7f0\ucc98 \ubb38\uc81c \ud574\uacb0 \uac00\uc774\ub4dc\ub97c \ud655\uc778\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam is niet binnen 90 seconden gestart. Raadpleeg de handleiding voor launcherproblemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam nie uruchomi\u0142 si\u0119 w ci\u0105gu 90 sekund. Sprawd\u017a przewodnik rozwi\u0105zywania problem\u00f3w z launcherami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Steam n\u00e3o iniciou em 90 segundos. Consulte o guia de resolu\u00e7\u00e3o de problemas de launchers."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Steam n\u00e3o arrancou em 90 segundos. Consulte o guia de resolu\u00e7\u00e3o de problemas de launchers."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam nu a pornit \u00een 90 de secunde. Consult\u0103 ghidul de depanare pentru launchere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam \u043d\u0435 \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u043b\u0441\u044f \u0437\u0430 90 \u0441\u0435\u043a\u0443\u043d\u0434. \u0421\u043c. \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e \u043f\u043e \u0443\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u044e \u043d\u0435\u043f\u043e\u043b\u0430\u0434\u043e\u043a \u043b\u0430\u0443\u043d\u0447\u0435\u0440\u043e\u0432."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam startade inte inom 90 sekunder. Se fels\u00f6kningsguiden f\u00f6r launchers."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam 90 saniye i\u00e7inde ba\u015flamad\u0131. Ba\u015flat\u0131c\u0131 sorun giderme k\u0131lavuzuna bak\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam \u043d\u0435 \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0432\u0441\u044f \u0437\u0430 90 \u0441\u0435\u043a\u0443\u043d\u0434. \u041f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u044c\u0442\u0435 \u043f\u043e\u0441\u0456\u0431\u043d\u0438\u043a \u0437 \u0443\u0441\u0443\u043d\u0435\u043d\u043d\u044f \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u043b\u0430\u0443\u043d\u0447\u0435\u0440\u0456\u0432."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam kh\u00f4ng kh\u1edfi \u0111\u1ed9ng trong 90 gi\u00e2y. H\u00e3y xem h\u01b0\u1edbng d\u1eabn kh\u1eafc ph\u1ee5c tr\u00ecnh kh\u1edfi ch\u1ea1y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam \u672a\u5728 90 \u79d2\u5185\u542f\u52a8\u3002\u8bf7\u67e5\u770b\u542f\u52a8\u5668\u7591\u96be\u89e3\u7b54\u6307\u5357\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam \u672a\u5728 90 \u79d2\u5167\u555f\u52d5\u3002\u8acb\u67e5\u770b\u555f\u52d5\u5668\u7591\u96e3\u6392\u89e3\u6307\u5357\u3002"
          }
        }
      }
    },
