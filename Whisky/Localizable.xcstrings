        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa correcciones autom\u00e1ticas para Steam, Rockstar, EA App, Epic Games y otros lanzadores de juegos (frankea/Whisky#41)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottaa k\u00e4ytt\u00f6\u00f6n automaattiset korjaukset Steamille, Rockstarille, EA Appille, Epic Gamesille ja muille pelik\u00e4ynnistimille (frankea/Whisky#41)"
          }
