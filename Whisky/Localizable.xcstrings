    "config.preset.balanced.desc": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 \u0644\u0645\u0639\u0638\u0645 \u0627\u0644\u0623\u0644\u0639\u0627\u0628"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00fdchoz\u00ed nastaven\u00ed pro v\u011bt\u0161inu her"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardindstillinger til de fleste spil"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardeinstellungen f\u00fcr die meisten Spiele"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default settings for most games"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Default settings for most games"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes predeterminados para la mayor\u00eda"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletusasetukset useimpiin peleihin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "R\u00e9glages par d\u00e9faut pour la plupart des jeux"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostazioni standard per quasi tutti i giochi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u307b\u3068\u3093\u3069\u306e\u30b2\u30fc\u30e0\u306b\u9069\u3057\u305f\u6a19\u6e96\u8a2d\u5b9a"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub300\ubd80\ubd84\uc758 \uac8c\uc784\uc5d0 \uc801\ud569\ud55c \uae30\ubcf8 \uc124\uc815"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaardinstellingen voor de meeste games"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domy\u015blne ustawienia dla wi\u0119kszo\u015bci gier"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura\u00e7\u00f5es padr\u00e3o para a maioria dos jogos"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Defini\u00e7\u00f5es padr\u00e3o para a maioria dos jogos"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Set\u0103ri implicite pentru majoritatea jocurilor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0434\u043b\u044f \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u0430 \u0438\u0433\u0440"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardinst\u00e4llningar f\u00f6r de flesta spel"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c7o\u011fu oyun i\u00e7in varsay\u0131lan ayarlar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0456 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0434\u043b\u044f \u0431\u0456\u043b\u044c\u0448\u043e\u0441\u0442\u0456 \u0456\u0433\u043e\u0440"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u00e0i \u0111\u1eb7t m\u1eb7c \u0111\u1ecbnh cho h\u1ea7u h\u1ebft game"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9002\u7528\u4e8e\u5927\u591a\u6570\u6e38\u620f\u7684\u9ed8\u8ba4\u8bbe\u7f6e"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9069\u7528\u65bc\u5927\u591a\u6578\u904a\u6232\u7684\u9810\u8a2d\u8a2d\u5b9a"
          }
        }
      }
    },
    "config.preset.performance.desc": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0639\u0637\u064a \u0627\u0644\u0623\u0648\u0644\u0648\u064a\u0629 \u0644\u0645\u0639\u062f\u0644 \u0627\u0644\u0625\u0637\u0627\u0631\u0627\u062a \u0639\u0644\u0649 \u062c\u0648\u062f\u0629 \u0627\u0644\u0635\u0648\u0631\u0629. \u0645\u0641\u064a\u062f \u0639\u0646\u062f \u0627\u0646\u062e\u0641\u0627\u0636 \u0627\u0644\u0625\u0637\u0627\u0631\u0627\u062a."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Up\u0159ednostn\u00ed FPS p\u0159ed kvalitou obrazu. Vhodn\u00e9 p\u0159i propadech FPS."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioriterer FPS frem for billedkvalitet. Godt ved FPS-fald."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevorzugt FPS gegen\u00fcber Bildqualit\u00e4t. Gut bei FPS-Einbr\u00fcchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioritizes FPS over visual quality. Good for FPS drops."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioritises FPS over visual quality. Good for FPS drops."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioriza los FPS sobre la calidad visual. \u00datil si hay ca\u00eddas de FPS."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Painottaa FPS:\u00e4\u00e4 kuvanlaadun sijaan. Auttaa FPS-pudotuksiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Privil\u00e9gie les FPS \u00e0 la qualit\u00e9 visuelle. Utile en cas de chutes de FPS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Privilegia gli FPS rispetto alla qualit\u00e0 visiva. Utile se gli FPS calano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u753b\u8cea\u3088\u308a FPS \u3092\u512a\u5148\u3057\u307e\u3059\u3002\u30d5\u30ec\u30fc\u30e0\u843d\u3061\u306e\u5bfe\u7b56\u306b\u6709\u52b9\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud654\uc9c8\ubcf4\ub2e4 FPS\ub97c \uc6b0\uc120\ud569\ub2c8\ub2e4. \ud504\ub808\uc784 \uc800\ud558\uc5d0 \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geeft voorrang aan fps boven beeldkwaliteit. Goed bij fps-dips."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorytet FPS kosztem jako\u015bci obrazu. Pomaga przy spadkach FPS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioriza os FPS em vez da qualidade visual. Bom para quedas de FPS."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioriza os FPS sobre a qualidade visual. Bom para quedas de FPS."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioritizeaz\u0103 FPS-ul \u00een locul calit\u0103\u021bii vizuale. Bun la sc\u0103deri de FPS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442 FPS \u043d\u0430\u0434 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u043e\u043c \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0438. \u041f\u043e\u043c\u043e\u0433\u0430\u0435\u0442 \u043f\u0440\u0438 \u043f\u0440\u043e\u0441\u0430\u0434\u043a\u0430\u0445 FPS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioriterar FPS f\u00f6re bildkvalitet. Bra vid FPS-fall."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00f6rsel kaliteden \u00e7ok FPS'e \u00f6ncelik verir. FPS d\u00fc\u015f\u00fc\u015flerinde iyidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0456\u043e\u0440\u0438\u0442\u0435\u0442 FPS \u043d\u0430\u0434 \u044f\u043a\u0456\u0441\u0442\u044e \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0438. \u041a\u043e\u0440\u0438\u0441\u043d\u043e \u043f\u0440\u0438 \u043f\u0440\u043e\u0441\u0456\u0434\u0430\u043d\u043d\u044f\u0445 FPS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u01afu ti\u00ean FPS h\u01a1n ch\u1ea5t l\u01b0\u1ee3ng h\u00ecnh \u1ea3nh. H\u1ee3p khi b\u1ecb t\u1ee5t FPS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f18\u5148\u4fdd\u8bc1\u5e27\u7387\u800c\u975e\u753b\u8d28\u3002\u9002\u5408\u5e27\u6570\u504f\u4f4e\u65f6\u4f7f\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u512a\u5148\u78ba\u4fdd FPS \u800c\u975e\u756b\u8cea\u3002\u9069\u5408\u756b\u9762\u6389\u5e40\u6642\u4f7f\u7528\u3002"
          }
        }
      }
    },
    "config.preset.quality.desc": {
      "localizations": {
        "ar": {
