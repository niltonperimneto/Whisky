    "main.createFirst": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0642\u0645 \u0628\u0625\u0646\u0634\u0627\u0621 \u0642\u0627\u0631\u0648\u0631\u062a\u0643 \u0627\u0644\u0623\u0648\u0644\u0649 \u0644\u0644\u0628\u062f\u0621"
