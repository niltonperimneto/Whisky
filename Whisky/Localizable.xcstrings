    "config.forceD3D11.info": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0633\u062a\u062e\u062f\u0645 \u0648\u0636\u0639 D3D11 \u0644\u062a\u0648\u0627\u0641\u0642 \u0623\u0641\u0636\u0644 \u0645\u0639 \u0627\u0644\u0623\u0644\u0639\u0627\u0628 \u0627\u0644\u0642\u062f\u064a\u0645\u0629"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Re\u017eim D3D11 pro lep\u0161\u00ed kompatibilitu se star\u0161\u00edmi hrami"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug D3D11-tilstand for bedre kompatibilitet med \u00e6ldre spil"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "D3D11-Modus f\u00fcr bessere Kompatibilit\u00e4t mit \u00e4lteren Spielen verwenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use D3D11 mode for better compatibility with older games"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use D3D11 mode for better compatibility with older games"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el modo D3D11 para mejorar la compatibilidad con juegos antiguos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u00e4ytt\u00e4\u00e4 D3D11-tilaa vanhempien pelien paremman yhteensopivuuden vuoksi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le mode D3D11 pour une meilleure compatibilit\u00e9 avec les jeux anciens"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la modalit\u00e0 D3D11 per una migliore compatibilit\u00e0 con i giochi meno recenti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53e4\u3044\u30b2\u30fc\u30e0\u3068\u306e\u4e92\u63db\u6027\u3092\u9ad8\u3081\u308b\u305f\u3081 D3D11 \u30e2\u30fc\u30c9\u3092\u4f7f\u7528\u3057\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ub798\ub41c \uac8c\uc784\uacfc\uc758 \ud638\ud658\uc131\uc744 \uc704\ud574 D3D11 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik de D3D11-modus voor betere compatibiliteit met oudere games"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb D3D11 dla lepszej zgodno\u015bci ze starszymi grami"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o modo D3D11 para melhor compatibilidade com jogos antigos"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o modo D3D11 para melhor compatibilidade com jogos mais antigos"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folose\u0219te modul D3D11 pentru compatibilitate mai bun\u0103 cu jocurile vechi"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0435\u0436\u0438\u043c D3D11 \u0434\u043b\u044f \u043b\u0443\u0447\u0448\u0435\u0439 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u0438\u043c\u043e\u0441\u0442\u0438 \u0441\u043e \u0441\u0442\u0430\u0440\u044b\u043c\u0438 \u0438\u0433\u0440\u0430\u043c\u0438"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anv\u00e4nd D3D11-l\u00e4ge f\u00f6r b\u00e4ttre kompatibilitet med \u00e4ldre spel"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski oyunlarla daha iyi uyumluluk i\u00e7in D3D11 modunu kullan\u0131r"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0435\u0436\u0438\u043c D3D11 \u0434\u043b\u044f \u043a\u0440\u0430\u0449\u043e\u0457 \u0441\u0443\u043c\u0456\u0441\u043d\u043e\u0441\u0442\u0456 \u0437\u0456 \u0441\u0442\u0430\u0440\u0438\u043c\u0438 \u0456\u0433\u0440\u0430\u043c\u0438"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00f9ng ch\u1ebf \u0111\u1ed9 D3D11 \u0111\u1ec3 t\u01b0\u01a1ng th\u00edch t\u1ed1t h\u01a1n v\u1edbi game c\u0169"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f7f\u7528 D3D11 \u6a21\u5f0f\u4ee5\u63d0\u5347\u4e0e\u65e7\u6e38\u620f\u7684\u517c\u5bb9\u6027"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f7f\u7528 D3D11 \u6a21\u5f0f\u4ee5\u63d0\u5347\u8207\u820a\u904a\u6232\u7684\u76f8\u5bb9\u6027"
          }
        }
      }
    },
