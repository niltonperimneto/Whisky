    "setup.whiskywine.error.serverError": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062e\u0637\u0623 \u0641\u064a \u0627\u0644\u062e\u0627\u062f\u0645. \u064a\u064f\u0631\u062c\u0649 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0644\u0627\u062d\u0642\u064b\u0627."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chyba serveru. Zkuste to pros\u00edm pozd\u011bji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverfejl. Pr\u00f8v igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverfehler. Bitte versuche es sp\u00e4ter erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server error. Please try again later."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Server error. Please try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error del servidor. Int\u00e9ntalo m\u00e1s tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelinvirhe. Yrit\u00e4 my\u00f6hemmin uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreur du serveur. Veuillez r\u00e9essayer plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Errore del server. Riprova pi\u00f9 tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b5\u30fc\u30d0\u30fc\u30a8\u30e9\u30fc\u3067\u3059\u3002\u3057\u3070\u3089\u304f\u3057\u3066\u304b\u3089\u3082\u3046\u4e00\u5ea6\u304a\u8a66\u3057\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc11c\ubc84 \uc624\ub958\uc785\ub2c8\ub2e4. \uc7a0\uc2dc \ud6c4 \ub2e4\uc2dc \uc2dc\ub3c4\ud574 \uc8fc\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverfout. Probeer het later opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u0142\u0105d serwera. Spr\u00f3buj ponownie p\u00f3\u017aniej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Erro do servidor. Tente novamente mais tarde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Erro do servidor. Tente novamente mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eroare de server. \u00cencearc\u0103 mai t\u00e2rziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0448\u0438\u0431\u043a\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0430. \u041f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u0435 \u043f\u043e\u043f\u044b\u0442\u043a\u0443 \u043f\u043e\u0437\u0436\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverfel. F\u00f6rs\u00f6k igen senare."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu hatas\u0131. L\u00fctfen daha sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043c\u0438\u043b\u043a\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0430. \u041f\u043e\u0432\u0442\u043e\u0440\u0456\u0442\u044c \u0441\u043f\u0440\u043e\u0431\u0443 \u043f\u0456\u0437\u043d\u0456\u0448\u0435."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u1ed7i m\u00e1y ch\u1ee7. H\u00e3y th\u1eed l\u1ea1i sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u670d\u52a1\u5668\u9519\u8bef\u3002\u8bf7\u7a0d\u540e\u518d\u8bd5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f3a\u670d\u5668\u932f\u8aa4\u3002\u8acb\u7a0d\u5f8c\u518d\u8a66\u3002"
          }
        }
      }
    },
    "setup.whiskywine.error.tarballMissing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0628\u064a\u0626\u0629 \u062a\u0634\u063a\u064a\u0644 Wine \u0627\u0644\u062a\u064a \u062a\u0645 \u062a\u0646\u0632\u064a\u0644\u0647\u0627 \u0645\u0641\u0642\u0648\u062f\u0629 \u0648\u0644\u0627 \u064a\u0645\u0643\u0646 \u062a\u062b\u0628\u064a\u062a\u0647\u0627. \u0639\u0644\u0649 \u0627\u0644\u0623\u0631\u062c\u062d \u0623\u064f\u0632\u064a\u0644\u062a \u0642\u0628\u0644 \u0627\u0643\u062a\u0645\u0627\u0644 \u0627\u0644\u062a\u062b\u0628\u064a\u062a. \u064a\u064f\u0631\u062c\u0649 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta\u017een\u00e9 prost\u0159ed\u00ed Wine chyb\u00ed, a proto je nelze nainstalovat. Pravd\u011bpodobn\u011b bylo odstran\u011bno p\u0159ed dokon\u010den\u00edm instalace. Zkuste to pros\u00edm znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den hentede Wine-runtime mangler og kan ikke installeres. Den blev sandsynligvis fjernet, f\u00f8r installationen var f\u00e6rdig. Pr\u00f8v igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die geladene Wine-Runtime fehlt und kann nicht installiert werden. Vermutlich wurde sie entfernt, bevor die Installation abgeschlossen war. Bitte versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The downloaded Wine runtime is missing and can't be installed. It was likely removed before installation finished. Please try again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The downloaded Wine runtime is missing and can't be installed. It was likely removed before installation finished. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El runtime de Wine descargado no est\u00e1 y no se puede instalar. Es probable que se eliminara antes de terminar la instalaci\u00f3n. Int\u00e9ntalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladattu Wine-ajoymp\u00e4rist\u00f6 puuttuu eik\u00e4 sit\u00e4 voi asentaa. Se poistettiin todenn\u00e4k\u00f6isesti ennen asennuksen valmistumista. Yrit\u00e4 uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le runtime Wine t\u00e9l\u00e9charg\u00e9 est introuvable et ne peut pas \u00eatre install\u00e9. Il a probablement \u00e9t\u00e9 supprim\u00e9 avant la fin de l'installation. Veuillez r\u00e9essayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il runtime Wine scaricato non \u00e8 presente e non pu\u00f2 essere installato. Probabilmente \u00e8 stato rimosso prima del termine dell'installazione. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u305f Wine \u30e9\u30f3\u30bf\u30a4\u30e0\u304c\u898b\u3064\u304b\u3089\u306a\u3044\u305f\u3081\u3001\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3067\u304d\u307e\u305b\u3093\u3002\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u304c\u5b8c\u4e86\u3059\u308b\u524d\u306b\u524a\u9664\u3055\u308c\u305f\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3082\u3046\u4e00\u5ea6\u304a\u8a66\u3057\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2e4\uc6b4\ub85c\ub4dc\ud55c Wine \ub7f0\ud0c0\uc784\uc774 \uc5c6\uc5b4 \uc124\uce58\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uc124\uce58\uac00 \ub05d\ub098\uae30 \uc804\uc5d0 \uc0ad\uc81c\ub41c \uac83\uc73c\ub85c \ubcf4\uc785\ub2c8\ub2e4. \ub2e4\uc2dc \uc2dc\ub3c4\ud574 \uc8fc\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gedownloade Wine-runtime ontbreekt en kan niet worden ge\u00efnstalleerd. Waarschijnlijk is deze verwijderd voordat de installatie klaar was. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brakuje pobranego silnika Wine, wi\u0119c nie mo\u017cna go zainstalowa\u0107. Prawdopodobnie zosta\u0142 usuni\u0119ty przed zako\u0144czeniem instalacji. Spr\u00f3buj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O runtime do Wine baixado n\u00e3o est\u00e1 presente e n\u00e3o pode ser instalado. Provavelmente foi removido antes de a instala\u00e7\u00e3o terminar. Tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O runtime do Wine transferido n\u00e3o est\u00e1 presente e n\u00e3o pode ser instalado. Provavelmente foi removido antes de a instala\u00e7\u00e3o terminar. Tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime-ul Wine desc\u0103rcat lipse\u0219te \u0219i nu poate fi instalat. Probabil a fost \u0219ters \u00eenainte de finalizarea instal\u0103rii. \u00cencearc\u0103 din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0433\u0440\u0443\u0436\u0435\u043d\u043d\u0430\u044f \u0441\u0440\u0435\u0434\u0430 Wine \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0435\u0451 \u043d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c. \u0421\u043a\u043e\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043e, \u0444\u0430\u0439\u043b \u0431\u044b\u043b \u0443\u0434\u0430\u043b\u0451\u043d \u0434\u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u044f \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438. \u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0451 \u0440\u0430\u0437."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den h\u00e4mtade Wine-runtime saknas och kan inte installeras. Den togs troligen bort innan installationen var klar. F\u00f6rs\u00f6k igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130ndirilen Wine \u00e7al\u0131\u015fma zaman\u0131 bulunamad\u0131\u011f\u0131 i\u00e7in y\u00fcklenemiyor. B\u00fcy\u00fck olas\u0131l\u0131kla y\u00fckleme tamamlanmadan kald\u0131r\u0131ld\u0131. L\u00fctfen yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043e\u0433\u043e \u0440\u0443\u0448\u0456\u044f Wine \u043d\u0435\u043c\u0430\u0454, \u0442\u043e\u043c\u0443 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0438 \u0439\u043e\u0433\u043e \u043d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f. \u041d\u0430\u0439\u0456\u043c\u043e\u0432\u0456\u0440\u043d\u0456\u0448\u0435, \u0444\u0430\u0439\u043b \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u043e \u0434\u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u044f \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f. \u0421\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0449\u0435 \u0440\u0430\u0437."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng t\u00ecm th\u1ea5y runtime Wine \u0111\u00e3 t\u1ea3i n\u00ean kh\u00f4ng th\u1ec3 c\u00e0i. C\u00f3 th\u1ec3 n\u00f3 \u0111\u00e3 b\u1ecb x\u00f3a tr\u01b0\u1edbc khi c\u00e0i xong. H\u00e3y th\u1eed l\u1ea1i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0b\u8f7d\u7684 Wine \u8fd0\u884c\u65f6\u5df2\u4e22\u5931\uff0c\u65e0\u6cd5\u5b89\u88c5\u3002\u5b83\u53ef\u80fd\u5728\u5b89\u88c5\u5b8c\u6210\u524d\u88ab\u79fb\u9664\u3002\u8bf7\u91cd\u8bd5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0b\u8f09\u7684 Wine \u57f7\u884c\u968e\u6bb5\u5df2\u907a\u5931\uff0c\u7121\u6cd5\u5b89\u88dd\u3002\u5b83\u53ef\u80fd\u5728\u5b89\u88dd\u5b8c\u6210\u524d\u88ab\u79fb\u9664\u3002\u8acb\u91cd\u8a66\u3002"
          }
        }
      }
    },
