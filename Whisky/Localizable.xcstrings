    "config.graphics.programOverrides.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0645\u0643\u0646\u0643 \u062a\u0643\u0648\u064a\u0646\u0647\u0627 \u0645\u0646 \u0635\u0641 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c \u0641\u064a \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0628\u0631\u0627\u0645\u062c \u0627\u0644\u0645\u062b\u0628\u062a\u0629."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastav\u00edte je v \u0159\u00e1dku programu v Nainstalovan\u00fdch programech."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan indstille dem fra programmets r\u00e6kke under Installerede programmer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese lassen sich in der Zeile des Programms unter \u201eInstallierte Programme\u201c konfigurieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure these from a program's row in Installed Programs."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure these from a program's row in Installed Programs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Config\u00faralas desde la fila del programa en Programas Instalados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00e4\u00e4rit\u00e4 n\u00e4m\u00e4 ohjelman rivilt\u00e4 Asennetut ohjelmat -luettelossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez-les depuis la ligne du programme dans Programmes install\u00e9s."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi configurarli dalla riga del programma in Programmi installati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u6e08\u307f\u306e\u30d7\u30ed\u30b0\u30e9\u30e0\u300d\u306e\u5404\u884c\u304b\u3089\u8a2d\u5b9a\u3067\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc124\uce58\ub41c \ud504\ub85c\uadf8\ub7a8 \ubaa9\ub85d\uc758 \uac01 \ud589\uc5d0\uc11c \uc124\uc815\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel deze in via de regel van een programma bij 'Ge\u00efnstalleerde programma's'."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skonfigurujesz je w wierszu programu w Zainstalowanych programach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure-as pela linha do programa em Programas Instalados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure-as a partir da linha do programa em Programas Instalados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Le po\u021bi configura din r\u00e2ndul programului, \u00een Programe Instalate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0445 \u043c\u043e\u0436\u043d\u043e \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u0432 \u0441\u0442\u0440\u043e\u043a\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b \u0432 \u0440\u0430\u0437\u0434\u0435\u043b\u0435 \u00ab\u0423\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044b\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b\u00bb."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du st\u00e4ller in dem fr\u00e5n programmets rad under Installerade program."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar\u0131 Y\u00fckl\u00fc Programlar listesindeki program sat\u0131r\u0131ndan yap\u0131land\u0131r\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0407\u0445 \u043c\u043e\u0436\u043d\u0430 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438 \u0432 \u0440\u044f\u0434\u043a\u0443 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u0432 \u0440\u043e\u0437\u0434\u0456\u043b\u0456 \u00ab\u0412\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0456 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438\u00bb."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u1ea5u h\u00ecnh t\u1eeb d\u00f2ng c\u1ee7a ch\u01b0\u01a1ng tr\u00ecnh trong m\u1ee5c Ch\u01b0\u01a1ng tr\u00ecnh \u0111\u00e3 c\u00e0i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ef\u5728\u201c\u5df2\u5b89\u88c5\u7684\u7a0b\u5e8f\u201d\u4e2d\u76f8\u5e94\u7a0b\u5e8f\u7684\u884c\u5185\u8fdb\u884c\u914d\u7f6e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ef\u5728\u300c\u5df2\u5b89\u88dd\u7684\u7a0b\u5f0f\u300d\u4e2d\u8a72\u7a0b\u5f0f\u7684\u5217\u9032\u884c\u8a2d\u5b9a\u3002"
          }
        }
      }
    },
    "config.graphics.programOverridesActive": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0648\u062c\u062f \u062a\u062c\u0627\u0648\u0632\u0627\u062a \u062e\u0627\u0635\u0629 \u0628\u0628\u0639\u0636 \u0627\u0644\u0628\u0631\u0627\u0645\u062c."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "U n\u011bkter\u00fdch program\u016f jsou aktivn\u00ed vlastn\u00ed p\u0159episy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogle programmer har deres egne tilsides\u00e6ttelser aktive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00fcr einige Programme sind eigene \u00dcberschreibungen aktiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per-program overrides are active for some programs."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Per-program overrides are active for some programs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay anulaciones activas para algunos programas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohjelmakohtaiset ohitukset ovat k\u00e4yt\u00f6ss\u00e4 joillakin ohjelmilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des r\u00e9glages sp\u00e9cifiques sont actifs pour certains programmes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per alcuni programmi sono attivi override specifici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u90e8\u306e\u30d7\u30ed\u30b0\u30e9\u30e0\u3067\u3001\u30d7\u30ed\u30b0\u30e9\u30e0\u3054\u3068\u306e\u4e0a\u66f8\u304d\u304c\u6709\u52b9\u306b\u306a\u3063\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc77c\ubd80 \ud504\ub85c\uadf8\ub7a8\uc5d0 \ud504\ub85c\uadf8\ub7a8\ubcc4 \uc7ac\uc815\uc758\uac00 \uc801\uc6a9\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor sommige programma's zijn eigen overrides actief."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla niekt\u00f3rych program\u00f3w dzia\u0142aj\u0105 w\u0142asne zast\u0105pienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e1 substitui\u00e7\u00f5es por programa ativas para alguns programas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e1 substitui\u00e7\u00f5es por programa ativas para alguns programas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru unele programe sunt active suprascrieri proprii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043b\u044f \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044e\u0442 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0435 \u0437\u0430\u043c\u0435\u043d\u044b."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissa program har egna \u00e5sidos\u00e4ttningar aktiva."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baz\u0131 programlar i\u00e7in programa \u00f6zel ge\u00e7ersiz k\u0131lmalar etkin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043b\u044f \u0434\u0435\u044f\u043a\u0438\u0445 \u043f\u0440\u043e\u0433\u0440\u0430\u043c \u0434\u0456\u044e\u0442\u044c \u043e\u043a\u0440\u0435\u043c\u0456 \u043f\u0435\u0440\u0435\u0432\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u1ed9t s\u1ed1 ch\u01b0\u01a1ng tr\u00ecnh \u0111ang b\u1eadt ghi \u0111\u00e8 ri\u00eang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u90e8\u5206\u7a0b\u5e8f\u5df2\u542f\u7528\u9488\u5bf9\u5355\u4e2a\u7a0b\u5e8f\u7684\u8986\u76d6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
