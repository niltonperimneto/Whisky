    "bottle.orphan.tooltip": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0628\u062f\u0623\u062a \u0628\u0639\u0636 \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u062e\u0627\u0631\u062c Whisky"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u011bkter\u00e9 procesy byly spu\u0161t\u011bny mimo Whisky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogle processer blev startet uden om Whisky"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Prozesse wurden au\u00dferhalb von Whisky gestartet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some processes were started outside Whisky"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Some processes were started outside Whisky"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos procesos se iniciaron fuera de Whisky"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osa prosesseista k\u00e4ynnistettiin Whiskyn ulkopuolella"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains processus ont \u00e9t\u00e9 lanc\u00e9s en dehors de Whisky"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni processi sono stati avviati fuori da Whisky"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u90e8\u306e\u30d7\u30ed\u30bb\u30b9\u306f Whisky \u306e\u5916\u90e8\u3067\u8d77\u52d5\u3055\u308c\u3066\u3044\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc77c\ubd80 \ud504\ub85c\uc138\uc2a4\ub294 Whisky \uc678\ubd80\uc5d0\uc11c \uc2dc\uc791\ub418\uc5c8\uc2b5\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige processen zijn buiten Whisky om gestart"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cz\u0119\u015b\u0107 proces\u00f3w uruchomiono poza Whisky"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns processos foram iniciados fora do Whisky"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns processos foram iniciados fora do Whisky"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Unele procese au fost pornite \u00een afara Whisky"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u044b \u0437\u0430\u043f\u0443\u0449\u0435\u043d\u044b \u043d\u0435 \u0438\u0437 Whisky"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissa processer startades utanf\u00f6r Whisky"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baz\u0131 i\u015flemler Whisky d\u0131\u015f\u0131nda ba\u015flat\u0131ld\u0131"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u0435\u044f\u043a\u0456 \u043f\u0440\u043e\u0446\u0435\u0441\u0438 \u0437\u0430\u043f\u0443\u0449\u0435\u043d\u043e \u043d\u0435 \u0437 Whisky"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u1ed9t s\u1ed1 ti\u1ebfn tr\u00ecnh \u0111\u01b0\u1ee3c kh\u1edfi ch\u1ea1y b\u00ean ngo\u00e0i Whisky"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u90e8\u5206\u8fdb\u7a0b\u662f\u5728 Whisky \u4e4b\u5916\u542f\u52a8\u7684"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u90e8\u5206\u7a0b\u5e8f\u662f\u5728 Whisky \u4e4b\u5916\u555f\u52d5\u7684"
          }
        }
      }
    },
    "bottle.orphaned.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0647\u0630\u0647 \u0627\u0644\u0632\u062c\u0627\u062c\u0627\u062a \u0645\u0648\u062c\u0648\u062f\u0629 \u0639\u0644\u0649 \u0627\u0644\u0642\u0631\u0635 \u0644\u0643\u0646\u0647\u0627 \u0644\u064a\u0633\u062a \u0641\u064a \u0645\u0643\u062a\u0628\u062a\u0643: %@. \u062a\u0624\u062f\u064a \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0625\u0644\u0649 \u0625\u0636\u0627\u0641\u062a\u0647\u0627 \u0645\u062c\u062f\u062f\u064b\u0627 \u0625\u0644\u0649 \u0627\u0644\u0634\u0631\u064a\u0637 \u0627\u0644\u062c\u0627\u0646\u0628\u064a\u060c \u0648\u0644\u0627 \u064a\u062a\u063a\u064a\u0631 \u0623\u064a \u0634\u064a\u0621 \u0639\u0644\u0649 \u0627\u0644\u0642\u0631\u0635."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto lahve jsou na disku, ale nejsou ve va\u0161\u00ed knihovn\u011b: %@. Op\u011btovn\u00fd import je vr\u00e1t\u00ed do postrann\u00edho panelu; na disku se nic nezm\u011bn\u00ed."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse flasker findes p\u00e5 disken, men ikke i dit bibliotek: %@. Importerer du dem igen, kommer de tilbage i indholdsoversigten; intet p\u00e5 disken \u00e6ndres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Flaschen liegen auf der Festplatte, fehlen aber in deiner \u00dcbersicht: %@. Beim erneuten Importieren erscheinen sie wieder in der Seitenleiste; auf der Festplatte \u00e4ndert sich nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These bottles exist on disk but aren't in your library: %@. Re-importing adds them back to the sidebar; nothing on disk is changed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "These bottles exist on disk but aren't in your library: %@. Re-importing adds them back to the sidebar; nothing on disk is changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas botellas est\u00e1n en el disco pero no en tu biblioteca: %@. Al reimportarlas vuelven a la barra lateral; no se modifica nada en el disco."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e4m\u00e4 pullot ovat levyll\u00e4, mutta eiv\u00e4t kirjastossasi: %@. Uudelleentuonti lis\u00e4\u00e4 ne takaisin sivupalkkiin; levyll\u00e4 olevaan ei kosketa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces bouteilles existent sur le disque mais ne figurent pas dans votre biblioth\u00e8que : %@. Les r\u00e9importer les rajoute \u00e0 la barre lat\u00e9rale ; rien n'est modifi\u00e9 sur le disque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste bottiglie esistono sul disco ma non sono nella tua libreria: %@. Reimportandole tornano nella barra laterale; sul disco non cambia nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u308c\u3089\u306e Bottle \u306f\u30c7\u30a3\u30b9\u30af\u4e0a\u306b\u3042\u308a\u307e\u3059\u304c\u3001\u30e9\u30a4\u30d6\u30e9\u30ea\u306b\u306f\u767b\u9332\u3055\u308c\u3066\u3044\u307e\u305b\u3093: %@\u3002\u518d\u30a4\u30f3\u30dd\u30fc\u30c8\u3059\u308b\u3068\u30b5\u30a4\u30c9\u30d0\u30fc\u306b\u623b\u308a\u307e\u3059\u3002\u30c7\u30a3\u30b9\u30af\u4e0a\u306e\u30c7\u30fc\u30bf\u306f\u5909\u66f4\u3055\u308c\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 Bottle\ub4e4\uc740 \ub514\uc2a4\ud06c\uc5d0 \uc788\uc9c0\ub9cc \ub77c\uc774\ube0c\ub7ec\ub9ac\uc5d0\ub294 \uc5c6\uc2b5\ub2c8\ub2e4: %@. \ub2e4\uc2dc \uac00\uc838\uc624\uba74 \uc0ac\uc774\ub4dc\ubc14\uc5d0 \ucd94\uac00\ub418\uba70, \ub514\uc2a4\ud06c\uc758 \ub0b4\uc6a9\uc740 \ubcc0\uacbd\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze flessen staan op de schijf, maar niet in je bibliotheek: %@. Door ze opnieuw te importeren komen ze terug in de navigatiekolom; op de schijf verandert er niets."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te butelki s\u0105 na dysku, ale nie ma ich w bibliotece: %@. Ponowny import doda je z powrotem do panelu bocznego; na dysku nic si\u0119 nie zmieni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas Bottles existem no disco, mas n\u00e3o est\u00e3o na sua biblioteca: %@. Reimport\u00e1-las as devolve \u00e0 barra lateral; nada \u00e9 alterado no disco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas Bottles existem no disco mas n\u00e3o est\u00e3o na sua biblioteca: %@. Ao reimport\u00e1-las, voltam \u00e0 barra lateral; nada \u00e9 alterado no disco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceste sticle exist\u0103 pe disc, dar nu sunt \u00een biblioteca ta: %@. Reimportarea le adaug\u0103 \u00eenapoi \u00een bara lateral\u0103; nimic de pe disc nu se modific\u0103."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u0438 \u0431\u0443\u0442\u044b\u043b\u043a\u0438 \u0435\u0441\u0442\u044c \u043d\u0430 \u0434\u0438\u0441\u043a\u0435, \u043d\u043e \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0442 \u0432 \u0432\u0430\u0448\u0435\u0439 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0435: %@. \u041f\u043e\u0432\u0442\u043e\u0440\u043d\u044b\u0439 \u0438\u043c\u043f\u043e\u0440\u0442 \u0432\u0435\u0440\u043d\u0451\u0442 \u0438\u0445 \u0432 \u0431\u043e\u043a\u043e\u0432\u043e\u0435 \u043c\u0435\u043d\u044e; \u043d\u0430 \u0434\u0438\u0441\u043a\u0435 \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u0441\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De h\u00e4r flaskorna finns p\u00e5 disken men saknas i ditt bibliotek: %@. Importerar du om dem l\u00e4ggs de tillbaka i sidof\u00e4ltet; inget p\u00e5 disken \u00e4ndras."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu \u015fi\u015feler diskte var ancak kitapl\u0131\u011f\u0131n\u0131zda yok: %@. Yeniden i\u00e7e aktarmak onlar\u0131 kenar \u00e7ubu\u011funa geri ekler; diskteki hi\u00e7bir \u015fey de\u011fi\u015fmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0426\u0456 \u043f\u043b\u044f\u0448\u043a\u0438 \u0454 \u043d\u0430 \u0434\u0438\u0441\u043a\u0443, \u0430\u043b\u0435 \u0457\u0445 \u043d\u0435\u043c\u0430\u0454 \u0443 \u0432\u0430\u0448\u0456\u0439 \u0431\u0456\u0431\u043b\u0456\u043e\u0442\u0435\u0446\u0456: %@. \u041f\u043e\u0432\u0442\u043e\u0440\u043d\u0438\u0439 \u0456\u043c\u043f\u043e\u0440\u0442 \u043f\u043e\u0432\u0435\u0440\u043d\u0435 \u0457\u0445 \u043d\u0430 \u0431\u0456\u0447\u043d\u0443 \u043f\u0430\u043d\u0435\u043b\u044c; \u043d\u0430 \u0434\u0438\u0441\u043a\u0443 \u043d\u0456\u0447\u043e\u0433\u043e \u043d\u0435 \u0437\u043c\u0456\u043d\u0438\u0442\u044c\u0441\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u00e1c bottle n\u00e0y c\u00f3 tr\u00ean \u1ed5 \u0111\u0129a nh\u01b0ng kh\u00f4ng c\u00f3 trong th\u01b0 vi\u1ec7n: %@. Nh\u1eadp l\u1ea1i s\u1ebd \u0111\u01b0a ch\u00fang tr\u1edf l\u1ea1i thanh b\u00ean; d\u1eef li\u1ec7u tr\u00ean \u1ed5 \u0111\u0129a kh\u00f4ng thay \u0111\u1ed5i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fd9\u4e9b Bottle \u5b58\u5728\u4e8e\u78c1\u76d8\u4e0a\uff0c\u4f46\u4e0d\u5728\u4f60\u7684\u8d44\u6599\u5e93\u4e2d\uff1a%@\u3002\u91cd\u65b0\u5bfc\u5165\u4f1a\u5c06\u5b83\u4eec\u52a0\u56de\u8fb9\u680f\uff1b\u78c1\u76d8\u4e0a\u7684\u5185\u5bb9\u4e0d\u4f1a\u6539\u53d8\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9019\u4e9b Bottle \u5b58\u5728\u65bc\u78c1\u789f\u4e0a\uff0c\u4f46\u4e0d\u5728\u4f60\u7684\u6e05\u55ae\u4e2d\uff1a%@\u3002\u91cd\u65b0\u532f\u5165\u6703\u5c07\u5b83\u5011\u52a0\u56de\u5074\u908a\u6b04\uff1b\u78c1\u789f\u4e0a\u7684\u5167\u5bb9\u4e0d\u6703\u8b8a\u52d5\u3002"
          }
        }
      }
    },
