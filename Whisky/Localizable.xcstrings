    "bottle.creation.preflight.insufficientSpace": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u062a\u0648\u062c\u062f \u0645\u0633\u0627\u062d\u0629 \u062e\u0627\u0644\u064a\u0629 \u0643\u0627\u0641\u064a\u0629 \u0644\u0625\u0646\u0634\u0627\u0621 \u0632\u062c\u0627\u062c\u0629: \u0627\u0644\u0645\u062a\u0627\u062d %1$@\u060c \u0628\u064a\u0646\u0645\u0627 \u0627\u0644\u0645\u0637\u0644\u0648\u0628 \u0646\u062d\u0648 %2$@. \u0623\u0641\u0631\u063a \u0628\u0639\u0636 \u0627\u0644\u0645\u0633\u0627\u062d\u0629 \u0623\u0648 \u0627\u062e\u062a\u0631 \u0642\u0631\u0635\u064b\u0627 \u0622\u062e\u0631."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nen\u00ed dost voln\u00e9ho m\u00edsta pro vytvo\u0159en\u00ed lahve: k dispozici %1$@, pot\u0159eba je asi %2$@. Uvoln\u011bte m\u00edsto nebo vyberte jin\u00fd disk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ikke plads nok til at oprette en flaske: %1$@ tilg\u00e6ngelig, men der skal bruges cirka %2$@. Frig\u00f8r plads, eller v\u00e6lg en anden disk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist nicht genug freier Speicherplatz vorhanden, um eine Flasche zu erstellen: %1$@ verf\u00fcgbar, ben\u00f6tigt werden etwa %2$@. Gib Speicherplatz frei oder w\u00e4hle ein anderes Volume."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There isn't enough free space to create a bottle: %1$@ available, but about %2$@ is needed. Free up space or choose another disk."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "There isn't enough free space to create a bottle: %1$@ available, but about %2$@ is needed. Free up space or choose another disk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay espacio libre suficiente para crear una botella: %1$@ disponibles, pero se necesitan unos %2$@. Libera espacio o elige otro disco."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullon luomiseen ei ole tarpeeksi vapaata tilaa: k\u00e4ytett\u00e4viss\u00e4 %1$@, tarvitaan noin %2$@. Vapauta tilaa tai valitse toinen levy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace disque insuffisant pour cr\u00e9er une bouteille : %1$@ disponibles, environ %2$@ n\u00e9cessaires. Lib\u00e9rez de l'espace ou choisissez un autre disque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio libero insufficiente per creare una bottiglia: %1$@ disponibili, ma ne servono circa %2$@. Libera spazio o scegli un altro disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bottle \u3092\u4f5c\u6210\u3059\u308b\u306e\u306b\u5341\u5206\u306a\u7a7a\u304d\u5bb9\u91cf\u304c\u3042\u308a\u307e\u305b\u3093\u3002\u4f7f\u7528\u53ef\u80fd: %1$@\u3001\u5fc5\u8981\u306a\u5bb9\u91cf: \u7d04 %2$@\u3002\u7a7a\u304d\u5bb9\u91cf\u3092\u5897\u3084\u3059\u304b\u3001\u5225\u306e\u30c7\u30a3\u30b9\u30af\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bottle\uc744 \uc0dd\uc131\ud560 \uacf5\uac04\uc774 \ubd80\uc871\ud569\ub2c8\ub2e4. \uc0ac\uc6a9 \uac00\ub2a5: %1$@, \ud544\uc694: \uc57d %2$@. \uacf5\uac04\uc744 \ud655\ubcf4\ud558\uac70\ub098 \ub2e4\ub978 \ub514\uc2a4\ud06c\ub97c \uc120\ud0dd\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is niet genoeg vrije ruimte om een fles aan te maken: %1$@ beschikbaar, terwijl ongeveer %2$@ nodig is. Maak ruimte vrij of kies een andere schijf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za ma\u0142o wolnego miejsca, aby utworzy\u0107 butelk\u0119: dost\u0119pne %1$@, a potrzeba oko\u0142o %2$@. Zwolnij miejsce lub wybierz inny dysk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o h\u00e1 espa\u00e7o livre suficiente para criar uma Bottle: %1$@ dispon\u00edveis, mas s\u00e3o necess\u00e1rios cerca de %2$@. Libere espa\u00e7o ou escolha outro disco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o h\u00e1 espa\u00e7o livre suficiente para criar uma Bottle: %1$@ dispon\u00edveis, mas s\u00e3o necess\u00e1rios cerca de %2$@. Liberte espa\u00e7o ou escolha outro disco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu este destul spa\u021biu liber pentru a crea o sticl\u0103: %1$@ disponibili, dar sunt necesari aproximativ %2$@. Elibereaz\u0103 spa\u021biu sau alege alt disc."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0433\u043e \u043c\u0435\u0441\u0442\u0430 \u0434\u043b\u044f \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u0431\u0443\u0442\u044b\u043b\u043a\u0438: \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e %1$@, \u0430 \u043d\u0443\u0436\u043d\u043e \u043e\u043a\u043e\u043b\u043e %2$@. \u041e\u0441\u0432\u043e\u0431\u043e\u0434\u0438\u0442\u0435 \u043c\u0435\u0441\u0442\u043e \u0438\u043b\u0438 \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0434\u0440\u0443\u0433\u043e\u0439 \u0434\u0438\u0441\u043a."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inte tillr\u00e4ckligt med ledigt utrymme f\u00f6r att skapa en flaska: %1$@ tillg\u00e4ngligt, men cirka %2$@ kr\u00e4vs. Frig\u00f6r utrymme eller v\u00e4lj en annan disk."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015ei\u015fe olu\u015fturmak i\u00e7in yeterli bo\u015f alan yok: %1$@ kullan\u0131labilir, ancak yakla\u015f\u0131k %2$@ gerekiyor. Yer a\u00e7\u0131n veya ba\u015fka bir disk se\u00e7in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043d\u044c\u043e \u0432\u0456\u043b\u044c\u043d\u043e\u0433\u043e \u043c\u0456\u0441\u0446\u044f \u0434\u043b\u044f \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f \u043f\u043b\u044f\u0448\u043a\u0438: \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e %1$@, \u0430 \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u0431\u043b\u0438\u0437\u044c\u043a\u043e %2$@. \u0417\u0432\u0456\u043b\u044c\u043d\u0456\u0442\u044c \u043c\u0456\u0441\u0446\u0435 \u0430\u0431\u043e \u0432\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0456\u043d\u0448\u0438\u0439 \u0434\u0438\u0441\u043a."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng \u0111\u1ee7 dung l\u01b0\u1ee3ng tr\u1ed1ng \u0111\u1ec3 t\u1ea1o bottle: c\u00f2n %1$@, c\u1ea7n kho\u1ea3ng %2$@. H\u00e3y gi\u1ea3i ph\u00f3ng dung l\u01b0\u1ee3ng ho\u1eb7c ch\u1ecdn \u1ed5 \u0111\u0129a kh\u00e1c."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ef\u7528\u7a7a\u95f4\u4e0d\u8db3\uff0c\u65e0\u6cd5\u521b\u5efa Bottle\uff1a\u53ef\u7528 %1$@\uff0c\u7ea6\u9700 %2$@\u3002\u8bf7\u91ca\u653e\u7a7a\u95f4\u6216\u9009\u62e9\u5176\u4ed6\u78c1\u76d8\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ef\u7528\u7a7a\u9593\u4e0d\u8db3\uff0c\u7121\u6cd5\u5efa\u7acb Bottle\uff1a\u53ef\u7528 %1$@\uff0c\u7d04\u9700 %2$@\u3002\u8acb\u91cb\u51fa\u7a7a\u9593\u6216\u9078\u64c7\u5176\u4ed6\u78c1\u789f\u3002"
          }
        }
      }
    },
    "bottle.creation.preflight.notWritable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u062a\u0639\u0630\u0651\u0631 \u0639\u0644\u0649 Whisky \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0641\u064a \u0627\u0644\u0645\u062c\u0644\u062f \u0627\u0644\u0630\u064a \u0627\u062e\u062a\u0631\u062a\u0647 (%@). \u0627\u062e\u062a\u0631 \u0645\u062c\u0644\u062f\u064b\u0627 \u064a\u0645\u0643\u0646\u0643 \u062a\u0639\u062f\u064a\u0644\u0647\u060c \u0645\u062b\u0644 \u0645\u062c\u0644\u062f \u062f\u0627\u062e\u0644 \u0645\u062c\u0644\u062f \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky nem\u016f\u017ee zapisovat do vybran\u00e9 slo\u017eky (%@). Vyberte slo\u017eku, kterou m\u016f\u017eete m\u011bnit, nap\u0159\u00edklad ve va\u0161\u00ed domovsk\u00e9 slo\u017ece."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky kan ikke skrive til den valgte mappe (%@). V\u00e6lg en mappe, du kan \u00e6ndre, f.eks. en mappe i din hjemmemappe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky kann nicht in den gew\u00e4hlten Ordner schreiben (%@). W\u00e4hle einen Ordner, den du \u00e4ndern kannst, zum Beispiel einen in deinem Benutzerordner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky can't write to the folder you chose (%@). Pick a folder you can modify, such as one inside your home folder."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky can't write to the folder you chose (%@). Pick a folder you can modify, such as one inside your home folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky no puede escribir en la carpeta que has elegido (%@). Elige una carpeta que puedas modificar, por ejemplo dentro de tu carpeta de inicio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky ei voi kirjoittaa valitsemaasi kansioon (%@). Valitse kansio, jota voit muokata, esimerkiksi kotikansiostasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky ne peut pas \u00e9crire dans le dossier choisi (%@). Choisissez un dossier que vous pouvez modifier, par exemple dans votre dossier de d\u00e9part."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky non pu\u00f2 scrivere nella cartella che hai scelto (%@). Scegli una cartella che puoi modificare, ad esempio all'interno della tua cartella Inizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9078\u629e\u3057\u305f\u30d5\u30a9\u30eb\u30c0 (%@) \u306b Whisky \u304c\u66f8\u304d\u8fbc\u3081\u307e\u305b\u3093\u3002\u30db\u30fc\u30e0\u30d5\u30a9\u30eb\u30c0\u5185\u306a\u3069\u3001\u5909\u66f4\u3067\u304d\u308b\u30d5\u30a9\u30eb\u30c0\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky\uac00 \uc120\ud0dd\ud55c \ud3f4\ub354(%@)\uc5d0 \uc4f8 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \ud648 \ud3f4\ub354 \uc548\ucc98\ub7fc \uc218\uc815\ud560 \uc218 \uc788\ub294 \ud3f4\ub354\ub97c \uc120\ud0dd\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky kan niet schrijven naar de gekozen map (%@). Kies een map die je kunt wijzigen, bijvoorbeeld een map in je thuismap."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky nie mo\u017ce zapisywa\u0107 w wybranym folderze (%@). Wybierz folder, kt\u00f3ry mo\u017cesz modyfikowa\u0107, na przyk\u0142ad w folderze domowym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Whisky n\u00e3o consegue gravar na pasta que voc\u00ea escolheu (%@). Escolha uma pasta que voc\u00ea possa modificar, como uma dentro da sua pasta pessoal."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Whisky n\u00e3o consegue escrever na pasta que escolheu (%@). Escolha uma pasta que possa modificar, por exemplo dentro da sua pasta pessoal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky nu poate scrie \u00een folderul ales (%@). Alege un folder pe care \u00eel po\u021bi modifica, de exemplu unul din folderul t\u0103u personal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky \u043d\u0435 \u043c\u043e\u0436\u0435\u0442 \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c \u0432 \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u0443\u044e \u043f\u0430\u043f\u043a\u0443 (%@). \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043f\u0430\u043f\u043a\u0443, \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0443\u044e \u0434\u043b\u044f \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 \u0432\u043d\u0443\u0442\u0440\u0438 \u0432\u0430\u0448\u0435\u0439 \u0434\u043e\u043c\u0430\u0448\u043d\u0435\u0439 \u043f\u0430\u043f\u043a\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky kan inte skriva till mappen du valde (%@). V\u00e4lj en mapp som du kan \u00e4ndra i, till exempel en mapp i din hemmapp."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky se\u00e7ti\u011finiz klas\u00f6re (%@) yazam\u0131yor. Ana klas\u00f6r\u00fcn\u00fczdeki gibi de\u011fi\u015ftirebilece\u011finiz bir klas\u00f6r se\u00e7in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky \u043d\u0435 \u043c\u043e\u0436\u0435 \u0437\u0430\u043f\u0438\u0441\u0443\u0432\u0430\u0442\u0438 \u0432 \u043e\u0431\u0440\u0430\u043d\u0443 \u0442\u0435\u043a\u0443 (%@). \u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0442\u0435\u043a\u0443, \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0443 \u0434\u043b\u044f \u0437\u043c\u0456\u043d, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434 \u0443\u0441\u0435\u0440\u0435\u0434\u0438\u043d\u0456 \u0432\u0430\u0448\u043e\u0457 \u0434\u043e\u043c\u0430\u0448\u043d\u044c\u043e\u0457 \u0442\u0435\u043a\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky kh\u00f4ng ghi \u0111\u01b0\u1ee3c v\u00e0o th\u01b0 m\u1ee5c b\u1ea1n \u0111\u00e3 ch\u1ecdn (%@). H\u00e3y ch\u1ecdn th\u01b0 m\u1ee5c b\u1ea1n c\u00f3 quy\u1ec1n s\u1eeda \u0111\u1ed5i, ch\u1eb3ng h\u1ea1n trong th\u01b0 m\u1ee5c nh\u00e0 c\u1ee7a b\u1ea1n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky \u65e0\u6cd5\u5199\u5165\u4f60\u9009\u62e9\u7684\u6587\u4ef6\u5939\uff08%@\uff09\u3002\u8bf7\u9009\u62e9\u4e00\u4e2a\u4f60\u53ef\u4ee5\u4fee\u6539\u7684\u6587\u4ef6\u5939\uff0c\u4f8b\u5982\u4e2a\u4eba\u6587\u4ef6\u5939\u4e2d\u7684\u4f4d\u7f6e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky \u7121\u6cd5\u5beb\u5165\u4f60\u9078\u64c7\u7684\u6a94\u6848\u593e\uff08%@\uff09\u3002\u8acb\u9078\u64c7\u4f60\u53ef\u4ee5\u4fee\u6539\u7684\u6a94\u6848\u593e\uff0c\u4f8b\u5982\u500b\u4eba\u5c08\u5c6c\u6a94\u6848\u593e\u4e2d\u7684\u4f4d\u7f6e\u3002"
          }
        }
      }
    },
