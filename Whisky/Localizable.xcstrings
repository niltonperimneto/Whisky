    "Host compatible": {
      "comment": "Label for a capability indicating whether the host is compatible with a runtime.",
      "isCommentAutoGenerated": true
    },
    "If controllers still don't work, try connecting via USB instead of Bluetooth, or check if the game has native controller support settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0625\u0630\u0627 \u0627\u0633\u062a\u0645\u0631\u062a \u0648\u062d\u062f\u0627\u062a \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0639\u062f\u0645 \u0627\u0644\u0639\u0645\u0644\u060c \u062c\u0631\u0651\u0628 \u0627\u0644\u062a\u0648\u0635\u064a\u0644 \u0639\u0628\u0631 USB \u0628\u062f\u0644\u064b\u0627 \u0645\u0646 Bluetooth\u060c \u0623\u0648 \u062a\u062d\u0642\u0642 \u0645\u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0627\u0644\u0644\u0639\u0628\u0629 \u062a\u0648\u0641\u0631 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u062f\u0639\u0645 \u062e\u0627\u0635\u0629 \u0628\u0648\u062d\u062f\u0627\u062a \u0627\u0644\u062a\u062d\u0643\u0645."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud ovlada\u010de st\u00e1le nefunguj\u00ed, p\u0159ipojte je p\u0159es USB m\u00edsto Bluetooth nebo zkontrolujte nastaven\u00ed podpory ovlada\u010d\u016f p\u0159\u00edmo ve h\u0159e."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis controllerne stadig ikke virker, kan du pr\u00f8ve at tilslutte dem via USB i stedet for Bluetooth eller se, om spillet har sine egne indstillinger til controllere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Controller weiterhin nicht funktionieren, verbinde sie per USB statt \u00fcber Bluetooth oder pr\u00fcfe, ob das Spiel eigene Einstellungen f\u00fcr Controller-Unterst\u00fctzung hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si los mandos siguen sin funcionar, prueba a conectarlos por USB en lugar de Bluetooth o comprueba si el juego tiene ajustes propios de mando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos ohjaimet eiv\u00e4t viel\u00e4k\u00e4\u00e4n toimi, kokeile USB-yhteytt\u00e4 Bluetoothin sijaan tai tarkista, onko peliss\u00e4 omat ohjainasetukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si les manettes ne fonctionnent toujours pas, essayez une connexion USB plut\u00f4t que Bluetooth, ou v\u00e9rifiez si le jeu propose ses propres r\u00e9glages de manette."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se i controller continuano a non funzionare, prova a collegarli via USB anzich\u00e9 via Bluetooth oppure verifica se il gioco ha impostazioni proprie per i controller."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u304c\u307e\u3060\u52d5\u4f5c\u3057\u306a\u3044\u5834\u5408\u306f\u3001Bluetooth \u3067\u306f\u306a\u304f USB \u3067\u63a5\u7d9a\u3059\u308b\u304b\u3001\u30b2\u30fc\u30e0\u5074\u306b\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u5bfe\u5fdc\u306e\u8a2d\u5b9a\u304c\u306a\u3044\u304b\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucee8\ud2b8\ub864\ub7ec\uac00 \uc5ec\uc804\ud788 \uc791\ub3d9\ud558\uc9c0 \uc54a\uc73c\uba74 Bluetooth \ub300\uc2e0 USB\ub85c \uc5f0\uacb0\ud558\uac70\ub098, \uac8c\uc784\uc5d0 \uc790\uccb4 \ucee8\ud2b8\ub864\ub7ec \uc9c0\uc6d0 \uc124\uc815\uc774 \uc788\ub294\uc9c0 \ud655\uc778\ud574 \ubcf4\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als controllers nog steeds niet werken, sluit ze dan aan via USB in plaats van Bluetooth, of kijk of de game eigen instellingen voor controllerondersteuning heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je\u015bli kontrolery nadal nie dzia\u0142aj\u0105, pod\u0142\u0105cz je przez USB zamiast Bluetooth lub sprawd\u017a ustawienia obs\u0142ugi kontroler\u00f3w w samej grze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se os controles ainda n\u00e3o funcionarem, tente conect\u00e1-los por USB em vez de Bluetooth ou veja se o jogo tem configura\u00e7\u00f5es pr\u00f3prias de controle."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se os comandos continuarem a n\u00e3o funcionar, experimente lig\u00e1-los por USB em vez de Bluetooth ou veja se o jogo tem defini\u00e7\u00f5es pr\u00f3prias para comandos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dac\u0103 controllerele tot nu func\u021bioneaz\u0103, \u00eencearc\u0103 o conexiune USB \u00een loc de Bluetooth sau verific\u0103 dac\u0103 jocul are propriile set\u0103ri pentru controller."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0415\u0441\u043b\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u043b\u0435\u0440\u044b \u0432\u0441\u0451 \u0435\u0449\u0451 \u043d\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442, \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0438\u0445 \u043f\u043e USB \u0432\u043c\u0435\u0441\u0442\u043e Bluetooth \u0438\u043b\u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u043b\u0435\u0440\u043e\u0432 \u0432 \u0441\u0430\u043c\u043e\u0439 \u0438\u0433\u0440\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om handkontrollerna fortfarande inte fungerar kan du ansluta dem via USB i st\u00e4llet f\u00f6r Bluetooth, eller se efter om spelet har egna inst\u00e4llningar f\u00f6r st\u00f6d f\u00f6r handkontroller."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumandalar h\u00e2l\u00e2 \u00e7al\u0131\u015fm\u0131yorsa Bluetooth yerine USB ile ba\u011flanmay\u0131 deneyin veya oyunun kendi kumanda deste\u011fi ayarlar\u0131n\u0131 denetleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f\u043a\u0449\u043e \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u0440\u0438 \u0434\u043e\u0441\u0456 \u043d\u0435 \u043f\u0440\u0430\u0446\u044e\u044e\u0442\u044c, \u043f\u0456\u0434'\u0454\u0434\u043d\u0430\u0439\u0442\u0435 \u0457\u0445 \u0447\u0435\u0440\u0435\u0437 USB \u0437\u0430\u043c\u0456\u0441\u0442\u044c Bluetooth \u0430\u0431\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u043a\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u0440\u0456\u0432 \u0443 \u0441\u0430\u043c\u0456\u0439 \u0433\u0440\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u1ebfu tay c\u1ea7m v\u1eabn kh\u00f4ng ho\u1ea1t \u0111\u1ed9ng, h\u00e3y th\u1eed k\u1ebft n\u1ed1i qua USB thay v\u00ec Bluetooth, ho\u1eb7c ki\u1ec3m tra xem game c\u00f3 c\u00e0i \u0111\u1eb7t h\u1ed7 tr\u1ee3 tay c\u1ea7m ri\u00eang kh\u00f4ng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5982\u679c\u63a7\u5236\u5668\u4ecd\u7136\u65e0\u6cd5\u4f7f\u7528\uff0c\u8bf7\u6539\u7528 USB \u8fde\u63a5\u800c\u975e\u84dd\u7259\uff0c\u6216\u67e5\u770b\u6e38\u620f\u672c\u8eab\u662f\u5426\u6709\u63a7\u5236\u5668\u652f\u6301\u8bbe\u7f6e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5982\u679c\u63a7\u5236\u5668\u4ecd\u7136\u7121\u6cd5\u4f7f\u7528\uff0c\u8acb\u6539\u7528 USB \u9023\u63a5\u800c\u975e\u85cd\u7259\uff0c\u6216\u67e5\u770b\u904a\u6232\u672c\u8eab\u662f\u5426\u6709\u63a7\u5236\u5668\u652f\u63f4\u8a2d\u5b9a\u3002"
          }
        }
      }
    },
    "Include full log file": {
      "localizations": {
