        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 15.x \u3067\u306e Steam \u3084\u63cf\u753b\u306e\u554f\u984c\u306b\u5bfe\u3059\u308b\u4fee\u6b63\u3092\u9069\u7528\u3057\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 15.x\uc758 Steam \ubc0f \uadf8\ub798\ud53d \ubb38\uc81c\uc5d0 \ub300\ud55c \uc218\uc815\uc744 \uc801\uc6a9\ud569\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Past oplossingen toe voor Steam- en grafische problemen op macOS 15.x"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stosuje poprawki dla Steam i grafiki w macOS 15.x"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica corre\u00e7\u00f5es para o Steam e problemas gr\u00e1ficos no macOS 15.x"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica corre\u00e7\u00f5es para o Steam e problemas gr\u00e1ficos no macOS 15.x"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplic\u0103 remedieri pentru Steam \u0219i probleme grafice pe macOS 15.x"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442 \u0438\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0434\u043b\u044f Steam \u0438 \u0433\u0440\u0430\u0444\u0438\u043a\u0438 \u0432 macOS 15.x"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c5tg\u00e4rdar Steam- och grafikproblem p\u00e5 macOS 15.x"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 15.x'te Steam ve grafik sorunlar\u0131 i\u00e7in d\u00fczeltmeler uygular"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0441\u0442\u043e\u0441\u043e\u0432\u0443\u0454 \u0432\u0438\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f \u0434\u043b\u044f Steam \u0456 \u0433\u0440\u0430\u0444\u0456\u043a\u0438 \u0432 macOS 15.x"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c1p d\u1ee5ng b\u1ea3n s\u1eeda l\u1ed7i cho Steam v\u00e0 \u0111\u1ed3 h\u1ecda tr\u00ean macOS 15.x"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5e94\u7528\u9488\u5bf9 macOS 15.x \u4e0a Steam \u548c\u56fe\u5f62\u95ee\u9898\u7684\u4fee\u590d"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5957\u7528\u91dd\u5c0d macOS 15.x \u4e0a Steam \u8207\u5716\u5f62\u554f\u984c\u7684\u4fee\u6b63"
          }
        }
      }
