    "config.cleanup.clipboardPolicy.help": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u062a\u062d\u0643\u0645 \u0641\u064a \u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646 \u064a\u062a\u0645 \u0641\u062d\u0635 \u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u062d\u0627\u0641\u0638\u0629 \u0642\u0628\u0644 \u062a\u0634\u063a\u064a\u0644 \u0628\u0631\u0627\u0645\u062c Wine"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ur\u010duje, zda se obsah schr\u00e1nky kontroluje p\u0159ed spu\u0161t\u011bn\u00edm program\u016f Wine"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestemmer, om indholdet i udklipsholderen tjekkes, f\u00f8r Wine-programmer startes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt fest, ob der Inhalt der Zwischenablage vor dem Start von Wine-Programmen gepr\u00fcft wird"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls whether clipboard content is checked before launching Wine programs"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls whether clipboard content is checked before launching Wine programs"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla si se comprueba el contenido del portapapeles antes de iniciar programas de Wine"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00e4\u00e4ritt\u00e4\u00e4, tarkistetaanko leikep\u00f6yd\u00e4n sis\u00e4lt\u00f6 ennen Wine-ohjelmien k\u00e4ynnist\u00e4mist\u00e4"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9termine si le contenu du presse-papiers est v\u00e9rifi\u00e9 avant le lancement des programmes Wine"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilisce se il contenuto degli appunti viene controllato prima di avviare i programmi Wine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \u306e\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u8d77\u52d5\u3059\u308b\u524d\u306b\u30af\u30ea\u30c3\u30d7\u30dc\u30fc\u30c9\u306e\u5185\u5bb9\u3092\u78ba\u8a8d\u3059\u308b\u304b\u3069\u3046\u304b\u3092\u8a2d\u5b9a\u3057\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \ud504\ub85c\uadf8\ub7a8\uc744 \uc2e4\ud589\ud558\uae30 \uc804\uc5d0 \ud074\ub9bd\ubcf4\ub4dc \ub0b4\uc6a9\uc744 \ud655\uc778\ud560\uc9c0 \uacb0\uc815\ud569\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaalt of de inhoud van het klembord wordt gecontroleerd voordat Wine-programma's worden gestart"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okre\u015bla, czy zawarto\u015b\u0107 schowka jest sprawdzana przed uruchomieniem program\u00f3w Wine"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla se o conte\u00fado da \u00e1rea de transfer\u00eancia \u00e9 verificado antes de iniciar programas do Wine"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla se o conte\u00fado da \u00e1rea de transfer\u00eancia \u00e9 verificado antes de iniciar programas do Wine"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabile\u0219te dac\u0103 se verific\u0103 con\u021binutul clipboardului \u00eenainte de lansarea programelor Wine"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442, \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u0442\u0441\u044f \u043b\u0438 \u0431\u0443\u0444\u0435\u0440 \u043e\u0431\u043c\u0435\u043d\u0430 \u043f\u0435\u0440\u0435\u0434 \u0437\u0430\u043f\u0443\u0441\u043a\u043e\u043c \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c Wine"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avg\u00f6r om inneh\u00e5llet i urklipp kontrolleras innan Wine-program startas"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine programlar\u0131 ba\u015flat\u0131lmadan \u00f6nce pano i\u00e7eri\u011finin denetlenip denetlenmeyece\u011fini belirler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0437\u043d\u0430\u0447\u0430\u0454, \u0447\u0438 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u044f\u0454\u0442\u044c\u0441\u044f \u0431\u0443\u0444\u0435\u0440 \u043e\u0431\u043c\u0456\u043d\u0443 \u043f\u0435\u0440\u0435\u0434 \u0437\u0430\u043f\u0443\u0441\u043a\u043e\u043c \u043f\u0440\u043e\u0433\u0440\u0430\u043c Wine"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ki\u1ec3m so\u00e1t vi\u1ec7c c\u00f3 ki\u1ec3m tra n\u1ed9i dung b\u1ea3ng nh\u1edb t\u1ea1m tr\u01b0\u1edbc khi ch\u1ea1y ch\u01b0\u01a1ng tr\u00ecnh Wine hay kh\u00f4ng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63a7\u5236\u5728\u542f\u52a8 Wine \u7a0b\u5e8f\u524d\u662f\u5426\u68c0\u67e5\u526a\u8d34\u677f\u5185\u5bb9"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63a7\u5236\u555f\u52d5 Wine \u7a0b\u5f0f\u524d\u662f\u5426\u6aa2\u67e5\u526a\u8cbc\u677f\u5167\u5bb9"
          }
        }
      }
    },
