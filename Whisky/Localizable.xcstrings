    "winetricks.error.corruptedPrefix": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0628\u0627\u062f\u0626\u0629 Wine \u062a\u0627\u0644\u0641\u0629 \u0623\u0648 \u062a\u0646\u0642\u0635\u0647\u0627 \u0645\u062c\u0644\u062f\u0627\u062a \u0623\u0633\u0627\u0633\u064a\u0629."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefix Wine je po\u0161kozen\u00fd nebo v n\u011bm chyb\u00ed d\u016fle\u017eit\u00e9 slo\u017eky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine-pr\u00e6fikset er beskadiget eller mangler vigtige mapper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wine-Pr\u00e4fix ist besch\u00e4digt, oder es fehlen wichtige Ordner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Wine prefix is corrupted or missing essential directories."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The Wine prefix is corrupted or missing essential directories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El prefijo de Wine est\u00e1 da\u00f1ado o le faltan carpetas esenciales."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine-etuliite on vioittunut tai siit\u00e4 puuttuu olennaisia kansioita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pr\u00e9fixe Wine est corrompu ou il manque des dossiers essentiels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prefisso Wine \u00e8 danneggiato o mancano cartelle essenziali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \u30d7\u30ec\u30d5\u30a3\u30c3\u30af\u30b9\u304c\u7834\u640d\u3057\u3066\u3044\u308b\u304b\u3001\u5fc5\u8981\u306a\u30d5\u30a9\u30eb\u30c0\u304c\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \ud504\ub9ac\ud53d\uc2a4\uac00 \uc190\uc0c1\ub418\uc5c8\uac70\ub098 \ud544\uc218 \ud3f4\ub354\uac00 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Wine-prefix is beschadigd of mist essenti\u00eble mappen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefiks Wine jest uszkodzony lub brakuje w nim niezb\u0119dnych folder\u00f3w."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O prefixo do Wine est\u00e1 corrompido ou faltam pastas essenciais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O prefixo do Wine est\u00e1 danificado ou faltam-lhe pastas essenciais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefixul Wine este corupt sau \u00eei lipsesc foldere esen\u021biale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0435\u0444\u0438\u043a\u0441 Wine \u043f\u043e\u0432\u0440\u0435\u0436\u0434\u0451\u043d \u0438\u043b\u0438 \u0432 \u043d\u0451\u043c \u043d\u0435\u0442 \u043d\u0443\u0436\u043d\u044b\u0445 \u043f\u0430\u043f\u043e\u043a."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine-prefixet \u00e4r skadat eller saknar viktiga mappar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \u00f6n eki bozuk veya temel klas\u00f6rleri eksik."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0435\u0444\u0456\u043a\u0441 Wine \u043f\u043e\u0448\u043a\u043e\u0434\u0436\u0435\u043d\u043e \u0430\u0431\u043e \u0432 \u043d\u044c\u043e\u043c\u0443 \u043d\u0435\u043c\u0430\u0454 \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u0438\u0445 \u0442\u0435\u043a."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefix Wine b\u1ecb h\u1ecfng ho\u1eb7c thi\u1ebfu c\u00e1c th\u01b0 m\u1ee5c thi\u1ebft y\u1ebfu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \u524d\u7f00\u5df2\u635f\u574f\u6216\u7f3a\u5c11\u5fc5\u8981\u7684\u76ee\u5f55\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \u524d\u7db4\u5df2\u640d\u6bc0\u6216\u7f3a\u5c11\u5fc5\u8981\u7684\u76ee\u9304\u3002"
          }
        }
      }
    },
    "winetricks.error.missingAppData": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u062c\u0644\u062f AppData \u0645\u0641\u0642\u0648\u062f \u0623\u0648 \u063a\u064a\u0631 \u0645\u0643\u062a\u0645\u0644. \u0633\u064a\u0624\u062f\u064a \u0630\u0644\u0643 \u0625\u0644\u0649 \u0641\u0634\u0644 \u062a\u062b\u0628\u064a\u062a \u0627\u0644\u062a\u0628\u0639\u064a\u0627\u062a."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slo\u017eka AppData chyb\u00ed nebo je ne\u00fapln\u00e1. Instalace z\u00e1vislost\u00ed kv\u016fli tomu sel\u017ee."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AppData-mappen mangler eller er ufuldst\u00e6ndig. Det f\u00e5r installation af afh\u00e6ngigheder til at mislykkes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der AppData-Ordner fehlt oder ist unvollst\u00e4ndig. Dadurch schlagen Installationen von Abh\u00e4ngigkeiten fehl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AppData directory is missing or incomplete. This will cause dependency installations to fail."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The AppData directory is missing or incomplete. This will cause dependency installations to fail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta la carpeta AppData o est\u00e1 incompleta. Las instalaciones de dependencias fallar\u00e1n."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "AppData-kansio puuttuu tai on puutteellinen. T\u00e4m\u00e4 saa riippuvuuksien asennukset ep\u00e4onnistumaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier AppData est manquant ou incomplet. Les installations de d\u00e9pendances \u00e9choueront."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella AppData manca o \u00e8 incompleta. Le installazioni delle dipendenze non andranno a buon fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AppData \u30d5\u30a9\u30eb\u30c0\u304c\u898b\u3064\u304b\u3089\u306a\u3044\u304b\u3001\u4e0d\u5b8c\u5168\u3067\u3059\u3002\u3053\u306e\u307e\u307e\u3067\u306f\u4f9d\u5b58\u95a2\u4fc2\u306e\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u306b\u5931\u6557\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AppData \ud3f4\ub354\uac00 \uc5c6\uac70\ub098 \ubd88\uc644\uc804\ud569\ub2c8\ub2e4. \uc774 \uc0c1\ud0dc\uc5d0\uc11c\ub294 \uc758\uc874\uc131 \uc124\uce58\uac00 \uc2e4\ud328\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De AppData-map ontbreekt of is onvolledig. Hierdoor mislukken installaties van afhankelijkheden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brakuje folderu AppData lub jest on niekompletny. Spowoduje to niepowodzenie instalacji zale\u017cno\u015bci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta AppData est\u00e1 ausente ou incompleta. Isso far\u00e1 as instala\u00e7\u00f5es de depend\u00eancias falharem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta AppData est\u00e1 em falta ou incompleta. Isto far\u00e1 falhar a instala\u00e7\u00e3o de depend\u00eancias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folderul AppData lipse\u0219te sau este incomplet. Din acest motiv, instalarea dependen\u021belor va e\u0219ua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0430\u043f\u043a\u0430 AppData \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0438\u043b\u0438 \u043d\u0435\u043f\u043e\u043b\u043d\u0430\u044f. \u0418\u0437-\u0437\u0430 \u044d\u0442\u043e\u0433\u043e \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0435\u0439 \u043d\u0435 \u0443\u0434\u0430\u0441\u0442\u0441\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AppData-mappen saknas eller \u00e4r ofullst\u00e4ndig. Det g\u00f6r att installationer av beroenden misslyckas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AppData klas\u00f6r\u00fc eksik ya da tamamlanmam\u0131\u015f. Bu, ba\u011f\u0131ml\u0131l\u0131k y\u00fcklemelerinin ba\u015far\u0131s\u0131z olmas\u0131na yol a\u00e7ar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0435\u043a\u0438 AppData \u043d\u0435\u043c\u0430\u0454 \u0430\u0431\u043e \u0432\u043e\u043d\u0430 \u043d\u0435\u043f\u043e\u0432\u043d\u0430. \u0427\u0435\u0440\u0435\u0437 \u0446\u0435 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0437\u0430\u043b\u0435\u0436\u043d\u043e\u0441\u0442\u0435\u0439 \u043d\u0435 \u0432\u0434\u0430\u0441\u0442\u044c\u0441\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thi\u1ebfu th\u01b0 m\u1ee5c AppData ho\u1eb7c th\u01b0 m\u1ee5c n\u00e0y kh\u00f4ng \u0111\u1ea7y \u0111\u1ee7. \u0110i\u1ec1u n\u00e0y s\u1ebd khi\u1ebfn vi\u1ec7c c\u00e0i th\u00e0nh ph\u1ea7n ph\u1ee5 thu\u1ed9c th\u1ea5t b\u1ea1i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AppData \u76ee\u5f55\u7f3a\u5931\u6216\u4e0d\u5b8c\u6574\u3002\u8fd9\u4f1a\u5bfc\u81f4\u4f9d\u8d56\u9879\u5b89\u88c5\u5931\u8d25\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AppData \u76ee\u9304\u907a\u5931\u6216\u4e0d\u5b8c\u6574\u3002\u9019\u6703\u5c0e\u81f4\u76f8\u4f9d\u9805\u76ee\u5b89\u88dd\u5931\u6557\u3002"
          }
        }
      }
    },
