    "gptk.error.forwarderNotBuiltin": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0647\u0630\u0647 \u0644\u064a\u0633\u062a \u062d\u0632\u0645\u0629 Game Porting Toolkit\u060c \u0641\u0623\u062d\u062f \u0645\u0644\u0641\u0627\u062a DLL \u0645\u0646 \u0646\u0648\u0639 \u062e\u0627\u0637\u0626:"
