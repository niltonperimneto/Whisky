        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u5229\u7528\u3067\u304d\u306a\u3044 Bottle \u3092\u30ea\u30b9\u30c8\u304b\u3089\u524a\u9664\u3057\u307e\u3059"
          }
        },
        "ko": {
