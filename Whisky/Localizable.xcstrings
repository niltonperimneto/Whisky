        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 \u0431\u0443\u0444\u0435\u0440\u0435 \u043e\u0431\u043c\u0435\u043d\u0430 \u043c\u043d\u043e\u0433\u043e \u0434\u0430\u043d\u043d\u044b\u0445 (\u043e\u043a\u043e\u043b\u043e {size} \u041a\u0411). \u0418\u0437-\u0437\u0430 \u044d\u0442\u043e\u0433\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u0433\u0440\u044b \u0437\u0430\u0432\u0438\u0441\u0430\u044e\u0442."
