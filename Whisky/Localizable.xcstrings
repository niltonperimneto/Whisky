    "NVIDIA (recommended) provides best compatibility across launchers": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0648\u0641\u0631 NVIDIA (\u0645\u0648\u0635\u0649 \u0628\u0647\u0627) \u0623\u0641\u0636\u0644 \u062a\u0648\u0627\u0641\u0642 \u0645\u0639 \u0645\u062e\u062a\u0644\u0641 \u0627\u0644\u0645\u0634\u063a\u0651\u0644\u0627\u062a"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA (doporu\u010deno) nab\u00edz\u00ed nejlep\u0161\u00ed kompatibilitu s launchery"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA (anbefales) giver den bedste kompatibilitet p\u00e5 tv\u00e6rs af launchere"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA (empfohlen) bietet die beste Kompatibilit\u00e4t mit allen Launchern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA (recommended) provides best compatibility across launchers"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA (recommended) provides best compatibility across launchers"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA (recomendado) ofrece la mejor compatibilidad con los lanzadores"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA (suositus) tarjoaa parhaan yhteensopivuuden eri k\u00e4ynnistimiss\u00e4"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA (recommand\u00e9) offre la meilleure compatibilit\u00e9 avec les lanceurs"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA (consigliata) offre la migliore compatibilit\u00e0 con i launcher"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA (\u63a8\u5968) \u306f\u5404\u30e9\u30f3\u30c1\u30e3\u30fc\u3067\u6700\u3082\u9ad8\u3044\u4e92\u63db\u6027\u304c\u5f97\u3089\u308c\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA(\uad8c\uc7a5)\uac00 \uc5ec\ub7ec \ub7f0\ucc98\uc5d0\uc11c \uac00\uc7a5 \uc88b\uc740 \ud638\ud658\uc131\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA (aanbevolen) biedt de beste compatibiliteit met alle launchers"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA (zalecane) zapewnia najlepsz\u0105 zgodno\u015b\u0107 z launcherami"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A NVIDIA (recomendada) oferece a melhor compatibilidade entre launchers"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A NVIDIA (recomendada) oferece a melhor compatibilidade entre launchers"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA (recomandat) ofer\u0103 cea mai bun\u0103 compatibilitate cu launcherele"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA (\u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f) \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043b\u0443\u0447\u0448\u0443\u044e \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u0438\u043c\u043e\u0441\u0442\u044c \u0441 \u043b\u0430\u0443\u043d\u0447\u0435\u0440\u0430\u043c\u0438"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA (rekommenderas) ger b\u00e4st kompatibilitet med alla launchers"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA (\u00f6nerilir) ba\u015flat\u0131c\u0131lar genelinde en iyi uyumlulu\u011fu sa\u011flar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA (\u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u043e) \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0443\u0454 \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0443 \u0441\u0443\u043c\u0456\u0441\u043d\u0456\u0441\u0442\u044c \u0456\u0437 \u043b\u0430\u0443\u043d\u0447\u0435\u0440\u0430\u043c\u0438"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA (khuy\u1ebfn ngh\u1ecb) cho kh\u1ea3 n\u0103ng t\u01b0\u01a1ng th\u00edch t\u1ed1t nh\u1ea5t v\u1edbi c\u00e1c tr\u00ecnh kh\u1edfi ch\u1ea1y"
          }
        },
        "zh-Hans": {
