        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u043e\u0432\u0435\u0440\u043d\u0443\u0442\u043e; \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0456 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0438 \u0437\u0430\u043b\u0438\u0448\u0438\u043b\u0438\u0441\u044f: %@"
