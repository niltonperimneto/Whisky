        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pod\u0142\u0105cz przez USB lub sprawd\u017a Ustawienia systemowe"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
