    "audio.troubleshoot.escalationNext": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0645\u0643\u0646\u0643 \u062a\u0635\u062f\u064a\u0631 \u062a\u0642\u0631\u064a\u0631 \u062a\u0634\u062e\u064a\u0635 \u0623\u0648 \u0641\u062a\u062d \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otev\u0159ete pokro\u010dil\u00e1 nastaven\u00ed zvuku nebo po\u0161lete diagnostiku v\u00fdvoj\u00e1\u0159\u016fm."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e6ste trin"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e4chste Schritte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next steps"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Next steps"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "audio.troubleshoot.escalationNext"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit vied\u00e4 vianm\u00e4\u00e4ritysraportin tai avata \u00e4\u00e4nen lis\u00e4asetukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "audio.troubleshoot.escalationNext"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "audio.troubleshoot.escalationNext"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a3a\u65ad\u60c5\u5831\u3092\u66f8\u304d\u51fa\u3057\u3066\u30b5\u30dd\u30fc\u30c8\u306b\u5171\u6709\u3059\u308b\u304b\u3001\u30b7\u30b9\u30c6\u30e0\u8a2d\u5b9a\u306e\u300c\u30b5\u30a6\u30f3\u30c9\u300d\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc9c4\ub2e8 \uc815\ubcf4\ub97c \ub0b4\ubcf4\ub0b4 \uc9c0\uc6d0\ud300\uc5d0 \uacf5\uc720\ud558\uac70\ub098, \uc2dc\uc2a4\ud15c \uc124\uc815\uc758 \uc0ac\uc6b4\ub4dc\ub97c \ud655\uc778\ud574 \ubcf4\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volgende stappen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otw\u00f3rz zaawansowane ustawienia d\u017awi\u0119ku lub wy\u015blij diagnostyk\u0119 do tw\u00f3rc\u00f3w."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "audio.troubleshoot.escalationNext"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "audio.troubleshoot.escalationNext"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "audio.troubleshoot.escalationNext"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u043d\u044b\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0437\u0432\u0443\u043a\u0430 \u0438\u043b\u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u044c\u0442\u0435 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0443 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u0430\u043c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e4sta steg"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tan\u0131lama raporu d\u0131\u015fa aktarabilir veya geli\u015fmi\u015f ses ayarlar\u0131n\u0131 a\u00e7abilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0456\u0434\u043a\u0440\u0438\u0439\u0442\u0435 \u0440\u043e\u0437\u0448\u0438\u0440\u0435\u043d\u0456 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0437\u0432\u0443\u043a\u0443 \u0430\u0431\u043e \u043d\u0430\u0434\u0456\u0448\u043b\u0456\u0442\u044c \u0434\u0456\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0443 \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0430\u043c."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u1ea1n c\u00f3 th\u1ec3 xu\u1ea5t b\u00e1o c\u00e1o ch\u1ea9n \u0111o\u00e1n ho\u1eb7c m\u1edf c\u00e0i \u0111\u1eb7t \u00e2m thanh n\u00e2ng cao."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ef\u4ee5\u5bfc\u51fa\u8bca\u65ad\u4fe1\u606f\u4ee5\u4fbf\u5171\u4eab\uff0c\u6216\u5728\u201c\u7cfb\u7edf\u8bbe\u7f6e\u201d\u4e2d\u68c0\u67e5\u58f0\u97f3\u8bbe\u7f6e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u53ef\u4ee5\u532f\u51fa\u8a3a\u65b7\u8cc7\u8a0a\u4ee5\u4fbf\u5206\u4eab\uff0c\u6216\u5728\u300c\u7cfb\u7d71\u8a2d\u5b9a\u300d\u4e2d\u6aa2\u67e5\u8072\u97f3\u8a2d\u5b9a\u3002"
          }
        }
      }
    },
