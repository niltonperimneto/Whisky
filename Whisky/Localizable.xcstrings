          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u062d\u062a\u0648\u064a \u0627\u0644\u062d\u0627\u0641\u0638\u0629 \u0639\u0644\u0649 \u0646\u0635 \u0643\u0628\u064a\u0631 ({size} KB). \u0645\u0639\u0627\u064a\u0646\u0629: {preview}. \u0642\u062f \u064a\u0624\u062f\u064a \u0647\u0630\u0627 \u0625\u0644\u0649 \u062a\u0639\u0644\u064a\u0642 \u0628\u0639\u0636 \u0627\u0644\u0623\u0644\u0639\u0627\u0628."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve schr\u00e1nce je hodn\u011b textu ({size} KB). N\u00e1hled: {preview}. N\u011bkter\u00e9 hry se kv\u016fli tomu m\u016f\u017eou zaseknout."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din udklipsholder indeholder meget tekst ({size} KB). Eksempel: {preview}. Det kan f\u00e5 nogle spil til at g\u00e5 i st\u00e5."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischenablage enth\u00e4lt viel Text ({size} KB). Vorschau: {preview}. Das kann Spiele zum H\u00e4ngen bringen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your clipboard contains a lot of text ({size} KB). Preview: {preview}. This can cause some games to hang."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your clipboard contains a lot of text ({size} KB). Preview: {preview}. This can cause some games to hang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El portapapeles contiene mucho texto ({size} KB). Vista previa: {preview}. Esto puede bloquear algunos juegos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leikep\u00f6yd\u00e4ll\u00e4si on paljon teksti\u00e4 ({size} KB). Esikatselu: {preview}. T\u00e4m\u00e4 voi jumittaa joitakin pelej\u00e4."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le presse-papiers contient beaucoup de texte ({size} Ko). Aper\u00e7u : {preview}. Cela peut bloquer certains jeux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli appunti contengono molto testo ({size} KB). Anteprima: {preview}. Alcuni giochi potrebbero bloccarsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30af\u30ea\u30c3\u30d7\u30dc\u30fc\u30c9\u306b\u5927\u91cf\u306e\u30c6\u30ad\u30b9\u30c8\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059 ({size} KB)\u3002\u30d7\u30ec\u30d3\u30e5\u30fc: {preview}\u3002\u4e00\u90e8\u306e\u30b2\u30fc\u30e0\u304c\u30cf\u30f3\u30b0\u3059\u308b\u539f\u56e0\u306b\u306a\u308b\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud074\ub9bd\ubcf4\ub4dc\uc5d0 \ub9ce\uc740 \ud14d\uc2a4\ud2b8\uac00 \uc788\uc2b5\ub2c8\ub2e4({size} KB). \ubbf8\ub9ac\ubcf4\uae30: {preview}. \uc77c\ubd80 \uac8c\uc784\uc774 \uba48\ucd9c \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je klembord bevat veel tekst ({size} KB). Voorbeeld: {preview}. Hierdoor kunnen sommige games vastlopen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schowek zawiera du\u017co tekstu ({size} KB). Podgl\u0105d: {preview}. Mo\u017ce to zawiesza\u0107 niekt\u00f3re gry."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A \u00e1rea de transfer\u00eancia cont\u00e9m muito texto ({size} KB). Pr\u00e9via: {preview}. Isso pode travar alguns jogos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A \u00e1rea de transfer\u00eancia cont\u00e9m muito texto ({size} KB). Pr\u00e9-visualiza\u00e7\u00e3o: {preview}. Isto pode bloquear alguns jogos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboardul con\u021bine mult text ({size} KB). Previzualizare: {preview}. Unele jocuri se pot bloca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 \u0431\u0443\u0444\u0435\u0440\u0435 \u043e\u0431\u043c\u0435\u043d\u0430 \u043c\u043d\u043e\u0433\u043e \u0442\u0435\u043a\u0441\u0442\u0430 ({size} \u041a\u0411). \u041d\u0430\u0447\u0430\u043b\u043e: {preview}. \u0418\u0437-\u0437\u0430 \u044d\u0442\u043e\u0433\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u0433\u0440\u044b \u0437\u0430\u0432\u0438\u0441\u0430\u044e\u0442."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt urklipp inneh\u00e5ller mycket text ({size} KB). F\u00f6rhandsvisning: {preview}. Det kan f\u00e5 vissa spel att h\u00e4nga sig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Panonuzda \u00e7ok fazla metin var ({size} KB). \u00d6nizleme: {preview}. Bu, baz\u0131 oyunlar\u0131n tak\u0131lmas\u0131na neden olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423 \u0431\u0443\u0444\u0435\u0440\u0456 \u043e\u0431\u043c\u0456\u043d\u0443 \u0431\u0430\u0433\u0430\u0442\u043e \u0442\u0435\u043a\u0441\u0442\u0443 ({size} \u041a\u0411). \u041f\u043e\u0447\u0430\u0442\u043e\u043a: {preview}. \u0427\u0435\u0440\u0435\u0437 \u0446\u0435 \u0434\u0435\u044f\u043a\u0456 \u0456\u0433\u0440\u0438 \u0437\u0430\u0432\u0438\u0441\u0430\u044e\u0442\u044c."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u1ea3ng nh\u1edb t\u1ea1m ch\u1ee9a r\u1ea5t nhi\u1ec1u v\u0103n b\u1ea3n ({size} KB). Xem tr\u01b0\u1edbc: {preview}. \u0110i\u1ec1u n\u00e0y c\u00f3 th\u1ec3 khi\u1ebfn m\u1ed9t s\u1ed1 game b\u1ecb treo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u526a\u8d34\u677f\u4e2d\u5305\u542b\u5927\u91cf\u6587\u672c\uff08{size} KB\uff09\u3002\u9884\u89c8\uff1a{preview}\u3002\u8fd9\u53ef\u80fd\u5bfc\u81f4\u67d0\u4e9b\u6e38\u620f\u5361\u6b7b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u526a\u8cbc\u677f\u4e2d\u542b\u6709\u5927\u91cf\u6587\u5b57\uff08{size} KB\uff09\u3002\u9810\u89bd\uff1a{preview}\u3002\u9019\u53ef\u80fd\u5c0e\u81f4\u67d0\u4e9b\u904a\u6232\u505c\u6b62\u56de\u61c9\u3002"
          }
        }
      }
    },
