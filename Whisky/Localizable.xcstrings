    "Manually select the launcher type for this bottle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u062e\u062a\u0631 \u0646\u0648\u0639 \u0627\u0644\u0645\u0634\u063a\u0651\u0644 \u0644\u0647\u0630\u0647 \u0627\u0644\u0632\u062c\u0627\u062c\u0629 \u064a\u062f\u0648\u064a\u064b\u0627"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ru\u010dn\u011b vyberte typ launcheru pro tuto l\u00e1hev"
          }
