    "controller.none.hint": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062c\u0631\u0651\u0628 \u0627\u0644\u062a\u0648\u0635\u064a\u0644 \u0639\u0628\u0631 USB \u0623\u0648 \u062a\u062d\u0642\u0642 \u0645\u0646 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0646\u0638\u0627\u0645"
          }
