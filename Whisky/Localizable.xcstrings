    "gptk.error.payloadNotFound": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u062d\u0632\u0645\u0629 Game Porting Toolkit \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0645\u0648\u0642\u0639. \u0627\u062e\u062a\u0631 \u0635\u0648\u0631\u0629 \u0642\u0631\u0635 \u0628\u064a\u0626\u0629 \u0627\u0644\u062a\u0642\u064a\u064a\u0645 \u0645\u0646 Apple \u0623\u0648 \u0645\u062c\u0644\u062f redist \u0627\u0644\u062e\u0627\u0635 \u0628\u0647\u0627."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V tomto um\u00edst\u011bn\u00ed nebyl nalezen \u017e\u00e1dn\u00fd bal\u00ed\u010dek Game Porting Toolkit. Vyberte obraz disku s evalua\u010dn\u00edm prost\u0159ed\u00edm Apple nebo jeho slo\u017eku redist."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke fundet en Game Porting Toolkit-payload her. V\u00e6lg Apples diskbillede med evalueringsmilj\u00f8et eller dets redist-mappe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An diesem Ort wurde kein Game-Porting-Toolkit-Payload gefunden. W\u00e4hle Apples Image der Evaluierungsumgebung oder dessen redist-Ordner aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Game Porting Toolkit payload was found at this location. Select Apple's evaluation environment disk image or its redist folder."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "No Game Porting Toolkit payload was found at this location. Select Apple's evaluation environment disk image or its redist folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado ning\u00fan paquete de Game Porting Toolkit en esta ubicaci\u00f3n. Selecciona la imagen de disco del entorno de evaluaci\u00f3n de Apple o su carpeta redist."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00e4st\u00e4 sijainnista ei l\u00f6ytynyt Game Porting Toolkit -pakettia. Valitse Applen arviointiymp\u00e4rist\u00f6n levykuva tai sen redist-kansio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun contenu Game Porting Toolkit trouv\u00e9 \u00e0 cet emplacement. S\u00e9lectionnez l'image disque de l'environnement d'\u00e9valuation d'Apple ou son dossier redist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun pacchetto Game Porting Toolkit trovato in questa posizione. Seleziona l'immagine disco dell'ambiente di valutazione di Apple o la sua cartella redist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u5834\u6240\u306b Game Porting Toolkit \u306e\u30da\u30a4\u30ed\u30fc\u30c9\u304c\u898b\u3064\u304b\u308a\u307e\u305b\u3093\u3067\u3057\u305f\u3002Apple \u306e\u8a55\u4fa1\u74b0\u5883\u306e\u30c7\u30a3\u30b9\u30af\u30a4\u30e1\u30fc\u30b8\u304b\u3001\u305d\u306e redist \u30d5\u30a9\u30eb\u30c0\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc704\uce58\uc5d0\uc11c Game Porting Toolkit \ud398\uc774\ub85c\ub4dc\ub97c \ucc3e\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4. Apple\uc758 \ud3c9\uac00 \ud658\uacbd \ub514\uc2a4\ud06c \uc774\ubbf8\uc9c0\ub098 redist \ud3f4\ub354\ub97c \uc120\ud0dd\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op deze locatie is geen Game Porting Toolkit-payload gevonden. Kies het schijfkopiebestand van Apple's evaluatieomgeving of de bijbehorende redist-map."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tej lokalizacji nie znaleziono pakietu Game Porting Toolkit. Wybierz obraz dysku \u015brodowiska ewaluacyjnego Apple lub jego folder redist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum pacote do Game Porting Toolkit foi encontrado neste local. Selecione a imagem de disco do ambiente de avalia\u00e7\u00e3o da Apple ou a pasta redist dela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o foi encontrado nenhum pacote do Game Porting Toolkit nesta localiza\u00e7\u00e3o. Selecione a imagem de disco do ambiente de avalia\u00e7\u00e3o da Apple ou a respetiva pasta redist."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu a fost g\u0103sit niciun pachet Game Porting Toolkit \u00een aceast\u0103 loca\u021bie. Selecteaz\u0103 imaginea de disc a mediului de evaluare Apple sau folderul redist al acesteia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e \u044d\u0442\u043e\u043c\u0443 \u043f\u0443\u0442\u0438 \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d \u043f\u0430\u043a\u0435\u0442 Game Porting Toolkit. \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043e\u0431\u0440\u0430\u0437 \u0434\u0438\u0441\u043a\u0430 \u0441\u0440\u0435\u0434\u044b Apple \u0434\u043b\u044f \u043e\u0446\u0435\u043d\u043a\u0438 \u0438\u043b\u0438 \u0435\u0433\u043e \u043f\u0430\u043f\u043a\u0443 redist."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen Game Porting Toolkit-payload hittades p\u00e5 den h\u00e4r platsen. V\u00e4lj Apples skivavbildning med utv\u00e4rderingsmilj\u00f6n eller dess redist-mapp."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu konumda Game Porting Toolkit paketi bulunamad\u0131. Apple'\u0131n de\u011ferlendirme ortam\u0131 disk imaj\u0131n\u0131 veya redist klas\u00f6r\u00fcn\u00fc se\u00e7in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430 \u0446\u0438\u043c \u0440\u043e\u0437\u0442\u0430\u0448\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u043d\u0435 \u0437\u043d\u0430\u0439\u0434\u0435\u043d\u043e \u043f\u0430\u043a\u0435\u0442\u0430 Game Porting Toolkit. \u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043e\u0431\u0440\u0430\u0437 \u0434\u0438\u0441\u043a\u0430 \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0430 Apple \u0434\u043b\u044f \u043e\u0446\u0456\u043d\u044e\u0432\u0430\u043d\u043d\u044f \u0430\u0431\u043e \u0439\u043e\u0433\u043e \u0442\u0435\u043a\u0443 redist."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng t\u00ecm th\u1ea5y g\u00f3i Game Porting Toolkit t\u1ea1i v\u1ecb tr\u00ed n\u00e0y. H\u00e3y ch\u1ecdn \u1ea3nh \u0111\u0129a m\u00f4i tr\u01b0\u1eddng \u0111\u00e1nh gi\u00e1 c\u1ee7a Apple ho\u1eb7c th\u01b0 m\u1ee5c redist c\u1ee7a n\u00f3."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u6b64\u4f4d\u7f6e\u672a\u627e\u5230 Game Porting Toolkit \u8d1f\u8f7d\u3002\u8bf7\u9009\u62e9 Apple \u7684\u8bc4\u4f30\u73af\u5883\u78c1\u76d8\u6620\u50cf\u6216\u5176 redist \u6587\u4ef6\u5939\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u6b64\u4f4d\u7f6e\u627e\u4e0d\u5230 Game Porting Toolkit \u916c\u8f09\u3002\u8acb\u9078\u64c7 Apple \u7684\u8a55\u4f30\u74b0\u5883\u78c1\u789f\u6620\u50cf\u6a94\u6216\u5176 redist \u6a94\u6848\u593e\u3002"
          }
        }
      }
    },
    "gptk.error.storeEmpty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u062a\u0648\u062c\u062f \u062d\u0632\u0645\u0629 Game Porting Toolkit \u0645\u0633\u062a\u0648\u0631\u062f\u0629 \u0644\u0646\u0634\u0631\u0647\u0627."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nen\u00ed k dispozici \u017e\u00e1dn\u00fd importovan\u00fd bal\u00ed\u010dek Game Porting Toolkit k nasazen\u00ed."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ingen importeret Game Porting Toolkit-payload at installere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist kein importierter Game-Porting-Toolkit-Payload zum Bereitstellen vorhanden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No imported Game Porting Toolkit payload to deploy."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "No imported Game Porting Toolkit payload to deploy."
