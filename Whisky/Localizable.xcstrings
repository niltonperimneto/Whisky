    "Fixes Steam download stalls and connection timeouts": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0635\u0644\u062d \u062a\u0648\u0642\u0641 \u062a\u0646\u0632\u064a\u0644\u0627\u062a Steam \u0648\u0645\u0647\u0644\u0627\u062a \u0627\u0644\u0627\u062a\u0635\u0627\u0644"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravuje zaseknut\u00e1 stahov\u00e1n\u00ed a vypr\u0161en\u00ed spojen\u00ed ve Steamu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Retter Steam-downloads, der g\u00e5r i st\u00e5, og timeouts i forbindelsen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behebt stockende Steam-Downloads und Verbindungs-Timeouts"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixes Steam download stalls and connection timeouts"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixes Steam download stalls and connection timeouts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige los bloqueos de descarga y los tiempos de espera de conexi\u00f3n de Steam"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korjaa Steamin latausten jumittumisen ja yhteyksien aikakatkaisut"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige les blocages de t\u00e9l\u00e9chargement et les d\u00e9lais de connexion de Steam"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corregge blocchi di download e timeout di connessione di Steam"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam \u306e\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u505c\u6b62\u3084\u63a5\u7d9a\u30bf\u30a4\u30e0\u30a2\u30a6\u30c8\u3092\u4fee\u6b63\u3057\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam \ub2e4\uc6b4\ub85c\ub4dc \uba48\ucda4\uacfc \uc5f0\uacb0 \uc2dc\uac04 \ucd08\uacfc\ub97c \uc218\uc815\ud569\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhelpt vastlopende Steam-downloads en verbindingstime-outs"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naprawia zacinaj\u0105ce si\u0119 pobierania i limity czasu w Steam"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige travamentos de download e tempos limite de conex\u00e3o do Steam"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige bloqueios de transfer\u00eancia e tempos limite de liga\u00e7\u00e3o do Steam"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Remediaz\u0103 blocajele la desc\u0103rcare \u0219i expir\u0103rile conexiunii Steam"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0441\u0442\u0440\u0430\u043d\u044f\u0435\u0442 \u0437\u0430\u0432\u0438\u0441\u0430\u043d\u0438\u044f \u0437\u0430\u0433\u0440\u0443\u0437\u043e\u043a Steam \u0438 \u0442\u0430\u0439\u043c\u0430\u0443\u0442\u044b \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c5tg\u00e4rdar Steam-h\u00e4mtningar som stannar och tidsgr\u00e4nser i anslutningen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam indirme tak\u0131lmalar\u0131n\u0131 ve ba\u011flant\u0131 zaman a\u015f\u0131mlar\u0131n\u0131 giderir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0441\u0443\u0432\u0430\u0454 \u0437\u0430\u0432\u0438\u0441\u0430\u043d\u043d\u044f \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u044c Steam \u0456 \u0442\u0430\u0439\u043c-\u0430\u0443\u0442\u0438 \u0437'\u0454\u0434\u043d\u0430\u043d\u043d\u044f"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u1eafc ph\u1ee5c t\u00ecnh tr\u1ea1ng treo t\u1ea3i xu\u1ed1ng v\u00e0 h\u1ebft th\u1eddi gian k\u1ebft n\u1ed1i c\u1ee7a Steam"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4fee\u590d Steam \u4e0b\u8f7d\u505c\u6ede\u548c\u8fde\u63a5\u8d85\u65f6\u95ee\u9898"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4fee\u6b63 Steam \u4e0b\u8f09\u505c\u6eef\u8207\u9023\u7dda\u903e\u6642\u554f\u984c"
          }
        }
      }
    },
