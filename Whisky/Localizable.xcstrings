            "value": "\u041d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u0430 URL-\u0430\u0434\u0440\u0435\u0441\u0430 \u0432\u0435\u0440\u0441\u0456\u0457"
          }
        },
        "vi": {
          "stringUnit": {
