    "config.cleanup.killOnQuit.help": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u062a\u062d\u0643\u0645 \u0641\u064a \u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0639\u0645\u0644\u064a\u0627\u062a Wine \u062a\u064f\u0646\u0647\u0649 \u0639\u0646\u062f \u0625\u063a\u0644\u0627\u0642 Whisky"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ur\u010duje, zda se procesy Wine ukon\u010d\u00ed p\u0159i zav\u0159en\u00ed Whisky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestemmer, om Wine-processer afsluttes, n\u00e5r Whisky lukkes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt fest, ob Wine-Prozesse beendet werden, wenn Whisky geschlossen wird"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls whether Wine processes are terminated when Whisky quits"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls whether Wine processes are terminated when Whisky quits"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla si los procesos de Wine se cierran cuando se sale de Whisky"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00e4\u00e4ritt\u00e4\u00e4, lopetetaanko Wine-prosessit, kun Whisky suljetaan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9termine si les processus Wine sont arr\u00eat\u00e9s \u00e0 la fermeture de Whisky"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilisce se i processi Wine vengono terminati alla chiusura di Whisky"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky \u306e\u7d42\u4e86\u6642\u306b Wine \u306e\u30d7\u30ed\u30bb\u30b9\u3092\u505c\u6b62\u3059\u308b\u304b\u3069\u3046\u304b\u3092\u8a2d\u5b9a\u3057\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky\ub97c \uc885\ub8cc\ud560 \ub54c Wine \ud504\ub85c\uc138\uc2a4\ub3c4 \uc885\ub8cc\ud560\uc9c0 \uacb0\uc815\ud569\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaalt of Wine-processen worden be\u00ebindigd wanneer Whisky wordt afgesloten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okre\u015bla, czy procesy Wine s\u0105 ko\u0144czone przy zamykaniu Whisky"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla se os processos do Wine s\u00e3o encerrados quando o Whisky \u00e9 fechado"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla se os processos do Wine s\u00e3o terminados quando o Whisky fecha"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabile\u0219te dac\u0103 procesele Wine sunt oprite c\u00e2nd Whisky se \u00eenchide"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442, \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u044e\u0442\u0441\u044f \u043b\u0438 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u044b Wine \u043f\u0440\u0438 \u0432\u044b\u0445\u043e\u0434\u0435 \u0438\u0437 Whisky"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avg\u00f6r om Wine-processer avslutas n\u00e4r Whisky avslutas"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky kapat\u0131ld\u0131\u011f\u0131nda Wine i\u015flemlerinin sonland\u0131r\u0131l\u0131p sonland\u0131r\u0131lmayaca\u011f\u0131n\u0131 belirler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0437\u043d\u0430\u0447\u0430\u0454, \u0447\u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0443\u044e\u0442\u044c\u0441\u044f \u043f\u0440\u043e\u0446\u0435\u0441\u0438 Wine \u043f\u0456\u0434 \u0447\u0430\u0441 \u0432\u0438\u0445\u043e\u0434\u0443 \u0437 Whisky"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ki\u1ec3m so\u00e1t vi\u1ec7c c\u00f3 k\u1ebft th\u00fac c\u00e1c ti\u1ebfn tr\u00ecnh Wine khi tho\u00e1t Whisky hay kh\u00f4ng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63a7\u5236 Whisky \u9000\u51fa\u65f6\u662f\u5426\u7ed3\u675f Wine \u8fdb\u7a0b"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63a7\u5236 Whisky \u7d50\u675f\u6642\u662f\u5426\u7d42\u6b62 Wine \u7a0b\u5e8f"
          }
        }
      }
    },
