        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u043c\u0456\u043d\u0438 \u0433\u0440\u0430\u0444\u0456\u043a\u0438 \u043d\u0430\u0431\u0435\u0440\u0443\u0442\u044c \u0447\u0438\u043d\u043d\u043e\u0441\u0442\u0456 \u043f\u0456\u0434 \u0447\u0430\u0441 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u043e\u0433\u043e \u0437\u0430\u043f\u0443\u0441\u043a\u0443."
