    "audio.troubleshoot.escalation": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0639\u0630\u0651\u0631 \u062d\u0644 \u0627\u0644\u0645\u0634\u0643\u0644\u0629 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepoda\u0159ilo se vy\u0159e\u0161it automaticky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Problemet kunne ikke l\u00f8ses automatisk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Problem lie\u00df sich nicht automatisch beheben."
