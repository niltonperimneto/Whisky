    "setup.whiskywine.error.interrupted": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0646\u0642\u0637\u0639 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0648\u0644\u0645 \u064a\u0643\u062a\u0645\u0644 \u0627\u0644\u062a\u0646\u0632\u064a\u0644. \u064a\u0631\u062c\u0649 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "P\u0159ipojen\u00ed bylo p\u0159eru\u0161eno a stahov\u00e1n\u00ed se nepoda\u0159ilo dokon\u010dit. Zkuste to pros\u00edm znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbindelsen blev afbrudt, og overf\u00f8rslen kunne ikke fuldf\u00f8res. Pr\u00f8v igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung wurde unterbrochen und der Download konnte nicht abgeschlossen werden. Bitte versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection was interrupted and the download could not be completed. Please try again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection was interrupted and the download could not be completed. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se interrumpi\u00f3 la conexi\u00f3n y no se pudo completar la descarga. Int\u00e9ntalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteys katkesi, eik\u00e4 latausta voitu suorittaa loppuun. Yrit\u00e4 uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a \u00e9t\u00e9 interrompue et le t\u00e9l\u00e9chargement n'a pas pu \u00eatre termin\u00e9. Veuillez r\u00e9essayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione si \u00e8 interrotta e non \u00e8 stato possibile completare il download. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63a5\u7d9a\u304c\u4e2d\u65ad\u3055\u308c\u305f\u305f\u3081\u3001\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3092\u5b8c\u4e86\u3067\u304d\u307e\u305b\u3093\u3067\u3057\u305f\u3002\u3082\u3046\u4e00\u5ea6\u304a\u8a66\u3057\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5f0\uacb0\uc774 \uc911\ub2e8\ub418\uc5b4 \ub2e4\uc6b4\ub85c\ub4dc\ub97c \uc644\ub8cc\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \ub2e4\uc2dc \uc2dc\ub3c4\ud574 \uc8fc\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verbinding is onderbroken en de download kan niet worden voltooid. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po\u0142\u0105czenie zosta\u0142o przerwane i nie uda\u0142o si\u0119 uko\u0144czy\u0107 pobierania. Spr\u00f3buj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conex\u00e3o foi interrompida e n\u00e3o foi poss\u00edvel concluir o download. Tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A liga\u00e7\u00e3o foi interrompida e n\u00e3o foi poss\u00edvel concluir a transfer\u00eancia. Tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexiunea a fost \u00eentrerupt\u0103, iar desc\u0103rcarea nu a putut fi finalizat\u0103. \u00cencearc\u0103 din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0435 \u0431\u044b\u043b\u043e \u043f\u0440\u0435\u0440\u0432\u0430\u043d\u043e, \u0438 \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0443 \u043d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044c. \u041f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u0435 \u043f\u043e\u043f\u044b\u0442\u043a\u0443."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslutningen avbr\u00f6ts och h\u00e4mtningen kunde inte slutf\u00f6ras. F\u00f6rs\u00f6k igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba\u011flant\u0131 kesildi ve indirme tamamlanamad\u0131. L\u00fctfen tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417'\u0454\u0434\u043d\u0430\u043d\u043d\u044f \u0431\u0443\u043b\u043e \u043f\u0435\u0440\u0435\u0440\u0432\u0430\u043d\u043e, \u0456 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u043d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0438. \u0421\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0449\u0435 \u0440\u0430\u0437."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u1ebft n\u1ed1i b\u1ecb gi\u00e1n \u0111o\u1ea1n v\u00e0 kh\u00f4ng th\u1ec3 ho\u00e0n t\u1ea5t qu\u00e1 tr\u00ecnh t\u1ea3i xu\u1ed1ng. Vui l\u00f2ng th\u1eed l\u1ea1i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fde\u63a5\u4e2d\u65ad\uff0c\u4e0b\u8f7d\u672a\u80fd\u5b8c\u6210\u3002\u8bf7\u91cd\u8bd5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9023\u7dda\u4e2d\u65b7\uff0c\u4e0b\u8f09\u672a\u80fd\u5b8c\u6210\u3002\u8acb\u518d\u8a66\u4e00\u6b21\u3002"
          }
        }
      }
    },
