    "Generates a bounded, privacy-safe report for issue triage.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0646\u0634\u0626 \u062a\u0642\u0631\u064a\u0631\u064b\u0627 \u0645\u062d\u062f\u0648\u062f\u064b\u0627 \u0648\u0622\u0645\u0646\u064b\u0627 \u0644\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0644\u0641\u0631\u0632 \u0627\u0644\u0645\u0634\u0643\u0644\u0627\u062a."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvo\u0159\u00ed stru\u010dnou zpr\u00e1vu bez osobn\u00edch \u00fadaj\u016f pro \u0159e\u0161en\u00ed probl\u00e9m\u016f."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genererer en afgr\u00e6nset, privatlivsvenlig rapport til fejlsortering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt einen begrenzten, datenschutzfreundlichen Bericht f\u00fcr die Fehleranalyse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera un informe acotado y respetuoso con la privacidad para clasificar incidencias."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo rajatun ja yksityisyyden s\u00e4ilytt\u00e4v\u00e4n raportin ongelmien k\u00e4sittely\u00e4 varten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00e9n\u00e8re un rapport limit\u00e9 et respectueux de la vie priv\u00e9e pour le tri des probl\u00e8mes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera un report limitato e rispettoso della privacy per l'analisi dei problemi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u554f\u984c\u306e\u5207\u308a\u5206\u3051\u7528\u306b\u3001\u7bc4\u56f2\u3092\u9650\u5b9a\u3057\u305f\u30d7\u30e9\u30a4\u30d0\u30b7\u30fc\u4fdd\u8b77\u30ec\u30dd\u30fc\u30c8\u3092\u751f\u6210\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubb38\uc81c \ubd84\ub958\uc5d0 \uc0ac\uc6a9\ud560, \ubc94\uc704\uac00 \uc81c\ud55c\ub41c \uac1c\uc778\uc815\ubcf4 \ubcf4\ud638 \ubcf4\uace0\uc11c\ub97c \uc0dd\uc131\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Genereert een beknopt, privacyvriendelijk rapport voor probleemanalyse."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tworzy zwi\u0119z\u0142y raport bez danych osobowych do analizy problem\u00f3w."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gera um relat\u00f3rio limitado e que preserva a privacidade para triagem de problemas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Gera um relat\u00f3rio limitado e respeitador da privacidade para triagem de problemas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Genereaz\u0103 un raport limitat, care respect\u0103 confiden\u021bialitatea, pentru triaj."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0437\u0434\u0430\u0451\u0442 \u043a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u044b\u0439 \u043e\u0442\u0447\u0451\u0442 \u0431\u0435\u0437 \u043b\u0438\u0447\u043d\u044b\u0445 \u0434\u0430\u043d\u043d\u044b\u0445 \u0434\u043b\u044f \u0440\u0430\u0437\u0431\u043e\u0440\u0430 \u043f\u0440\u043e\u0431\u043b\u0435\u043c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapar en avgr\u00e4nsad, integritetss\u00e4ker rapport f\u00f6r felsortering."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorun de\u011ferlendirmesi i\u00e7in s\u0131n\u0131rl\u0131 ve gizlili\u011fe duyarl\u0131 bir rapor olu\u015fturur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0442\u0432\u043e\u0440\u044e\u0454 \u043a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u0438\u0439 \u0437\u0432\u0456\u0442 \u0431\u0435\u0437 \u043e\u0441\u043e\u0431\u0438\u0441\u0442\u0438\u0445 \u0434\u0430\u043d\u0438\u0445 \u0434\u043b\u044f \u0440\u043e\u0437\u0431\u043e\u0440\u0443 \u043f\u0440\u043e\u0431\u043b\u0435\u043c."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1ea1o b\u00e1o c\u00e1o gi\u1edbi h\u1ea1n, an to\u00e0n cho quy\u1ec1n ri\u00eang t\u01b0 \u0111\u1ec3 ph\u00e2n lo\u1ea1i s\u1ef1 c\u1ed1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u751f\u6210\u8303\u56f4\u6709\u9650\u4e14\u4fdd\u62a4\u9690\u79c1\u7684\u62a5\u544a\uff0c\u7528\u4e8e\u95ee\u9898\u5206\u7c7b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7522\u751f\u7bc4\u570d\u6709\u9650\u4e14\u4fdd\u8b77\u96b1\u79c1\u7684\u5831\u544a\uff0c\u4f9b\u554f\u984c\u5206\u985e\u4f7f\u7528\u3002"
          }
        }
      }
    },
