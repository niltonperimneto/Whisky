    "config.audio.resetState.confirm": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0647\u0644 \u062a\u0631\u064a\u062f \u0625\u0639\u0627\u062f\u0629 \u062a\u0639\u064a\u064a\u0646 \u062d\u0627\u0644\u0629 \u0627\u0644\u0635\u0648\u062a \u0644\u0647\u0630\u0647 \u0627\u0644\u0632\u062c\u0627\u062c\u0629\u061f"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezipam\u011b\u0165 zvukov\u00fdch za\u0159\u00edzen\u00ed Wine se vyma\u017ee a server Wine se restartuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du nulstille den arkiverede lydstatus for denne flaske?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gesicherten Audiostatus dieser Flasche zur\u00fccksetzen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset this bottle's saved audio state?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset this bottle's saved audio state?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "config.audio.resetState.confirm"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nollataanko t\u00e4m\u00e4n pullon \u00e4\u00e4nen tila?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "config.audio.resetState.confirm"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "config.audio.resetState.confirm"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \u304c\u30ad\u30e3\u30c3\u30b7\u30e5\u3057\u3066\u3044\u308b\u30aa\u30fc\u30c7\u30a3\u30aa\u30c7\u30d0\u30a4\u30b9\u306e\u5272\u308a\u5f53\u3066\u3092\u6d88\u53bb\u3057\u3001wineserver \u3092\u518d\u8d77\u52d5\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine\uc5d0 \uce90\uc2dc\ub41c \uc624\ub514\uc624 \uae30\uae30 \ub9e4\ud551\uc744 \uc9c0\uc6b0\uace0 wineserver\ub97c \ub2e4\uc2dc \uc2dc\uc791\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bewaarde audiostatus van deze fles opnieuw instellen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pami\u0119\u0107 podr\u0119czna urz\u0105dze\u0144 audio Wine zostanie wyczyszczona, a serwer Wine uruchomiony ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "config.audio.resetState.confirm"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "config.audio.resetState.confirm"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "config.audio.resetState.confirm"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u044d\u0448 \u0430\u0443\u0434\u0438\u043e\u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432 Wine \u0431\u0443\u0434\u0435\u0442 \u043e\u0447\u0438\u0449\u0435\u043d, \u0430 \u0441\u0435\u0440\u0432\u0435\u0440 Wine \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0449\u0435\u043d."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vill du \u00e5terst\u00e4lla den sparade ljudstatusen f\u00f6r den h\u00e4r flaskan?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu \u015fi\u015fenin ses durumu s\u0131f\u0131rlans\u0131n m\u0131?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0435\u0448 \u0430\u0443\u0434\u0456\u043e\u043f\u0440\u0438\u0441\u0442\u0440\u043e\u0457\u0432 Wine \u0431\u0443\u0434\u0435 \u043e\u0447\u0438\u0449\u0435\u043d\u043e, \u0430 \u0441\u0435\u0440\u0432\u0435\u0440 Wine \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0449\u0435\u043d\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u1eb7t l\u1ea1i tr\u1ea1ng th\u00e1i \u00e2m thanh cho bottle n\u00e0y?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fd9\u5c06\u6e05\u9664 Wine \u7f13\u5b58\u7684\u97f3\u9891\u8bbe\u5907\u6620\u5c04\u5e76\u91cd\u65b0\u542f\u52a8 wineserver\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9019\u6703\u6e05\u9664 Wine \u5feb\u53d6\u7684\u97f3\u8a0a\u88dd\u7f6e\u5c0d\u61c9\uff0c\u4e26\u91cd\u65b0\u555f\u52d5 wineserver\u3002"
          }
        }
      }
    },
    "config.audio.simple": {
