    "config.winVersion.info": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0625\u0635\u062f\u0627\u0631 Windows \u0627\u0644\u0630\u064a \u064a\u0628\u0644\u0651\u063a \u0639\u0646\u0647 Wine \u0644\u0644\u0628\u0631\u0627\u0645\u062c. \u064a\u0646\u0627\u0633\u0628 Windows 10 \u0645\u0639\u0638\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Verze Windows, kterou Wine hl\u00e1s\u00ed program\u016fm. V\u011bt\u0161in\u011b aplikac\u00ed vyhovuje Windows 10."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Windows-version, som Wine oplyser til programmer. Windows 10 passer til de fleste apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Windows-Version, die Wine an Programme meldet. Windows 10 passt f\u00fcr die meisten Apps."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Windows version Wine reports to programs. Windows 10 suits most apps."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The Windows version Wine reports to programs. Windows 10 suits most apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versi\u00f3n de Windows que Wine informa a los programas. Windows 10 sirve para la mayor\u00eda de apps."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows-versio, jonka Wine ilmoittaa ohjelmille. Windows 10 sopii useimmille sovelluksille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version de Windows que Wine signale aux programmes. Windows 10 convient \u00e0 la plupart des apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione di Windows che Wine comunica ai programmi. Windows 10 va bene per quasi tutte le app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \u304c\u30d7\u30ed\u30b0\u30e9\u30e0\u306b\u5831\u544a\u3059\u308b Windows \u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u3067\u3059\u3002\u307b\u3068\u3093\u3069\u306e\u30a2\u30d7\u30ea\u306b\u306f Windows 10 \u304c\u9069\u3057\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine\uc774 \ud504\ub85c\uadf8\ub7a8\uc5d0 \ubcf4\uace0\ud558\ub294 Windows \ubc84\uc804\uc785\ub2c8\ub2e4. \ub300\ubd80\ubd84\uc758 \uc571\uc5d0\ub294 Windows 10\uc774 \uc801\ud569\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Windows-versie die Wine aan programma's meldt. Windows 10 voldoet voor de meeste apps."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja Windows zg\u0142aszana programom przez Wine. Windows 10 pasuje do wi\u0119kszo\u015bci aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A vers\u00e3o do Windows que o Wine informa aos programas. O Windows 10 atende \u00e0 maioria dos apps."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A vers\u00e3o do Windows que o Wine comunica aos programas. O Windows 10 serve para a maioria das apps."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiunea de Windows raportat\u0103 de Wine. Windows 10 e potrivit pentru majoritatea aplica\u021biilor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0435\u0440\u0441\u0438\u044f Windows, \u043e \u043a\u043e\u0442\u043e\u0440\u043e\u0439 Wine \u0441\u043e\u043e\u0431\u0449\u0430\u0435\u0442 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430\u043c. \u0414\u043b\u044f \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u0430 \u043f\u043e\u0434\u0445\u043e\u0434\u0438\u0442 Windows 10."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Windows-version som Wine rapporterar till program. Windows 10 passar de flesta appar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine'\u0131n programlara bildirdi\u011fi Windows s\u00fcr\u00fcm\u00fc. \u00c7o\u011fu uygulama i\u00e7in Windows 10 uygundur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0435\u0440\u0441\u0456\u044f Windows, \u044f\u043a\u0443 Wine \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u044f\u0454 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0430\u043c. \u0414\u043b\u044f \u0431\u0456\u043b\u044c\u0448\u043e\u0441\u0442\u0456 \u043f\u0456\u0434\u0445\u043e\u0434\u0438\u0442\u044c Windows 10."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phi\u00ean b\u1ea3n Windows m\u00e0 Wine b\u00e1o cho c\u00e1c ch\u01b0\u01a1ng tr\u00ecnh. Windows 10 h\u1ee3p v\u1edbi h\u1ea7u h\u1ebft \u1ee9ng d\u1ee5ng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \u5411\u7a0b\u5e8f\u62a5\u544a\u7684 Windows \u7248\u672c\u3002\u5927\u591a\u6570\u5e94\u7528\u9002\u5408\u4f7f\u7528 Windows 10\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \u5411\u7a0b\u5f0f\u56de\u5831\u7684 Windows \u7248\u672c\u3002\u5927\u591a\u6578 App \u9069\u5408\u4f7f\u7528 Windows 10\u3002"
          }
        }
      }
    },
