    "steam.launch.error.gameNotFound %lld": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u062a\u0648\u062c\u062f \u0632\u062c\u0627\u062c\u0629 \u0645\u062b\u0628\u0651\u062a \u0628\u0647\u0627 \u0627\u0644\u0645\u0639\u0631\u0651\u0641 App ID \u0631\u0642\u0645 %lld."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "\u017d\u00e1dn\u00e1 l\u00e1hev nem\u00e1 nainstalovan\u00e9 App ID %lld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "App-id %lld er ikke installeret i nogen flaske."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In keiner Flasche ist App-ID %lld installiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No bottle has App ID %lld installed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "No bottle has App ID %lld installed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna botella tiene instalado el App ID %lld."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdess\u00e4k\u00e4\u00e4n pullossa ei ole asennettuna App ID:t\u00e4 %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune bouteille n'a l'App ID %lld install\u00e9."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna bottiglia ha installato l'App ID %lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App ID %lld \u304c\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3055\u308c\u3066\u3044\u308b Bottle \u306f\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App ID %lld\uc774(\uac00) \uc124\uce58\ub41c Bottle\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen enkele fles heeft App-ID %lld ge\u00efnstalleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u017badna butelka nie ma zainstalowanego App ID %lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma Bottle tem o App ID %lld instalado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma Bottle tem o App ID %lld instalado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicio sticl\u0103 nu are instalat App ID-ul %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0438 \u0432 \u043e\u0434\u043d\u043e\u0439 \u0431\u0443\u0442\u044b\u043b\u043a\u0435 \u043d\u0435 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0441 App ID %lld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "App-ID %lld \u00e4r inte installerat i n\u00e5gon flaska."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi\u00e7bir \u015fi\u015fede %lld App ID'li oyun y\u00fckl\u00fc de\u011fil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423 \u0436\u043e\u0434\u043d\u0456\u0439 \u043f\u043b\u044f\u0448\u0446\u0456 \u043d\u0435 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043e \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a \u0437 App ID %lld."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng c\u00f3 bottle n\u00e0o c\u00e0i App ID %lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ca1\u6709\u4efb\u4f55 Bottle \u5b89\u88c5\u4e86 App ID %lld\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c92\u6709\u4efb\u4f55 Bottle \u5b89\u88dd\u4e86 App ID %lld\u3002"
          }
        }
      }
