    "troubleshooting.symptom.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u0627 \u0627\u0644\u0645\u0634\u0643\u0644\u0629 \u0627\u0644\u062a\u064a \u062a\u0648\u0627\u062c\u0647\u0647\u0627\u061f"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak\u00fd probl\u00e9m \u0159e\u0161\u00edte?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilket problem oplever du?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welches Problem hast du?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What issue are you experiencing?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "What issue are you experiencing?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfQu\u00e9 problema tienes?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mik\u00e4 ongelma sinulla on?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel probl\u00e8me rencontrez-vous ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale problema stai riscontrando?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3069\u306e\u3088\u3046\u306a\u554f\u984c\u304c\u8d77\u304d\u3066\u3044\u307e\u3059\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5b4\ub5a4 \ubb38\uc81c\ub97c \uacaa\uace0 \uc788\uc2b5\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welk probleem heb je?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakiego problemu do\u015bwiadczasz?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual problema voc\u00ea est\u00e1 tendo?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Que problema est\u00e1 a ter?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce problem\u0103 \u00eent\u00e2mpini?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421 \u043a\u0430\u043a\u043e\u0439 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u043e\u0439 \u0432\u044b \u0441\u0442\u043e\u043b\u043a\u043d\u0443\u043b\u0438\u0441\u044c?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilket problem har du?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi sorunu ya\u015f\u0131yorsunuz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417 \u044f\u043a\u043e\u044e \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u043e\u044e \u0432\u0438 \u0437\u0456\u0442\u043a\u043d\u0443\u043b\u0438\u0441\u044f?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u1ea1n \u0111ang g\u1eb7p s\u1ef1 c\u1ed1 g\u00ec?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
