    "steam.client.missing": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u062a\u0639\u062f \u0647\u0630\u0647 \u0627\u0644\u0632\u062c\u0627\u062c\u0629 \u062a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u062a\u062b\u0628\u064a\u062a Steam."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato l\u00e1hev u\u017e neobsahuje instalaci Steamu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne flaske indeholder ikke l\u00e6ngere en Steam-installation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Flasche enth\u00e4lt keine Steam-Installation mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This bottle no longer contains a Steam installation."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This bottle no longer contains a Steam installation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta botella ya no contiene una instalaci\u00f3n de Steam."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00e4ss\u00e4 pullossa ei ole en\u00e4\u00e4 Steam-asennusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette bouteille ne contient plus d'installation de Steam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa bottiglia non contiene pi\u00f9 un'installazione di Steam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e Bottle \u306b\u306f Steam \u304c\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 Bottle\uc5d0\ub294 \ub354 \uc774\uc0c1 Steam\uc774 \uc124\uce58\ub418\uc5b4 \uc788\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze fles bevat geen Steam-installatie meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta butelka nie zawiera ju\u017c instalacji Steam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Bottle n\u00e3o cont\u00e9m mais uma instala\u00e7\u00e3o do Steam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Bottle j\u00e1 n\u00e3o cont\u00e9m uma instala\u00e7\u00e3o do Steam."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceast\u0103 sticl\u0103 nu mai con\u021bine o instalare Steam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 \u044d\u0442\u043e\u0439 \u0431\u0443\u0442\u044b\u043b\u043a\u0435 \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435\u0442 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u043e\u0433\u043e Steam."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den h\u00e4r flaskan inneh\u00e5ller inte l\u00e4ngre n\u00e5gon Steam-installation."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu \u015fi\u015fede art\u0131k Steam kurulumu yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423 \u0446\u0456\u0439 \u043f\u043b\u044f\u0448\u0446\u0456 \u0431\u0456\u043b\u044c\u0448\u0435 \u043d\u0435\u043c\u0430\u0454 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043e\u0433\u043e Steam."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bottle n\u00e0y kh\u00f4ng c\u00f2n b\u1ea3n c\u00e0i Steam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64 Bottle \u4e2d\u5df2\u4e0d\u518d\u5b89\u88c5 Steam\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
