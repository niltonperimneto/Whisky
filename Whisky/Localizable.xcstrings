    "process.confirm.stop.includesUntracked": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0634\u0645\u0644 \u0630\u0644\u0643 \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u063a\u064a\u0631 \u0627\u0644\u0645\u062a\u062a\u0628\u064e\u0651\u0639\u0629 \u0627\u0644\u062a\u064a \u0644\u0645 \u064a\u0634\u063a\u0651\u0644\u0647\u0627 Whisky."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u010detn\u011b nesledovan\u00fdch proces\u016f, kter\u00e9 nespustila Whisky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det omfatter ogs\u00e5 processer, der ikke er startet af Whisky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das schlie\u00dft nicht erfasste Prozesse ein, die nicht von Whisky gestartet wurden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This includes untracked processes not launched by Whisky."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This includes untracked processes not launched by Whisky."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto incluye procesos no supervisados que no ha iniciado Whisky."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00e4m\u00e4 sis\u00e4lt\u00e4\u00e4 my\u00f6s seuraamattomat prosessit, joita Whisky ei k\u00e4ynnist\u00e4nyt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela inclut les processus non suivis qui n'ont pas \u00e9t\u00e9 lanc\u00e9s par Whisky."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono inclusi i processi non tracciati che non sono stati avviati da Whisky."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky \u304b\u3089\u8d77\u52d5\u3057\u3066\u3044\u306a\u3044\u3001\u8ffd\u8de1\u5916\u306e\u30d7\u30ed\u30bb\u30b9\u3082\u542b\u307e\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky\uac00 \uc2e4\ud589\ud558\uc9c0 \uc54a\uc740 \ucd94\uc801\ub418\uc9c0 \uc54a\ub294 \ud504\ub85c\uc138\uc2a4\ub3c4 \ud3ec\ud568\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit geldt ook voor niet-bijgehouden processen die niet door Whisky zijn gestart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotyczy to tak\u017ce proces\u00f3w nieuruchomionych przez Whisky."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso inclui processos n\u00e3o monitorados que n\u00e3o foram iniciados pelo Whisky."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto inclui processos n\u00e3o monitorizados que n\u00e3o foram iniciados pelo Whisky."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunt incluse \u0219i procesele neurm\u0103rite, care nu au fost lansate de Whisky."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u044b, \u0437\u0430\u043f\u0443\u0449\u0435\u043d\u043d\u044b\u0435 \u043d\u0435 \u0438\u0437 Whisky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det omfattar \u00e4ven processer som inte startats av Whisky."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buna, Whisky taraf\u0131ndan ba\u015flat\u0131lmayan izlenmeyen i\u015flemler de dahildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u043e\u043a\u0440\u0435\u043c\u0430 \u043f\u0440\u043e\u0446\u0435\u0441\u0438, \u0437\u0430\u043f\u0443\u0449\u0435\u043d\u0456 \u043d\u0435 \u0437 Whisky."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bao g\u1ed3m c\u1ea3 c\u00e1c ti\u1ebfn tr\u00ecnh kh\u00f4ng \u0111\u01b0\u1ee3c theo d\u00f5i, kh\u00f4ng do Whisky kh\u1edfi ch\u1ea1y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5176\u4e2d\u5305\u62ec\u5e76\u975e\u7531 Whisky \u542f\u52a8\u7684\u672a\u8ddf\u8e2a\u8fdb\u7a0b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5176\u4e2d\u5305\u62ec\u4e26\u975e\u7531 Whisky \u555f\u52d5\u7684\u672a\u8ffd\u8e64\u7a0b\u5e8f\u3002"
          }
        }
      }
    },
    "process.confirm.stop.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0633\u064a\u062d\u0627\u0648\u0644 \u0647\u0630\u0627 \u0625\u063a\u0644\u0627\u0642 \u062c\u0645\u064a\u0639 \u0627\u0644\u0628\u0631\u0627\u0645\u062c \u0642\u064a\u062f \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0628\u0633\u0644\u0627\u0633\u0629."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky se pokus\u00ed korektn\u011b zav\u0159\u00edt v\u0161echny b\u011b\u017e\u00edc\u00ed programy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der bliver fors\u00f8gt at lukke alle k\u00f8rende programmer p\u00e5 p\u00e6n vis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dabei wird versucht, alle laufenden Programme geordnet zu beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will attempt to gracefully close all running programs."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This will attempt to gracefully close all running programs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se intentar\u00e1 cerrar correctamente todos los programas en ejecuci\u00f3n."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00e4m\u00e4 yritt\u00e4\u00e4 sulkea kaikki k\u00e4ynniss\u00e4 olevat ohjelmat hallitusti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky tentera de fermer proprement tous les programmes en cours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verr\u00e0 tentata la chiusura corretta di tutti i programmi in esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b9f\u884c\u4e2d\u306e\u3059\u3079\u3066\u306e\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u6b63\u5e38\u306b\u7d42\u4e86\u3059\u308b\u3088\u3046\u8a66\u307f\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2e4\ud589 \uc911\uc778 \ubaa8\ub4e0 \ud504\ub85c\uadf8\ub7a8\uc744 \uc815\uc0c1\uc801\uc73c\ub85c \uc885\ub8cc\ud558\ub3c4\ub85d \uc2dc\ub3c4\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt geprobeerd alle actieve programma's netjes af te sluiten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky spr\u00f3buje normalnie zamkn\u0105\u0107 wszystkie dzia\u0142aj\u0105ce programy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Whisky tentar\u00e1 fechar normalmente todos os programas em execu\u00e7\u00e3o."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ser\u00e1 tentado o encerramento correto de todos os programas em execu\u00e7\u00e3o."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se va \u00eencerca \u00eenchiderea normal\u0103 a tuturor programelor \u00een execu\u021bie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0441\u0435 \u0437\u0430\u043f\u0443\u0449\u0435\u043d\u043d\u044b\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b \u0431\u0443\u0434\u0443\u0442 \u0437\u0430\u043a\u0440\u044b\u0442\u044b \u0448\u0442\u0430\u0442\u043d\u043e."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett f\u00f6rs\u00f6k g\u00f6rs att st\u00e4nga alla program som k\u00f6rs p\u00e5 ett kontrollerat s\u00e4tt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu i\u015flem, \u00e7al\u0131\u015fan t\u00fcm programlar\u0131 d\u00fczg\u00fcn \u015fekilde kapatmay\u0131 dener."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0441\u0456 \u0437\u0430\u043f\u0443\u0449\u0435\u043d\u0456 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u0431\u0443\u0434\u0435 \u0437\u0430\u043a\u0440\u0438\u0442\u043e \u0448\u0442\u0430\u0442\u043d\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao t\u00e1c n\u00e0y s\u1ebd c\u1ed1 \u0111\u00f3ng to\u00e0n b\u1ed9 ch\u01b0\u01a1ng tr\u00ecnh \u0111ang ch\u1ea1y m\u1ed9t c\u00e1ch an to\u00e0n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fd9\u5c06\u5c1d\u8bd5\u6b63\u5e38\u5173\u95ed\u6240\u6709\u6b63\u5728\u8fd0\u884c\u7684\u7a0b\u5e8f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9019\u6703\u5617\u8a66\u6b63\u5e38\u95dc\u9589\u6240\u6709\u57f7\u884c\u4e2d\u7684\u7a0b\u5f0f\u3002"
          }
        }
      }
    },
