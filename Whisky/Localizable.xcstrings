    "Sets LeftCommandIsCtrl/RightCommandIsCtrl in Wine's Mac driver registry so Cmd+A/C/V/S register inside Wine apps as Ctrl+A/C/V/S.": {
      "comment": "Maps the Cmd key to the Windows Ctrl key.",
      "isCommentAutoGenerated": true
    },
    "Sets SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1 to preserve native button layouts for PlayStation and Switch controllers instead of converting to XInput format.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0636\u0628\u0637 SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1 \u0644\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u062a\u062e\u0637\u064a\u0637 \u0627\u0644\u0623\u0632\u0631\u0627\u0631 \u0627\u0644\u0623\u0635\u0644\u064a \u0644\u0648\u062d\u062f\u0627\u062a \u062a\u062d\u0643\u0645 PlayStation \u0648Switch \u0628\u062f\u0644\u064b\u0627 \u0645\u0646 \u062a\u062d\u0648\u064a\u0644\u0647\u0627 \u0625\u0644\u0649 \u062a\u0646\u0633\u064a\u0642 XInput."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastav\u00ed SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1, aby z\u016fstalo p\u016fvodn\u00ed zna\u010den\u00ed tla\u010d\u00edtek ovlada\u010d\u016f PlayStation a Switch m\u00edsto p\u0159evodu na form\u00e1t XInput."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00e6tter SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1, s\u00e5 den oprindelige knapplacering p\u00e5 PlayStation- og Switch-controllere bevares i stedet for at blive konverteret til XInput-format."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1, um die native Tastenbelegung von PlayStation- und Switch-Controllern beizubehalten, statt sie ins XInput-Format zu \u00fcbersetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1 para conservar la disposici\u00f3n original de los botones de los mandos de PlayStation y Switch en lugar de convertirla al formato XInput."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asettaa SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1, jolloin PlayStation- ja Switch-ohjaimien alkuper\u00e4iset painikemerkinn\u00e4t s\u00e4ilyv\u00e4t eik\u00e4 niit\u00e4 muunneta XInput-muotoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9finit SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1 pour conserver la disposition d'origine des boutons des manettes PlayStation et Switch au lieu de la convertir au format XInput."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1 per mantenere la disposizione originale dei tasti dei controller PlayStation e Switch invece di convertirla nel formato XInput."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1 \u3092\u8a2d\u5b9a\u3057\u3001PlayStation \u304a\u3088\u3073 Switch \u306e\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u306e\u30dc\u30bf\u30f3\u914d\u5217\u3092 XInput \u5f62\u5f0f\u306b\u5909\u63db\u305b\u305a\u3001\u305d\u306e\u307e\u307e\u7dad\u6301\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1\uc744 \uc124\uc815\ud574 PlayStation \ubc0f Switch \ucee8\ud2b8\ub864\ub7ec\uc758 \ubc84\ud2bc \ubc30\uc5f4\uc744 XInput \ud615\uc2dd\uc73c\ub85c \ubcc0\ud658\ud558\uc9c0 \uc54a\uace0 \uadf8\ub300\ub85c \uc720\uc9c0\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelt SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1 in om de oorspronkelijke knopindeling van PlayStation- en Switch-controllers te behouden in plaats van deze om te zetten naar XInput."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawia SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1, aby zachowa\u0107 oryginalne oznaczenia przycisk\u00f3w kontroler\u00f3w PlayStation i Switch zamiast zamiany na format XInput."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Define SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1 para preservar o layout original dos bot\u00f5es dos controles de PlayStation e Switch em vez de convert\u00ea-lo para o formato XInput."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Define SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1 para manter a disposi\u00e7\u00e3o original dos bot\u00f5es dos comandos PlayStation e Switch em vez de a converter para o formato XInput."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Seteaz\u0103 SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1 pentru a p\u0103stra dispunerea original\u0103 a butoanelor la controllerele PlayStation \u0219i Switch, \u00een loc s\u0103 o converteasc\u0103 \u00een format XInput."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0434\u0430\u0451\u0442 SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1, \u0447\u0442\u043e\u0431\u044b \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u043a\u043d\u043e\u043f\u043e\u043a \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u043b\u0435\u0440\u043e\u0432 PlayStation \u0438 Switch \u0432\u043c\u0435\u0441\u0442\u043e \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0430 \u0432 \u0444\u043e\u0440\u043c\u0430\u0442 XInput."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anger SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1 s\u00e5 att den ursprungliga knapplayouten p\u00e5 PlayStation- och Switch-handkontroller beh\u00e5lls i st\u00e4llet f\u00f6r att omvandlas till XInput-format."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PlayStation ve Switch kumandalar\u0131nda XInput bi\u00e7imine d\u00f6n\u00fc\u015ft\u00fcrmek yerine yerel d\u00fc\u011fme d\u00fczenlerini korumak i\u00e7in SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1 ayarlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0434\u0430\u0454 SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1, \u0449\u043e\u0431 \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0440\u0456\u0434\u043d\u0456 \u043f\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u043a\u043d\u043e\u043f\u043e\u043a \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u0440\u0456\u0432 PlayStation \u0456 Switch \u0437\u0430\u043c\u0456\u0441\u0442\u044c \u043f\u0435\u0440\u0435\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f \u043d\u0430 \u0444\u043e\u0440\u043c\u0430\u0442 XInput."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u1eb7t SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1 \u0111\u1ec3 gi\u1eef b\u1ed1 c\u1ee5c n\u00fat g\u1ed1c c\u1ee7a tay c\u1ea7m PlayStation v\u00e0 Switch thay v\u00ec chuy\u1ec3n sang \u0111\u1ecbnh d\u1ea1ng XInput."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bbe\u7f6e SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1\uff0c\u4fdd\u7559 PlayStation \u548c Switch \u63a7\u5236\u5668\u7684\u539f\u751f\u6309\u952e\u5e03\u5c40\uff0c\u800c\u4e0d\u8f6c\u6362\u4e3a XInput \u683c\u5f0f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a2d\u5b9a SDL_GAMECONTROLLER_USE_BUTTON_LABELS=1\uff0c\u4fdd\u7559 PlayStation \u8207 Switch \u63a7\u5236\u5668\u7684\u539f\u751f\u6309\u9375\u914d\u7f6e\uff0c\u800c\u4e0d\u8f49\u63db\u70ba XInput \u683c\u5f0f\u3002"
          }
        }
      }
    },
    "Sets SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1 to enable controller input when the game window doesn't have focus.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0636\u0628\u0637 SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1 \u0644\u062a\u0641\u0639\u064a\u0644 \u0625\u062f\u062e\u0627\u0644 \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0639\u0646\u062f\u0645\u0627 \u0644\u0627 \u062a\u0643\u0648\u0646 \u0646\u0627\u0641\u0630\u0629 \u0627\u0644\u0644\u0639\u0628\u0629 \u0646\u0634\u0637\u0629."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastav\u00ed SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1, aby ovlada\u010d fungoval, i kdy\u017e okno hry nen\u00ed aktivn\u00ed."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00e6tter SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1, s\u00e5 controlleren virker, n\u00e5r spilvinduet ikke er i forgrunden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1, um Controller-Eingaben zu erm\u00f6glichen, wenn das Spielfenster nicht im Vordergrund ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1 para permitir la entrada del mando cuando la ventana del juego no tiene el foco."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asettaa SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1, jolloin ohjainsy\u00f6te toimii my\u00f6s silloin, kun peli-ikkuna ei ole aktiivinen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9finit SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1 pour activer la manette lorsque la fen\u00eatre du jeu n'a pas le focus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1 per abilitare l'input del controller quando la finestra del gioco non \u00e8 in primo piano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1 \u3092\u8a2d\u5b9a\u3057\u3001\u30b2\u30fc\u30e0\u306e\u30a6\u30a4\u30f3\u30c9\u30a6\u304c\u6700\u524d\u9762\u3067\u306a\u3044\u3068\u304d\u3082\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u5165\u529b\u3092\u6709\u52b9\u306b\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1\uc744 \uc124\uc815\ud574 \uac8c\uc784 \uc708\ub3c4\uc6b0\uac00 \ud65c\uc131 \uc0c1\ud0dc\uac00 \uc544\ub2d0 \ub54c\ub3c4 \ucee8\ud2b8\ub864\ub7ec \uc785\ub825\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\uac8c \ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelt SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1 in zodat controllerinvoer werkt wanneer het gamevenster niet actief is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawia SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1, aby kontroler dzia\u0142a\u0142, gdy okno gry nie jest aktywne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Define SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1 para permitir a entrada do controle quando a janela do jogo n\u00e3o est\u00e1 em foco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Define SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1 para permitir a entrada do comando quando a janela do jogo n\u00e3o est\u00e1 em primeiro plano."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Seteaz\u0103 SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1 pentru a permite intrarea de la controller c\u00e2nd fereastra jocului nu este activ\u0103."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0434\u0430\u0451\u0442 SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1, \u0447\u0442\u043e\u0431\u044b \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u043b\u0435\u0440 \u0440\u0430\u0431\u043e\u0442\u0430\u043b, \u043a\u043e\u0433\u0434\u0430 \u043e\u043a\u043d\u043e \u0438\u0433\u0440\u044b \u043d\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u043e."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anger SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1 s\u00e5 att handkontrollen fungerar n\u00e4r spelf\u00f6nstret inte \u00e4r i f\u00f6rgrunden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyun penceresi odakta de\u011filken kumanda giri\u015fini etkinle\u015ftirmek i\u00e7in SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1 ayarlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0434\u0430\u0454 SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1, \u0449\u043e\u0431 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u0440 \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0432, \u043a\u043e\u043b\u0438 \u0432\u0456\u043a\u043d\u043e \u0433\u0440\u0438 \u043d\u0435\u0430\u043a\u0442\u0438\u0432\u043d\u0435."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u1eb7t SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1 \u0111\u1ec3 tay c\u1ea7m v\u1eabn nh\u1eadn t\u00edn hi\u1ec7u khi c\u1eeda s\u1ed5 game kh\u00f4ng \u0111\u01b0\u1ee3c focus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bbe\u7f6e SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1\uff0c\u4f7f\u6e38\u620f\u7a97\u53e3\u672a\u5904\u4e8e\u524d\u53f0\u65f6\u4ecd\u53ef\u63a5\u6536\u63a7\u5236\u5668\u8f93\u5165\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a2d\u5b9a SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1\uff0c\u8b93\u904a\u6232\u8996\u7a97\u4e0d\u5728\u524d\u666f\u6642\u4ecd\u53ef\u63a5\u6536\u63a7\u5236\u5668\u8f38\u5165\u3002"
          }
        }
      }
    },
    "Sets SDL_JOYSTICK_HIDAPI=0 to force SDL to use alternative input backends. May improve detection for some controllers.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0636\u0628\u0637 SDL_JOYSTICK_HIDAPI=0 \u0644\u0625\u062c\u0628\u0627\u0631 SDL \u0639\u0644\u0649 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0648\u0627\u062c\u0647\u0627\u062a \u0625\u062f\u062e\u0627\u0644 \u0628\u062f\u064a\u0644\u0629. \u0642\u062f \u064a\u062d\u0633\u0651\u0646 \u0630\u0644\u0643 \u0627\u0643\u062a\u0634\u0627\u0641 \u0628\u0639\u0636 \u0648\u062d\u062f\u0627\u062a \u0627\u0644\u062a\u062d\u0643\u0645."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastav\u00ed SDL_JOYSTICK_HIDAPI=0, aby SDL pou\u017eila jin\u00e9 vstupn\u00ed backendy. U n\u011bkter\u00fdch ovlada\u010d\u016f to zlep\u0161\u00ed rozpozn\u00e1n\u00ed."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00e6tter SDL_JOYSTICK_HIDAPI=0, s\u00e5 SDL bruger andre input-backends. Det kan forbedre registreringen af nogle controllere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt SDL_JOYSTICK_HIDAPI=0, damit SDL alternative Eingabe-Backends verwendet. Kann die Erkennung mancher Controller verbessern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define SDL_JOYSTICK_HIDAPI=0 para forzar a SDL a usar otros backends de entrada. Puede mejorar la detecci\u00f3n de algunos mandos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asettaa SDL_JOYSTICK_HIDAPI=0, jolloin SDL k\u00e4ytt\u00e4\u00e4 vaihtoehtoisia sy\u00f6tetaustaj\u00e4rjestelmi\u00e4. Voi parantaa joidenkin ohjaimien tunnistusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9finit SDL_JOYSTICK_HIDAPI=0 pour forcer SDL \u00e0 utiliser d'autres backends d'entr\u00e9e. Peut am\u00e9liorer la d\u00e9tection de certaines manettes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta SDL_JOYSTICK_HIDAPI=0 per forzare SDL a usare backend di input alternativi. Pu\u00f2 migliorare il rilevamento di alcuni controller."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SDL_JOYSTICK_HIDAPI=0 \u3092\u8a2d\u5b9a\u3057\u3001SDL \u306b\u5225\u306e\u5165\u529b\u30d0\u30c3\u30af\u30a8\u30f3\u30c9\u3092\u4f7f\u7528\u3055\u305b\u307e\u3059\u3002\u4e00\u90e8\u306e\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u3067\u691c\u51fa\u304c\u6539\u5584\u3059\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SDL_JOYSTICK_HIDAPI=0\uc744 \uc124\uc815\ud574 SDL\uc774 \ub2e4\ub978 \uc785\ub825 \ubc31\uc5d4\ub4dc\ub97c \uc0ac\uc6a9\ud558\ub3c4\ub85d \ud569\ub2c8\ub2e4. \uc77c\ubd80 \ucee8\ud2b8\ub864\ub7ec\uc758 \uac10\uc9c0\uac00 \uac1c\uc120\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelt SDL_JOYSTICK_HIDAPI=0 in zodat SDL andere invoerbackends gebruikt. Dit kan de detectie van sommige controllers verbeteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawia SDL_JOYSTICK_HIDAPI=0, aby SDL korzysta\u0142a z innych metod wej\u015bcia. Czasem poprawia to wykrywanie kontroler\u00f3w."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Define SDL_JOYSTICK_HIDAPI=0 para for\u00e7ar o SDL a usar outros backends de entrada. Pode melhorar a detec\u00e7\u00e3o de alguns controles."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Define SDL_JOYSTICK_HIDAPI=0 para for\u00e7ar o SDL a usar outros backends de entrada. Pode melhorar a dete\u00e7\u00e3o de alguns comandos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Seteaz\u0103 SDL_JOYSTICK_HIDAPI=0 pentru a for\u021ba SDL s\u0103 foloseasc\u0103 alte backenduri de intrare. Poate \u00eembun\u0103t\u0103\u021bi detectarea unor controllere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0434\u0430\u0451\u0442 SDL_JOYSTICK_HIDAPI=0, \u0447\u0442\u043e\u0431\u044b SDL \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0430 \u0434\u0440\u0443\u0433\u0438\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u044b \u0432\u0432\u043e\u0434\u0430. \u0418\u043d\u043e\u0433\u0434\u0430 \u043f\u043e\u043c\u043e\u0433\u0430\u0435\u0442 \u0440\u0430\u0441\u043f\u043e\u0437\u043d\u0430\u0442\u044c \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u043b\u0435\u0440."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anger SDL_JOYSTICK_HIDAPI=0 s\u00e5 att SDL anv\u00e4nder andra inmatningsbackends. Det kan f\u00f6rb\u00e4ttra identifieringen av vissa handkontroller."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SDL'nin alternatif giri\u015f arka u\u00e7lar\u0131n\u0131 kullanmas\u0131n\u0131 zorlamak i\u00e7in SDL_JOYSTICK_HIDAPI=0 ayarlar. Baz\u0131 kumandalarda alg\u0131lamay\u0131 iyile\u015ftirebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0434\u0430\u0454 SDL_JOYSTICK_HIDAPI=0, \u0449\u043e\u0431 SDL \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u043b\u0430 \u0456\u043d\u0448\u0456 \u0441\u043f\u043e\u0441\u043e\u0431\u0438 \u0432\u0432\u043e\u0434\u0443. \u0406\u043d\u043e\u0434\u0456 \u0446\u0435 \u0434\u043e\u043f\u043e\u043c\u0430\u0433\u0430\u0454 \u0440\u043e\u0437\u043f\u0456\u0437\u043d\u0430\u0442\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u0440."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u1eb7t SDL_JOYSTICK_HIDAPI=0 \u0111\u1ec3 bu\u1ed9c SDL d\u00f9ng backend nh\u1eadp li\u1ec7u thay th\u1ebf. C\u00f3 th\u1ec3 c\u1ea3i thi\u1ec7n kh\u1ea3 n\u0103ng nh\u1eadn di\u1ec7n m\u1ed9t s\u1ed1 tay c\u1ea7m."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bbe\u7f6e SDL_JOYSTICK_HIDAPI=0\uff0c\u5f3a\u5236 SDL \u4f7f\u7528\u5176\u4ed6\u8f93\u5165\u540e\u7aef\u3002\u53ef\u80fd\u6539\u5584\u90e8\u5206\u63a7\u5236\u5668\u7684\u8bc6\u522b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a2d\u5b9a SDL_JOYSTICK_HIDAPI=0\uff0c\u5f37\u5236 SDL \u4f7f\u7528\u5176\u4ed6\u8f38\u5165\u5f8c\u7aef\u3002\u53ef\u80fd\u6539\u5584\u90e8\u5206\u63a7\u5236\u5668\u7684\u5075\u6e2c\u3002"
          }
        }
      }
    },
