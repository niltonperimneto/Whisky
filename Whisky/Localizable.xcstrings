    "config.enhancedSync.info": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u0632\u0627\u0645\u0646\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u0639\u0645\u0644\u064a\u0629 \u0644\u062e\u064a\u0648\u0637 Wine. MSync \u0647\u064a \u0627\u0644\u0623\u0633\u0631\u0639 \u0639\u0644\u0649 macOS\u060c \u0648ESync \u0628\u062f\u064a\u0644 \u0627\u062d\u062a\u064a\u0627\u0637\u064a\u060c \u0648\u0628\u0644\u0627 \u0647\u064a \u0627\u0644\u0623\u0643\u062b\u0631 \u062a\u0648\u0627\u0641\u0642\u064b\u0627."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizace vl\u00e1ken Wine v procesu. MSync je na macOS nejrychlej\u0161\u00ed, ESync je z\u00e1loha, \u201e\u017d\u00e1dn\u00e1\u201c je nejkompatibiln\u011bj\u0161\u00ed."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronisering af Wine-tr\u00e5de. MSync er hurtigst p\u00e5 macOS, ESync er reservel\u00f8sningen, og Ingen er mest kompatibel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisierung von Wine-Threads. MSync ist am schnellsten, ESync die Ausweichoption, \u201eKeine\u201c am kompatibelsten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In-process synchronization for Wine threads. MSync is fastest on macOS; ESync is a fallback; None is most compatible."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "In-process synchronisation for Wine threads. MSync is fastest on macOS; ESync is a fallback; None is most compatible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizaci\u00f3n interna de hilos de Wine. MSync: la m\u00e1s r\u00e1pida en macOS; ESync: alternativa; Ninguna: la m\u00e1s compatible."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine-s\u00e4ikeiden sis\u00e4inen synkronointi. MSync on nopein macOS:ss\u00e4, ESync varavaihtoehto, Ei mit\u00e4\u00e4n yhteensopivin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisation interne des threads Wine. MSync : le plus rapide sur macOS ; ESync : repli ; Aucun : le plus compatible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizzazione interna dei thread Wine. MSync: pi\u00f9 veloce su macOS; ESync: alternativa; Nessuno: pi\u00f9 compatibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \u306e\u30b9\u30ec\u30c3\u30c9\u540c\u671f\u3092\u30d7\u30ed\u30bb\u30b9\u5185\u3067\u884c\u3044\u307e\u3059\u3002macOS \u3067\u306f MSync \u304c\u6700\u901f\u3001ESync \u306f\u4ee3\u66ff\u624b\u6bb5\u3001\u306a\u3057\u304c\u6700\u3082\u4e92\u63db\u6027\u306b\u512a\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \uc2a4\ub808\ub4dc\ub97c \ud504\ub85c\uc138\uc2a4 \ub0b4\uc5d0\uc11c \ub3d9\uae30\ud654\ud569\ub2c8\ub2e4. macOS\uc5d0\uc11c\ub294 MSync\uac00 \uac00\uc7a5 \ube60\ub974\uace0, ESync\ub294 \ub300\uccb4 \uc218\ub2e8\uc774\uba70, \uc5c6\uc74c\uc774 \uac00\uc7a5 \ud638\ud658\uc131\uc774 \uc88b\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisatie van Wine-threads. MSync is het snelst op macOS, ESync is de terugvaloptie en Geen het meest compatibel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja w\u0105tk\u00f3w Wine w procesie. MSync jest najszybszy na macOS, ESync to rezerwa, \u201eBrak\u201d jest najzgodniejszy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza\u00e7\u00e3o interna das threads do Wine. MSync: mais r\u00e1pida no macOS; ESync: alternativa; Nenhum: mais compat\u00edvel."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza\u00e7\u00e3o interna das threads do Wine. MSync: mais r\u00e1pida no macOS; ESync: alternativa; Nenhum: mais compat\u00edvel."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizare intern\u0103 a firelor Wine. MSync: cea mai rapid\u0103 pe macOS; ESync: alternativ\u0103; Niciunul: cel mai compatibil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0438\u043d\u0445\u0440\u043e\u043d\u0438\u0437\u0430\u0446\u0438\u044f \u043f\u043e\u0442\u043e\u043a\u043e\u0432 Wine \u0432 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0435. MSync \u0431\u044b\u0441\u0442\u0440\u0435\u0435 \u043d\u0430 macOS, ESync \u2014 \u0437\u0430\u043f\u0430\u0441\u043d\u043e\u0439 \u0432\u0430\u0440\u0438\u0430\u043d\u0442, \u00ab\u041d\u0435\u0442\u00bb \u2014 \u0441\u0430\u043c\u044b\u0439 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u0438\u043c\u044b\u0439."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronisering av Wine-tr\u00e5dar. MSync \u00e4r snabbast p\u00e5 macOS, ESync \u00e4r reservalternativet och Ingen \u00e4r mest kompatibel."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine i\u015f par\u00e7ac\u0131klar\u0131 i\u00e7in i\u015flem i\u00e7i e\u015fitleme. macOS'te MSync en h\u0131zl\u0131s\u0131, ESync yedektir; Yok en uyumlusudur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0438\u043d\u0445\u0440\u043e\u043d\u0456\u0437\u0430\u0446\u0456\u044f \u043f\u043e\u0442\u043e\u043a\u0456\u0432 Wine \u0443 \u043f\u0440\u043e\u0446\u0435\u0441\u0456. MSync \u043d\u0430\u0439\u0448\u0432\u0438\u0434\u0448\u0430 \u043d\u0430 macOS, ESync \u2014 \u0437\u0430\u043f\u0430\u0441\u043d\u0438\u0439 \u0432\u0430\u0440\u0456\u0430\u043d\u0442, \u00ab\u041d\u0435\u043c\u0430\u0454\u00bb \u2014 \u043d\u0430\u0439\u0441\u0443\u043c\u0456\u0441\u043d\u0456\u0448\u0438\u0439."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u1ed3ng b\u1ed9 trong ti\u1ebfn tr\u00ecnh cho lu\u1ed3ng Wine. MSync nhanh nh\u1ea5t tr\u00ean macOS, ESync d\u1ef1 ph\u00f2ng, Kh\u00f4ng l\u00e0 t\u01b0\u01a1ng th\u00edch nh\u1ea5t."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e3a Wine \u7ebf\u7a0b\u63d0\u4f9b\u8fdb\u7a0b\u5185\u540c\u6b65\u3002\u5728 macOS \u4e0a MSync \u6700\u5feb\uff0cESync \u4e3a\u5907\u9009\uff0c\u201c\u65e0\u201d\u517c\u5bb9\u6027\u6700\u597d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70ba Wine \u57f7\u884c\u7dd2\u63d0\u4f9b\u7a0b\u5e8f\u5167\u540c\u6b65\u3002\u5728 macOS \u4e0a MSync \u6700\u5feb\uff0cESync \u70ba\u5099\u63f4\uff0c\u300c\u7121\u300d\u76f8\u5bb9\u6027\u6700\u4f73\u3002"
          }
        }
      }
    },
