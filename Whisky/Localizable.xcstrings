            "state": "translated",
            "value": "\u81ea\u52d5\u3067\u306f\u89e3\u6c7a\u3067\u304d\u307e\u305b\u3093\u3067\u3057\u305f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc790\ub3d9\uc73c\ub85c \ud574\uacb0\ud558\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
