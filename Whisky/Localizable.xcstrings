    "config.virtualDesktop.processesRunning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u0648\u0642\u0641 \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0642\u064a\u062f \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0644\u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u062f\u0642\u0629."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro zm\u011bnu rozli\u0161en\u00ed zastavte b\u011b\u017e\u00edc\u00ed procesy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop k\u00f8rende processer for at \u00e6ndre opl\u00f8sningen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppe laufende Prozesse, um die Aufl\u00f6sung zu \u00e4ndern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop running processes to change resolution."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop running processes to change resolution."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Det\u00e9n los procesos en ejecuci\u00f3n para cambiar la resoluci\u00f3n."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pys\u00e4yt\u00e4 k\u00e4ynniss\u00e4 olevat prosessit, jotta voit vaihtaa tarkkuutta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arr\u00eatez les processus en cours pour changer la r\u00e9solution."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arresta i processi in esecuzione per cambiare la risoluzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u89e3\u50cf\u5ea6\u3092\u5909\u66f4\u3059\u308b\u306b\u306f\u3001\u5b9f\u884c\u4e2d\u306e\u30d7\u30ed\u30bb\u30b9\u3092\u505c\u6b62\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud574\uc0c1\ub3c4\ub97c \ubcc0\uacbd\ud558\ub824\uba74 \uc2e4\ud589 \uc911\uc778 \ud504\ub85c\uc138\uc2a4\ub97c \uc911\uc9c0\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop actieve processen om de resolutie te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymaj dzia\u0142aj\u0105ce procesy, aby zmieni\u0107 rozdzielczo\u015b\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare os processos em execu\u00e7\u00e3o para alterar a resolu\u00e7\u00e3o."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare os processos em execu\u00e7\u00e3o para alterar a resolu\u00e7\u00e3o."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Opre\u0219te procesele \u00een execu\u021bie pentru a schimba rezolu\u021bia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0427\u0442\u043e\u0431\u044b \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0435, \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u0437\u0430\u043f\u0443\u0449\u0435\u043d\u043d\u044b\u0435 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u044b."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppa processer som k\u00f6rs f\u00f6r att \u00e4ndra uppl\u00f6sningen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c7\u00f6z\u00fcn\u00fcrl\u00fc\u011f\u00fc de\u011fi\u015ftirmek i\u00e7in \u00e7al\u0131\u015fan i\u015flemleri durdurun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0429\u043e\u0431 \u0437\u043c\u0456\u043d\u0438\u0442\u0438 \u0440\u043e\u0437\u0434\u0456\u043b\u044c\u043d\u0443 \u0437\u0434\u0430\u0442\u043d\u0456\u0441\u0442\u044c, \u0437\u0443\u043f\u0438\u043d\u0456\u0442\u044c \u0437\u0430\u043f\u0443\u0449\u0435\u043d\u0456 \u043f\u0440\u043e\u0446\u0435\u0441\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e3y d\u1eebng c\u00e1c ti\u1ebfn tr\u00ecnh \u0111ang ch\u1ea1y \u0111\u1ec3 \u0111\u1ed5i \u0111\u1ed9 ph\u00e2n gi\u1ea3i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5148\u505c\u6b62\u6b63\u5728\u8fd0\u884c\u7684\u8fdb\u7a0b\uff0c\u7136\u540e\u518d\u66f4\u6539\u5206\u8fa8\u7387\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u5148\u505c\u6b62\u57f7\u884c\u4e2d\u7684\u7a0b\u5e8f\uff0c\u624d\u80fd\u66f4\u6539\u89e3\u6790\u5ea6\u3002"
          }
        }
      }
    },
