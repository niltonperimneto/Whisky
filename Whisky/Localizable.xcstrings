    "gptk.error.versionUnreadable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0639\u0630\u0651\u0631\u062a \u0642\u0631\u0627\u0621\u0629 \u0625\u0635\u062f\u0627\u0631 D3DMetal \u0645\u0646 \u0627\u0644\u062d\u0632\u0645\u0629."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzi D3DMetal se z bal\u00ed\u010dku nepoda\u0159ilo p\u0159e\u010d\u00edst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "D3DMetal-versionen kunne ikke l\u00e6ses fra payloaden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die D3DMetal-Version konnte nicht aus dem Payload gelesen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the D3DMetal version from the payload."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the D3DMetal version from the payload."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer la versi\u00f3n de D3DMetal del paquete."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "D3DMetal-versiota ei voitu lukea paketista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire la version de D3DMetal dans le contenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere la versione di D3DMetal dal pacchetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30da\u30a4\u30ed\u30fc\u30c9\u304b\u3089 D3DMetal \u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u3092\u8aad\u307f\u53d6\u308c\u307e\u305b\u3093\u3067\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud398\uc774\ub85c\ub4dc\uc5d0\uc11c D3DMetal \ubc84\uc804\uc744 \uc77d\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de D3DMetal-versie niet uit de payload lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie uda\u0142o si\u0119 odczyta\u0107 wersji D3DMetal z pakietu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o foi poss\u00edvel ler a vers\u00e3o do D3DMetal no pacote."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o foi poss\u00edvel ler a vers\u00e3o do D3DMetal a partir do pacote."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiunea D3DMetal nu a putut fi citit\u0103 din pachet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c \u0432\u0435\u0440\u0441\u0438\u044e D3DMetal \u0432 \u043f\u0430\u043a\u0435\u0442\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "D3DMetal-versionen kunde inte l\u00e4sas fr\u00e5n payloaden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paketten D3DMetal s\u00fcr\u00fcm\u00fc okunamad\u0131."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0432\u0438\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u0432\u0435\u0440\u0441\u0456\u044e D3DMetal \u0443 \u043f\u0430\u043a\u0435\u0442\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng \u0111\u1ecdc \u0111\u01b0\u1ee3c phi\u00ean b\u1ea3n D3DMetal t\u1eeb g\u00f3i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e0\u6cd5\u4ece\u8d1f\u8f7d\u4e2d\u8bfb\u53d6 D3DMetal \u7248\u672c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121\u6cd5\u5f9e\u916c\u8f09\u4e2d\u8b80\u53d6 D3DMetal \u7248\u672c\u3002"
          }
        }
      }
    },
