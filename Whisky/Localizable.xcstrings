    "This will remove all crash diagnosis records for this program.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0633\u064a\u0624\u062f\u064a \u0647\u0630\u0627 \u0625\u0644\u0649 \u062d\u0630\u0641 \u062c\u0645\u064a\u0639 \u0633\u062c\u0644\u0627\u062a \u062a\u0634\u062e\u064a\u0635 \u0627\u0644\u062a\u0639\u0637\u0644 \u0644\u0647\u0630\u0627 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u0161echny z\u00e1znamy o diagnostice p\u00e1d\u016f tohoto programu budou odstran\u011bny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle nedbrudsdiagnoser for dette program bliver fjernet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle Absturzdiagnosen f\u00fcr dieses Programm entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminar\u00e1n todos los registros de diagn\u00f3stico de fallos de este programa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00e4m\u00e4 poistaa kaikki t\u00e4m\u00e4n ohjelman kaatumisdiagnoosit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les diagnostics de plantage enregistr\u00e9s pour ce programme seront supprim\u00e9s."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno rimossi tutti i record di diagnosi degli arresti di questo programma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30d7\u30ed\u30b0\u30e9\u30e0\u306e\u30af\u30e9\u30c3\u30b7\u30e5\u8a3a\u65ad\u306e\u8a18\u9332\u304c\u3059\u3079\u3066\u524a\u9664\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ud504\ub85c\uadf8\ub7a8\uc758 \ud06c\ub798\uc2dc \uc9c4\ub2e8 \uae30\ub85d\uc774 \ubaa8\ub450 \uc0ad\uc81c\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden alle crashdiagnoses voor dit programma verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie zapisy diagnoz awarii tego programu zostan\u0105 usuni\u0119te."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os registros de diagn\u00f3stico de falhas deste programa ser\u00e3o removidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ser\u00e3o removidos todos os registos de diagn\u00f3stico de falhas deste programa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor fi eliminate toate \u00eenregistr\u0103rile de diagnoz\u0103 a crash-urilor pentru acest program."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0441\u0435 \u0437\u0430\u043f\u0438\u0441\u0438 \u043e \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0435 \u0441\u0431\u043e\u0435\u0432 \u0434\u043b\u044f \u044d\u0442\u043e\u0439 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b \u0431\u0443\u0434\u0443\u0442 \u0443\u0434\u0430\u043b\u0435\u043d\u044b."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla kraschdiagnoser f\u00f6r det h\u00e4r programmet tas bort."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu i\u015flem, bu programa ait t\u00fcm \u00e7\u00f6kme tan\u0131lama kay\u0131tlar\u0131n\u0131 siler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u043f\u0440\u043e \u0434\u0456\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0443 \u0437\u0431\u043e\u0457\u0432 \u0434\u043b\u044f \u0446\u0456\u0454\u0457 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u0431\u0443\u0434\u0435 \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao t\u00e1c n\u00e0y s\u1ebd x\u00f3a to\u00e0n b\u1ed9 b\u1ea3n ghi ch\u1ea9n \u0111o\u00e1n s\u1ef1 c\u1ed1 c\u1ee7a ch\u01b0\u01a1ng tr\u00ecnh n\u00e0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fd9\u5c06\u79fb\u9664\u6b64\u7a0b\u5e8f\u7684\u6240\u6709\u5d29\u6e83\u8bca\u65ad\u8bb0\u5f55\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9019\u6703\u79fb\u9664\u6b64\u7a0b\u5f0f\u7684\u6240\u6709\u7576\u6a5f\u8a3a\u65b7\u8a18\u9304\u3002"
          }
        }
      }
    },
