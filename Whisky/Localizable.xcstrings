    "settings.gptk.capability.blocked": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u064a\u0633\u062a\u0637\u064a\u0639 \u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u0645\u062d\u0631\u0643 \u0627\u0644\u0645\u062b\u0628\u062a \u062a\u0634\u063a\u064a\u0644 D3DMetal \u0628\u0639\u062f. \u062a\u064f\u062d\u0641\u0638 \u0627\u0644\u062d\u0632\u0645 \u0627\u0644\u0645\u0633\u062a\u0648\u0631\u062f\u0629 \u0648\u062a\u064f\u0646\u0634\u0631 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0628\u0645\u062c\u0631\u062f \u062a\u062b\u0628\u064a\u062a \u0645\u062d\u0631\u0643 \u064a\u062f\u0639\u0645 GPTK."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nainstalovan\u00e9 sestaven\u00ed prost\u0159ed\u00ed zat\u00edm neum\u00ed spustit D3DMetal. Importovan\u00e9 bal\u00ed\u010dky z\u016fstanou ulo\u017een\u00e9 a nasad\u00ed se automaticky, jakmile bude nainstalov\u00e1no prost\u0159ed\u00ed s podporou GPTK."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det installerede engine-build kan ikke k\u00f8re D3DMetal endnu. Importerede payloads bevares og installeres automatisk, n\u00e5r der er installeret en engine, der underst\u00f8tter GPTK."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der installierte Engine-Build kann D3DMetal noch nicht ausf\u00fchren. Importierte Payloads bleiben erhalten und werden automatisch bereitgestellt, sobald eine GPTK-f\u00e4hige Engine installiert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The installed engine build cannot run D3DMetal yet. Imported payloads are kept and deploy automatically once a GPTK-capable engine is installed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The installed engine build cannot run D3DMetal yet. Imported payloads are kept and deploy automatically once a GPTK-capable engine is installed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versi\u00f3n del motor instalada a\u00fan no puede ejecutar D3DMetal. Los paquetes importados se conservan y se despliegan autom\u00e1ticamente en cuanto se instale un motor compatible con GPTK."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asennettu moottoriversio ei viel\u00e4 pysty ajamaan D3DMetalia. Tuodut paketit s\u00e4ilytet\u00e4\u00e4n ja otetaan automaattisesti k\u00e4ytt\u00f6\u00f6n, kun GPTK-yhteensopiva moottori asennetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version du moteur install\u00e9e ne peut pas encore ex\u00e9cuter D3DMetal. Les contenus import\u00e9s sont conserv\u00e9s et se d\u00e9ploieront automatiquement d\u00e8s qu'un moteur compatible GPTK sera install\u00e9."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La build del motore installata non pu\u00f2 ancora eseguire D3DMetal. I pacchetti importati vengono conservati e distribuiti automaticamente non appena viene installato un motore compatibile con GPTK."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u6e08\u307f\u306e\u30a8\u30f3\u30b8\u30f3\u30d3\u30eb\u30c9\u3067\u306f\u307e\u3060 D3DMetal \u3092\u5b9f\u884c\u3067\u304d\u307e\u305b\u3093\u3002\u8aad\u307f\u8fbc\u3093\u3060\u30da\u30a4\u30ed\u30fc\u30c9\u306f\u4fdd\u6301\u3055\u308c\u3001GPTK \u306b\u5bfe\u5fdc\u3057\u305f\u30a8\u30f3\u30b8\u30f3\u304c\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3055\u308c\u308b\u3068\u81ea\u52d5\u7684\u306b\u914d\u7f6e\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc124\uce58\ub41c \uc5d4\uc9c4 \ube4c\ub4dc\ub294 \uc544\uc9c1 D3DMetal\uc744 \uc2e4\ud589\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uac00\uc838\uc628 \ud398\uc774\ub85c\ub4dc\ub294 \uc720\uc9c0\ub418\uba70, GPTK\ub97c \uc9c0\uc6d0\ud558\ub294 \uc5d4\uc9c4\uc774 \uc124\uce58\ub418\uba74 \uc790\ub3d9\uc73c\ub85c \ubc30\ud3ec\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ge\u00efnstalleerde engine-build kan D3DMetal nog niet draaien. Ge\u00efmporteerde payloads blijven bewaard en worden automatisch uitgerold zodra er een GPTK-geschikte engine is ge\u00efnstalleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstalowana wersja silnika nie obs\u0142uguje jeszcze D3DMetal. Zaimportowane pakiety s\u0105 zachowywane i wdro\u017c\u0105 si\u0119 automatycznie po zainstalowaniu silnika zgodnego z GPTK."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A vers\u00e3o do motor instalada ainda n\u00e3o roda o D3DMetal. Os pacotes importados s\u00e3o mantidos e implantados automaticamente assim que um motor compat\u00edvel com o GPTK for instalado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A vers\u00e3o do motor instalada ainda n\u00e3o consegue executar o D3DMetal. Os pacotes importados s\u00e3o mantidos e implementados automaticamente assim que for instalado um motor compat\u00edvel com o GPTK."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiunea de motor instalat\u0103 nu poate rula \u00eenc\u0103 D3DMetal. Pachetele importate sunt p\u0103strate \u0219i se instaleaz\u0103 automat imediat ce este instalat un motor compatibil cu GPTK."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u0430\u044f \u0441\u0431\u043e\u0440\u043a\u0430 \u0441\u0440\u0435\u0434\u044b \u043f\u043e\u043a\u0430 \u043d\u0435 \u043c\u043e\u0436\u0435\u0442 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0442\u044c D3DMetal. \u0418\u043c\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u043f\u0430\u043a\u0435\u0442\u044b \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u044e\u0442\u0441\u044f \u0438 \u0440\u0430\u0437\u0432\u0435\u0440\u043d\u0443\u0442\u0441\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438, \u043a\u043e\u0433\u0434\u0430 \u043f\u043e\u044f\u0432\u0438\u0442\u0441\u044f \u0441\u0440\u0435\u0434\u0430 \u0441 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u043e\u0439 GPTK."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det installerade motorbygget kan inte k\u00f6ra D3DMetal \u00e4nnu. Importerade payloads sparas och installeras automatiskt n\u00e4r en GPTK-kompatibel motor har installerats."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Y\u00fckl\u00fc motor s\u00fcr\u00fcm\u00fc hen\u00fcz D3DMetal'i \u00e7al\u0131\u015ft\u0131ram\u0131yor. \u0130\u00e7e aktar\u0131lan paketler saklan\u0131r ve GPTK uyumlu bir motor y\u00fcklendi\u011finde otomatik olarak da\u011f\u0131t\u0131l\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0430 \u0437\u0431\u0456\u0440\u043a\u0430 \u0440\u0443\u0448\u0456\u044f \u043f\u043e\u043a\u0438 \u043d\u0435 \u043c\u043e\u0436\u0435 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0442\u0438 D3DMetal. \u0406\u043c\u043f\u043e\u0440\u0442\u043e\u0432\u0430\u043d\u0456 \u043f\u0430\u043a\u0435\u0442\u0438 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u044e\u0442\u044c\u0441\u044f \u0439 \u0440\u043e\u0437\u0433\u043e\u0440\u043d\u0443\u0442\u044c\u0441\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e, \u043a\u043e\u043b\u0438 \u0437'\u044f\u0432\u0438\u0442\u044c\u0441\u044f \u0440\u0443\u0448\u0456\u0439 \u0456\u0437 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u043a\u043e\u044e GPTK."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u1ea3n d\u1ef1ng engine \u0111\u00e3 c\u00e0i ch\u01b0a ch\u1ea1y \u0111\u01b0\u1ee3c D3DMetal. C\u00e1c g\u00f3i \u0111\u00e3 nh\u1eadp v\u1eabn \u0111\u01b0\u1ee3c gi\u1eef v\u00e0 t\u1ef1 \u0111\u1ed9ng tri\u1ec3n khai khi c\u00e0i engine h\u1ed7 tr\u1ee3 GPTK."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u5b89\u88c5\u7684\u5f15\u64ce\u7248\u672c\u5c1a\u65e0\u6cd5\u8fd0\u884c D3DMetal\u3002\u5df2\u5bfc\u5165\u7684\u8d1f\u8f7d\u4f1a\u4fdd\u7559\uff0c\u5e76\u5728\u5b89\u88c5\u652f\u6301 GPTK \u7684\u5f15\u64ce\u540e\u81ea\u52a8\u90e8\u7f72\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u5b89\u88dd\u7684\u5f15\u64ce\u7248\u672c\u5c1a\u7121\u6cd5\u57f7\u884c D3DMetal\u3002\u5df2\u532f\u5165\u7684\u916c\u8f09\u6703\u4fdd\u7559\uff0c\u4e26\u5728\u5b89\u88dd\u652f\u63f4 GPTK \u7684\u5f15\u64ce\u5f8c\u81ea\u52d5\u90e8\u7f72\u3002"
          }
        }
      }
    },
    "settings.gptk.capability.ok": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0633\u062a\u0637\u064a\u0639 \u0627\u0644\u0645\u062d\u0631\u0643 \u0627\u0644\u0645\u062b\u0628\u062a \u062a\u0634\u063a\u064a\u0644 D3DMetal. \u062a\u064f\u0646\u0634\u0631 \u0627\u0644\u062d\u0632\u0645 \u0627\u0644\u0645\u0633\u062a\u0648\u0631\u062f\u0629 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nainstalovan\u00e9 prost\u0159ed\u00ed um\u00ed spustit D3DMetal. Importovan\u00e9 bal\u00ed\u010dky se nasad\u00ed automaticky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den installerede engine kan k\u00f8re D3DMetal. Importerede payloads installeres automatisk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die installierte Engine kann D3DMetal ausf\u00fchren. Importierte Payloads werden automatisch bereitgestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The installed engine can run D3DMetal. Imported payloads deploy automatically."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The installed engine can run D3DMetal. Imported payloads deploy automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor instalado puede ejecutar D3DMetal. Los paquetes importados se despliegan autom\u00e1ticamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asennettu moottori pystyy ajamaan D3DMetalia. Tuodut paketit otetaan k\u00e4ytt\u00f6\u00f6n automaattisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur install\u00e9 peut ex\u00e9cuter D3DMetal. Les contenus import\u00e9s se d\u00e9ploient automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore installato pu\u00f2 eseguire D3DMetal. I pacchetti importati vengono distribuiti automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u6e08\u307f\u306e\u30a8\u30f3\u30b8\u30f3\u3067 D3DMetal \u3092\u5b9f\u884c\u3067\u304d\u307e\u3059\u3002\u8aad\u307f\u8fbc\u3093\u3060\u30da\u30a4\u30ed\u30fc\u30c9\u306f\u81ea\u52d5\u7684\u306b\u914d\u7f6e\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc124\uce58\ub41c \uc5d4\uc9c4\uc5d0\uc11c D3DMetal\uc744 \uc2e4\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac00\uc838\uc628 \ud398\uc774\ub85c\ub4dc\uac00 \uc790\ub3d9\uc73c\ub85c \ubc30\ud3ec\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ge\u00efnstalleerde engine kan D3DMetal draaien. Ge\u00efmporteerde payloads worden automatisch uitgerold."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstalowany silnik obs\u0142uguje D3DMetal. Zaimportowane pakiety wdra\u017caj\u0105 si\u0119 automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O motor instalado roda o D3DMetal. Os pacotes importados s\u00e3o implantados automaticamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O motor instalado consegue executar o D3DMetal. Os pacotes importados s\u00e3o implementados automaticamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Motorul instalat poate rula D3DMetal. Pachetele importate se instaleaz\u0103 automat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u0430\u044f \u0441\u0440\u0435\u0434\u0430 \u043c\u043e\u0436\u0435\u0442 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0442\u044c D3DMetal. \u0418\u043c\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u043f\u0430\u043a\u0435\u0442\u044b \u0440\u0430\u0437\u0432\u0451\u0440\u0442\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den installerade motorn kan k\u00f6ra D3DMetal. Importerade payloads installeras automatiskt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Y\u00fckl\u00fc motor D3DMetal'i \u00e7al\u0131\u015ft\u0131rabilir. \u0130\u00e7e aktar\u0131lan paketler otomatik olarak da\u011f\u0131t\u0131l\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0439 \u0440\u0443\u0448\u0456\u0439 \u043c\u043e\u0436\u0435 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0442\u0438 D3DMetal. \u0406\u043c\u043f\u043e\u0440\u0442\u043e\u0432\u0430\u043d\u0456 \u043f\u0430\u043a\u0435\u0442\u0438 \u0440\u043e\u0437\u0433\u043e\u0440\u0442\u0430\u044e\u0442\u044c\u0441\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Engine \u0111\u00e3 c\u00e0i c\u00f3 th\u1ec3 ch\u1ea1y D3DMetal. C\u00e1c g\u00f3i \u0111\u00e3 nh\u1eadp s\u1ebd t\u1ef1 \u0111\u1ed9ng tri\u1ec3n khai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u5b89\u88c5\u7684\u5f15\u64ce\u53ef\u4ee5\u8fd0\u884c D3DMetal\u3002\u5df2\u5bfc\u5165\u7684\u8d1f\u8f7d\u4f1a\u81ea\u52a8\u90e8\u7f72\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u5b89\u88dd\u7684\u5f15\u64ce\u53ef\u4ee5\u57f7\u884c D3DMetal\u3002\u5df2\u532f\u5165\u7684\u916c\u8f09\u6703\u81ea\u52d5\u90e8\u7f72\u3002"
          }
        }
      }
    },
    "settings.gptk.import": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0645\u0646 Game Porting Toolkit\u2026"
          }
        },
        "cs": {
