    "config.retinaMode.unknownHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00ab\u063a\u064a\u0631 \u0645\u0639\u0631\u0648\u0641\u00bb \u064a\u0639\u0646\u064a \u0627\u0644\u0648\u0631\u0627\u062b\u0629 \u0645\u0646 \u0628\u0627\u062f\u0626\u0629 Wine."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201eNezn\u00e1m\u00e9\u201c znamen\u00e1 p\u0159evzet\u00ed z prefixu Wine."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukendt betyder, at indstillingen arves fra Wine-pr\u00e6fikset."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201eUnbekannt\u201c bedeutet: vom Wine-Pr\u00e4fix \u00fcbernehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown means inherit from the Wine prefix."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown means inherit from the Wine prefix."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconocido significa heredar del prefijo de Wine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuntematon tarkoittaa, ett\u00e4 asetus perit\u00e4\u00e4n Wine-etuliitteest\u00e4."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inconnu signifie h\u00e9riter du pr\u00e9fixe Wine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sconosciuto significa ereditare dal prefisso Wine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c\u4e0d\u660e\u300d\u306f Wine \u30d7\u30ec\u30d5\u30a3\u30c3\u30af\u30b9\u306e\u8a2d\u5b9a\u3092\u5f15\u304d\u7d99\u3050\u3068\u3044\u3046\u610f\u5473\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\u2018\uc54c \uc218 \uc5c6\uc74c\u2019\uc740 Wine \ud504\ub9ac\ud53d\uc2a4 \uc124\uc815\uc744 \ub530\ub978\ub2e4\ub294 \ub73b\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'Onbekend' betekent: overnemen van de Wine-prefix."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201eNieznany\u201d oznacza dziedziczenie z prefiksu Wine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconhecido significa herdar do prefixo do Wine."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconhecido significa herdar do prefixo do Wine."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Necunoscut \u00eenseamn\u0103 mo\u0219tenire din prefixul Wine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00ab\u041d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u00bb \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442 \u043d\u0430\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0438\u0437 \u043f\u0440\u0435\u0444\u0438\u043a\u0441\u0430 Wine."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ok\u00e4nt betyder att inst\u00e4llningen \u00e4rvs fr\u00e5n Wine-prefixet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilinmiyor, ayar\u0131n Wine \u00f6n ekinden devral\u0131naca\u011f\u0131 anlam\u0131na gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00ab\u041d\u0435\u0432\u0456\u0434\u043e\u043c\u043e\u00bb \u043e\u0437\u043d\u0430\u0447\u0430\u0454 \u0443\u0441\u043f\u0430\u0434\u043a\u0443\u0432\u0430\u043d\u043d\u044f \u0437 \u043f\u0440\u0435\u0444\u0456\u043a\u0441\u0430 Wine."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng r\u00f5 ngh\u0129a l\u00e0 k\u1ebf th\u1eeba t\u1eeb prefix Wine."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201c\u672a\u77e5\u201d\u8868\u793a\u6cbf\u7528 Wine \u524d\u7f00\u4e2d\u7684\u8bbe\u7f6e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c\u672a\u77e5\u300d\u8868\u793a\u6cbf\u7528 Wine \u524d\u7db4\u4e2d\u7684\u8a2d\u5b9a\u3002"
          }
        }
      }
    },
