    "config.graphics.nextLaunchInfo": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0633\u0631\u064a \u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0627\u0644\u0631\u0633\u0648\u0645\u064a\u0627\u062a \u0639\u0646\u062f \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u062a\u0627\u0644\u064a."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zm\u011bny grafiky se projev\u00ed p\u0159i p\u0159\u00ed\u0161t\u00edm spu\u0161t\u011bn\u00ed."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Grafik\u00e6ndringer tr\u00e6der i kraft ved n\u00e6ste start."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grafik\u00e4nderungen werden beim n\u00e4chsten Start wirksam."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Graphics changes take effect on next launch."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Graphics changes take effect on next launch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios gr\u00e1ficos se aplican en el pr\u00f3ximo inicio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Grafiikkamuutokset tulevat voimaan seuraavalla k\u00e4ynnistyskerralla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications graphiques prennent effet au prochain lancement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche grafiche hanno effetto al prossimo avvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u30b9\u306e\u5909\u66f4\u306f\u6b21\u56de\u306e\u8d77\u52d5\u6642\u306b\u53cd\u6620\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uadf8\ub798\ud53d \ubcc0\uacbd \uc0ac\ud56d\uc740 \ub2e4\uc74c \uc2e4\ud589 \uc2dc \uc801\uc6a9\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grafische wijzigingen worden bij de volgende start actief."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany grafiki zadzia\u0142aj\u0105 przy nast\u0119pnym uruchomieniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As altera\u00e7\u00f5es gr\u00e1ficas entram em vigor na pr\u00f3xima abertura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As altera\u00e7\u00f5es gr\u00e1ficas t\u00eam efeito no pr\u00f3ximo arranque."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modific\u0103rile grafice au efect la urm\u0103toarea lansare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0433\u0440\u0430\u0444\u0438\u043a\u0438 \u0432\u0441\u0442\u0443\u043f\u044f\u0442 \u0432 \u0441\u0438\u043b\u0443 \u043f\u0440\u0438 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u043c \u0437\u0430\u043f\u0443\u0441\u043a\u0435."
