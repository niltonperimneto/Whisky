    "launcher.diagnostics.export.error.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062d\u062f\u062b \u062e\u0637\u0623 \u0623\u062b\u0646\u0627\u0621 \u062d\u0641\u0638 \u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u062a\u0634\u062e\u064a\u0635:\n\n%@\n\n\u064a\u064f\u0631\u062c\u0649 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0623\u0648 \u0627\u062e\u062a\u064a\u0627\u0631 \u0645\u0648\u0642\u0639 \u0622\u062e\u0631."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "P\u0159i ukl\u00e1d\u00e1n\u00ed diagnostick\u00e9 zpr\u00e1vy do\u0161lo k chyb\u011b:\n\n%@\n\nZkuste to znovu nebo vyberte jin\u00e9 um\u00edst\u011bn\u00ed."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der opstod en fejl, da diagnostikrapporten skulle arkiveres:\n\n%@\n\nPr\u00f8v igen, eller v\u00e6lg en anden placering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Sichern des Diagnoseberichts ist ein Fehler aufgetreten:\n\n%@\n\nVersuche es erneut oder w\u00e4hle einen anderen Ort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An error occurred while saving the diagnostics report:\n\n%@\n\nPlease try again or choose a different location."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "An error occurred while saving the diagnostics report:\n\n%@\n\nPlease try again or choose a different location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha producido un error al guardar el informe de diagn\u00f3stico:\n\n%@\n\nInt\u00e9ntalo de nuevo o elige otra ubicaci\u00f3n."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vianm\u00e4\u00e4ritysraportin tallentamisessa tapahtui virhe:\n\n%@\n\nYrit\u00e4 uudelleen tai valitse toinen sijainti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur s'est produite lors de l'enregistrement du rapport de diagnostic :\n\n%@\n\nR\u00e9essayez ou choisissez un autre emplacement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si \u00e8 verificato un errore durante il salvataggio del report diagnostico:\n\n%@\n\nRiprova o scegli un'altra posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a3a\u65ad\u30ec\u30dd\u30fc\u30c8\u306e\u4fdd\u5b58\u4e2d\u306b\u30a8\u30e9\u30fc\u304c\u767a\u751f\u3057\u307e\u3057\u305f:\n\n%@\n\n\u3082\u3046\u4e00\u5ea6\u8a66\u3059\u304b\u3001\u5225\u306e\u4fdd\u5b58\u5834\u6240\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc9c4\ub2e8 \ubcf4\uace0\uc11c\ub97c \uc800\uc7a5\ud558\ub294 \uc911 \uc624\ub958\uac00 \ubc1c\uc0dd\ud588\uc2b5\ub2c8\ub2e4:\n\n%@\n\n\ub2e4\uc2dc \uc2dc\ub3c4\ud558\uac70\ub098 \ub2e4\ub978 \uc704\uce58\ub97c \uc120\ud0dd\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een fout opgetreden bij het bewaren van het diagnoserapport:\n\n%@\n\nProbeer het opnieuw of kies een andere locatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas zapisywania raportu diagnostycznego wyst\u0105pi\u0142 b\u0142\u0105d:\n\n%@\n\nSpr\u00f3buj ponownie lub wybierz inn\u0105 lokalizacj\u0119."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorreu um erro ao salvar o relat\u00f3rio de diagn\u00f3stico:\n\n%@\n\nTente novamente ou escolha outro local."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorreu um erro ao guardar o relat\u00f3rio de diagn\u00f3stico:\n\n%@\n\nTente novamente ou escolha outra localiza\u00e7\u00e3o."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "A ap\u0103rut o eroare la salvarea raportului de diagnostic:\n\n%@\n\n\u00cencearc\u0103 din nou sau alege alt\u0103 loca\u021bie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0438 \u043e\u0442\u0447\u0451\u0442\u0430 \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u0430 \u043e\u0448\u0438\u0431\u043a\u0430:\n\n%@\n\n\u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0451 \u0440\u0430\u0437 \u0438\u043b\u0438 \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0434\u0440\u0443\u0433\u043e\u0435 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett fel uppstod n\u00e4r diagnostikrapporten skulle sparas:\n\n%@\n\nF\u00f6rs\u00f6k igen eller v\u00e4lj en annan plats."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tan\u0131lama raporu kaydedilirken bir hata olu\u015ftu:\n\n%@\n\nL\u00fctfen yeniden deneyin veya farkl\u0131 bir konum se\u00e7in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0456\u0434 \u0447\u0430\u0441 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f \u0437\u0432\u0456\u0442\u0443 \u0434\u0456\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u043f\u043e\u043c\u0438\u043b\u043a\u0430:\n\n%@\n\n\u0421\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0449\u0435 \u0440\u0430\u0437 \u0430\u0431\u043e \u0432\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0456\u043d\u0448\u0435 \u0440\u043e\u0437\u0442\u0430\u0448\u0443\u0432\u0430\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 x\u1ea3y ra l\u1ed7i khi l\u01b0u b\u00e1o c\u00e1o ch\u1ea9n \u0111o\u00e1n:\n\n%@\n\nH\u00e3y th\u1eed l\u1ea1i ho\u1eb7c ch\u1ecdn v\u1ecb tr\u00ed kh\u00e1c."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b58\u50a8\u8bca\u65ad\u62a5\u544a\u65f6\u51fa\u9519\uff1a\n\n%@\n\n\u8bf7\u91cd\u8bd5\u6216\u9009\u62e9\u5176\u4ed6\u4f4d\u7f6e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5132\u5b58\u8a3a\u65b7\u5831\u544a\u6642\u767c\u751f\u932f\u8aa4\uff1a\n\n%@\n\n\u8acb\u91cd\u8a66\u6216\u9078\u64c7\u5176\u4ed6\u4f4d\u7f6e\u3002"
          }
        }
      }
    },
