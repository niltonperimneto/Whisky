    "troubleshooting.verify.attempt %d %d": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u062d\u0627\u0648\u0644\u0629 \u0627\u0644\u0625\u0635\u0644\u0627\u062d %1$d \u0645\u0646 %2$d"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokus o opravu %1$d z %2$d"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00f8sningsfors\u00f8g %1$d af %2$d"
          }
