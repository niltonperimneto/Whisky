    "config.retinaMode.info": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0639\u0631\u0636 \u0628\u062f\u0642\u0629 Retina \u0627\u0644\u0643\u0627\u0645\u0644\u0629 \u0644\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0635\u0648\u0631\u0629 \u0623\u0648\u0636\u062d. \u0639\u0637\u0651\u0644\u0647 \u0625\u0630\u0627 \u0628\u062f\u062a \u0627\u0644\u0644\u0639\u0628\u0629 \u0635\u063a\u064a\u0631\u0629 \u062c\u062f\u064b\u0627 \u0623\u0648 \u0643\u0627\u0646\u062a \u0628\u0637\u064a\u0626\u0629."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vykresluje v pln\u00e9m rozli\u0161en\u00ed Retina pro ost\u0159ej\u0161\u00ed obraz. Vypn\u011bte, pokud hra vypad\u00e1 drobn\u011b nebo b\u011b\u017e\u00ed pomalu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderer i fuld Retina-opl\u00f8sning for et skarpere billede. Sl\u00e5 fra, hvis et spil ser bittesm\u00e5t ud eller k\u00f8rer langsomt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendert in voller Retina-Aufl\u00f6sung f\u00fcr ein sch\u00e4rferes Bild. Deaktivieren, wenn Spiele winzig wirken oder langsam laufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Render at full Retina resolution for sharper output. Disable if a game looks tiny or runs slowly."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Render at full Retina resolution for sharper output. Disable if a game looks tiny or runs slowly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderiza a resoluci\u00f3n Retina completa para una imagen m\u00e1s n\u00edtida. Desact\u00edvalo si un juego se ve diminuto o va lento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piirt\u00e4\u00e4 t\u00e4ydell\u00e4 Retina-tarkkuudella ter\u00e4v\u00e4mp\u00e4\u00e4 kuvaa. Poista k\u00e4yt\u00f6st\u00e4, jos peli n\u00e4ytt\u00e4\u00e4 pienelt\u00e4 tai on hidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche en pleine r\u00e9solution Retina pour une image plus nette. D\u00e9sactivez si un jeu para\u00eet minuscule ou devient lent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendering a risoluzione Retina completa per immagini pi\u00f9 nitide. Disattivalo se il gioco appare minuscolo o \u00e8 lento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Retina \u306e\u89e3\u50cf\u5ea6\u306e\u307e\u307e\u63cf\u753b\u3057\u3001\u3088\u308a\u9bae\u660e\u306b\u8868\u793a\u3057\u307e\u3059\u3002\u30b2\u30fc\u30e0\u304c\u5c0f\u3055\u304f\u8868\u793a\u3055\u308c\u305f\u308a\u52d5\u4f5c\u304c\u91cd\u3044\u5834\u5408\u306f\u30aa\u30d5\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Retina \ud574\uc0c1\ub3c4 \uadf8\ub300\ub85c \ub80c\ub354\ub9c1\ud574 \ub354 \uc120\uba85\ud558\uac8c \ud45c\uc2dc\ud569\ub2c8\ub2e4. \uac8c\uc784\uc774 \ub108\ubb34 \uc791\uac8c \ubcf4\uc774\uac70\ub098 \ub290\ub9ac\uba74 \ub044\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendert op volle Retina-resolutie voor een scherper beeld. Schakel dit uit als een game klein oogt of traag draait."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderuje w pe\u0142nej rozdzielczo\u015bci Retina dla ostrzejszego obrazu. Wy\u0142\u0105cz, je\u015bli gra jest male\u0144ka lub dzia\u0142a wolno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderiza na resolu\u00e7\u00e3o Retina completa para uma imagem mais n\u00edtida. Desative se um jogo ficar min\u00fasculo ou lento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderiza na resolu\u00e7\u00e3o Retina completa para uma imagem mais n\u00edtida. Desative se um jogo ficar min\u00fasculo ou lento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Randeaz\u0103 la rezolu\u021bie Retina complet\u0103, pentru imagine mai clar\u0103. Dezactiveaz\u0103 dac\u0103 jocul apare minuscul sau merge greu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0435\u043d\u0434\u0435\u0440\u0438\u043d\u0433 \u0432 \u043f\u043e\u043b\u043d\u043e\u043c \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0438 Retina \u0434\u043b\u044f \u0447\u0451\u0442\u043a\u043e\u0439 \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0438. \u041e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u0435, \u0435\u0441\u043b\u0438 \u0438\u0433\u0440\u0430 \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u043a\u0440\u043e\u0448\u0435\u0447\u043d\u043e\u0439 \u0438\u043b\u0438 \u0442\u043e\u0440\u043c\u043e\u0437\u0438\u0442."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderar i full Retina-uppl\u00f6sning f\u00f6r skarpare bild. St\u00e4ng av om ett spel ser pyttelitet ut eller g\u00e5r l\u00e5ngsamt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha net g\u00f6r\u00fcnt\u00fc i\u00e7in tam Retina \u00e7\u00f6z\u00fcn\u00fcrl\u00fc\u011f\u00fcnde i\u015fler. Oyun \u00e7ok k\u00fc\u00e7\u00fck g\u00f6r\u00fcn\u00fcyorsa veya yava\u015f \u00e7al\u0131\u015f\u0131yorsa kapat\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0435\u043d\u0434\u0435\u0440\u0438\u043d\u0433 \u0456\u0437 \u043f\u043e\u0432\u043d\u043e\u044e \u0440\u043e\u0437\u0434\u0456\u043b\u044c\u043d\u043e\u044e \u0437\u0434\u0430\u0442\u043d\u0456\u0441\u0442\u044e Retina \u0434\u043b\u044f \u0447\u0456\u0442\u043a\u0456\u0448\u043e\u0457 \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0438. \u0412\u0438\u043c\u043a\u043d\u0456\u0442\u044c, \u044f\u043a\u0449\u043e \u0433\u0440\u0430 \u0434\u0440\u0456\u0431\u043d\u0430 \u0430\u0431\u043e \u0433\u0430\u043b\u044c\u043c\u0443\u0454."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u1ebft xu\u1ea5t \u1edf \u0111\u1ed9 ph\u00e2n gi\u1ea3i Retina \u0111\u1ea7y \u0111\u1ee7 \u0111\u1ec3 h\u00ecnh \u1ea3nh s\u1eafc n\u00e9t h\u01a1n. T\u1eaft n\u1ebfu game tr\u00f4ng qu\u00e1 nh\u1ecf ho\u1eb7c ch\u1ea1y ch\u1eadm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ee5\u5b8c\u6574 Retina \u5206\u8fa8\u7387\u6e32\u67d3\uff0c\u753b\u9762\u66f4\u6e05\u6670\u3002\u5982\u679c\u6e38\u620f\u663e\u793a\u8fc7\u5c0f\u6216\u8fd0\u884c\u7f13\u6162\uff0c\u8bf7\u5173\u95ed\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ee5\u5b8c\u6574 Retina \u89e3\u6790\u5ea6\u7b97\u7e6a\uff0c\u756b\u9762\u66f4\u6e05\u6670\u3002\u5982\u679c\u904a\u6232\u986f\u793a\u904e\u5c0f\u6216\u57f7\u884c\u7de9\u6162\uff0c\u8acb\u95dc\u9589\u3002"
          }
        }
      }
    },
