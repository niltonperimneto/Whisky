    "config.graphics.advancedActive": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u062a\u062c\u0627\u0648\u0632\u0627\u062a \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629 \u0646\u0634\u0637\u0629. \u064a\u0638\u0644 \u0627\u0644\u0645\u062d\u062f\u062f \u0627\u0644\u0628\u0633\u064a\u0637 \u0645\u062e\u0641\u064a\u064b\u0627 \u062d\u062a\u0649 \u064a\u062a\u0645 \u0645\u0633\u062d\u0647\u0627."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jsou aktivn\u00ed pokro\u010dil\u00e9 p\u0159episy. Jednoduch\u00fd v\u00fdb\u011br je skryt\u00fd, dokud je nezru\u0161\u00edte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Avancerede tilsides\u00e6ttelser er aktive. Den enkle v\u00e6lger er skjult, indtil de fjernes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erweiterte \u00dcberschreibungen sind aktiv. Die einfache Auswahl wird erst wieder angezeigt, wenn sie entfernt wurden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advanced overrides are active. The simple picker is hidden until they are cleared."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Advanced overrides are active. The simple picker is hidden until they are cleared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay anulaciones avanzadas activas. El selector simple permanece oculto hasta que se borren."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lis\u00e4asetusten ohitukset ovat k\u00e4yt\u00f6ss\u00e4. Perusvalitsin on piilotettu, kunnes ne tyhjennet\u00e4\u00e4n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des r\u00e9glages avanc\u00e9s sont actifs. Le s\u00e9lecteur simple reste masqu\u00e9 tant qu'ils ne sont pas effac\u00e9s."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono attivi override avanzati. Il selettore semplice resta nascosto finch\u00e9 non vengono rimossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a73\u7d30\u306a\u4e0a\u66f8\u304d\u304c\u6709\u52b9\u3067\u3059\u3002\u3053\u308c\u3089\u3092\u89e3\u9664\u3059\u308b\u307e\u3067\u3001\u30b7\u30f3\u30d7\u30eb\u306a\u9078\u629e\u80a2\u306f\u8868\u793a\u3055\u308c\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uace0\uae09 \uc7ac\uc815\uc758\uac00 \uc801\uc6a9\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub97c \ud574\uc81c\ud560 \ub54c\uae4c\uc9c0 \uac04\ub2e8 \uc120\ud0dd\uae30\ub294 \ud45c\uc2dc\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geavanceerde overrides zijn actief. De eenvoudige keuzelijst blijft verborgen totdat ze zijn gewist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywne s\u0105 zaawansowane zast\u0105pienia. Prosty wyb\u00f3r jest ukryty, dop\u00f3ki ich nie wyczy\u015bcisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e1 substitui\u00e7\u00f5es avan\u00e7adas ativas. O seletor simples fica oculto at\u00e9 que sejam removidas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e1 substitui\u00e7\u00f5es avan\u00e7adas ativas. O seletor simples fica oculto at\u00e9 serem removidas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunt active suprascrieri avansate. Selectorul simplu r\u0103m\u00e2ne ascuns p\u00e2n\u0103 c\u00e2nd sunt eliminate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u0435\u0439\u0441\u0442\u0432\u0443\u044e\u0442 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u043d\u044b\u0435 \u0437\u0430\u043c\u0435\u043d\u044b. \u041f\u0440\u043e\u0441\u0442\u043e\u0439 \u0432\u044b\u0431\u043e\u0440 \u0441\u043a\u0440\u044b\u0442, \u043f\u043e\u043a\u0430 \u043e\u043d\u0438 \u043d\u0435 \u0441\u0431\u0440\u043e\u0448\u0435\u043d\u044b."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avancerade \u00e5sidos\u00e4ttningar \u00e4r aktiva. Den enkla v\u00e4ljaren visas igen n\u00e4r de har tagits bort."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geli\u015fmi\u015f ge\u00e7ersiz k\u0131lmalar etkin. Bunlar temizlenene kadar basit se\u00e7ici gizlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u0456\u044e\u0442\u044c \u0440\u043e\u0437\u0448\u0438\u0440\u0435\u043d\u0456 \u043f\u0435\u0440\u0435\u0432\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f. \u041f\u0440\u043e\u0441\u0442\u0438\u0439 \u0432\u0438\u0431\u0456\u0440 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u043e, \u0434\u043e\u043a\u0438 \u0457\u0445 \u043d\u0435 \u0441\u043a\u0438\u043d\u0443\u0442\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi \u0111\u00e8 n\u00e2ng cao \u0111ang b\u1eadt. B\u1ed9 ch\u1ecdn \u0111\u01a1n gi\u1ea3n s\u1ebd \u1ea9n cho \u0111\u1ebfn khi x\u00f3a c\u00e1c ghi \u0111\u00e8 n\u00e0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u542f\u7528\u9ad8\u7ea7\u8986\u76d6\u3002\u5728\u6e05\u9664\u8fd9\u4e9b\u8bbe\u7f6e\u4e4b\u524d\uff0c\u7b80\u5355\u9009\u62e9\u5668\u4e0d\u4f1a\u663e\u793a\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u555f\u7528\u9032\u968e\u8986\u5beb\u3002\u5728\u6e05\u9664\u9019\u4e9b\u8a2d\u5b9a\u4e4b\u524d\uff0c\u7c21\u6613\u9078\u64c7\u5668\u4e0d\u6703\u986f\u793a\u3002"
          }
        }
      }
    },
