        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u89e3\u50cf\u5ea6\u306f\u6b21\u56de\u306e\u8d77\u52d5\u6642\u306b\u53cd\u6620\u3055\u308c\u307e\u3059\u3002"
