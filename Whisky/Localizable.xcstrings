    "config.buildVersion.info": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0631\u0642\u0645 \u0628\u0646\u064a\u0629 Windows \u0627\u0644\u0630\u064a \u064a\u0628\u0644\u0651\u063a \u0639\u0646\u0647 Wine. \u0627\u062a\u0631\u0643\u0647 \u0628\u062f\u0648\u0646 \u062a\u0639\u064a\u064a\u0646 \u0645\u0627 \u0644\u0645 \u064a\u062a\u0637\u0644\u0628 \u0628\u0631\u0646\u0627\u0645\u062c \u0628\u0646\u064a\u0629 \u0645\u0639\u064a\u0646\u0629."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "\u010c\u00edslo sestaven\u00ed Windows, kter\u00e9 Wine hl\u00e1s\u00ed. Nenastavujte, pokud program nevy\u017eaduje konkr\u00e9tn\u00ed sestaven\u00ed."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det Windows-buildnummer, som Wine oplyser. Lad det v\u00e6re tomt, medmindre et program kr\u00e6ver et bestemt build."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Windows-Build-Nummer, die Wine meldet. Nur festlegen, wenn ein Programm einen bestimmten Build ben\u00f6tigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Windows build number Wine reports. Leave unset unless a program needs a specific build."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The Windows build number Wine reports. Leave unset unless a program needs a specific build."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El n\u00famero de compilaci\u00f3n de Windows que informa Wine. D\u00e9jalo sin definir salvo que un programa necesite uno concreto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows-koontiversion numero, jonka Wine ilmoittaa. J\u00e4t\u00e4 asettamatta, ellei ohjelma vaadi tietty\u00e4 koontiversiota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le num\u00e9ro de build Windows signal\u00e9 par Wine. \u00c0 laisser vide sauf si un programme exige un build pr\u00e9cis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il numero di build di Windows dichiarato da Wine. Lascialo vuoto se nessun programma richiede una build specifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \u304c\u5831\u544a\u3059\u308b Windows \u306e\u30d3\u30eb\u30c9\u756a\u53f7\u3067\u3059\u3002\u7279\u5b9a\u306e\u30d3\u30eb\u30c9\u3092\u5fc5\u8981\u3068\u3059\u308b\u30d7\u30ed\u30b0\u30e9\u30e0\u304c\u306a\u3051\u308c\u3070\u3001\u672a\u8a2d\u5b9a\u306e\u307e\u307e\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine\uc774 \ubcf4\uace0\ud558\ub294 Windows \ube4c\ub4dc \ubc88\ud638\uc785\ub2c8\ub2e4. \ud2b9\uc815 \ube4c\ub4dc\uac00 \ud544\uc694\ud55c \ud504\ub85c\uadf8\ub7a8\uc774 \uc5c6\ub2e4\uba74 \uc124\uc815\ud558\uc9c0 \ub9c8\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het Windows-buildnummer dat Wine meldt. Laat dit leeg, tenzij een programma een specifieke build nodig heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Numer kompilacji Windows zg\u0142aszany przez Wine. Zostaw pusty, chyba \u017ce program wymaga konkretnej kompilacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O n\u00famero de compila\u00e7\u00e3o do Windows que o Wine informa. Deixe sem definir a menos que um programa exija um espec\u00edfico."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O n\u00famero de compila\u00e7\u00e3o do Windows que o Wine comunica. Deixe sem definir a menos que um programa exija uma espec\u00edfica."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Num\u0103rul de build Windows raportat de Wine. Las\u0103 nesetat, cu excep\u021bia cazului \u00een care un program cere un build anume."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u043e\u043c\u0435\u0440 \u0441\u0431\u043e\u0440\u043a\u0438 Windows, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043e\u043e\u0431\u0449\u0430\u0435\u0442 Wine. \u041d\u0435 \u0437\u0430\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0435\u0433\u043e, \u0435\u0441\u043b\u0438 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0435 \u043d\u0435 \u043d\u0443\u0436\u043d\u0430 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u0430\u044f \u0441\u0431\u043e\u0440\u043a\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det Windows-buildnummer som Wine rapporterar. L\u00e4mna tomt om inte ett program kr\u00e4ver ett visst build."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine'\u0131n bildirdi\u011fi Windows derleme numaras\u0131. Bir program belirli bir derleme gerektirmedik\u00e7e bo\u015f b\u0131rak\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u043e\u043c\u0435\u0440 \u0437\u0431\u0456\u0440\u043a\u0438 Windows, \u044f\u043a\u0438\u0439 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u044f\u0454 Wine. \u041d\u0435 \u0437\u0430\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0439\u043e\u0433\u043e, \u044f\u043a\u0449\u043e \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0456 \u043d\u0435 \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u0430 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u0430 \u0437\u0431\u0456\u0440\u043a\u0430."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u1ed1 b\u1ea3n d\u1ef1ng Windows m\u00e0 Wine b\u00e1o c\u00e1o. \u0110\u1ec3 tr\u1ed1ng tr\u1eeb khi ch\u01b0\u01a1ng tr\u00ecnh c\u1ea7n m\u1ed9t b\u1ea3n d\u1ef1ng c\u1ee5 th\u1ec3."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \u62a5\u544a\u7684 Windows \u7248\u672c\u53f7\u3002\u9664\u975e\u67d0\u4e2a\u7a0b\u5e8f\u9700\u8981\u7279\u5b9a\u7248\u672c\u53f7\uff0c\u5426\u5219\u8bf7\u4fdd\u6301\u672a\u8bbe\u5b9a\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \u56de\u5831\u7684 Windows \u7248\u672c\u865f\u3002\u9664\u975e\u6709\u7a0b\u5f0f\u9700\u8981\u7279\u5b9a\u7248\u672c\u865f\uff0c\u5426\u5247\u8acb\u4fdd\u6301\u672a\u8a2d\u5b9a\u3002"
          }
        }
      }
    },
