    "troubleshooting.symptom.launchCrash": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u062a\u0639\u0645\u0644 \u0623\u0648 \u062a\u062a\u0639\u0637\u0644 \u0641\u0648\u0631\u064b\u0627"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nespust\u00ed se / hned spadne"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Starter ikke / g\u00e5r ned med det samme"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet nicht / st\u00fcrzt sofort ab"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Won't launch / crashes immediately"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Won't launch / crashes immediately"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se abre o se cierra al instante"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei k\u00e4ynnisty / kaatuu heti"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne se lance pas ou plante aussit\u00f4t"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non si avvia o si chiude subito"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8d77\u52d5\u3057\u306a\u3044\u3001\u3059\u3050\u306b\u30af\u30e9\u30c3\u30b7\u30e5\u3059\u308b"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2e4\ud589\ub418\uc9c0 \uc54a\uac70\ub098 \ubc14\ub85c \uc885\ub8cc\ub428"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start niet / crasht direct"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie uruchamia si\u0119 / od razu si\u0119 zamyka"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o abre ou fecha na hora"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o abre ou fecha de imediato"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu porne\u0219te sau se \u00eenchide imediat"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0435\u0442\u0441\u044f \u0438\u043b\u0438 \u0441\u0440\u0430\u0437\u0443 \u0432\u044b\u043b\u0435\u0442\u0430\u0435\u0442"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Startar inte / kraschar direkt"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba\u015flam\u0131yor / hemen \u00e7\u00f6k\u00fcyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0454\u0442\u044c\u0441\u044f \u0430\u0431\u043e \u043e\u0434\u0440\u0430\u0437\u0443 \u0432\u0438\u043b\u0456\u0442\u0430\u0454"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng kh\u1edfi ch\u1ea1y \u0111\u01b0\u1ee3c / l\u1ed7i ngay l\u1eadp t\u1ee9c"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e0\u6cd5\u542f\u52a8\u6216\u542f\u52a8\u540e\u7acb\u5373\u5d29\u6e83"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121\u6cd5\u555f\u52d5\u6216\u555f\u52d5\u5f8c\u7acb\u5373\u7576\u6a5f"
          }
        }
      }
    },
