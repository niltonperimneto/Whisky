    "setup.whiskywine.error.noFileReceived": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0641\u0634\u0644 \u0627\u0644\u062a\u0646\u0632\u064a\u0644: \u0644\u0645 \u064a\u062a\u0645 \u0627\u0633\u062a\u0644\u0627\u0645 \u0623\u064a \u0645\u0644\u0641"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta\u017een\u00ed selhalo: nebyl p\u0159ijat \u017e\u00e1dn\u00fd soubor"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Overf\u00f8rslen mislykkedes: der blev ikke modtaget nogen fil"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Download fehlgeschlagen: keine Datei empfangen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download failed: no file received"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Download failed: no file received"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error de descarga: no se ha recibido ning\u00fan archivo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataus ep\u00e4onnistui: tiedostoa ei saatu"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c9chec du t\u00e9l\u00e9chargement : aucun fichier re\u00e7u"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Download non riuscito: nessun file ricevuto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u306b\u5931\u6557\u3057\u307e\u3057\u305f: \u30d5\u30a1\u30a4\u30eb\u3092\u53d7\u4fe1\u3067\u304d\u307e\u305b\u3093\u3067\u3057\u305f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2e4\uc6b4\ub85c\ub4dc \uc2e4\ud328: \ud30c\uc77c\uc744 \ubc1b\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download mislukt: geen bestand ontvangen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobieranie nie powiod\u0142o si\u0119: nie otrzymano pliku"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha no download: nenhum arquivo recebido"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na transfer\u00eancia: nenhum ficheiro recebido"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Desc\u0103rcare e\u0219uat\u0103: nu s-a primit niciun fi\u0219ier"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044c: \u0444\u0430\u0439\u043b \u043d\u0435 \u043f\u043e\u043b\u0443\u0447\u0435\u043d"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e4mtningen misslyckades: ingen fil togs emot"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130ndirme ba\u015far\u0131s\u0131z: dosya al\u0131nmad\u0131"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438: \u0444\u0430\u0439\u043b \u043d\u0435 \u043e\u0442\u0440\u0438\u043c\u0430\u043d\u043e"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1ea3i xu\u1ed1ng th\u1ea5t b\u1ea1i: kh\u00f4ng nh\u1eadn \u0111\u01b0\u1ee3c t\u1ec7p"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0b\u8f7d\u5931\u8d25\uff1a\u672a\u6536\u5230\u6587\u4ef6"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0b\u8f09\u5931\u6557\uff1a\u672a\u6536\u5230\u6a94\u6848"
          }
        }
      }
    },
    "setup.whiskywine.error.rateLimit": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0645 \u062a\u062c\u0627\u0648\u0632 \u062d\u062f \u0627\u0644\u0637\u0644\u0628\u0627\u062a. \u064a\u064f\u0631\u062c\u0649 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0644\u0627\u062d\u0642\u064b\u0627."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "P\u0159ekro\u010den limit po\u017eadavk\u016f. Zkuste to pros\u00edm pozd\u011bji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gr\u00e6nsen for antal foresp\u00f8rgsler er n\u00e5et. Pr\u00f8v igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfragelimit erreicht. Bitte versuche es sp\u00e4ter erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate limit exceeded. Please try again later."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate limit exceeded. Please try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha superado el l\u00edmite de peticiones. Int\u00e9ntalo m\u00e1s tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyynt\u00f6raja ylittyi. Yrit\u00e4 my\u00f6hemmin uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de requ\u00eates atteinte. Veuillez r\u00e9essayer plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite di richieste superato. Riprova pi\u00f9 tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30ec\u30fc\u30c8\u5236\u9650\u306b\u9054\u3057\u307e\u3057\u305f\u3002\u3057\u3070\u3089\u304f\u3057\u3066\u304b\u3089\u3082\u3046\u4e00\u5ea6\u304a\u8a66\u3057\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc694\uccad \ud55c\ub3c4\ub97c \ucd08\uacfc\ud588\uc2b5\ub2c8\ub2e4. \uc7a0\uc2dc \ud6c4 \ub2e4\uc2dc \uc2dc\ub3c4\ud574 \uc8fc\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aanvraaglimiet bereikt. Probeer het later opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekroczono limit \u017c\u0105da\u0144. Spr\u00f3buj ponownie p\u00f3\u017aniej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de requisi\u00e7\u00f5es excedido. Tente novamente mais tarde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de pedidos excedido. Tente novamente mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita de solicit\u0103ri a fost dep\u0103\u0219it\u0103. \u00cencearc\u0103 mai t\u00e2rziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0435\u0432\u044b\u0448\u0435\u043d \u043b\u0438\u043c\u0438\u0442 \u0437\u0430\u043f\u0440\u043e\u0441\u043e\u0432. \u041f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u0435 \u043f\u043e\u043f\u044b\u0442\u043a\u0443 \u043f\u043e\u0437\u0436\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gr\u00e4nsen f\u00f6r antal f\u00f6rfr\u00e5gningar har n\u00e5tts. F\u00f6rs\u00f6k igen senare."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130stek s\u0131n\u0131r\u0131 a\u015f\u0131ld\u0131. L\u00fctfen daha sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u0432\u0438\u0449\u0435\u043d\u043e \u043b\u0456\u043c\u0456\u0442 \u0437\u0430\u043f\u0438\u0442\u0456\u0432. \u041f\u043e\u0432\u0442\u043e\u0440\u0456\u0442\u044c \u0441\u043f\u0440\u043e\u0431\u0443 \u043f\u0456\u0437\u043d\u0456\u0448\u0435."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 v\u01b0\u1ee3t qu\u00e1 gi\u1edbi h\u1ea1n y\u00eau c\u1ea7u. H\u00e3y th\u1eed l\u1ea1i sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u8d85\u51fa\u8bf7\u6c42\u9891\u7387\u9650\u5236\u3002\u8bf7\u7a0d\u540e\u518d\u8bd5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u8d85\u51fa\u8acb\u6c42\u6b21\u6578\u9650\u5236\u3002\u8acb\u7a0d\u5f8c\u518d\u8a66\u3002"
          }
        }
      }
    },
