    "wine.clearShaderCaches.confirm.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clearing the caches shuts Wine down first, in: %@. Anything unsaved in those programs is lost. The caches rebuild themselves the next time a game runs."
          }
        },
