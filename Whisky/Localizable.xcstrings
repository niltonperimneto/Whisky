        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0435\u043a\u0441\u0442 \u0431\u0443\u0434\u0435\u0442 \u0432\u044b\u0433\u043b\u044f\u0434\u0435\u0442\u044c \u0442\u0430\u043a:"
