    "process.detail.systemWarning": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0647\u0630\u0647 \u0639\u0645\u0644\u064a\u0629 \u0646\u0638\u0627\u0645 \u062a\u0627\u0628\u0639\u0629 \u0644\u0640 Wine. \u0642\u062f \u064a\u0624\u062b\u0631 \u0625\u0646\u0647\u0627\u0624\u0647\u0627 \u0639\u0644\u0649 \u0628\u0631\u0627\u0645\u062c \u0623\u062e\u0631\u0649 \u0642\u064a\u062f \u0627\u0644\u062a\u0634\u063a\u064a\u0644."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je syst\u00e9mov\u00fd proces Wine. Jeho ukon\u010den\u00ed m\u016f\u017ee ovlivnit dal\u0161\u00ed programy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er en Wine-systemproces. Hvis du afbryder den, kan det p\u00e5virke andre k\u00f8rende programmer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist ein Wine-Systemprozess. Ihn zu beenden, kann andere laufende Programme beeintr\u00e4chtigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a Wine system process. Killing it may affect other running programs."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a Wine system process. Killing it may affect other running programs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un proceso del sistema de Wine. Cerrarlo puede afectar a otros programas en ejecuci\u00f3n."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00e4m\u00e4 on Winen j\u00e4rjestelm\u00e4prosessi. Sen lopettaminen voi vaikuttaa muihin k\u00e4ynniss\u00e4 oleviin ohjelmiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s'agit d'un processus syst\u00e8me Wine. L'arr\u00eater peut affecter les autres programmes en cours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo \u00e8 un processo di sistema di Wine. Terminarlo pu\u00f2 influire su altri programmi in esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u308c\u306f Wine \u306e\u30b7\u30b9\u30c6\u30e0\u30d7\u30ed\u30bb\u30b9\u3067\u3059\u3002\u7d42\u4e86\u3059\u308b\u3068\u3001\u307b\u304b\u306e\u5b9f\u884c\u4e2d\u306e\u30d7\u30ed\u30b0\u30e9\u30e0\u306b\u5f71\u97ff\u3059\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \uc2dc\uc2a4\ud15c \ud504\ub85c\uc138\uc2a4\uc785\ub2c8\ub2e4. \uc885\ub8cc\ud558\uba74 \uc2e4\ud589 \uc911\uc778 \ub2e4\ub978 \ud504\ub85c\uadf8\ub7a8\uc5d0 \uc601\ud5a5\uc744 \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een Wine-systeemproces. Het be\u00ebindigen kan andere actieve programma's be\u00efnvloeden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To systemowy proces Wine. Jego zako\u0144czenie mo\u017ce wp\u0142yn\u0105\u0107 na inne programy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este \u00e9 um processo de sistema do Wine. Encerr\u00e1-lo pode afetar outros programas em execu\u00e7\u00e3o."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este \u00e9 um processo de sistema do Wine. Termin\u00e1-lo pode afetar outros programas em execu\u00e7\u00e3o."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesta este un proces de sistem Wine. Oprirea lui poate afecta alte programe \u00een execu\u021bie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u043e \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u044b\u0439 \u043f\u0440\u043e\u0446\u0435\u0441\u0441 Wine. \u0415\u0433\u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0435 \u043c\u043e\u0436\u0435\u0442 \u043f\u043e\u0432\u043b\u0438\u044f\u0442\u044c \u043d\u0430 \u0434\u0440\u0443\u0433\u0438\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det h\u00e4r \u00e4r en Wine-systemprocess. Om du avslutar den kan andra program som k\u00f6rs p\u00e5verkas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir Wine sistem i\u015flemidir. Sonland\u0131rmak, \u00e7al\u0131\u015fan di\u011fer programlar\u0131 etkileyebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0426\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u0438\u0439 \u043f\u0440\u043e\u0446\u0435\u0441 Wine. \u0419\u043e\u0433\u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u044f \u043c\u043e\u0436\u0435 \u0432\u043f\u043b\u0438\u043d\u0443\u0442\u0438 \u043d\u0430 \u0456\u043d\u0448\u0456 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e2y l\u00e0 ti\u1ebfn tr\u00ecnh h\u1ec7 th\u1ed1ng c\u1ee7a Wine. K\u1ebft th\u00fac n\u00f3 c\u00f3 th\u1ec3 \u1ea3nh h\u01b0\u1edfng \u0111\u1ebfn c\u00e1c ch\u01b0\u01a1ng tr\u00ecnh kh\u00e1c \u0111ang ch\u1ea1y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fd9\u662f Wine \u7cfb\u7edf\u8fdb\u7a0b\u3002\u7ed3\u675f\u5b83\u53ef\u80fd\u4f1a\u5f71\u54cd\u5176\u4ed6\u6b63\u5728\u8fd0\u884c\u7684\u7a0b\u5e8f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9019\u662f Wine \u7cfb\u7d71\u7a0b\u5e8f\u3002\u7d42\u6b62\u5b83\u53ef\u80fd\u6703\u5f71\u97ff\u5176\u4ed6\u57f7\u884c\u4e2d\u7684\u7a0b\u5f0f\u3002"
          }
        }
      }
    },
