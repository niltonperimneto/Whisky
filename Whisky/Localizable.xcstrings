    "config.virtualDesktop.info": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0639\u0646\u062f \u0627\u0644\u062a\u0641\u0639\u064a\u0644\u060c \u064a\u0639\u0631\u0636 Wine \u062f\u0627\u062e\u0644 \u0634\u0627\u0634\u0629 \u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 \u0628\u0627\u0644\u062d\u062c\u0645 \u0627\u0644\u0645\u062e\u062a\u0627\u0631."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdy\u017e je zapnuto, Wine vykresluje do virtu\u00e1ln\u00ed obrazovky zvolen\u00e9 velikosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e5r dette er sl\u00e5et til, renderer Wine til en virtuel sk\u00e6rm i den valgte st\u00f8rrelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, rendert Wine in einen virtuellen Bildschirm der gew\u00e4hlten Gr\u00f6\u00dfe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, Wine renders into a virtual screen of the chosen size."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, Wine renders into a virtual screen of the chosen size."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se activa, Wine se dibuja en una pantalla virtual del tama\u00f1o elegido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun k\u00e4yt\u00f6ss\u00e4, Wine piirt\u00e4\u00e4 valitun kokoiselle virtuaalin\u00e4yt\u00f6lle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque cette option est activ\u00e9e, Wine s'affiche dans un \u00e9cran virtuel de la taille choisie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se attivo, Wine disegna in uno schermo virtuale della dimensione scelta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30aa\u30f3\u306b\u3059\u308b\u3068\u3001Wine \u306f\u6307\u5b9a\u3057\u305f\u30b5\u30a4\u30ba\u306e\u4eee\u60f3\u753b\u9762\u306b\u63cf\u753b\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucf1c\uba74 Wine\uc774 \uc120\ud0dd\ud55c \ud06c\uae30\uc758 \uac00\uc0c1 \ud654\uba74\uc5d0 \ub80c\ub354\ub9c1\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer dit is ingeschakeld, rendert Wine in een virtueel scherm van de gekozen grootte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po w\u0142\u0105czeniu Wine renderuje na wirtualnym ekranie o wybranym rozmiarze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, o Wine desenha em uma tela virtual do tamanho escolhido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, o Wine desenha num ecr\u00e3 virtual do tamanho escolhido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u00e2nd este activat, Wine randeaz\u0103 \u00eentr-un ecran virtual de dimensiunea aleas\u0103."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0415\u0441\u043b\u0438 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u043e, Wine \u0432\u044b\u0432\u043e\u0434\u0438\u0442 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0432 \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u044d\u043a\u0440\u0430\u043d \u0437\u0430\u0434\u0430\u043d\u043d\u043e\u0433\u043e \u0440\u0430\u0437\u043c\u0435\u0440\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e4r detta \u00e4r p\u00e5 renderar Wine till en virtuell sk\u00e4rm i vald storlek."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinle\u015ftirildi\u011finde Wine, se\u00e7ilen boyutta sanal bir ekrana \u00e7izim yapar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f\u043a\u0449\u043e \u0432\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043e, Wine \u0432\u0438\u0432\u043e\u0434\u0438\u0442\u044c \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f \u0443 \u0432\u0456\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u0438\u0439 \u0435\u043a\u0440\u0430\u043d \u0437\u0430\u0434\u0430\u043d\u043e\u0433\u043e \u0440\u043e\u0437\u043c\u0456\u0440\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi b\u1eadt, Wine s\u1ebd k\u1ebft xu\u1ea5t v\u00e0o m\u1ed9t m\u00e0n h\u00ecnh \u1ea3o c\u00f3 k\u00edch th\u01b0\u1edbc \u0111\u00e3 ch\u1ecdn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u542f\u7528\u540e\uff0cWine \u4f1a\u6e32\u67d3\u5230\u6240\u9009\u5c3a\u5bf8\u7684\u865a\u62df\u5c4f\u5e55\u4e2d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u555f\u7528\u5f8c\uff0cWine \u6703\u7b97\u7e6a\u5230\u6240\u9078\u5c3a\u5bf8\u7684\u865b\u64ec\u87a2\u5e55\u4e2d\u3002"
          }
        }
      }
    },
    "config.virtualDesktop.matchDisplay %lld %lld": {
      "comment": "A caption that displays the recommended resolution for virtual desktop mode, based on the current screen's pixel dimensions. The first and second arguments are the width and height of the screen in pixels.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "config.virtualDesktop.matchDisplay %1$lld %2$lld"
          }
        }
      }
    },
    "config.virtualDesktop.matchDisplay.fallback": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0639\u0630\u0651\u0631 \u0627\u0643\u062a\u0634\u0627\u0641 \u062d\u062c\u0645 \u0627\u0644\u0634\u0627\u0634\u0629\u060c \u0648\u0633\u064a\u062a\u0645 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 1920x1080."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Velikost displeje se nepoda\u0159ilo zjistit; pou\u017eito 1920x1080."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sk\u00e6rmst\u00f8rrelsen kunne ikke findes; 1920x1080 bruges i stedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirmgr\u00f6\u00dfe konnte nicht ermittelt werden; 1920x1080 wird verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to detect display size; using 1920x1080."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to detect display size; using 1920x1080."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido detectar el tama\u00f1o de la pantalla; se usar\u00e1 1920x1080."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e4yt\u00f6n kokoa ei tunnistettu; k\u00e4ytet\u00e4\u00e4n tarkkuutta 1920x1080."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de d\u00e9tecter la taille de l'\u00e9cran ; utilisation de 1920x1080."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile rilevare la dimensione dello schermo; verr\u00e0 usata 1920x1080."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c7\u30a3\u30b9\u30d7\u30ec\u30a4\u306e\u30b5\u30a4\u30ba\u3092\u691c\u51fa\u3067\u304d\u307e\u305b\u3093\u3067\u3057\u305f\u30021920x1080 \u3092\u4f7f\u7528\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub514\uc2a4\ud50c\ub808\uc774 \ud06c\uae30\ub97c \uac10\uc9c0\ud558\uc9c0 \ubabb\ud574 1920x1080\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schermgrootte kon niet worden bepaald; 1920x1080 wordt gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie uda\u0142o si\u0119 wykry\u0107 rozmiaru ekranu; u\u017cyto 1920x1080."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o foi poss\u00edvel detectar o tamanho da tela; usando 1920x1080."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o foi poss\u00edvel detetar o tamanho do ecr\u00e3; a usar 1920x1080."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensiunea ecranului nu a putut fi detectat\u0103; se folose\u0219te 1920x1080."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c \u0440\u0430\u0437\u043c\u0435\u0440 \u0434\u0438\u0441\u043f\u043b\u0435\u044f, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f 1920x1080."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sk\u00e4rmstorleken kunde inte avg\u00f6ras; 1920x1080 anv\u00e4nds."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran boyutu alg\u0131lanamad\u0131; 1920x1080 kullan\u0131l\u0131yor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0432\u0438\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u0440\u043e\u0437\u043c\u0456\u0440 \u0434\u0438\u0441\u043f\u043b\u0435\u044f, \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f 1920x1080."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng nh\u1eadn \u0111\u01b0\u1ee3c k\u00edch th\u01b0\u1edbc m\u00e0n h\u00ecnh; d\u00f9ng 1920x1080."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e0\u6cd5\u68c0\u6d4b\u663e\u793a\u5668\u5c3a\u5bf8\uff0c\u5c06\u4f7f\u7528 1920x1080\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121\u6cd5\u5075\u6e2c\u986f\u793a\u5668\u5c3a\u5bf8\uff0c\u5c07\u4f7f\u7528 1920x1080\u3002"
          }
        }
      }
    },
