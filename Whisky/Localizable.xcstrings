    "config.dxvkHud.info": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0639\u0631\u0636 \u0625\u062d\u0635\u0627\u0621\u0627\u062a DXVK (\u0645\u0639\u062f\u0644 \u0627\u0644\u0625\u0637\u0627\u0631\u0627\u062a \u0648\u0627\u0644\u0625\u0635\u062f\u0627\u0631 \u0648\u0627\u0644\u0630\u0627\u0643\u0631\u0629) \u0641\u0648\u0642 \u0627\u0644\u0644\u0639\u0628\u0629 \u0642\u064a\u062f \u0627\u0644\u062a\u0634\u063a\u064a\u0644."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje statistiky DXVK (FPS, verze, pam\u011b\u0165) p\u0159es b\u011b\u017e\u00edc\u00ed hru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser DXVK-statistik (FPS, version, hukommelse) oven p\u00e5 det k\u00f8rende spil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet DXVK-Statistiken (FPS, Version, Speicher) \u00fcber dem laufenden Spiel ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overlay DXVK statistics (FPS, version, memory) on top of the running game."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Overlay DXVK statistics (FPS, version, memory) on top of the running game."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Superpone estad\u00edsticas de DXVK (FPS, versi\u00f3n, memoria) sobre el juego en ejecuci\u00f3n."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e4ytt\u00e4\u00e4 DXVK-tilastot (FPS, versio, muisti) k\u00e4ynniss\u00e4 olevan pelin p\u00e4\u00e4ll\u00e4."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les statistiques DXVK (FPS, version, m\u00e9moire) par-dessus le jeu en cours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovrappone le statistiche DXVK (FPS, versione, memoria) al gioco in esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b9f\u884c\u4e2d\u306e\u30b2\u30fc\u30e0\u306b DXVK \u306e\u7d71\u8a08\u60c5\u5831 (FPS\u3001\u30d0\u30fc\u30b8\u30e7\u30f3\u3001\u30e1\u30e2\u30ea) \u3092\u91cd\u306d\u3066\u8868\u793a\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2e4\ud589 \uc911\uc778 \uac8c\uc784 \uc704\uc5d0 DXVK \ud1b5\uacc4(FPS, \ubc84\uc804, \uba54\ubaa8\ub9ac)\ub97c \ud45c\uc2dc\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont DXVK-statistieken (FPS, versie, geheugen) over de actieve game heen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wy\u015bwietla statystyki DXVK (FPS, wersja, pami\u0119\u0107) na wierzchu gry."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrep\u00f5e estat\u00edsticas do DXVK (FPS, vers\u00e3o, mem\u00f3ria) ao jogo em execu\u00e7\u00e3o."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrep\u00f5e estat\u00edsticas do DXVK (FPS, vers\u00e3o, mem\u00f3ria) ao jogo em execu\u00e7\u00e3o."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afi\u0219eaz\u0103 statistici DXVK (FPS, versiune, memorie) peste jocul care ruleaz\u0103."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443 DXVK (FPS, \u0432\u0435\u0440\u0441\u0438\u044f, \u043f\u0430\u043c\u044f\u0442\u044c) \u043f\u043e\u0432\u0435\u0440\u0445 \u0437\u0430\u043f\u0443\u0449\u0435\u043d\u043d\u043e\u0439 \u0438\u0433\u0440\u044b."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar DXVK-statistik (FPS, version, minne) ovanp\u00e5 spelet som k\u00f6rs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c7al\u0131\u015fan oyunun \u00fczerinde DXVK istatistiklerini (FPS, s\u00fcr\u00fcm, bellek) g\u00f6sterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043a\u0430\u0437\u0443\u0454 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443 DXVK (FPS, \u0432\u0435\u0440\u0441\u0456\u044f, \u043f\u0430\u043c'\u044f\u0442\u044c) \u043f\u043e\u0432\u0435\u0440\u0445 \u0437\u0430\u043f\u0443\u0449\u0435\u043d\u043e\u0457 \u0433\u0440\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi\u1ec3n th\u1ecb th\u1ed1ng k\u00ea DXVK (FPS, phi\u00ean b\u1ea3n, b\u1ed9 nh\u1edb) ch\u1ed3ng l\u00ean game \u0111ang ch\u1ea1y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u8fd0\u884c\u4e2d\u7684\u6e38\u620f\u4e0a\u53e0\u52a0\u663e\u793a DXVK \u7edf\u8ba1\u4fe1\u606f\uff08\u5e27\u7387\u3001\u7248\u672c\u3001\u5185\u5b58\uff09\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u57f7\u884c\u4e2d\u7684\u904a\u6232\u4e0a\u758a\u52a0\u986f\u793a DXVK \u7d71\u8a08\u8cc7\u8a0a\uff08FPS\u3001\u7248\u672c\u3001\u8a18\u61b6\u9ad4\uff09\u3002"
          }
        }
      }
    },
