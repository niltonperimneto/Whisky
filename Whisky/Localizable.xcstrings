            "state": "translated",
            "value": "\u00bfSe ha resuelto el problema?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korjasiko t\u00e4m\u00e4 ongelman?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le probl\u00e8me est-il r\u00e9solu ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il problema \u00e8 stato risolto?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u554f\u984c\u306f\u89e3\u6c7a\u3057\u307e\u3057\u305f\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc218\uc815\uc73c\ub85c \ubb38\uc81c\uac00 \ud574\uacb0\ub418\uc5c8\uc2b5\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Is het probleem hiermee opgelost?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy to naprawi\u0142o problem?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso resolveu o problema?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto resolveu o problema?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "S-a rezolvat problema?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0443\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0430?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00f6ste det problemet?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, sorunu \u00e7\u00f6zd\u00fc m\u00fc?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0431\u043b\u0435\u043c\u0443 \u0443\u0441\u0443\u043d\u0435\u043d\u043e?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u00e1ch n\u00e0y c\u00f3 kh\u1eafc ph\u1ee5c \u0111\u01b0\u1ee3c s\u1ef1 c\u1ed1 kh\u00f4ng?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u4fee\u590d\u89e3\u51b3\u95ee\u9898\u4e86\u5417\uff1f"
