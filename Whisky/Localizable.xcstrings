    "troubleshooting.symptom.performanceStability": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0623\u062f\u0627\u0621 \u0623\u0648 \u0627\u0644\u0627\u0633\u062a\u0642\u0631\u0627\u0631 \u0645\u0639 \u0645\u0631\u0648\u0631 \u0627\u0644\u0648\u0642\u062a"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00fdkon a stabilita v pr\u016fb\u011bhu \u010dasu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ydeevne eller stabilitet over tid"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leistung / Stabilit\u00e4t im Verlauf"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Performance / stability over time"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Performance / stability over time"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendimiento o estabilidad con el tiempo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suorituskyky tai vakaus ajan my\u00f6t\u00e4"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Performances ou stabilit\u00e9 dans la dur\u00e9e"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prestazioni o stabilit\u00e0 nel tempo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6642\u9593\u306e\u7d4c\u904e\u306b\u4f34\u3046\u6027\u80fd\u3084\u5b89\u5b9a\u6027\u306e\u4f4e\u4e0b"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2dc\uac04\uc774 \uc9c0\ub0a0\uc218\ub85d \uc131\ub2a5/\uc548\uc815\uc131 \uc800\ud558"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prestaties / stabiliteit na verloop van tijd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydajno\u015b\u0107 i stabilno\u015b\u0107 z czasem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desempenho ou estabilidade ao longo do tempo"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desempenho ou estabilidade ao longo do tempo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Performan\u021b\u0103 sau stabilitate \u00een timp"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0438 \u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0441\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043c"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prestanda eller stabilitet \u00f6ver tid"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanla performans / kararl\u0131l\u0131k"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044c \u0456 \u0441\u0442\u0430\u0431\u0456\u043b\u044c\u043d\u0456\u0441\u0442\u044c \u0456\u0437 \u0447\u0430\u0441\u043e\u043c"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi\u1ec7u n\u0103ng / \u0111\u1ed9 \u1ed5n \u0111\u1ecbnh theo th\u1eddi gian"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fd0\u884c\u4e00\u6bb5\u65f6\u95f4\u540e\u6027\u80fd/\u7a33\u5b9a\u6027\u4e0b\u964d"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u57f7\u884c\u4e00\u6bb5\u6642\u9593\u5f8c\u6548\u80fd/\u7a69\u5b9a\u6027\u4e0b\u964d"
          }
        }
      }
    },
