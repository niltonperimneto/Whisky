    "config.disableAppNap.info": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0645\u0646\u0639 macOS \u0645\u0646 \u062e\u0641\u0636 \u0623\u062f\u0627\u0621 \u0639\u0645\u0644\u064a\u0627\u062a Wine \u0644\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0623\u062f\u0627\u0621 \u0623\u0641\u0636\u0644"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabr\u00e1n\u00ed macOS zpomalovat procesy Wine \u2014 vy\u0161\u0161\u00ed v\u00fdkon"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forhindrer macOS i at bremse Wine-processer, s\u00e5 ydeevnen bliver bedre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert, dass macOS Wine-Prozesse drosselt \u2013 f\u00fcr bessere Leistung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevent macOS from throttling Wine processes for better performance"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevent macOS from throttling Wine processes for better performance"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita que macOS limite los procesos de Wine para mejorar el rendimiento"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Est\u00e4\u00e4 macOS:\u00e4\u00e4 hidastamasta Wine-prosesseja, mik\u00e4 parantaa suorituskyky\u00e4"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emp\u00eache macOS de brider les processus Wine pour de meilleures performances"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impedisce a macOS di limitare i processi Wine per prestazioni migliori"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS \u304c Wine \u306e\u30d7\u30ed\u30bb\u30b9\u3092\u6291\u5236\u3057\u306a\u3044\u3088\u3046\u306b\u3057\u3066\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u9ad8\u3081\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc131\ub2a5 \ud5a5\uc0c1\uc744 \uc704\ud574 macOS\uac00 Wine \ud504\ub85c\uc138\uc2a4\ub97c \uc81c\ud55c\ud558\uc9c0 \uc54a\ub3c4\ub85d \ud569\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorkomt dat macOS Wine-processen afremt, voor betere prestaties"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapobiega spowalnianiu proces\u00f3w Wine przez macOS \u2014 wi\u0119ksza wydajno\u015b\u0107"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impede que o macOS limite os processos do Wine, melhorando o desempenho"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Impede o macOS de limitar os processos do Wine para melhor desempenho"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00cempiedic\u0103 macOS s\u0103 limiteze procesele Wine, pentru performan\u021be mai bune"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0434\u0430\u0451\u0442 macOS \u0437\u0430\u043c\u0435\u0434\u043b\u044f\u0442\u044c \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u044b Wine \u2014 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0432\u044b\u0448\u0435"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindrar macOS fr\u00e5n att strypa Wine-processer, vilket ger b\u00e4ttre prestanda"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha iyi performans i\u00e7in macOS'in Wine i\u015flemlerini k\u0131s\u0131tlamas\u0131n\u0131 engeller"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0434\u0430\u0454 macOS \u0441\u043f\u043e\u0432\u0456\u043b\u044c\u043d\u044e\u0432\u0430\u0442\u0438 \u043f\u0440\u043e\u0446\u0435\u0441\u0438 Wine \u2014 \u0432\u0438\u0449\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044c"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ng\u0103n macOS h\u1ea1n ch\u1ebf ti\u1ebfn tr\u00ecnh Wine \u0111\u1ec3 c\u00f3 hi\u1ec7u n\u0103ng t\u1ed1t h\u01a1n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9632\u6b62 macOS \u9650\u5236 Wine \u8fdb\u7a0b\uff0c\u4ee5\u63d0\u5347\u6027\u80fd"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u907f\u514d macOS \u9650\u5236 Wine \u7a0b\u5e8f\uff0c\u4ee5\u63d0\u5347\u6548\u80fd"
          }
        }
      }
    },
