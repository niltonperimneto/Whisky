    "bottle.remove.hasProcesses.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0648\u062c\u062f \u0639\u0645\u0644\u064a\u0627\u062a Wine \u0642\u064a\u062f \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0632\u062c\u0627\u062c\u0629. \u0633\u064a\u062a\u0645 \u0625\u064a\u0642\u0627\u0641\u0647\u0627 \u0642\u0628\u0644 \u0625\u0632\u0627\u0644\u0629 \u0627\u0644\u0632\u062c\u0627\u062c\u0629."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V t\u00e9to lahvi b\u011b\u017e\u00ed procesy Wine. P\u0159ed odstran\u011bn\u00edm lahve budou zastaveny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der k\u00f8rer Wine-processer i denne flaske. De bliver stoppet, f\u00f8r flasken fjernes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In dieser Flasche laufen Wine-Prozesse. Sie werden gestoppt, bevor die Flasche entfernt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are Wine processes running in this bottle. They will be stopped before the bottle is removed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "There are Wine processes running in this bottle. They will be stopped before the bottle is removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay procesos de Wine en ejecuci\u00f3n en esta botella. Se detendr\u00e1n antes de eliminarla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00e4ss\u00e4 pullossa on k\u00e4ynniss\u00e4 Wine-prosesseja. Ne pys\u00e4ytet\u00e4\u00e4n ennen pullon poistamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des processus Wine sont en cours d'ex\u00e9cution dans cette bouteille. Ils seront arr\u00eat\u00e9s avant sa suppression."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questa bottiglia ci sono processi Wine in esecuzione. Verranno arrestati prima della rimozione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e Bottle \u3067 Wine \u306e\u30d7\u30ed\u30bb\u30b9\u304c\u5b9f\u884c\u4e2d\u3067\u3059\u3002Bottle \u3092\u524a\u9664\u3059\u308b\u524d\u306b\u505c\u6b62\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 Bottle\uc5d0\uc11c Wine \ud504\ub85c\uc138\uc2a4\uac00 \uc2e4\ud589 \uc911\uc785\ub2c8\ub2e4. Bottle\uc744 \uc0ad\uc81c\ud558\uae30 \uc804\uc5d0 \uc911\uc9c0\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In deze fles draaien Wine-processen. Ze worden gestopt voordat de fles wordt verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tej butelce dzia\u0142aj\u0105 procesy Wine. Zostan\u0105 zatrzymane przed usuni\u0119ciem butelki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e1 processos do Wine em execu\u00e7\u00e3o nesta Bottle. Eles ser\u00e3o parados antes de a Bottle ser removida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Existem processos do Wine em execu\u00e7\u00e3o nesta Bottle. Ser\u00e3o parados antes de a Bottle ser removida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00cen aceast\u0103 sticl\u0103 ruleaz\u0103 procese Wine. Vor fi oprite \u00eenainte de eliminarea sticlei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 \u044d\u0442\u043e\u0439 \u0431\u0443\u0442\u044b\u043b\u043a\u0435 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u044e\u0442\u0441\u044f \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u044b Wine. \u041f\u0435\u0440\u0435\u0434 \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u0435\u043c \u0431\u0443\u0442\u044b\u043b\u043a\u0438 \u043e\u043d\u0438 \u0431\u0443\u0434\u0443\u0442 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u044b."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det k\u00f6rs Wine-processer i den h\u00e4r flaskan. De stoppas innan flaskan tas bort."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu \u015fi\u015fede \u00e7al\u0131\u015fan Wine i\u015flemleri var. \u015ei\u015fe kald\u0131r\u0131lmadan \u00f6nce durdurulacaklar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423 \u0446\u0456\u0439 \u043f\u043b\u044f\u0448\u0446\u0456 \u0432\u0438\u043a\u043e\u043d\u0443\u044e\u0442\u044c\u0441\u044f \u043f\u0440\u043e\u0446\u0435\u0441\u0438 Wine. \u041f\u0435\u0440\u0435\u0434 \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u043d\u044f\u043c \u043f\u043b\u044f\u0448\u043a\u0438 \u0457\u0445 \u0431\u0443\u0434\u0435 \u0437\u0443\u043f\u0438\u043d\u0435\u043d\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u00f3 ti\u1ebfn tr\u00ecnh Wine \u0111ang ch\u1ea1y trong bottle n\u00e0y. Ch\u00fang s\u1ebd b\u1ecb d\u1eebng tr\u01b0\u1edbc khi g\u1ee1 bottle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64 Bottle \u4e2d\u6709 Wine \u8fdb\u7a0b\u6b63\u5728\u8fd0\u884c\u3002\u79fb\u9664 Bottle \u524d\u4f1a\u5148\u505c\u6b62\u8fd9\u4e9b\u8fdb\u7a0b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64 Bottle \u4e2d\u6709 Wine \u7a0b\u5e8f\u6b63\u5728\u57f7\u884c\u3002\u79fb\u9664 Bottle \u524d\u6703\u5148\u505c\u6b62\u9019\u4e9b\u7a0b\u5e8f\u3002"
          }
        }
      }
    },
