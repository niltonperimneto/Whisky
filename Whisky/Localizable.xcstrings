    "troubleshooting.verify.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062c\u0631\u0651\u0628 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c \u0645\u0631\u0629 \u0623\u062e\u0631\u0649 \u0644\u0644\u062a\u062d\u0642\u0642 \u0645\u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0627\u0644\u0645\u0634\u0643\u0644\u0629 \u0642\u062f \u062d\u064f\u0644\u0651\u062a."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkuste program spustit znovu a ov\u011b\u0159te, zda je probl\u00e9m vy\u0159e\u0161en."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pr\u00f8v at k\u00f8re programmet igen for at se, om problemet er l\u00f8st."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte dein Programm erneut, um zu pr\u00fcfen, ob das Problem behoben ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try running your program again to check if the issue is resolved."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Try running your program again to check if the issue is resolved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a ejecutar el programa para comprobar si el problema se ha resuelto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeile k\u00e4ynnist\u00e4\u00e4 ohjelma uudelleen ja tarkista, ratkesiko ongelma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relancez votre programme pour v\u00e9rifier si le probl\u00e8me est r\u00e9solu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova ad avviare di nuovo il programma per verificare se il problema \u00e8 risolto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u3082\u3046\u4e00\u5ea6\u5b9f\u884c\u3057\u3066\u3001\u554f\u984c\u304c\u89e3\u6c7a\u3057\u305f\u304b\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud504\ub85c\uadf8\ub7a8\uc744 \ub2e4\uc2dc \uc2e4\ud589\ud574 \ubb38\uc81c\uac00 \ud574\uacb0\ub418\uc5c8\ub294\uc9c0 \ud655\uc778\ud574 \ubcf4\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start je programma opnieuw om te kijken of het probleem is opgelost."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchom program ponownie, aby sprawdzi\u0107, czy problem znikn\u0105\u0142."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente executar o programa de novo para ver se o problema foi resolvido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente executar o programa outra vez para ver se o problema ficou resolvido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruleaz\u0103 din nou programul pentru a verifica dac\u0103 problema s-a rezolvat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443 \u0435\u0449\u0451 \u0440\u0430\u0437 \u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435, \u0443\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0430 \u043b\u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova att k\u00f6ra programmet igen f\u00f6r att se om problemet \u00e4r l\u00f6st."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorunun \u00e7\u00f6z\u00fcl\u00fcp \u00e7\u00f6z\u00fclmedi\u011fini g\u00f6rmek i\u00e7in program\u0131n\u0131z\u0131 yeniden \u00e7al\u0131\u015ft\u0131rmay\u0131 deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0443\u0441\u0442\u0456\u0442\u044c \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443 \u0449\u0435 \u0440\u0430\u0437 \u0456 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435, \u0447\u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443 \u0443\u0441\u0443\u043d\u0435\u043d\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e3y th\u1eed ch\u1ea1y l\u1ea1i ch\u01b0\u01a1ng tr\u00ecnh \u0111\u1ec3 xem s\u1ef1 c\u1ed1 \u0111\u00e3 \u0111\u01b0\u1ee3c kh\u1eafc ph\u1ee5c ch\u01b0a."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u518d\u6b21\u8fd0\u884c\u4f60\u7684\u7a0b\u5e8f\uff0c\u770b\u770b\u95ee\u9898\u662f\u5426\u5df2\u89e3\u51b3\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u518d\u6b21\u57f7\u884c\u4f60\u7684\u7a0b\u5f0f\uff0c\u770b\u770b\u554f\u984c\u662f\u5426\u5df2\u89e3\u6c7a\u3002"
          }
        }
      }
    },
