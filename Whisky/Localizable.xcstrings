    "troubleshooting.fix.irreversible": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u064a\u0645\u0643\u0646 \u0627\u0644\u062a\u0631\u0627\u062c\u0639 \u0639\u0646 \u0647\u0630\u0627 \u0627\u0644\u0625\u062c\u0631\u0627\u0621"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto akci nelze vr\u00e1tit zp\u011bt"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Handlingen kan ikke fortrydes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktion kann nicht r\u00fcckg\u00e4ngig gemacht werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action cannot be undone"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This action cannot be undone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acci\u00f3n no se puede deshacer"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00e4t\u00e4 toimintoa ei voi perua"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irr\u00e9versible"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione non pu\u00f2 essere annullata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u64cd\u4f5c\u306f\u53d6\u308a\u6d88\u305b\u307e\u305b\u3093"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc791\uc5c5\uc740 \ub418\ub3cc\ub9b4 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze actie kan niet ongedaan worden gemaakt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tej czynno\u015bci nie mo\u017cna cofn\u0105\u0107"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta a\u00e7\u00e3o n\u00e3o pode ser desfeita"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta a\u00e7\u00e3o n\u00e3o pode ser anulada"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceast\u0103 ac\u021biune nu poate fi anulat\u0103"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043d\u0435\u043b\u044c\u0437\u044f \u043e\u0442\u043c\u0435\u043d\u0438\u0442\u044c"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c5tg\u00e4rden g\u00e5r inte att \u00e5ngra"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu i\u015flem geri al\u0131namaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0426\u044e \u0434\u0456\u044e \u043d\u0435 \u043c\u043e\u0436\u043d\u0430 \u0441\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng th\u1ec3 ho\u00e0n t\u00e1c thao t\u00e1c n\u00e0y"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u64cd\u4f5c\u65e0\u6cd5\u64a4\u9500"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u64cd\u4f5c\u7121\u6cd5\u9084\u539f"
          }
        }
      }
    },
