            "value": "Weryfikacja prefiksu po naprawie nie powiod\u0142a si\u0119"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A valida\u00e7\u00e3o do prefixo falhou ap\u00f3s o reparo"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A valida\u00e7\u00e3o do prefixo falhou ap\u00f3s a repara\u00e7\u00e3o"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Validarea prefixului a e\u0219uat dup\u0103 reparare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u043f\u0440\u0435\u0444\u0438\u043a\u0441\u0430 \u043f\u043e\u0441\u043b\u0435 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u043d\u0435 \u043f\u0440\u043e\u0439\u0434\u0435\u043d\u0430"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollen av prefixet misslyckades efter reparationen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onar\u0131mdan sonra \u00f6n ek do\u011frulamas\u0131 ba\u015far\u0131s\u0131z oldu"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0443 \u043f\u0440\u0435\u0444\u0456\u043a\u0441\u0430 \u043f\u0456\u0441\u043b\u044f \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u043d\u0435 \u043f\u0440\u043e\u0439\u0434\u0435\u043d\u043e"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "X\u00e1c th\u1ef1c prefix th\u1ea5t b\u1ea1i sau khi s\u1eeda ch\u1eefa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4fee\u590d\u540e\u524d\u7f00\u6821\u9a8c\u5931\u8d25"
          }
        },
        "zh-Hant": {
          "stringUnit": {
