    "config.dpi.info": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0636\u0628\u0637 \u0642\u064a\u0645\u0629 DPI \u0644\u0634\u0627\u0634\u0629 \u0627\u0644\u0632\u062c\u0627\u062c\u0629 \u0644\u062a\u063a\u064a\u064a\u0631 \u062d\u062c\u0645 \u0646\u0635\u0648\u0635 Windows \u0648\u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u0648\u0627\u062c\u0647\u0629."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastav\u00ed DPI obrazovky lahve pro \u0161k\u00e1lov\u00e1n\u00ed textu a prvk\u016f rozhran\u00ed Windows."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv flaskens sk\u00e6rm-DPI for at skalere Windows-tekst og -gr\u00e6nseflade."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt den Bildschirm-DPI-Wert der Flasche fest, um Windows-Text und -Bedienelemente zu skalieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the bottle's screen DPI to scale Windows text and interface elements."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the bottle's screen DPI to scale Windows text and interface elements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define los DPI de la botella para escalar el texto y la interfaz de Windows."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseta pullon n\u00e4yt\u00f6n DPI, joka skaalaa Windowsin tekstin ja k\u00e4ytt\u00f6liittym\u00e4n osat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9finit le PPP de la bouteille pour mettre \u00e0 l'\u00e9chelle le texte et l'interface de Windows."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta il DPI della bottiglia per scalare testo e interfaccia di Windows."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bottle \u306e\u753b\u9762 DPI \u3092\u8a2d\u5b9a\u3057\u3001Windows \u306e\u6587\u5b57\u3084\u30a4\u30f3\u30bf\u30fc\u30d5\u30a7\u30a4\u30b9\u8981\u7d20\u3092\u62e1\u5927\u7e2e\u5c0f\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bottle\uc758 \ud654\uba74 DPI\ub97c \uc124\uc815\ud574 Windows \ud14d\uc2a4\ud2b8\uc640 \uc778\ud130\ud398\uc774\uc2a4 \uc694\uc18c\uc758 \ud06c\uae30\ub97c \uc870\uc808\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelt de DPI van het scherm van de fles in om Windows-tekst en -interface te schalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawia DPI ekranu butelki, aby skalowa\u0107 tekst i elementy interfejsu Windows."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Define o DPI da Bottle para dimensionar o texto e a interface do Windows."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Define os DPI da Bottle para dimensionar o texto e a interface do Windows."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Seteaz\u0103 DPI-ul sticlei pentru a scala textul \u0219i interfa\u021ba Windows."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0434\u0430\u0451\u0442 DPI \u044d\u043a\u0440\u0430\u043d\u0430 \u0431\u0443\u0442\u044b\u043b\u043a\u0438 \u0434\u043b\u044f \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0442\u0435\u043a\u0441\u0442\u0430 \u0438 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432 \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430 Windows."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange flaskans sk\u00e4rm-DPI f\u00f6r att skala Windows-text och gr\u00e4nssnitt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows metnini ve aray\u00fcz \u00f6gelerini \u00f6l\u00e7eklemek i\u00e7in \u015fi\u015fenin ekran DPI de\u011ferini ayarlay\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0434\u0430\u0454 DPI \u0435\u043a\u0440\u0430\u043d\u0430 \u043f\u043b\u044f\u0448\u043a\u0438 \u0434\u043b\u044f \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0443\u0432\u0430\u043d\u043d\u044f \u0442\u0435\u043a\u0441\u0442\u0443 \u0439 \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0456\u0432 \u0456\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0443 Windows."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u1eb7t DPI m\u00e0n h\u00ecnh c\u1ee7a bottle \u0111\u1ec3 ch\u1ec9nh t\u1ef7 l\u1ec7 ch\u1eef v\u00e0 giao di\u1ec7n Windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bbe\u5b9a\u6b64 Bottle \u7684\u5c4f\u5e55 DPI\uff0c\u4ee5\u7f29\u653e Windows \u6587\u672c\u548c\u754c\u9762\u5143\u7d20\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a2d\u5b9a\u6b64 Bottle \u7684\u87a2\u5e55 DPI\uff0c\u4ee5\u7e2e\u653e Windows \u6587\u5b57\u8207\u4ecb\u9762\u5143\u7d20\u3002"
          }
        }
      }
    },
