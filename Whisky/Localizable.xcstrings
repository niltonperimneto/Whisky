    "clipboard.large.message.image": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u062d\u062a\u0648\u064a \u0627\u0644\u062d\u0627\u0641\u0638\u0629 \u0639\u0644\u0649 \u0635\u0648\u0631\u0629 (\u0646\u062d\u0648 {size} KB). \u0642\u062f \u064a\u0624\u062f\u064a \u0647\u0630\u0627 \u0625\u0644\u0649 \u062a\u0639\u0644\u064a\u0642 \u0628\u0639\u0636 \u0627\u0644\u0623\u0644\u0639\u0627\u0628."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve schr\u00e1nce je obr\u00e1zek (asi {size} KB). N\u011bkter\u00e9 hry se kv\u016fli tomu m\u016f\u017eou zaseknout."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din udklipsholder indeholder et billede (ca. {size} KB). Det kan f\u00e5 nogle spil til at g\u00e5 i st\u00e5."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Zwischenablage enth\u00e4lt ein Bild (etwa {size} KB). Das kann bei manchen Spielen zu H\u00e4ngern f\u00fchren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your clipboard contains an image (about {size} KB). This can cause some games to hang."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your clipboard contains an image (about {size} KB). This can cause some games to hang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El portapapeles contiene una imagen (unos {size} KB). Esto puede bloquear algunos juegos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leikep\u00f6yd\u00e4ll\u00e4si on kuva (noin {size} KB). T\u00e4m\u00e4 voi jumittaa joitakin pelej\u00e4."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le presse-papiers contient une image (environ {size} Ko). Cela peut bloquer certains jeux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli appunti contengono un'immagine (circa {size} KB). Alcuni giochi potrebbero bloccarsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30af\u30ea\u30c3\u30d7\u30dc\u30fc\u30c9\u306b\u753b\u50cf\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059 (\u7d04 {size} KB)\u3002\u4e00\u90e8\u306e\u30b2\u30fc\u30e0\u304c\u30cf\u30f3\u30b0\u3059\u308b\u539f\u56e0\u306b\u306a\u308b\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud074\ub9bd\ubcf4\ub4dc\uc5d0 \uc774\ubbf8\uc9c0\uac00 \uc788\uc2b5\ub2c8\ub2e4(\uc57d {size} KB). \uc77c\ubd80 \uac8c\uc784\uc774 \uba48\ucd9c \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je klembord bevat een afbeelding (ongeveer {size} KB). Hierdoor kunnen sommige games vastlopen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schowek zawiera obraz (oko\u0142o {size} KB). Mo\u017ce to powodowa\u0107 zawieszanie si\u0119 niekt\u00f3rych gier."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A \u00e1rea de transfer\u00eancia cont\u00e9m uma imagem (cerca de {size} KB). Isso pode travar alguns jogos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A \u00e1rea de transfer\u00eancia cont\u00e9m uma imagem (cerca de {size} KB). Isto pode bloquear alguns jogos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboardul con\u021bine o imagine (circa {size} KB). Unele jocuri se pot bloca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 \u0431\u0443\u0444\u0435\u0440\u0435 \u043e\u0431\u043c\u0435\u043d\u0430 \u0435\u0441\u0442\u044c \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 (\u043e\u043a\u043e\u043b\u043e {size} \u041a\u0411). \u0418\u0437-\u0437\u0430 \u044d\u0442\u043e\u0433\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u0433\u0440\u044b \u0437\u0430\u0432\u0438\u0441\u0430\u044e\u0442."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt urklipp inneh\u00e5ller en bild (cirka {size} KB). Det kan f\u00e5 vissa spel att h\u00e4nga sig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Panonuzda bir g\u00f6r\u00fcnt\u00fc var (yakla\u015f\u0131k {size} KB). Bu, baz\u0131 oyunlar\u0131n tak\u0131lmas\u0131na neden olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423 \u0431\u0443\u0444\u0435\u0440\u0456 \u043e\u0431\u043c\u0456\u043d\u0443 \u0454 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f (\u0431\u043b\u0438\u0437\u044c\u043a\u043e {size} \u041a\u0411). \u0427\u0435\u0440\u0435\u0437 \u0446\u0435 \u0434\u0435\u044f\u043a\u0456 \u0456\u0433\u0440\u0438 \u0437\u0430\u0432\u0438\u0441\u0430\u044e\u0442\u044c."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u1ea3ng nh\u1edb t\u1ea1m ch\u1ee9a m\u1ed9t h\u00ecnh \u1ea3nh (kho\u1ea3ng {size} KB). \u0110i\u1ec1u n\u00e0y c\u00f3 th\u1ec3 khi\u1ebfn m\u1ed9t s\u1ed1 game b\u1ecb treo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u526a\u8d34\u677f\u4e2d\u5305\u542b\u4e00\u5f20\u56fe\u50cf\uff08\u7ea6 {size} KB\uff09\u3002\u8fd9\u53ef\u80fd\u5bfc\u81f4\u67d0\u4e9b\u6e38\u620f\u5361\u6b7b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u526a\u8cbc\u677f\u4e2d\u542b\u6709\u4e00\u5f35\u5f71\u50cf\uff08\u7d04 {size} KB\uff09\u3002\u9019\u53ef\u80fd\u5c0e\u81f4\u67d0\u4e9b\u904a\u6232\u505c\u6b62\u56de\u61c9\u3002"
          }
        }
      }
    },
    "clipboard.large.message.other": {
