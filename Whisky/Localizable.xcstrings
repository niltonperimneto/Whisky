    "winetricks.error.repairFailedInfo": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0639\u0630\u0651\u0631 \u0625\u0635\u0644\u0627\u062d \u0628\u0627\u062f\u0626\u0629 Wine. \u064a\u064f\u0631\u062c\u0649 \u0645\u062d\u0627\u0648\u0644\u0629 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0632\u062c\u0627\u062c\u0629 \u0645\u0646 \u062c\u062f\u064a\u062f."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefix Wine se nepoda\u0159ilo opravit. Zkuste l\u00e1hev vytvo\u0159it znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine-pr\u00e6fikset kunne ikke repareres. Pr\u00f8v at oprette flasken igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wine-Pr\u00e4fix konnte nicht repariert werden. Erstelle die Flasche am besten neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to repair the Wine prefix. Please try recreating the bottle."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to repair the Wine prefix. Please try recreating the bottle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido reparar el prefijo de Wine. Prueba a crear la botella de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine-etuliitteen korjaus ep\u00e4onnistui. Kokeile luoda pullo uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de r\u00e9parer le pr\u00e9fixe Wine. Essayez de recr\u00e9er la bouteille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile riparare il prefisso Wine. Prova a ricreare la bottiglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \u30d7\u30ec\u30d5\u30a3\u30c3\u30af\u30b9\u3092\u4fee\u5fa9\u3067\u304d\u307e\u305b\u3093\u3067\u3057\u305f\u3002Bottle \u3092\u4f5c\u308a\u76f4\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \ud504\ub9ac\ud53d\uc2a4\ub97c \ubcf5\uad6c\ud558\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4. Bottle\uc744 \ub2e4\uc2dc \uc0dd\uc131\ud574 \ubcf4\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstellen van de Wine-prefix is mislukt. Maak de fles opnieuw aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie uda\u0142o si\u0119 naprawi\u0107 prefiksu Wine. Spr\u00f3buj utworzy\u0107 butelk\u0119 ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o foi poss\u00edvel reparar o prefixo do Wine. Tente criar a Bottle de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o foi poss\u00edvel reparar o prefixo do Wine. Experimente criar a Bottle de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefixul Wine nu a putut fi reparat. \u00cencearc\u0103 s\u0103 recreezi sticla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u043f\u0440\u0435\u0444\u0438\u043a\u0441 Wine. \u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0431\u0443\u0442\u044b\u043b\u043a\u0443 \u0437\u0430\u043d\u043e\u0432\u043e."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine-prefixet kunde inte repareras. Prova att skapa flaskan p\u00e5 nytt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \u00f6n eki onar\u0131lamad\u0131. L\u00fctfen \u015fi\u015feyi yeniden olu\u015fturmay\u0131 deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0432\u0456\u0434\u043d\u043e\u0432\u0438\u0442\u0438 \u043f\u0440\u0435\u0444\u0456\u043a\u0441 Wine. \u0421\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u043f\u043b\u044f\u0448\u043a\u0443 \u0437\u0430\u043d\u043e\u0432\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng s\u1eeda \u0111\u01b0\u1ee3c prefix Wine. H\u00e3y th\u1eed t\u1ea1o l\u1ea1i bottle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e0\u6cd5\u4fee\u590d Wine \u524d\u7f00\u3002\u8bf7\u5c1d\u8bd5\u91cd\u65b0\u521b\u5efa Bottle\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121\u6cd5\u4fee\u5fa9 Wine \u524d\u7db4\u3002\u8acb\u5617\u8a66\u91cd\u65b0\u5efa\u7acb Bottle\u3002"
          }
        }
      }
    },
