        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0456\u0434'\u0454\u0434\u043d\u0430\u0439\u0442\u0435 \u0447\u0435\u0440\u0435\u0437 USB \u0430\u0431\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u0421\u0438\u0441\u0442\u0435\u043c\u043d\u0456 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0438"
