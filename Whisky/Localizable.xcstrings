          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozdzielczo\u015b\u0107 zadzia\u0142a przy nast\u0119pnym uruchomieniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resolu\u00e7\u00e3o vale na pr\u00f3xima abertura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
