    "config.graphics.backend.d3dMetal.missingWarning": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0647\u0630\u0647 \u0627\u0644\u0632\u062c\u0627\u062c\u0629 \u0645\u0636\u0628\u0648\u0637\u0629 \u0639\u0644\u0649 D3DMetal\u060c \u0648\u0647\u0648 \u063a\u064a\u0631 \u0645\u0636\u0645\u0651\u0646 \u0641\u064a \u0627\u0644\u0645\u062d\u0631\u0643 \u0627\u0644\u0645\u062b\u0628\u062a. \u0633\u062a\u0639\u0648\u062f \u0627\u0644\u0623\u0644\u0639\u0627\u0628 \u0625\u0644\u0649 WineD3D \u0627\u0644\u0630\u064a \u0644\u0627 \u064a\u0633\u062a\u0637\u064a\u0639 \u062a\u0634\u063a\u064a\u0644 \u0623\u0644\u0639\u0627\u0628 DirectX 11 \u2014 \u0628\u062f\u0651\u0644 \u0625\u0644\u0649 DXMT \u0623\u0648 DXVK."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato l\u00e1hev m\u00e1 nastaven\u00fd D3DMetal, kter\u00fd nainstalovan\u00e9 prost\u0159ed\u00ed neobsahuje. Hry p\u0159ejdou na WineD3D, kter\u00fd neum\u00ed hry s DirectX 11 \u2014 p\u0159epn\u011bte na DXMT nebo DXVK."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne flaske er indstillet til D3DMetal, som ikke findes i den installerede engine. Spil falder tilbage til WineD3D, der ikke kan k\u00f8re DirectX 11-titler \u2014 skift til DXMT eller DXVK."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00fcr diese Flasche ist D3DMetal eingestellt, das in der installierten Engine nicht enthalten ist. Spiele weichen auf WineD3D aus, das keine DirectX-11-Titel ausf\u00fchren kann \u2013 wechsle zu DXMT oder DXVK."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This bottle is set to D3DMetal, which the installed engine doesn't include. Games will fall back to WineD3D, which can't run DirectX 11 titles \u2014 switch to DXMT or DXVK."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This bottle is set to D3DMetal, which the installed engine doesn't include. Games will fall back to WineD3D, which can't run DirectX 11 titles \u2014 switch to DXMT or DXVK."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta botella usa D3DMetal, que el motor instalado no incluye. Los juegos recurrir\u00e1n a WineD3D, que no puede ejecutar t\u00edtulos DirectX 11: cambia a DXMT o DXVK."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00e4m\u00e4 pullo on asetettu k\u00e4ytt\u00e4m\u00e4\u00e4n D3DMetalia, jota asennettu moottori ei sis\u00e4ll\u00e4. Pelit siirtyv\u00e4t WineD3D:hen, joka ei pysty ajamaan DirectX 11 -pelej\u00e4 \u2014 vaihda DXMT:hen tai DXVK:hon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette bouteille utilise D3DMetal, absent du moteur install\u00e9. Les jeux basculeront sur WineD3D, qui ne peut pas ex\u00e9cuter les titres DirectX 11 \u2014 passez \u00e0 DXMT ou DXVK."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa bottiglia \u00e8 impostata su D3DMetal, che il motore installato non include. I giochi useranno WineD3D, che non pu\u00f2 eseguire i titoli DirectX 11: passa a DXMT o DXVK."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e Bottle \u306f D3DMetal \u306b\u8a2d\u5b9a\u3055\u308c\u3066\u3044\u307e\u3059\u304c\u3001\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u6e08\u307f\u306e\u30a8\u30f3\u30b8\u30f3\u306b\u306f\u542b\u307e\u308c\u3066\u3044\u307e\u305b\u3093\u3002\u30b2\u30fc\u30e0\u306f WineD3D \u306b\u30d5\u30a9\u30fc\u30eb\u30d0\u30c3\u30af\u3057\u3001DirectX 11 \u306e\u30bf\u30a4\u30c8\u30eb\u306f\u5b9f\u884c\u3067\u304d\u307e\u305b\u3093\u3002DXMT \u307e\u305f\u306f DXVK \u306b\u5207\u308a\u66ff\u3048\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 Bottle\uc740 D3DMetal\ub85c \uc124\uc815\ub418\uc5b4 \uc788\uc9c0\ub9cc \uc124\uce58\ub41c \uc5d4\uc9c4\uc5d0\ub294 \ud3ec\ud568\ub418\uc5b4 \uc788\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uac8c\uc784\uc740 WineD3D\ub85c \ub300\uccb4 \uc2e4\ud589\ub418\uc5b4 DirectX 11 \ud0c0\uc774\ud2c0\uc744 \uc2e4\ud589\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. DXMT \ub610\ub294 DXVK\ub85c \uc804\ud658\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze fles is ingesteld op D3DMetal, dat niet in de ge\u00efnstalleerde engine zit. Games vallen terug op WineD3D, dat geen DirectX 11-titels kan draaien \u2014 schakel over naar DXMT of DXVK."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta butelka ma ustawiony D3DMetal, kt\u00f3rego nie zawiera zainstalowany silnik. Gry prze\u0142\u0105cz\u0105 si\u0119 na WineD3D, kt\u00f3ry nie obs\u0142uguje DirectX 11 \u2014 wybierz DXMT lub DXVK."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Bottle est\u00e1 definida para D3DMetal, que o motor instalado n\u00e3o inclui. Os jogos v\u00e3o recorrer ao WineD3D, que n\u00e3o roda t\u00edtulos DirectX 11 \u2014 mude para DXMT ou DXVK."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Bottle est\u00e1 definida para D3DMetal, que o motor instalado n\u00e3o inclui. Os jogos v\u00e3o recorrer ao WineD3D, que n\u00e3o consegue executar t\u00edtulos DirectX 11 \u2014 mude para DXMT ou DXVK."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceast\u0103 sticl\u0103 este setat\u0103 pe D3DMetal, care nu este inclus \u00een motorul instalat. Jocurile vor folosi WineD3D, care nu poate rula titluri DirectX 11 \u2014 treci la DXMT sau DXVK."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043b\u044f \u044d\u0442\u043e\u0439 \u0431\u0443\u0442\u044b\u043b\u043a\u0438 \u0432\u044b\u0431\u0440\u0430\u043d D3DMetal, \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043d\u0435\u0442 \u0432 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u043e\u0439 \u0441\u0440\u0435\u0434\u0435. \u0418\u0433\u0440\u044b \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0441\u044f \u043d\u0430 WineD3D, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0435 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 DirectX 11 \u2014 \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 DXMT \u0438\u043b\u0438 DXVK."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den h\u00e4r flaskan \u00e4r inst\u00e4lld p\u00e5 D3DMetal, som inte ing\u00e5r i den installerade motorn. Spel faller tillbaka p\u00e5 WineD3D, som inte kan k\u00f6ra DirectX 11-titlar \u2014 byt till DXMT eller DXVK."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu \u015fi\u015fe D3DMetal olarak ayarl\u0131, ancak y\u00fckl\u00fc motor bunu i\u00e7ermiyor. Oyunlar WineD3D'ye geri d\u00f6ner ve DirectX 11 oyunlar\u0131 \u00e7al\u0131\u015fmaz \u2014 DXMT veya DXVK'ya ge\u00e7in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043b\u044f \u0446\u0456\u0454\u0457 \u043f\u043b\u044f\u0448\u043a\u0438 \u0432\u0438\u0431\u0440\u0430\u043d\u043e D3DMetal, \u044f\u043a\u043e\u0433\u043e \u043d\u0435\u043c\u0430\u0454 \u0443 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043e\u043c\u0443 \u0440\u0443\u0448\u0456\u0457. \u0406\u0433\u0440\u0438 \u043f\u0435\u0440\u0435\u0439\u0434\u0443\u0442\u044c \u043d\u0430 WineD3D, \u0449\u043e \u043d\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454 DirectX 11 \u2014 \u0432\u0438\u0431\u0435\u0440\u0456\u0442\u044c DXMT \u0430\u0431\u043e DXVK."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bottle n\u00e0y \u0111\u01b0\u1ee3c \u0111\u1eb7t d\u00f9ng D3DMetal, nh\u01b0ng engine \u0111\u00e3 c\u00e0i kh\u00f4ng c\u00f3 s\u1eb5n. Game s\u1ebd l\u00f9i v\u1ec1 WineD3D, v\u1ed1n kh\u00f4ng ch\u1ea1y \u0111\u01b0\u1ee3c game DirectX 11 \u2014 h\u00e3y chuy\u1ec3n sang DXMT ho\u1eb7c DXVK."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64 Bottle \u8bbe\u4e3a\u4f7f\u7528 D3DMetal\uff0c\u4f46\u5df2\u5b89\u88c5\u7684\u5f15\u64ce\u5e76\u4e0d\u5305\u542b\u5b83\u3002\u6e38\u620f\u4f1a\u56de\u9000\u5230 WineD3D\uff0c\u800c\u5b83\u65e0\u6cd5\u8fd0\u884c DirectX 11 \u6e38\u620f \u2014 \u8bf7\u6539\u7528 DXMT \u6216 DXVK\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64 Bottle \u8a2d\u70ba\u4f7f\u7528 D3DMetal\uff0c\u4f46\u5df2\u5b89\u88dd\u7684\u5f15\u64ce\u4e26\u672a\u5305\u542b\u5b83\u3002\u904a\u6232\u6703\u9000\u56de\u4f7f\u7528 WineD3D\uff0c\u800c\u5b83\u7121\u6cd5\u57f7\u884c DirectX 11 \u904a\u6232 \u2014 \u8acb\u6539\u7528 DXMT \u6216 DXVK\u3002"
          }
        }
      }
    },
    "config.graphics.backend.d3dMetal.summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0637\u0628\u0642\u0629 Apple \u0644\u062a\u0631\u062c\u0645\u0629 Direct3D \u0625\u0644\u0649 Metal\u060c \u0648\u0647\u064a \u0627\u0644\u0623\u0633\u0631\u0639 \u0639\u0644\u0649 Apple Silicon \u0644\u0648\u0627\u062c\u0647\u0627\u062a D3D9\u201312."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "P\u0159eklad Direct3D do Metalu od Apple, nejrychlej\u0161\u00ed na Apple Silicon pro D3D9\u201312."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples overs\u00e6ttelse fra Direct3D til Metal, hurtigst p\u00e5 Apple Silicon til D3D9\u201312."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples \u00dcbersetzung von Direct3D nach Metal, auf Apple Silicon am schnellsten f\u00fcr D3D9\u201312."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's Direct3D-to-Metal translation, fastest on Apple Silicon for D3D9\u201312."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's Direct3D-to-Metal translation, fastest on Apple Silicon for D3D9\u201312."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traducci\u00f3n de Direct3D a Metal de Apple, la m\u00e1s r\u00e1pida en Apple Silicon para D3D9\u201312."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Applen Direct3D\u2013Metal-k\u00e4\u00e4nn\u00f6skerros, nopein Apple Siliconilla D3D9\u201312:lle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduction Direct3D vers Metal sign\u00e9e Apple, la plus rapide sur Apple Silicon pour D3D9\u201312."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduzione Direct3D-Metal di Apple, la pi\u00f9 veloce su Apple Silicon per D3D9\u201312."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple \u306e Direct3D \u304b\u3089 Metal \u3078\u306e\u5909\u63db\u3002Apple Silicon \u3067\u306f D3D9\u301c12 \u3067\u6700\u901f\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple\uc758 Direct3D\ub97c Metal\ub85c \ubcc0\ud658\ud569\ub2c8\ub2e4. Apple Silicon\uc5d0\uc11c D3D9~12\uc5d0 \uac00\uc7a5 \ube60\ub985\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's vertaling van Direct3D naar Metal, het snelst op Apple Silicon voor D3D9\u201312."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Translacja Direct3D na Metal od Apple, najszybsza na Apple Silicon dla D3D9\u201312."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tradu\u00e7\u00e3o de Direct3D para Metal da Apple, a mais r\u00e1pida em Apple Silicon para D3D9\u201312."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tradu\u00e7\u00e3o de Direct3D para Metal da Apple, a mais r\u00e1pida em Apple Silicon para D3D9\u201312."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Traducerea Direct3D \u00een Metal de la Apple, cea mai rapid\u0103 pe Apple Silicon pentru D3D9\u201312."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0440\u0430\u043d\u0441\u043b\u044f\u0446\u0438\u044f Direct3D \u0432 Metal \u043e\u0442 Apple: \u0441\u0430\u043c\u0430\u044f \u0431\u044b\u0441\u0442\u0440\u0430\u044f \u043d\u0430 Apple Silicon \u0434\u043b\u044f D3D9\u201312."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples \u00f6vers\u00e4ttning fr\u00e5n Direct3D till Metal, snabbast p\u00e5 Apple Silicon f\u00f6r D3D9\u201312."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple'\u0131n Direct3D'den Metal'e \u00e7eviri katman\u0131; D3D9\u201312 i\u00e7in Apple Silicon'da en h\u0131zl\u0131s\u0131."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0440\u0430\u043d\u0441\u043b\u044f\u0446\u0456\u044f Direct3D \u0443 Metal \u0432\u0456\u0434 Apple: \u043d\u0430\u0439\u0448\u0432\u0438\u0434\u0448\u0430 \u043d\u0430 Apple Silicon \u0434\u043b\u044f D3D9\u201312."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u1edbp d\u1ecbch Direct3D sang Metal c\u1ee7a Apple, nhanh nh\u1ea5t tr\u00ean Apple Silicon cho D3D9\u201312."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple \u7684 Direct3D \u5230 Metal \u8f6c\u6362\uff0c\u5728 Apple Silicon \u4e0a\u5bf9 D3D9\u201312 \u901f\u5ea6\u6700\u5feb\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple \u7684 Direct3D \u8f49 Metal \u6280\u8853\uff0c\u5728 Apple Silicon \u4e0a\u5c0d D3D9\u201312 \u901f\u5ea6\u6700\u5feb\u3002"
          }
        }
      }
    },
    "config.graphics.backend.d3dMetal.unavailable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u063a\u064a\u0631 \u0645\u0636\u0645\u0651\u0646 \u0641\u064a \u0627\u0644\u0645\u062d\u0631\u0643 \u0627\u0644\u0645\u062b\u0628\u062a \u2014 \u064a\u062a\u0637\u0644\u0628 \u0628\u064a\u0626\u0629 \u062a\u0634\u063a\u064a\u0644 Game Porting Toolkit"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nen\u00ed v nainstalovan\u00e9m prost\u0159ed\u00ed \u2014 vy\u017eaduje prost\u0159ed\u00ed Game Porting Toolkit"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Findes ikke i den installerede engine \u2014 kr\u00e6ver en Game Porting Toolkit-runtime"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der installierten Engine nicht enthalten \u2013 ben\u00f6tigt eine Game-Porting-Toolkit-Runtime"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not included in the installed engine \u2014 needs a Game Porting Toolkit runtime"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Not included in the installed engine \u2014 needs a Game Porting Toolkit runtime"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se incluye en el motor instalado: necesita un runtime de Game Porting Toolkit"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei sis\u00e4lly asennettuun moottoriin \u2014 vaatii Game Porting Toolkit -ajoymp\u00e4rist\u00f6n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Absent du moteur install\u00e9 \u2014 n\u00e9cessite un runtime Game Porting Toolkit"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non incluso nel motore installato: richiede un runtime Game Porting Toolkit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u6e08\u307f\u306e\u30a8\u30f3\u30b8\u30f3\u306b\u306f\u542b\u307e\u308c\u3066\u3044\u307e\u305b\u3093\u3002Game Porting Toolkit \u306e\u30e9\u30f3\u30bf\u30a4\u30e0\u304c\u5fc5\u8981\u3067\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc124\uce58\ub41c \uc5d4\uc9c4\uc5d0 \ud3ec\ud568\ub418\uc5b4 \uc788\uc9c0 \uc54a\uc74c \u2014 Game Porting Toolkit \ub7f0\ud0c0\uc784\uc774 \ud544\uc694\ud569\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet inbegrepen in de ge\u00efnstalleerde engine \u2014 vereist een Game Porting Toolkit-runtime"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak w zainstalowanym silniku \u2014 wymaga \u015brodowiska Game Porting Toolkit"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o inclu\u00eddo no motor instalado \u2014 precisa de um runtime do Game Porting Toolkit"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o inclu\u00eddo no motor instalado \u2014 precisa de um runtime Game Porting Toolkit"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu este inclus \u00een motorul instalat \u2014 necesit\u0103 un runtime Game Porting Toolkit"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u0442 \u0432 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u043e\u0439 \u0441\u0440\u0435\u0434\u0435 \u2014 \u043d\u0443\u0436\u043d\u0430 \u0441\u0440\u0435\u0434\u0430 Game Porting Toolkit"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ing\u00e5r inte i den installerade motorn \u2014 kr\u00e4ver en Game Porting Toolkit-runtime"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Y\u00fckl\u00fc motorda bulunmuyor \u2014 Game Porting Toolkit \u00e7al\u0131\u015fma zaman\u0131 gerekir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043c\u0430\u0454 \u0443 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043e\u043c\u0443 \u0440\u0443\u0448\u0456\u0457 \u2014 \u043f\u043e\u0442\u0440\u0456\u0431\u0435\u043d \u0440\u0443\u0448\u0456\u0439 Game Porting Toolkit"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng c\u00f3 trong engine \u0111\u00e3 c\u00e0i \u2014 c\u1ea7n runtime Game Porting Toolkit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u5b89\u88c5\u7684\u5f15\u64ce\u4e0d\u5305\u542b \u2014 \u9700\u8981 Game Porting Toolkit \u8fd0\u884c\u65f6"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u5b89\u88dd\u7684\u5f15\u64ce\u672a\u5305\u542b \u2014 \u9700\u8981 Game Porting Toolkit \u57f7\u884c\u968e\u6bb5"
          }
        }
      }
    },
    "config.graphics.backend.dxmt.summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0631\u062c\u0645\u0629 Direct3D 11 \u0625\u0644\u0649 Metal. \u0642\u062f \u062a\u062a\u0641\u0648\u0642 \u0639\u0644\u0649 D3DMetal \u0641\u064a \u0628\u0639\u0636 \u0623\u0644\u0639\u0627\u0628 DX11."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "P\u0159eklad Direct3D 11 do Metalu. V n\u011bkter\u00fdch hr\u00e1ch s DX11 p\u0159ekon\u00e1 D3DMetal."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Overs\u00e6ttelse fra Direct3D 11 til Metal. Kan v\u00e6re hurtigere end D3DMetal i visse DX11-titler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00dcbersetzung von Direct3D 11 nach Metal. Kann D3DMetal in manchen DX11-Titeln \u00fcbertreffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D-11-to-Metal translation. Can outperform D3DMetal in some DX11 titles."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D-11-to-Metal translation. Can outperform D3DMetal in some DX11 titles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traducci\u00f3n de Direct3D 11 a Metal. Puede superar a D3DMetal en algunos juegos DX11."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D 11 \u2013 Metal -k\u00e4\u00e4nn\u00f6s. Voi olla D3DMetalia nopeampi joissakin DX11-peleiss\u00e4."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduction Direct3D 11 vers Metal. Peut d\u00e9passer D3DMetal sur certains jeux DX11."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduzione Direct3D 11-Metal. In alcuni giochi DX11 pu\u00f2 superare D3DMetal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D 11 \u304b\u3089 Metal \u3078\u306e\u5909\u63db\u3002DX11 \u306e\u30bf\u30a4\u30c8\u30eb\u3067\u306f D3DMetal \u3088\u308a\u9ad8\u901f\u306a\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D 11\uc744 Metal\ub85c \ubcc0\ud658\ud569\ub2c8\ub2e4. \uc77c\ubd80 DX11 \ud0c0\uc774\ud2c0\uc5d0\uc11c\ub294 D3DMetal\ubcf4\ub2e4 \ube60\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertaling van Direct3D 11 naar Metal. Kan D3DMetal in sommige DX11-titels overtreffen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Translacja Direct3D 11 na Metal. W niekt\u00f3rych grach DX11 bywa szybsza ni\u017c D3DMetal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tradu\u00e7\u00e3o de Direct3D 11 para Metal. Pode superar o D3DMetal em alguns t\u00edtulos DX11."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tradu\u00e7\u00e3o de Direct3D 11 para Metal. Em alguns t\u00edtulos DX11 pode superar o D3DMetal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Traducerea Direct3D 11 \u00een Metal. \u00cen unele titluri DX11 poate dep\u0103\u0219i D3DMetal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0440\u0430\u043d\u0441\u043b\u044f\u0446\u0438\u044f Direct3D 11 \u0432 Metal. \u0412 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0445 \u0438\u0433\u0440\u0430\u0445 \u043d\u0430 DX11 \u0431\u044b\u0441\u0442\u0440\u0435\u0435 D3DMetal."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6vers\u00e4ttning fr\u00e5n Direct3D 11 till Metal. Kan vara snabbare \u00e4n D3DMetal i vissa DX11-titlar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D 11'den Metal'e \u00e7eviri. Baz\u0131 DX11 oyunlar\u0131nda D3DMetal'den daha h\u0131zl\u0131 olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0440\u0430\u043d\u0441\u043b\u044f\u0446\u0456\u044f Direct3D 11 \u0443 Metal. \u0412 \u043e\u043a\u0440\u0435\u043c\u0438\u0445 \u0456\u0433\u0440\u0430\u0445 \u043d\u0430 DX11 \u0448\u0432\u0438\u0434\u0448\u0430 \u0437\u0430 D3DMetal."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u1edbp d\u1ecbch Direct3D 11 sang Metal. C\u00f3 th\u1ec3 nhanh h\u01a1n D3DMetal \u1edf m\u1ed9t s\u1ed1 game DX11."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D 11 \u5230 Metal \u7684\u8f6c\u6362\u3002\u5728\u90e8\u5206 DX11 \u6e38\u620f\u4e2d\u53ef\u80fd\u5feb\u4e8e D3DMetal\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D 11 \u8f49 Metal \u7684\u6280\u8853\u3002\u5728\u90e8\u5206 DX11 \u904a\u6232\u4e2d\u53ef\u80fd\u52dd\u904e D3DMetal\u3002"
          }
        }
      }
    },
    "config.graphics.backend.dxmt.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u062a\u0637\u0644\u0628 \u062a\u062d\u062f\u064a\u062b \u0628\u064a\u0626\u0629 \u062a\u0634\u063a\u064a\u0644 Wine. \u0623\u0639\u062f \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0644\u062a\u0646\u0632\u064a\u0644 \u0623\u062d\u062f\u062b \u0625\u0635\u062f\u0627\u0631."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vy\u017eaduje aktualizaci prost\u0159ed\u00ed Wine. Spus\u0165te znovu nastaven\u00ed a st\u00e1hn\u011bte nejnov\u011bj\u0161\u00ed verzi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kr\u00e6ver en opdatering af Wine-runtimen. K\u00f8r ops\u00e6tningen igen for at hente den nyeste runtime."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert eine Aktualisierung der Wine-Runtime. F\u00fchre die Einrichtung erneut aus, um die neueste Runtime zu laden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires a Wine runtime update. Re-run setup to download the latest runtime."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires a Wine runtime update. Re-run setup to download the latest runtime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere actualizar el runtime de Wine. Vuelve a ejecutar la configuraci\u00f3n para descargar el m\u00e1s reciente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaatii Wine-ajoymp\u00e4rist\u00f6n p\u00e4ivityksen. Lataa uusin ajoymp\u00e4rist\u00f6 suorittamalla asennus uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e9cessite une mise \u00e0 jour du runtime Wine. Relancez la configuration pour t\u00e9l\u00e9charger la derni\u00e8re version."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede un aggiornamento del runtime Wine. Riesegui la configurazione per scaricare il runtime pi\u00f9 recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \u30e9\u30f3\u30bf\u30a4\u30e0\u306e\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u304c\u5fc5\u8981\u3067\u3059\u3002\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7\u3092\u3084\u308a\u76f4\u3057\u3066\u6700\u65b0\u306e\u30e9\u30f3\u30bf\u30a4\u30e0\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \ub7f0\ud0c0\uc784 \uc5c5\ub370\uc774\ud2b8\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \uc124\uc815\uc744 \ub2e4\uc2dc \uc2e4\ud589\ud574 \ucd5c\uc2e0 \ub7f0\ud0c0\uc784\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereist een update van de Wine-runtime. Voer de setup opnieuw uit om de nieuwste runtime te downloaden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymaga aktualizacji silnika Wine. Uruchom konfiguracj\u0119 ponownie, aby go pobra\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer uma atualiza\u00e7\u00e3o do runtime do Wine. Execute a configura\u00e7\u00e3o de novo para baixar o runtime mais recente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer uma atualiza\u00e7\u00e3o do runtime do Wine. Volte a executar a configura\u00e7\u00e3o para transferir o runtime mais recente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesit\u0103 actualizarea runtime-ului Wine. Ruleaz\u0103 din nou configurarea pentru a desc\u0103rca cea mai recent\u0103 versiune."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0443\u0436\u043d\u0430 \u043d\u043e\u0432\u0430\u044f \u0432\u0435\u0440\u0441\u0438\u044f \u0441\u0440\u0435\u0434\u044b Wine. \u0417\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0435 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0443 \u0437\u0430\u043d\u043e\u0432\u043e, \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044c \u0435\u0451."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kr\u00e4ver en uppdaterad Wine-runtime. K\u00f6r konfigurationen igen f\u00f6r att h\u00e4mta den senaste runtime-versionen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \u00e7al\u0131\u015fma zaman\u0131 g\u00fcncellemesi gerekir. En son \u00e7al\u0131\u015fma zaman\u0131n\u0131 indirmek i\u00e7in kurulumu yeniden \u00e7al\u0131\u015ft\u0131r\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u043e\u043d\u043e\u0432\u0438\u0442\u0438 \u0440\u0443\u0448\u0456\u0439 Wine. \u0417\u0430\u043f\u0443\u0441\u0442\u0456\u0442\u044c \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0449\u0435 \u0440\u0430\u0437, \u0449\u043e\u0431 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438 \u0439\u043e\u0433\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u1ea7n c\u1eadp nh\u1eadt runtime Wine. H\u00e3y ch\u1ea1y l\u1ea1i ph\u1ea7n c\u00e0i \u0111\u1eb7t \u0111\u1ec3 t\u1ea3i runtime m\u1edbi nh\u1ea5t."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9700\u8981\u66f4\u65b0 Wine \u8fd0\u884c\u65f6\u3002\u8bf7\u91cd\u65b0\u8fd0\u884c\u8bbe\u7f6e\u4ee5\u4e0b\u8f7d\u6700\u65b0\u8fd0\u884c\u65f6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9700\u8981\u66f4\u65b0 Wine \u57f7\u884c\u968e\u6bb5\u3002\u8acb\u91cd\u65b0\u57f7\u884c\u8a2d\u5b9a\u6d41\u7a0b\u4ee5\u4e0b\u8f09\u6700\u65b0\u7248\u672c\u3002"
          }
        }
      }
    },
    "config.graphics.backend.dxvk.summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0631\u062c\u0645\u0629 Direct3D \u0625\u0644\u0649 Vulkan \u0639\u0628\u0631 MoltenVK\u060c \u0645\u0639 \u062a\u0648\u0627\u0641\u0642 \u0623\u0648\u0633\u0639 \u0645\u0639 \u0623\u0644\u0639\u0627\u0628 D3D10/11."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "P\u0159eklad Direct3D do Vulkanu p\u0159es MoltenVK; \u0161ir\u0161\u00ed kompatibilita u her s D3D10/11."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D til Vulkan via MoltenVK; bredere kompatibilitet for D3D10/11-titler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D nach Vulkan \u00fcber MoltenVK; breitere Kompatibilit\u00e4t f\u00fcr D3D10/11-Titel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D-to-Vulkan via MoltenVK; broader compatibility for D3D10/11 titles."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D-to-Vulkan via MoltenVK; broader compatibility for D3D10/11 titles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D a Vulkan mediante MoltenVK; mayor compatibilidad con juegos D3D10/11."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D\u2013Vulkan MoltenVK:n kautta; laajempi yhteensopivuus D3D10/11-peleiss\u00e4."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D vers Vulkan via MoltenVK ; compatibilit\u00e9 plus large pour les jeux D3D10/11."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D-Vulkan tramite MoltenVK; compatibilit\u00e0 pi\u00f9 ampia per i giochi D3D10/11."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MoltenVK \u7d4c\u7531\u3067 Direct3D \u3092 Vulkan \u306b\u5909\u63db\u3057\u307e\u3059\u3002D3D10/11 \u306e\u30bf\u30a4\u30c8\u30eb\u3067\u5e45\u5e83\u3044\u4e92\u63db\u6027\u304c\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MoltenVK\ub97c \ud1b5\ud574 Direct3D\ub97c Vulkan\uc73c\ub85c \ubcc0\ud658\ud569\ub2c8\ub2e4. D3D10/11 \ud0c0\uc774\ud2c0\uc5d0\uc11c \ud638\ud658\uc131\uc774 \ub354 \ub113\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D naar Vulkan via MoltenVK; bredere compatibiliteit voor D3D10/11-titels."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Translacja Direct3D na Vulkan przez MoltenVK; szersza zgodno\u015b\u0107 w grach D3D10/11."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D para Vulkan via MoltenVK; compatibilidade mais ampla em t\u00edtulos D3D10/11."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D para Vulkan atrav\u00e9s de MoltenVK; compatibilidade mais ampla em t\u00edtulos D3D10/11."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D \u00een Vulkan prin MoltenVK; compatibilitate mai larg\u0103 pentru titlurile D3D10/11."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0440\u0430\u043d\u0441\u043b\u044f\u0446\u0438\u044f Direct3D \u0432 Vulkan \u0447\u0435\u0440\u0435\u0437 MoltenVK: \u0448\u0438\u0440\u0435 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u0438\u043c\u043e\u0441\u0442\u044c \u0441 \u0438\u0433\u0440\u0430\u043c\u0438 \u043d\u0430 D3D10/11."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D till Vulkan via MoltenVK; bredare kompatibilitet f\u00f6r D3D10/11-titlar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MoltenVK \u00fczerinden Direct3D'den Vulkan'a; D3D10/11 oyunlar\u0131nda daha geni\u015f uyumluluk."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0440\u0430\u043d\u0441\u043b\u044f\u0446\u0456\u044f Direct3D \u0443 Vulkan \u0447\u0435\u0440\u0435\u0437 MoltenVK: \u0448\u0438\u0440\u0448\u0430 \u0441\u0443\u043c\u0456\u0441\u043d\u0456\u0441\u0442\u044c \u0437 \u0456\u0433\u0440\u0430\u043c\u0438 \u043d\u0430 D3D10/11."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D sang Vulkan qua MoltenVK; t\u01b0\u01a1ng th\u00edch r\u1ed9ng h\u01a1n v\u1edbi game D3D10/11."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u901a\u8fc7 MoltenVK \u5c06 Direct3D \u8f6c\u6362\u4e3a Vulkan\uff1b\u5bf9 D3D10/11 \u6e38\u620f\u7684\u517c\u5bb9\u6027\u66f4\u5e7f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u900f\u904e MoltenVK \u5c07 Direct3D \u8f49\u70ba Vulkan\uff1b\u5c0d D3D10/11 \u904a\u6232\u7684\u76f8\u5bb9\u6027\u66f4\u5ee3\u3002"
          }
        }
      }
