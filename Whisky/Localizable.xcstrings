            "state": "translated",
            "value": "\u30c6\u30ad\u30b9\u30c8\u306f\u3053\u306e\u3088\u3046\u306b\u898b\u3048\u307e\u3059:"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud14d\uc2a4\ud2b8\ub294 \ub2e4\uc74c\uacfc \uac19\uc774 \ud45c\uc2dc\ub420 \uac83\uc785\ub2c8\ub2e4:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst ziet er als volgt uit:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst b\u0119dzie wygl\u0105da\u0142 tak:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto ficar\u00e1 assim:"
          }
        },
        "pt-PT": {
