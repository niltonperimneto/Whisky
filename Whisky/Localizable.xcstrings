          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun pacchetto Game Porting Toolkit importato da distribuire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u914d\u7f6e\u3067\u304d\u308b\u3001\u8aad\u307f\u8fbc\u307f\u6e08\u307f\u306e Game Porting Toolkit \u306e\u30da\u30a4\u30ed\u30fc\u30c9\u304c\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubc30\ud3ec\ud560 \uc218 \uc788\ub3c4\ub85d \uac00\uc838\uc628 Game Porting Toolkit \ud398\uc774\ub85c\ub4dc\uac00 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen ge\u00efmporteerde Game Porting Toolkit-payload om uit te rollen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak zaimportowanego pakietu Game Porting Toolkit do wdro\u017cenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum pacote do Game Porting Toolkit importado para implantar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o h\u00e1 nenhum pacote do Game Porting Toolkit importado para implementar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu exist\u0103 niciun pachet Game Porting Toolkit importat pentru instalare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u0442 \u0438\u043c\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u043f\u0430\u043a\u0435\u0442\u0430 Game Porting Toolkit \u0434\u043b\u044f \u0440\u0430\u0437\u0432\u0451\u0440\u0442\u044b\u0432\u0430\u043d\u0438\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns ingen importerad Game Porting Toolkit-payload att installera."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Da\u011f\u0131t\u0131lacak, i\u00e7e aktar\u0131lm\u0131\u015f bir Game Porting Toolkit paketi yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043c\u0430\u0454 \u0456\u043c\u043f\u043e\u0440\u0442\u043e\u0432\u0430\u043d\u043e\u0433\u043e \u043f\u0430\u043a\u0435\u0442\u0430 Game Porting Toolkit \u0434\u043b\u044f \u0440\u043e\u0437\u0433\u043e\u0440\u0442\u0430\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u01b0a c\u00f3 g\u00f3i Game Porting Toolkit n\u00e0o \u0111\u01b0\u1ee3c nh\u1eadp \u0111\u1ec3 tri\u1ec3n khai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ca1\u6709\u53ef\u90e8\u7f72\u7684\u5df2\u5bfc\u5165 Game Porting Toolkit \u8d1f\u8f7d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c92\u6709\u53ef\u90e8\u7f72\u7684\u5df2\u532f\u5165 Game Porting Toolkit \u916c\u8f09\u3002"
          }
