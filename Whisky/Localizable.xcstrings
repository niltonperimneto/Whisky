    "config.graphics.backend.recommended.summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u062a\u0631\u0643 \u0644\u0640 Whisky \u0627\u062e\u062a\u064a\u0627\u0631 \u0623\u0641\u0636\u0644 \u0648\u0627\u062c\u0647\u0629 \u062e\u0644\u0641\u064a\u0629 \u0644\u062c\u0647\u0627\u0632\u0643."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky sama vybere nejlep\u0161\u00ed backend pro v\u00e1\u0161 po\u010d\u00edta\u010d."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lader Whisky v\u00e6lge den bedste backend til din Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00e4sst Whisky das beste Backend f\u00fcr deinen Mac w\u00e4hlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets Whisky choose the best backend for your machine."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets Whisky choose the best backend for your machine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja que Whisky elija el mejor backend para tu equipo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Antaa Whiskyn valita koneellesi parhaan taustaj\u00e4rjestelm\u00e4n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse Whisky choisir le meilleur backend pour votre machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia che Whisky scelga il backend migliore per il tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u304a\u4f7f\u3044\u306e Mac \u306b\u6700\u9069\u306a\u30d0\u30c3\u30af\u30a8\u30f3\u30c9\u3092 Whisky \u304c\u9078\u3073\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky\uac00 \uc774 Mac\uc5d0 \uac00\uc7a5 \uc801\ud569\ud55c \ubc31\uc5d4\ub4dc\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat Whisky de beste backend voor je Mac kiezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky sam wybierze najlepszy backend dla Twojego komputera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa o Whisky escolher o melhor backend para o seu Mac."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa o Whisky escolher o melhor backend para o seu Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Las\u0103 Whisky s\u0103 aleag\u0103 cel mai bun backend pentru Mac-ul t\u0103u."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky \u0441\u0430\u043c \u0432\u044b\u0431\u0435\u0440\u0435\u0442 \u043b\u0443\u0447\u0448\u0438\u0439 \u0431\u044d\u043a\u0435\u043d\u0434 \u0434\u043b\u044f \u0432\u0430\u0448\u0435\u0433\u043e \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00e5ter Whisky v\u00e4lja den b\u00e4sta backenden f\u00f6r din dator."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky'nin makineniz i\u00e7in en iyi arka ucu se\u00e7mesini sa\u011flar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky \u0441\u0430\u043c \u0432\u0438\u0431\u0435\u0440\u0435 \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u0439 \u0431\u0435\u043a\u0435\u043d\u0434 \u0434\u043b\u044f \u0432\u0430\u0448\u043e\u0433\u043e \u043a\u043e\u043c\u043f'\u044e\u0442\u0435\u0440\u0430."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u1ec3 Whisky ch\u1ecdn backend t\u1ed1t nh\u1ea5t cho m\u00e1y c\u1ee7a b\u1ea1n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7531 Whisky \u4e3a\u4f60\u7684\u7535\u8111\u9009\u62e9\u6700\u5408\u9002\u7684\u540e\u7aef\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8b93 Whisky \u70ba\u4f60\u7684\u96fb\u8166\u9078\u64c7\u6700\u5408\u9069\u7684\u5f8c\u7aef\u3002"
          }
        }
      }
    },
    "config.graphics.backend.wined3d.summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0631\u062c\u0645\u0629 OpenGL \u0627\u0644\u0645\u062f\u0645\u062c\u0629 \u0641\u064a Wine\u060c \u0648\u0647\u064a \u062e\u064a\u0627\u0631 \u0627\u062d\u062a\u064a\u0627\u0637\u064a \u0642\u062f\u064a\u0645."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vestav\u011bn\u00fd p\u0159eklad Wine do OpenGL; star\u0161\u00ed z\u00e1lo\u017en\u00ed \u0159e\u0161en\u00ed."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Wines indbyggede OpenGL-overs\u00e6ttelse; reservel\u00f8sning til \u00e6ldre titler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wines integrierte OpenGL-\u00dcbersetzung; Ausweichoption f\u00fcr \u00e4ltere Titel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine's built-in OpenGL translation; legacy fallback."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine's built-in OpenGL translation; legacy fallback."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traducci\u00f3n a OpenGL integrada en Wine; alternativa heredada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Winen sis\u00e4inen OpenGL-k\u00e4\u00e4nn\u00f6s; vanha varavaihtoehto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduction OpenGL int\u00e9gr\u00e9e \u00e0 Wine ; solution de repli h\u00e9rit\u00e9e."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduzione OpenGL integrata in Wine; alternativa legacy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \u5185\u8535\u306e OpenGL \u5909\u63db\u3002\u5f93\u6765\u304b\u3089\u306e\u4ee3\u66ff\u624b\u6bb5\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine\uc5d0 \ub0b4\uc7a5\ub41c OpenGL \ubcc0\ud658\uc73c\ub85c, \uc608\uc804 \ubc29\uc2dd\uc758 \ub300\uccb4 \uc218\ub2e8\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wines ingebouwde OpenGL-vertaling; terugvaloptie voor oudere titels."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wbudowana translacja Wine na OpenGL; starsze rozwi\u0105zanie awaryjne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tradu\u00e7\u00e3o OpenGL nativa do Wine; alternativa legada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tradu\u00e7\u00e3o OpenGL integrada no Wine; alternativa antiga."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Traducerea OpenGL integrat\u0103 \u00een Wine; alternativ\u0103 mai veche."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u0430\u044f \u0442\u0440\u0430\u043d\u0441\u043b\u044f\u0446\u0438\u044f Wine \u0432 OpenGL: \u0443\u0441\u0442\u0430\u0440\u0435\u0432\u0448\u0438\u0439 \u0437\u0430\u043f\u0430\u0441\u043d\u043e\u0439 \u0432\u0430\u0440\u0438\u0430\u043d\u0442."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Wines inbyggda OpenGL-\u00f6vers\u00e4ttning; reservalternativ f\u00f6r \u00e4ldre titlar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine'\u0131n yerle\u015fik OpenGL \u00e7evirisi; eski yedek se\u00e7enek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0431\u0443\u0434\u043e\u0432\u0430\u043d\u0430 \u0442\u0440\u0430\u043d\u0441\u043b\u044f\u0446\u0456\u044f Wine \u0432 OpenGL: \u0437\u0430\u0441\u0442\u0430\u0440\u0456\u043b\u0438\u0439 \u0437\u0430\u043f\u0430\u0441\u043d\u0438\u0439 \u0432\u0430\u0440\u0456\u0430\u043d\u0442."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u1edbp d\u1ecbch OpenGL t\u00edch h\u1ee3p c\u1ee7a Wine; ph\u01b0\u01a1ng \u00e1n d\u1ef1 ph\u00f2ng c\u0169."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \u5185\u5efa\u7684 OpenGL \u8f6c\u6362\uff1b\u4f5c\u4e3a\u65e7\u65b9\u6848\u7684\u5907\u9009\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \u5167\u5efa\u7684 OpenGL \u8f49\u63db\uff1b\u70ba\u820a\u6709\u7684\u5099\u63f4\u65b9\u6848\u3002"
          }
        }
      }
    },
