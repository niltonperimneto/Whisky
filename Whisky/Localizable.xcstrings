        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jde o z\u00e1sadn\u00ed zm\u011bnu. Opravdu pokra\u010dovat?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er en gennemgribende \u00e6ndring. Er du sikker?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist eine weitreichende \u00c4nderung. Bist du sicher?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a high-impact change. Are you sure?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a high-impact change. Are you sure?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un cambio de gran impacto. \u00bfSeguro que quieres continuar?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00e4m\u00e4 on vaikutuksiltaan suuri muutos. Oletko varma?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette modification a un impact important. Confirmer ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c8 una modifica ad alto impatto. Vuoi procedere?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f71\u97ff\u306e\u5927\u304d\u3044\u5909\u66f4\u3067\u3059\u3002\u5b9f\u884c\u3057\u3066\u3082\u3088\u308d\u3057\u3044\u3067\u3059\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc601\ud5a5\uc774 \ud070 \ubcc0\uacbd\uc785\ub2c8\ub2e4. \uacc4\uc18d\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een ingrijpende wijziging. Weet je het zeker?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zmiana o du\u017cym wp\u0142ywie. Na pewno?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta \u00e9 uma altera\u00e7\u00e3o de grande impacto. Quer continuar?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta altera\u00e7\u00e3o tem grande impacto. Pretende continuar?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este o modificare cu impact mare. Continui?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u043e \u0441\u0435\u0440\u044c\u0451\u0437\u043d\u043e\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435. \u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u044c?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det h\u00e4r \u00e4r en genomgripande \u00e4ndring. \u00c4r du s\u00e4ker?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, etkisi b\u00fcy\u00fck bir de\u011fi\u015fiklik. Emin misiniz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0426\u0435 \u0441\u0443\u0442\u0442\u0454\u0432\u0430 \u0437\u043c\u0456\u043d\u0430. \u041f\u0440\u043e\u0434\u043e\u0432\u0436\u0438\u0442\u0438?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e2y l\u00e0 thay \u0111\u1ed5i c\u00f3 t\u00e1c \u0111\u1ed9ng l\u1edbn. B\u1ea1n ch\u1eafc ch\u1ee9?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fd9\u662f\u5f71\u54cd\u8f83\u5927\u7684\u66f4\u6539\u3002\u786e\u5b9a\u8981\u7ee7\u7eed\u5417\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9019\u662f\u5f71\u97ff\u8f03\u5927\u7684\u8b8a\u66f4\u3002\u78ba\u5b9a\u8981\u7e7c\u7e8c\u55ce\uff1f"
          }
        }
      }
    },
