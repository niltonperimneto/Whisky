    "wine.dxmt.error.payloadMissing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "DXMT \u063a\u064a\u0631 \u0645\u0636\u0645\u0651\u0646 \u0641\u064a \u0628\u064a\u0626\u0629 \u062a\u0634\u063a\u064a\u0644 Wine \u0627\u0644\u0645\u062b\u0628\u062a\u0629. \u062d\u062f\u0651\u062b \u0628\u064a\u0626\u0629 \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0645\u0646 \u0625\u0639\u062f\u0627\u062f Whisky \u062b\u0645 \u0623\u0639\u062f \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "DXMT nen\u00ed sou\u010d\u00e1st\u00ed nainstalovan\u00e9ho prost\u0159ed\u00ed Wine. Aktualizujte prost\u0159ed\u00ed v nastaven\u00ed Whisky a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "DXMT findes ikke i den installerede Wine-runtime. Opdater runtimen via Whiskys ops\u00e6tning, og pr\u00f8v igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DXMT ist in der installierten Wine-Runtime nicht enthalten. Aktualisiere die Runtime \u00fcber die Einrichtung von Whisky und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DXMT is not included in the installed Wine runtime. Update the runtime from Whisky's setup and try again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "DXMT is not included in the installed Wine runtime. Update the runtime from Whisky's setup and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DXMT no se incluye en el runtime de Wine instalado. Actualiza el runtime desde la configuraci\u00f3n de Whisky e int\u00e9ntalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "DXMT ei sis\u00e4lly asennettuun Wine-ajoymp\u00e4rist\u00f6\u00f6n. P\u00e4ivit\u00e4 ajoymp\u00e4rist\u00f6 Whiskyn asennuksesta ja yrit\u00e4 uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DXMT n'est pas inclus dans le runtime Wine install\u00e9. Mettez le runtime \u00e0 jour depuis la configuration de Whisky, puis r\u00e9essayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "DXMT non \u00e8 incluso nel runtime Wine installato. Aggiorna il runtime dalla configurazione di Whisky e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u6e08\u307f\u306e Wine \u30e9\u30f3\u30bf\u30a4\u30e0\u306b DXMT \u304c\u542b\u307e\u308c\u3066\u3044\u307e\u305b\u3093\u3002Whisky \u306e\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7\u304b\u3089\u30e9\u30f3\u30bf\u30a4\u30e0\u3092\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3057\u3066\u3001\u3082\u3046\u4e00\u5ea6\u304a\u8a66\u3057\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc124\uce58\ub41c Wine \ub7f0\ud0c0\uc784\uc5d0 DXMT\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. Whisky \uc124\uc815\uc5d0\uc11c \ub7f0\ud0c0\uc784\uc744 \uc5c5\ub370\uc774\ud2b8\ud55c \ub4a4 \ub2e4\uc2dc \uc2dc\ub3c4\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "DXMT zit niet in de ge\u00efnstalleerde Wine-runtime. Werk de runtime bij via de setup van Whisky en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "DXMT nie jest cz\u0119\u015bci\u0105 zainstalowanego silnika Wine. Zaktualizuj silnik w konfiguracji Whisky i spr\u00f3buj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O DXMT n\u00e3o est\u00e1 inclu\u00eddo no runtime do Wine instalado. Atualize o runtime pela configura\u00e7\u00e3o do Whisky e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O DXMT n\u00e3o est\u00e1 inclu\u00eddo no runtime do Wine instalado. Atualize o runtime a partir da configura\u00e7\u00e3o do Whisky e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "DXMT nu este inclus \u00een runtime-ul Wine instalat. Actualizeaz\u0103 runtime-ul din configurarea Whisky \u0219i \u00eencearc\u0103 din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "DXMT \u043d\u0435\u0442 \u0432 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u043e\u0439 \u0441\u0440\u0435\u0434\u0435 Wine. \u041e\u0431\u043d\u043e\u0432\u0438\u0442\u0435 \u0441\u0440\u0435\u0434\u0443 \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0435 Whisky \u0438 \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0441\u043d\u043e\u0432\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "DXMT ing\u00e5r inte i den installerade Wine-runtime. Uppdatera den via Whiskys konfiguration och f\u00f6rs\u00f6k igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DXMT, y\u00fckl\u00fc Wine \u00e7al\u0131\u015fma zaman\u0131na dahil de\u011fil. \u00c7al\u0131\u015fma zaman\u0131n\u0131 Whisky kurulumundan g\u00fcncelleyip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "DXMT \u043d\u0435\u043c\u0430\u0454 \u0443 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043e\u043c\u0443 \u0440\u0443\u0448\u0456\u0457 Wine. \u041e\u043d\u043e\u0432\u0456\u0442\u044c \u0440\u0443\u0448\u0456\u0439 \u0443 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u0456 Whisky \u0456 \u0441\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0437\u043d\u043e\u0432\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime Wine \u0111\u00e3 c\u00e0i kh\u00f4ng bao g\u1ed3m DXMT. H\u00e3y c\u1eadp nh\u1eadt runtime t\u1eeb ph\u1ea7n c\u00e0i \u0111\u1eb7t c\u1ee7a Whisky r\u1ed3i th\u1eed l\u1ea1i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u5b89\u88c5\u7684 Wine \u8fd0\u884c\u65f6\u4e0d\u5305\u542b DXMT\u3002\u8bf7\u5728 Whisky \u7684\u8bbe\u7f6e\u6d41\u7a0b\u4e2d\u66f4\u65b0\u8fd0\u884c\u65f6\u540e\u91cd\u8bd5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u5b89\u88dd\u7684 Wine \u57f7\u884c\u968e\u6bb5\u672a\u5305\u542b DXMT\u3002\u8acb\u5728 Whisky \u7684\u8a2d\u5b9a\u6d41\u7a0b\u4e2d\u66f4\u65b0\u57f7\u884c\u968e\u6bb5\u5f8c\u91cd\u8a66\u3002"
          }
        }
      }
    },
