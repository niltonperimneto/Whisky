        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkuste p\u0159ipojen\u00ed p\u0159es USB nebo Nastaven\u00ed syst\u00e9mu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
