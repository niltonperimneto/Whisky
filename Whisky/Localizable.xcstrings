        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozli\u0161en\u00ed se projev\u00ed p\u0159i p\u0159\u00ed\u0161t\u00edm spu\u0161t\u011bn\u00ed."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
