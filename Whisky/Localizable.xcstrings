    "gameConfig.revert.confirm.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0633\u062a\u064f\u0633\u062a\u0639\u0627\u062f \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0625\u0644\u0649 \u062d\u0627\u0644\u062a\u0647\u0627 \u0642\u0628\u0644 \u062a\u0637\u0628\u064a\u0642 \u062a\u0643\u0648\u064a\u0646 \u0627\u0644\u0644\u0639\u0628\u0629. \u0648\u0633\u062a\u0628\u0642\u0649 \u0645\u0643\u0648\u0646\u0627\u062a winetricks \u0627\u0644\u0645\u062b\u0628\u062a\u0629."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastaven\u00ed se vr\u00e1t\u00ed do stavu p\u0159ed pou\u017eit\u00edm hern\u00ed konfigurace. Nainstalovan\u00e9 komponenty winetricks z\u016fstanou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indstillingerne gendannes til, som de var, f\u00f8r spilkonfigurationen blev anvendt. Installerede winetricks-komponenter bevares."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungen werden auf den Stand vor dem Anwenden der Spielkonfiguration zur\u00fcckgesetzt. Installierte Winetricks-Komponenten bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings will be restored to their state before the game configuration was applied. Installed winetricks components will remain."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings will be restored to their state before the game configuration was applied. Installed winetricks components will remain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes volver\u00e1n al estado que ten\u00edan antes de aplicar la configuraci\u00f3n del juego. Los componentes de winetricks instalados se mantendr\u00e1n."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asetukset palautetaan tilaan, joka oli ennen pelim\u00e4\u00e4rityksen k\u00e4ytt\u00f6\u00f6nottoa. Asennetut winetricks-komponentit s\u00e4ilyv\u00e4t."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les r\u00e9glages seront restaur\u00e9s dans l'\u00e9tat o\u00f9 ils \u00e9taient avant l'application de la configuration de jeu. Les composants winetricks install\u00e9s seront conserv\u00e9s."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni verranno ripristinate allo stato precedente all'applicazione della configurazione di gioco. I componenti winetricks installati resteranno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b2\u30fc\u30e0\u69cb\u6210\u3092\u9069\u7528\u3059\u308b\u524d\u306e\u72b6\u614b\u306b\u8a2d\u5b9a\u304c\u623b\u308a\u307e\u3059\u3002\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u6e08\u307f\u306e winetricks \u30b3\u30f3\u30dd\u30fc\u30cd\u30f3\u30c8\u306f\u305d\u306e\u307e\u307e\u6b8b\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uac8c\uc784 \uad6c\uc131\uc744 \uc801\uc6a9\ud558\uae30 \uc804 \uc0c1\ud0dc\ub85c \uc124\uc815\uc774 \ubcf5\uc6d0\ub429\ub2c8\ub2e4. \uc124\uce58\ub41c winetricks \uad6c\uc131 \uc694\uc18c\ub294 \uadf8\ub300\ub85c \ub0a8\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De instellingen worden teruggezet naar hoe ze waren voordat de gameconfiguratie werd toegepast. Ge\u00efnstalleerde winetricks-onderdelen blijven behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienia wr\u00f3c\u0105 do stanu sprzed zastosowania konfiguracji gry. Zainstalowane sk\u0142adniki winetricks pozostan\u0105."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As configura\u00e7\u00f5es voltar\u00e3o ao estado anterior \u00e0 aplica\u00e7\u00e3o da configura\u00e7\u00e3o do jogo. Os componentes do winetricks instalados ser\u00e3o mantidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As defini\u00e7\u00f5es ser\u00e3o repostas no estado em que estavam antes de a configura\u00e7\u00e3o do jogo ser aplicada. Os componentes do winetricks instalados v\u00e3o manter-se."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Set\u0103rile vor fi readuse la starea de dinainte de aplicarea configura\u021biei de joc. Componentele winetricks instalate r\u0103m\u00e2n."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0432\u0435\u0440\u043d\u0443\u0442\u0441\u044f \u043a \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044e \u0434\u043e \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0438\u0433\u0440\u043e\u0432\u043e\u0439 \u043a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u0438. \u0423\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044b\u0435 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u044b winetricks \u043e\u0441\u0442\u0430\u043d\u0443\u0442\u0441\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inst\u00e4llningarna \u00e5terst\u00e4lls till hur de var innan spelkonfigurationen till\u00e4mpades. Installerade winetricks-komponenter beh\u00e5lls."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar, oyun yap\u0131land\u0131rmas\u0131 uygulanmadan \u00f6nceki durumuna d\u00f6nd\u00fcr\u00fclecek. Y\u00fcklenen winetricks bile\u015fenleri kalacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u043e\u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f \u0434\u043e \u0441\u0442\u0430\u043d\u0443 \u043f\u0435\u0440\u0435\u0434 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u0456\u0433\u0440\u043e\u0432\u043e\u0457 \u043a\u043e\u043d\u0444\u0456\u0433\u0443\u0440\u0430\u0446\u0456\u0457. \u0412\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0456 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0438 winetricks \u0437\u0430\u043b\u0438\u0448\u0430\u0442\u044c\u0441\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u00e1c c\u00e0i \u0111\u1eb7t s\u1ebd \u0111\u01b0\u1ee3c kh\u00f4i ph\u1ee5c v\u1ec1 tr\u1ea1ng th\u00e1i tr\u01b0\u1edbc khi \u00e1p d\u1ee5ng c\u1ea5u h\u00ecnh game. C\u00e1c th\u00e0nh ph\u1ea7n winetricks \u0111\u00e3 c\u00e0i v\u1eabn \u0111\u01b0\u1ee3c gi\u1eef l\u1ea1i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bbe\u7f6e\u5c06\u6062\u590d\u5230\u5e94\u7528\u6e38\u620f\u914d\u7f6e\u4e4b\u524d\u7684\u72b6\u6001\u3002\u5df2\u5b89\u88c5\u7684 winetricks \u7ec4\u4ef6\u5c06\u4fdd\u7559\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a2d\u5b9a\u6703\u56de\u5fa9\u5230\u5957\u7528\u904a\u6232\u7d44\u614b\u4e4b\u524d\u7684\u72c0\u614b\u3002\u5df2\u5b89\u88dd\u7684 winetricks \u5143\u4ef6\u6703\u4fdd\u7559\u3002"
          }
        }
      }
    },
