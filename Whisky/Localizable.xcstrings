    "config.graphics.helperNextLaunch": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u064f\u0637\u0628\u064e\u0651\u0642 \u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0639\u0646\u062f \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u062a\u0627\u0644\u064a."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zm\u011bny se projev\u00ed p\u0159i p\u0159\u00ed\u0161t\u00edm spu\u0161t\u011bn\u00ed."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c6ndringerne tr\u00e6der i kraft ved n\u00e6ste start."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c4nderungen werden beim n\u00e4chsten Start wirksam."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes apply on next launch."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes apply on next launch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios se aplican en el pr\u00f3ximo inicio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutokset tulevat voimaan seuraavalla k\u00e4ynnistyskerralla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications s'appliquent au prochain lancement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche vengono applicate al prossimo avvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5909\u66f4\u306f\u6b21\u56de\u306e\u8d77\u52d5\u6642\u306b\u53cd\u6620\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubcc0\uacbd \uc0ac\ud56d\uc740 \ub2e4\uc74c \uc2e4\ud589 \uc2dc \uc801\uc6a9\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigingen worden bij de volgende start toegepast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany zadzia\u0142aj\u0105 przy nast\u0119pnym uruchomieniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As altera\u00e7\u00f5es valem na pr\u00f3xima abertura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As altera\u00e7\u00f5es aplicam-se no pr\u00f3ximo arranque."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modific\u0103rile se aplic\u0103 la urm\u0103toarea lansare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0432\u0441\u0442\u0443\u043f\u044f\u0442 \u0432 \u0441\u0438\u043b\u0443 \u043f\u0440\u0438 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u043c \u0437\u0430\u043f\u0443\u0441\u043a\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c4ndringarna b\u00f6rjar g\u00e4lla vid n\u00e4sta start."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "De\u011fi\u015fiklikler bir sonraki ba\u015flatmada uygulan\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u043c\u0456\u043d\u0438 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u044e\u0442\u044c\u0441\u044f \u043f\u0456\u0434 \u0447\u0430\u0441 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u043e\u0433\u043e \u0437\u0430\u043f\u0443\u0441\u043a\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay \u0111\u1ed5i c\u00f3 hi\u1ec7u l\u1ef1c \u1edf l\u1ea7n kh\u1edfi ch\u1ea1y ti\u1ebfp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u66f4\u6539\u5c06\u5728\u4e0b\u6b21\u542f\u52a8\u65f6\u751f\u6548\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8b8a\u66f4\u6703\u5728\u4e0b\u6b21\u555f\u52d5\u6642\u751f\u6548\u3002"
          }
        }
