    "winetricks.error.missingResourcesInfo": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0639\u0630\u0651\u0631 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0623\u062f\u0627\u0629 winetricks \u0627\u0644\u0645\u0631\u0641\u0642\u0629 \u0645\u0639 Whisky. \u0623\u0639\u062f \u062a\u062b\u0628\u064a\u062a Whisky \u0645\u0646 \u062a\u0646\u0632\u064a\u0644 \u062c\u062f\u064a\u062f \u0644\u0627\u0633\u062a\u0639\u0627\u062f\u062a\u0647\u0627."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e1stroj winetricks dod\u00e1van\u00fd s Whisky se nepoda\u0159ilo naj\u00edt. Nainstalujte Whisky znovu z \u010derstv\u011b sta\u017een\u00e9ho bal\u00ed\u010dku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00e6rkt\u00f8jet winetricks, der f\u00f8lger med Whisky, blev ikke fundet. Installer Whisky igen fra en ny overf\u00f8rsel for at gendanne det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das mit Whisky mitgelieferte winetricks-Werkzeug wurde nicht gefunden. Installiere Whisky aus einem neuen Download erneut, um es wiederherzustellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The winetricks tool bundled with Whisky couldn't be found. Reinstall Whisky from a fresh download to restore it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The winetricks tool bundled with Whisky couldn't be found. Reinstall Whisky from a fresh download to restore it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encuentra la herramienta winetricks incluida con Whisky. Reinstala Whisky desde una descarga nueva para recuperarla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Whiskyn mukana tulevaa winetricks-ty\u00f6kalua ei l\u00f6ytynyt. Palauta se asentamalla Whisky uudelleen tuoreesta latauksesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'outil winetricks fourni avec Whisky est introuvable. R\u00e9installez Whisky \u00e0 partir d'un t\u00e9l\u00e9chargement r\u00e9cent pour le restaurer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo strumento winetricks incluso in Whisky non \u00e8 stato trovato. Reinstalla Whisky da un download nuovo per ripristinarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky \u306b\u540c\u68b1\u3055\u308c\u3066\u3044\u308b winetricks \u304c\u898b\u3064\u304b\u308a\u307e\u305b\u3093\u3067\u3057\u305f\u3002Whisky \u3092\u65b0\u305f\u306b\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u3066\u518d\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky\uc5d0 \ud3ec\ud568\ub41c winetricks \ub3c4\uad6c\ub97c \ucc3e\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. Whisky\ub97c \uc0c8\ub85c \ub2e4\uc6b4\ub85c\ub4dc\ud574 \ub2e4\uc2dc \uc124\uce58\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het winetricks-hulpprogramma dat bij Whisky wordt geleverd, is niet gevonden. Installeer Whisky opnieuw vanaf een verse download om het te herstellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono narz\u0119dzia winetricks do\u0142\u0105czonego do Whisky. Zainstaluj Whisky ponownie z nowo pobranej kopii, aby je przywr\u00f3ci\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A ferramenta winetricks que vem com o Whisky n\u00e3o foi encontrada. Reinstale o Whisky a partir de um download novo para restaur\u00e1-la."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A ferramenta winetricks inclu\u00edda no Whisky n\u00e3o foi encontrada. Reinstale o Whisky a partir de uma transfer\u00eancia nova para a repor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilitarul winetricks livrat cu Whisky nu a fost g\u0103sit. Reinstaleaz\u0103 Whisky dintr-o desc\u0103rcare nou\u0103 pentru a-l reface."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043d\u0430\u0439\u0442\u0438 winetricks, \u0432\u0445\u043e\u0434\u044f\u0449\u0438\u0439 \u0432 \u0441\u043e\u0441\u0442\u0430\u0432 Whisky. \u041f\u0435\u0440\u0435\u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 Whisky \u0438\u0437 \u0441\u0432\u0435\u0436\u0435\u0439 \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0438, \u0447\u0442\u043e\u0431\u044b \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0435\u0433\u043e."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Verktyget winetricks som f\u00f6ljer med Whisky kunde inte hittas. Installera om Whisky fr\u00e5n en ny h\u00e4mtning f\u00f6r att \u00e5terst\u00e4lla det."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky ile birlikte gelen winetricks arac\u0131 bulunamad\u0131. Geri y\u00fcklemek i\u00e7in Whisky'yi yeni bir indirmeyle yeniden y\u00fckleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0437\u043d\u0430\u0439\u0442\u0438 winetricks, \u0449\u043e \u0432\u0445\u043e\u0434\u0438\u0442\u044c \u0434\u043e \u0441\u043a\u043b\u0430\u0434\u0443 Whisky. \u041f\u0435\u0440\u0435\u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0442\u044c Whisky \u0437\u0456 \u0441\u0432\u0456\u0436\u043e\u0433\u043e \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f, \u0449\u043e\u0431 \u0432\u0456\u0434\u043d\u043e\u0432\u0438\u0442\u0438 \u0439\u043e\u0433\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng t\u00ecm th\u1ea5y c\u00f4ng c\u1ee5 winetricks \u0111i k\u00e8m Whisky. H\u00e3y c\u00e0i l\u1ea1i Whisky t\u1eeb b\u1ea3n t\u1ea3i m\u1edbi \u0111\u1ec3 kh\u00f4i ph\u1ee5c."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u627e\u4e0d\u5230 Whisky \u5185\u7f6e\u7684 winetricks \u5de5\u5177\u3002\u8bf7\u91cd\u65b0\u4e0b\u8f7d\u5e76\u5b89\u88c5 Whisky \u4ee5\u6062\u590d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u627e\u4e0d\u5230 Whisky \u5167\u5efa\u7684 winetricks \u5de5\u5177\u3002\u8acb\u91cd\u65b0\u4e0b\u8f09\u4e26\u5b89\u88dd Whisky \u4ee5\u5fa9\u539f\u3002"
          }
        }
      }
    },
    "winetricks.error.missingUserProfile": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u062c\u0644\u062f \u0645\u0644\u0641 \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0645\u0641\u0642\u0648\u062f. \u0631\u0628\u0645\u0627 \u0644\u0645 \u062a\u062a\u0645 \u062a\u0647\u064a\u0626\u0629 Wine \u0628\u0634\u0643\u0644 \u0635\u062d\u064a\u062d."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chyb\u00ed slo\u017eka u\u017eivatelsk\u00e9ho profilu. Wine mo\u017en\u00e1 nen\u00ed spr\u00e1vn\u011b inicializov\u00e1n."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappen med brugerprofilen mangler. Wine er muligvis ikke klargjort korrekt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Benutzerprofil-Ordner fehlt. Wine ist m\u00f6glicherweise nicht richtig initialisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The user profile directory is missing. Wine may not be properly initialized."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The user profile directory is missing. Wine may not be properly initialised."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta la carpeta del perfil de usuario. Puede que Wine no se haya inicializado correctamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u00e4ytt\u00e4j\u00e4profiilin kansio puuttuu. Wine\u00e4 ei ehk\u00e4 ole alustettu oikein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier du profil utilisateur est manquant. Wine n'est peut-\u00eatre pas correctement initialis\u00e9."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella del profilo utente non \u00e8 presente. Wine potrebbe non essere inizializzato correttamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30e6\u30fc\u30b6\u30fc\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u306e\u30d5\u30a9\u30eb\u30c0\u304c\u898b\u3064\u304b\u308a\u307e\u305b\u3093\u3002Wine \u304c\u6b63\u3057\u304f\u521d\u671f\u5316\u3055\u308c\u3066\u3044\u306a\u3044\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0ac\uc6a9\uc790 \ud504\ub85c\ud544 \ud3f4\ub354\uac00 \uc5c6\uc2b5\ub2c8\ub2e4. Wine\uc774 \uc81c\ub300\ub85c \ucd08\uae30\ud654\ub418\uc9c0 \uc54a\uc558\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De map met het gebruikersprofiel ontbreekt. Wine is mogelijk niet goed ge\u00efnitialiseerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brakuje folderu profilu u\u017cytkownika. Wine mo\u017ce nie by\u0107 poprawnie zainicjowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta do perfil do usu\u00e1rio est\u00e1 ausente. O Wine pode n\u00e3o ter sido inicializado corretamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta do perfil do utilizador est\u00e1 em falta. O Wine pode n\u00e3o estar corretamente inicializado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folderul profilului de utilizator lipse\u0219te. Este posibil ca Wine s\u0103 nu fie ini\u021bializat corect."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0430\u043f\u043a\u0430 \u043f\u0440\u043e\u0444\u0438\u043b\u044f \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, Wine \u0438\u043d\u0438\u0446\u0438\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d \u043d\u0435 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappen med anv\u00e4ndarprofilen saknas. Wine kanske inte har f\u00f6rberetts korrekt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullan\u0131c\u0131 profili klas\u00f6r\u00fc eksik. Wine d\u00fczg\u00fcn \u015fekilde haz\u0131rlanmam\u0131\u015f olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0435\u043a\u0438 \u043f\u0440\u043e\u0444\u0456\u043b\u044e \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430 \u043d\u0435\u043c\u0430\u0454. \u041c\u043e\u0436\u043b\u0438\u0432\u043e, Wine \u0456\u043d\u0456\u0446\u0456\u0430\u043b\u0456\u0437\u043e\u0432\u0430\u043d\u043e \u043d\u0435 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thi\u1ebfu th\u01b0 m\u1ee5c h\u1ed3 s\u01a1 ng\u01b0\u1eddi d\u00f9ng. C\u00f3 th\u1ec3 Wine ch\u01b0a \u0111\u01b0\u1ee3c kh\u1edfi t\u1ea1o \u0111\u00fang c\u00e1ch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7528\u6237\u914d\u7f6e\u6587\u4ef6\u76ee\u5f55\u7f3a\u5931\u3002Wine \u53ef\u80fd\u672a\u6b63\u786e\u521d\u59cb\u5316\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f7f\u7528\u8005\u8a2d\u5b9a\u6a94\u76ee\u9304\u907a\u5931\u3002Wine \u53ef\u80fd\u672a\u6b63\u78ba\u521d\u59cb\u5316\u3002"
          }
        }
      }
    },
