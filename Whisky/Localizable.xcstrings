    "steam.launch.timeout": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u062a\u0628\u062f\u0623 \u0627\u0644\u0644\u0639\u0628\u0629 \u062e\u0644\u0627\u0644 \u062f\u0642\u064a\u0642\u062a\u064a\u0646. \u0642\u062f \u062a\u0643\u0648\u0646 \u0645\u0627 \u0632\u0627\u0644\u062a \u0642\u064a\u062f \u0627\u0644\u062a\u062d\u0645\u064a\u0644\u060c \u0623\u0648 \u0623\u0646 \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0642\u062f \u0641\u0634\u0644."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hra se nespustila do dvou minut. Mo\u017en\u00e1 se st\u00e1le na\u010d\u00edt\u00e1, nebo spu\u0161t\u011bn\u00ed selhalo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spillet startede ikke inden for to minutter. Det indl\u00e6ses m\u00e5ske stadig, eller ogs\u00e5 mislykkedes starten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spiel wurde nicht innerhalb von zwei Minuten gestartet. Es l\u00e4dt vielleicht noch, oder der Start ist fehlgeschlagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game didn't start within two minutes. It may still be loading, or the launch failed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The game didn't start within two minutes. It may still be loading, or the launch failed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego no se ha iniciado en dos minutos. Puede que siga cargando o que el inicio haya fallado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Peli ei k\u00e4ynnistynyt kahdessa minuutissa. Se voi yh\u00e4 latautua tai k\u00e4ynnistys ep\u00e4onnistui."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu n'a pas d\u00e9marr\u00e9 en deux minutes. Il est peut-\u00eatre encore en cours de chargement, ou le lancement a \u00e9chou\u00e9."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gioco non si \u00e8 avviato entro due minuti. Potrebbe essere ancora in caricamento oppure l'avvio non \u00e8 riuscito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b2\u30fc\u30e0\u304c 2 \u5206\u4ee5\u5185\u306b\u8d77\u52d5\u3057\u307e\u305b\u3093\u3067\u3057\u305f\u3002\u307e\u3060\u8aad\u307f\u8fbc\u307f\u4e2d\u304b\u3001\u8d77\u52d5\u306b\u5931\u6557\u3057\u305f\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uac8c\uc784\uc774 2\ubd84 \uc548\uc5d0 \uc2dc\uc791\ub418\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \uc544\uc9c1 \ub85c\ub529 \uc911\uc774\uac70\ub098 \uc2e4\ud589\uc5d0 \uc2e4\ud328\ud588\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De game is niet binnen twee minuten gestart. Mogelijk wordt hij nog geladen of is het starten mislukt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gra nie uruchomi\u0142a si\u0119 w ci\u0105gu dw\u00f3ch minut. Mo\u017ce si\u0119 jeszcze wczytywa\u0107 albo uruchomienie si\u0119 nie powiod\u0142o."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O jogo n\u00e3o iniciou em dois minutos. Ele pode ainda estar carregando ou a abertura falhou."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O jogo n\u00e3o arrancou em dois minutos. Pode ainda estar a carregar ou o arranque falhou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Jocul nu a pornit \u00een dou\u0103 minute. Poate \u00eenc\u0103 se \u00eencarc\u0103 sau lansarea a e\u0219uat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0433\u0440\u0430 \u043d\u0435 \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u043b\u0430\u0441\u044c \u0437\u0430 \u0434\u0432\u0435 \u043c\u0438\u043d\u0443\u0442\u044b. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043e\u043d\u0430 \u0435\u0449\u0451 \u0437\u0430\u0433\u0440\u0443\u0436\u0430\u0435\u0442\u0441\u044f \u0438\u043b\u0438 \u0437\u0430\u043f\u0443\u0441\u043a \u043d\u0435 \u0443\u0434\u0430\u043b\u0441\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spelet startade inte inom tv\u00e5 minuter. Det kanske fortfarande l\u00e4ses in, eller s\u00e5 misslyckades starten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyun iki dakika i\u00e7inde ba\u015flamad\u0131. H\u00e2l\u00e2 y\u00fckleniyor olabilir veya ba\u015flatma ba\u015far\u0131s\u0131z oldu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0413\u0440\u0430 \u043d\u0435 \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u043b\u0430\u0441\u044f \u0437\u0430 \u0434\u0432\u0456 \u0445\u0432\u0438\u043b\u0438\u043d\u0438. \u041c\u043e\u0436\u043b\u0438\u0432\u043e, \u0432\u043e\u043d\u0430 \u0449\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454\u0442\u044c\u0441\u044f \u0430\u0431\u043e \u0437\u0430\u043f\u0443\u0441\u043a \u043d\u0435 \u0432\u0434\u0430\u0432\u0441\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Game kh\u00f4ng kh\u1edfi \u0111\u1ed9ng trong hai ph\u00fat. C\u00f3 th\u1ec3 game v\u1eabn \u0111ang t\u1ea3i, ho\u1eb7c vi\u1ec7c kh\u1edfi ch\u1ea1y \u0111\u00e3 th\u1ea5t b\u1ea1i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6e38\u620f\u672a\u5728\u4e24\u5206\u949f\u5185\u542f\u52a8\u3002\u5b83\u53ef\u80fd\u4ecd\u5728\u8f7d\u5165\uff0c\u4e5f\u53ef\u80fd\u542f\u52a8\u5931\u8d25\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u904a\u6232\u672a\u5728\u5169\u5206\u9418\u5167\u555f\u52d5\u3002\u5b83\u53ef\u80fd\u4ecd\u5728\u8f09\u5165\uff0c\u4e5f\u53ef\u80fd\u555f\u52d5\u5931\u6557\u3002"
          }
        }
      }
    },
    "steam.library.empty": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0623\u0644\u0639\u0627\u0628 Steam \u0645\u062b\u0628\u062a\u0629 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0632\u062c\u0627\u062c\u0629."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V t\u00e9to lahvi nebyly nalezeny \u017e\u00e1dn\u00e9 nainstalovan\u00e9 hry ze Steamu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke fundet installerede Steam-spil i denne flaske."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In dieser Flasche wurden keine installierten Steam-Spiele gefunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No installed Steam games found in this bottle."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "No installed Steam games found in this bottle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han encontrado juegos de Steam instalados en esta botella."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00e4st\u00e4 pullosta ei l\u00f6ytynyt asennettuja Steam-pelej\u00e4."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun jeu Steam install\u00e9 dans cette bouteille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun gioco Steam installato in questa bottiglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e Bottle \u306b\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u6e08\u307f\u306e Steam \u306e\u30b2\u30fc\u30e0\u306f\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 Bottle\uc5d0 \uc124\uce58\ub41c Steam \uac8c\uc784\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen ge\u00efnstalleerde Steam-games gevonden in deze fles."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono zainstalowanych gier Steam w tej butelce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum jogo do Steam instalado foi encontrado nesta Bottle."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o foram encontrados jogos do Steam instalados nesta Bottle."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-au g\u0103sit jocuri Steam instalate \u00een aceast\u0103 sticl\u0103."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 \u044d\u0442\u043e\u0439 \u0431\u0443\u0442\u044b\u043b\u043a\u0435 \u043d\u0435\u0442 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u0438\u0433\u0440 Steam."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga installerade Steam-spel hittades i den h\u00e4r flaskan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu \u015fi\u015fede y\u00fckl\u00fc Steam oyunu bulunamad\u0131."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423 \u0446\u0456\u0439 \u043f\u043b\u044f\u0448\u0446\u0456 \u043d\u0435\u043c\u0430\u0454 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0445 \u0456\u0433\u043e\u0440 Steam."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng t\u00ecm th\u1ea5y game Steam \u0111\u00e3 c\u00e0i trong bottle n\u00e0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64 Bottle \u4e2d\u6ca1\u6709\u5df2\u5b89\u88c5\u7684 Steam \u6e38\u620f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64 Bottle \u4e2d\u6c92\u6709\u5df2\u5b89\u88dd\u7684 Steam \u904a\u6232\u3002"
          }
        }
      }
    },
