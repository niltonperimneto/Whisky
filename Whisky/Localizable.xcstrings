    "bottle.close.confirm.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0648\u062c\u062f \u0639\u0645\u0644\u064a\u0627\u062a \u0642\u064a\u062f \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0632\u062c\u0627\u062c\u0629. \u0645\u0627\u0630\u0627 \u062a\u0631\u064a\u062f \u0623\u0646 \u062a\u0641\u0639\u0644\u061f"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V t\u00e9to lahvi b\u011b\u017e\u00ed procesy. Co chcete ud\u011blat?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der k\u00f8rer stadig processer i denne flaske. Hvad vil du g\u00f8re?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In dieser Flasche laufen noch Prozesse. Was m\u00f6chtest du tun?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This bottle has running processes. What would you like to do?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This bottle has running processes. What would you like to do?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta botella tiene procesos en ejecuci\u00f3n. \u00bfQu\u00e9 quieres hacer?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00e4ss\u00e4 pullossa on k\u00e4ynniss\u00e4 olevia prosesseja. Mit\u00e4 haluat tehd\u00e4?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des processus sont en cours d'ex\u00e9cution dans cette bouteille. Que voulez-vous faire ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa bottiglia ha processi in esecuzione. Cosa vuoi fare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e Bottle \u306b\u306f\u5b9f\u884c\u4e2d\u306e\u30d7\u30ed\u30bb\u30b9\u304c\u3042\u308a\u307e\u3059\u3002\u3069\u3046\u3057\u307e\u3059\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 Bottle\uc5d0\uc11c \uc2e4\ud589 \uc911\uc778 \ud504\ub85c\uc138\uc2a4\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc5b4\ub5bb\uac8c \ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In deze fles draaien nog processen. Wat wil je doen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tej butelce dzia\u0142aj\u0105 procesy. Co chcesz zrobi\u0107?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Bottle tem processos em execu\u00e7\u00e3o. O que voc\u00ea quer fazer?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Bottle tem processos em execu\u00e7\u00e3o. O que pretende fazer?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceast\u0103 sticl\u0103 are procese \u00een execu\u021bie. Ce vrei s\u0103 faci?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 \u044d\u0442\u043e\u0439 \u0431\u0443\u0442\u044b\u043b\u043a\u0435 \u0435\u0441\u0442\u044c \u0437\u0430\u043f\u0443\u0449\u0435\u043d\u043d\u044b\u0435 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u044b. \u0427\u0442\u043e \u0432\u044b \u0445\u043e\u0442\u0438\u0442\u0435 \u0441\u0434\u0435\u043b\u0430\u0442\u044c?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det k\u00f6rs fortfarande processer i den h\u00e4r flaskan. Vad vill du g\u00f6ra?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu \u015fi\u015fede \u00e7al\u0131\u015fan i\u015flemler var. Ne yapmak istersiniz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423 \u0446\u0456\u0439 \u043f\u043b\u044f\u0448\u0446\u0456 \u0454 \u0437\u0430\u043f\u0443\u0449\u0435\u043d\u0456 \u043f\u0440\u043e\u0446\u0435\u0441\u0438. \u0429\u043e \u0432\u0438 \u0445\u043e\u0447\u0435\u0442\u0435 \u0437\u0440\u043e\u0431\u0438\u0442\u0438?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bottle n\u00e0y c\u00f2n ti\u1ebfn tr\u00ecnh \u0111ang ch\u1ea1y. B\u1ea1n mu\u1ed1n l\u00e0m g\u00ec?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64 Bottle \u4e2d\u6709\u6b63\u5728\u8fd0\u884c\u7684\u8fdb\u7a0b\u3002\u4f60\u60f3\u8981\u600e\u4e48\u505a\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
