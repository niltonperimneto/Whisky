    "bottle.creation.error.runtimeMissing": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0628\u064a\u0626\u0629 \u062a\u0634\u063a\u064a\u0644 Wine (WhiskyWine) \u063a\u064a\u0631 \u0645\u062b\u0628\u062a\u0629\u060c \u0644\u0630\u0627 \u0644\u0627 \u064a\u0645\u0643\u0646 \u062a\u0647\u064a\u0626\u0629 \u0627\u0644\u0632\u062c\u0627\u062c\u0629. \u0634\u063a\u0651\u0644 \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0644\u062a\u0646\u0632\u064a\u0644\u0647\u0627 \u062b\u0645 \u0623\u0639\u062f \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prost\u0159ed\u00ed Wine (WhiskyWine) nen\u00ed nainstalov\u00e1no, tak\u017ee l\u00e1hev nelze inicializovat. Spus\u0165te nastaven\u00ed, st\u00e1hn\u011bte je a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine-runtimen (WhiskyWine) er ikke installeret, s\u00e5 flasken kan ikke klarg\u00f8res. K\u00f8r ops\u00e6tningen for at hente den, og pr\u00f8v igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wine-Runtime (WhiskyWine) ist nicht installiert, daher kann die Flasche nicht initialisiert werden. F\u00fchre die Einrichtung aus, um sie zu laden, und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Wine runtime (WhiskyWine) isn't installed, so the bottle can't be initialized. Run Setup to download it, then try again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The Wine runtime (WhiskyWine) isn't installed, so the bottle can't be initialised. Run Setup to download it, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El runtime de Wine (WhiskyWine) no est\u00e1 instalado, as\u00ed que la botella no se puede inicializar. Ejecuta la configuraci\u00f3n para descargarlo e int\u00e9ntalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine-ajoymp\u00e4rist\u00f6\u00e4 (WhiskyWine) ei ole asennettu, joten pulloa ei voi alustaa. Lataa se suorittamalla asennus ja yrit\u00e4 uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le runtime Wine (WhiskyWine) n'est pas install\u00e9, la bouteille ne peut donc pas \u00eatre initialis\u00e9e. Lancez la configuration pour le t\u00e9l\u00e9charger, puis r\u00e9essayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il runtime Wine (WhiskyWine) non \u00e8 installato, quindi la bottiglia non pu\u00f2 essere inizializzata. Esegui la configurazione per scaricarlo, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \u30e9\u30f3\u30bf\u30a4\u30e0 (WhiskyWine) \u304c\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3055\u308c\u3066\u3044\u306a\u3044\u305f\u3081\u3001Bottle \u3092\u521d\u671f\u5316\u3067\u304d\u307e\u305b\u3093\u3002\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7\u3092\u5b9f\u884c\u3057\u3066\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u3066\u304b\u3089\u3001\u3082\u3046\u4e00\u5ea6\u304a\u8a66\u3057\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \ub7f0\ud0c0\uc784(WhiskyWine)\uc774 \uc124\uce58\ub418\uc9c0 \uc54a\uc544 Bottle\uc744 \ucd08\uae30\ud654\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uc124\uc815\uc744 \uc2e4\ud589\ud574 \ub2e4\uc6b4\ub85c\ub4dc\ud55c \ub4a4 \ub2e4\uc2dc \uc2dc\ub3c4\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Wine-runtime (WhiskyWine) is niet ge\u00efnstalleerd, dus de fles kan niet worden ge\u00efnitialiseerd. Voer de setup uit om deze te downloaden en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Silnik Wine (WhiskyWine) nie jest zainstalowany, wi\u0119c nie mo\u017cna zainicjowa\u0107 butelki. Uruchom konfiguracj\u0119, aby go pobra\u0107, i spr\u00f3buj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O runtime do Wine (WhiskyWine) n\u00e3o est\u00e1 instalado, ent\u00e3o a Bottle n\u00e3o pode ser inicializada. Execute a configura\u00e7\u00e3o para baix\u00e1-lo e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O runtime do Wine (WhiskyWine) n\u00e3o est\u00e1 instalado, por isso a Bottle n\u00e3o pode ser inicializada. Execute a configura\u00e7\u00e3o para o transferir e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime-ul Wine (WhiskyWine) nu este instalat, a\u0219a c\u0103 sticla nu poate fi ini\u021bializat\u0103. Ruleaz\u0103 configurarea pentru a-l desc\u0103rca, apoi \u00eencearc\u0103 din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0440\u0435\u0434\u0430 Wine (WhiskyWine) \u043d\u0435 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0430, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0431\u0443\u0442\u044b\u043b\u043a\u0443 \u043d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0438\u043d\u0438\u0446\u0438\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u0442\u044c. \u0417\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0443, \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044c \u0435\u0451, \u0438 \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u0435 \u043f\u043e\u043f\u044b\u0442\u043a\u0443."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine-runtime (WhiskyWine) \u00e4r inte installerad, s\u00e5 flaskan kan inte f\u00f6rberedas. K\u00f6r konfigurationen f\u00f6r att h\u00e4mta den och f\u00f6rs\u00f6k igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine \u00e7al\u0131\u015fma zaman\u0131 (WhiskyWine) y\u00fckl\u00fc olmad\u0131\u011f\u0131ndan \u015fi\u015fe haz\u0131rlanam\u0131yor. \u0130ndirmek i\u00e7in Kurulum'u \u00e7al\u0131\u015ft\u0131r\u0131n, sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0443\u0448\u0456\u0439 Wine (WhiskyWine) \u043d\u0435 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043e, \u0442\u043e\u043c\u0443 \u043f\u043b\u044f\u0448\u043a\u0443 \u043d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0456\u043d\u0456\u0446\u0456\u0430\u043b\u0456\u0437\u0443\u0432\u0430\u0442\u0438. \u0417\u0430\u043f\u0443\u0441\u0442\u0456\u0442\u044c \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f, \u0449\u043e\u0431 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438 \u0439\u043e\u0433\u043e, \u0456 \u0441\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0437\u043d\u043e\u0432\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u01b0a c\u00e0i runtime Wine (WhiskyWine) n\u00ean kh\u00f4ng th\u1ec3 kh\u1edfi t\u1ea1o bottle. H\u00e3y ch\u1ea1y ph\u1ea7n c\u00e0i \u0111\u1eb7t \u0111\u1ec3 t\u1ea3i v\u1ec1 r\u1ed3i th\u1eed l\u1ea1i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c1a\u672a\u5b89\u88c5 Wine \u8fd0\u884c\u65f6\uff08WhiskyWine\uff09\uff0c\u56e0\u6b64\u65e0\u6cd5\u521d\u59cb\u5316 Bottle\u3002\u8bf7\u8fd0\u884c\u8bbe\u7f6e\u4ee5\u4e0b\u8f7d\uff0c\u7136\u540e\u91cd\u8bd5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c1a\u672a\u5b89\u88dd Wine \u57f7\u884c\u968e\u6bb5\uff08WhiskyWine\uff09\uff0c\u56e0\u6b64\u7121\u6cd5\u521d\u59cb\u5316 Bottle\u3002\u8acb\u57f7\u884c\u8a2d\u5b9a\u6d41\u7a0b\u4e0b\u8f09\u5f8c\u518d\u8a66\u4e00\u6b21\u3002"
          }
        }
      }
    },
