    "setup.rosetta.fail": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0641\u0634\u0644 \u062a\u062b\u0628\u064a\u062a Rosetta 2. \u0627\u0644\u0631\u062c\u0627\u0621 \u062a\u062b\u0628\u064a\u062a\u0647 \u064a\u062f\u0648\u064a\u0627\u064b."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalace Rosetta 2 se nezda\u0159ila. Nainstalujte ji pros\u00edm ru\u010dn\u011b."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta 2-installation mislykkedes. Installer venligst manuelt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta 2 Installation fehlgeschlagen. Bitte installieren es manuell."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta 2 installation failed. Please install it manually."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta 2 installation failed. Please install it manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La instalaci\u00f3n de Rosetta 2 ha fallado. Por favor, inst\u00e1lala manualmente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta 2:n asennus ep\u00e4onnistui. Asenna se manuaalisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installation de Rosetta 2 a \u00e9chou\u00e9. Veuillez l'installer manuellement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installazione di Rosetta 2 fallita. Si prega di installarlo manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta 2 \u306e\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u306b\u5931\u6557\u3057\u307e\u3057\u305f\u3002\u624b\u52d5\u3067\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta 2 \uc124\uce58\uc5d0 \uc2e4\ud328\ud588\uc2b5\ub2c8\ub2e4. \uc218\ub3d9\uc73c\ub85c \uc124\uce58\ud574 \uc8fc\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Rosetta 2 installatie is mislukt. Installeer het handmatig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalacja Rosetta 2 nie powiod\u0142a si\u0119. Prosz\u0119 zainstaluj j\u0105 manualnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A instala\u00e7\u00e3o do Rosetta 2 falhou. Instale-o manualmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A instala\u00e7\u00e3o do Rosetta 2 falhou. Por favor instale manualmente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a putut instala Rosetta 2. V\u0103 rug\u0103m s\u0103 o instala\u021bi manual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 Rosetta 2 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b\u0430\u0441\u044c \u0441 \u043e\u0448\u0438\u0431\u043a\u043e\u0439. \u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u0435 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0443 \u0432\u0440\u0443\u0447\u043d\u0443\u044e."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta 2 kunde inte installeras. Installera det manuellt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta 2 kurulumu ba\u015far\u0131s\u0131z oldu. L\u00fctfen manuel olarak y\u00fckleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0438 Rosetta 2. \u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0442\u044c \u0432\u0440\u0443\u0447\u043d\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng th\u1ec3 c\u00e0i \u0111\u1eb7t Rosetta 2. H\u00e3y c\u00e0i \u0111\u1eb7t n\u00f3 th\u1ee7 c\u00f4ng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta 2\u5b89\u88c5\u5931\u8d25\u3002\u8bf7\u624b\u52a8\u5b89\u88c5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta 2 \u5b89\u88dd\u5931\u6557\u3002\u8acb\u624b\u52d5\u5b89\u88dd\u3002"
          }
        }
      }
    },
    "setup.rosetta.subtitle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0633\u0645\u062d Rosetta \u0628\u0623\u0643\u0648\u0627\u062f x86\u060c \u0645\u062b\u0644 Wine\u060c \u0628\u0627\u0644\u0639\u0645\u0644 \u0639\u0644\u0649 \u0627\u0644\u0645\u0627\u0643 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta umo\u017e\u0148uje x86 k\u00f3du, jak\u00fdm je Wine, b\u011b\u017eet na va\u0161em Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta tillader x86 kode, som Wine, til at k\u00f8re p\u00e5 din Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta erlaubt es, x86 code auf deinem Mac auszuf\u00fchren, \u00e4hnlich wie Wine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta allows x86 code, like Wine, to run on your Mac."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta allows x86 code, like Wine, to run on your Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta permite que programas de arquitectura x86 (Wine por ejemplo) funcionen en tu Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta, kuten Wine, mahdollistaa x86 koodin k\u00e4ytt\u00e4misen Macill\u00e4si."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta permet au code x86, comme Wine, de s'ex\u00e9cuter sur votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta permette al codice x86, come Wine, di funzionare sul tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta \u306f\u3001Wine \u306e\u3088\u3046\u306a x86 \u30d0\u30a4\u30ca\u30ea\u3092 Mac \u4e0a\u3067\u5b9f\u884c\u3067\u304d\u308b\u3088\u3046\u306b\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta\ub294 Wine\uacfc \uac19\uc740 x86 \ucf54\ub4dc\ub97c \ub2f9\uc2e0\uc758 Mac\uc5d0\uc11c \uc2e4\ud589\ud560 \uc218 \uc788\uac8c \ud574 \uc90d\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta laat x86 code, zoals Wine, uitgevoerd worden op je Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta pozwala kodowi x86, tak jak Wine, na uruchamianie na komputerze Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta permite c\u00f3digo x86, como Wine, a rodar em seu Mac."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta permite que c\u00f3digo x86, como o Wine, execute no seu Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta permite codului x86, ca de exemplu Wine, s\u0103 ruleze pe Mac-ul dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430\u043c x86, \u0442\u0430\u043a\u0438\u043c \u043a\u0430\u043a Wine, \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u043d\u0430 \u0432\u0430\u0448\u0435\u043c Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med Rosetta kan x86-kod, som Wine, k\u00f6ras p\u00e5 din Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta, Wine gibi, x86 yaz\u0131l\u0131m\u0131n\u0131n Mac bilgisayar\u0131n\u0131zda \u00e7al\u0131\u015fmas\u0131na izin verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta \u0434\u043e\u0437\u0432\u043e\u043b\u044f\u0454 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0442\u0438 x86 \u043a\u043e\u0434 (\u043d\u0430\u043f\u0440. Wine) \u043d\u0430 \u0432\u0430\u0448\u043e\u043c\u0443 Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta cho ph\u00e9p c\u00e1c \u1ee9ng d\u1ee5ng x86 nh\u01b0 Wine ch\u1ea1y tr\u00ean m\u00e1y Mac c\u1ee7a b\u1ea1n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta \u8ba9\u60a8\u7684 Mac \u53ef\u4ee5\u8fd0\u884c Wine \u7b49 x86 \u67b6\u6784\u7684\u7a0b\u5e8f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta \u5141\u8a31 x86 \u4ee3\u78bc\uff08\u5982 Wine\uff09\u5728 Mac \u4e0a\u904b\u884c\u3002"
          }
        }
      }
    },
    "setup.subtitle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u062a\u0628\u0639\u064a\u0627\u062a \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629 \u0644\u0640Whisky."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spravovat po\u017eadovan\u00e9 z\u00e1vislosti Whisky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrer Whisky's n\u00f8dvendige afh\u00e6ngigheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwalte Whiskys erforderliche Abh\u00e4ngigkeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage Whisky's required dependencies."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage Whisky's required dependencies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Administre las dependencias requeridas de Whisky."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallitse Whiskyn tarvittavia riippuvuuksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00e9rer les d\u00e9pendances requises de Whisky."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci le dipendenze richieste da Whisky."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky \u306b\u5fc5\u8981\u306a\u4f9d\u5b58\u95a2\u4fc2\u3092\u7ba1\u7406\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky\uc758 \ud544\uc218 \uc758\uc874\uc131 \uad00\ub9ac\ud558\uae30."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer Whisky's vereiste dependencies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarz\u0105dzaj wymaganymi zale\u017cno\u015bciami Whisky."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerir as depend\u00eancias necess\u00e1rias do Whisky."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie depend\u00eancias necess\u00e1rias do Whisky."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestioneaz\u0103 dependen\u021bele cerute de Whisky."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u043c\u044b\u043c\u0438 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044f\u043c\u0438 Whisky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hantera de beroenden som Whisky kr\u00e4ver."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky'nin gerekli yaz\u0131l\u0131mlar\u0131n\u0131 d\u00fczenle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u0438\u043c\u0438 \u0437\u0430\u043b\u0435\u0436\u043d\u043e\u0441\u0442\u044f\u043c\u0438 Whisky."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu\u1ea3n l\u00fd nh\u1eefng t\u1ec7p quan tr\u1ecdng c\u1ee7a Whisky."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7ba1\u7406 Whisky \u6240\u9700\u4f9d\u8d56"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7ba1\u7406Whisky\u9700\u8981\u7684\u76f8\u4f9d\u6027\u5957\u4ef6"
          }
        }
      }
    },
    "setup.telemetry.consent": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0634\u0627\u0631\u0643 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u062c\u0647\u0648\u0644\u0629 \u0644\u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u0641\u064a \u062a\u062d\u0633\u064a\u0646 Whisky"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sd\u00edlet anonymn\u00ed data a pomoct tak vylep\u0161it Whisky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Del anonyme brugsdata, og hj\u00e6lp med at forbedre Whisky"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonyme Nutzungsdaten teilen, um Whisky zu verbessern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share anonymous usage data to help improve Whisky"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Share anonymous usage data to help improve Whisky"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte datos de uso an\u00f3nimos para ayudar a mejorar Whisky"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaa nimett\u00f6mi\u00e4 k\u00e4ytt\u00f6tietoja Whiskyn kehitt\u00e4miseksi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partager des donn\u00e9es d'utilisation anonymes pour am\u00e9liorer Whisky"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi dati d'uso anonimi per contribuire a migliorare Whisky"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u533f\u540d\u306e\u4f7f\u7528\u72b6\u6cc1\u30c7\u30fc\u30bf\u3092\u5171\u6709\u3057\u3066 Whisky \u306e\u6539\u5584\u306b\u5354\u529b\u3059\u308b"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky \uac1c\uc120\uc5d0 \ub3c4\uc6c0\uc774 \ub418\ub3c4\ub85d \uc775\uba85 \uc0ac\uc6a9 \ub370\uc774\ud130 \uacf5\uc720"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel anonieme gebruiksgegevens om Whisky te verbeteren"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udost\u0119pniaj anonimowe dane, aby pom\u00f3c ulepszy\u0107 Whisky"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhar dados de uso an\u00f4nimos para ajudar a melhorar o Whisky"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Partilhar dados de utiliza\u00e7\u00e3o an\u00f3nimos para ajudar a melhorar o Whisky"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Partajeaz\u0103 date de utilizare anonime pentru a ajuta la \u00eembun\u0103t\u0103\u021birea Whisky"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u044c \u0430\u043d\u043e\u043d\u0438\u043c\u043d\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043c\u043e\u0447\u044c \u0443\u043b\u0443\u0447\u0448\u0438\u0442\u044c Whisky"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dela anonym anv\u00e4ndningsdata och hj\u00e4lp till att f\u00f6rb\u00e4ttra Whisky"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky'nin geli\u015ftirilmesine yard\u0131mc\u0131 olmak i\u00e7in anonim kullan\u0131m verilerini payla\u015f"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0434\u0441\u0438\u043b\u0430\u0442\u0438 \u0430\u043d\u043e\u043d\u0456\u043c\u043d\u0456 \u0434\u0430\u043d\u0456, \u0449\u043e\u0431 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0442\u0438 \u043f\u043e\u043a\u0440\u0430\u0449\u0438\u0442\u0438 Whisky"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia s\u1ebb d\u1eef li\u1ec7u s\u1eed d\u1ee5ng \u1ea9n danh \u0111\u1ec3 gi\u00fap c\u1ea3i thi\u1ec7n Whisky"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5171\u4eab\u533f\u540d\u4f7f\u7528\u6570\u636e\uff0c\u5e2e\u52a9\u6539\u8fdb Whisky"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5206\u4eab\u533f\u540d\u4f7f\u7528\u8cc7\u6599\uff0c\u5354\u52a9\u6539\u9032 Whisky"
          }
        }
      }
    },
    "setup.telemetry.consent.help": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u062e\u062a\u064a\u0627\u0631\u064a \u0648\u0645\u0639\u0637\u0651\u0644 \u0627\u0641\u062a\u0631\u0627\u0636\u064a\u064b\u0627. \u0639\u0646\u062f \u062a\u0641\u0639\u064a\u0644\u0647\u060c \u064a\u0631\u0633\u0644 Whisky \u062e\u0645\u0633\u0629 \u0623\u062d\u062f\u0627\u062b \u0645\u062c\u0647\u0648\u0644\u0629 \u062a\u063a\u0637\u064a \u0645\u0633\u0627\u0631 \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0623\u0648\u0644: \u0628\u062f\u0621 \u062a\u062b\u0628\u064a\u062a \u0628\u064a\u0626\u0629 \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0623\u0648 \u0646\u062c\u0627\u062d\u0647 \u0623\u0648 \u0641\u0634\u0644\u0647 (\u0645\u0639 \u0633\u0628\u0628 \u0639\u0627\u0645)\u060c \u0648\u0625\u0646\u0634\u0627\u0621 \u0623\u0648\u0644 \u0632\u062c\u0627\u062c\u0629\u060c \u0648\u0623\u0648\u0644 \u0645\u062d\u0627\u0648\u0644\u0629 \u0644\u062a\u0634\u063a\u064a\u0644 \u0628\u0631\u0646\u0627\u0645\u062c. \u0644\u0627 \u062a\u064f\u0631\u0633\u0644 \u0623\u0628\u062f\u064b\u0627 \u0623\u064a \u0628\u064a\u0627\u0646\u0627\u062a \u0634\u062e\u0635\u064a\u0629 \u0623\u0648 \u0623\u0633\u0645\u0627\u0621 \u0645\u0644\u0641\u0627\u062a \u0623\u0648 \u0645\u0639\u0631\u0651\u0641\u0627\u062a \u0645\u0631\u062a\u0628\u0637\u0629 \u0628\u0643. \u064a\u0645\u0643\u0646\u0643 \u062a\u063a\u064a\u064a\u0631 \u0630\u0644\u0643 \u0641\u064a \u0623\u064a \u0648\u0642\u062a \u0645\u0646 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Voliteln\u00e9 a ve v\u00fdchoz\u00edm stavu vypnut\u00e9. Po zapnut\u00ed Whisky ode\u0161le p\u011bt anonymn\u00edch ud\u00e1lost\u00ed o prvn\u00edm spu\u0161t\u011bn\u00ed: instalace prost\u0159ed\u00ed za\u010dala, usp\u011bla nebo selhala (s obecn\u00fdm d\u016fvodem), byla vytvo\u0159ena prvn\u00ed l\u00e1hev a prob\u011bhl prvn\u00ed pokus o spu\u0161t\u011bn\u00ed programu. Osobn\u00ed \u00fadaje, n\u00e1zvy soubor\u016f ani identifik\u00e1tory spojen\u00e9 s v\u00e1mi se neodes\u00edlaj\u00ed nikdy. Kdykoli to m\u016f\u017eete zm\u011bnit v Nastaven\u00ed."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfrit og sl\u00e5et fra som standard. N\u00e5r det er sl\u00e5et til, sender Whisky fem anonyme begivenheder om det f\u00f8rste forl\u00f8b: installation af runtime startet, lykkedes eller mislykkedes (med en overordnet \u00e5rsag), f\u00f8rste flaske oprettet og f\u00f8rste fors\u00f8g p\u00e5 at starte et program. Der sendes aldrig personlige oplysninger, filnavne eller id'er, der kan knyttes til dig. Du kan altid \u00e6ndre det i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional und standardm\u00e4\u00dfig deaktiviert. Wenn aktiviert, sendet Whisky f\u00fcnf anonyme Ereignisse zum Ablauf der Ersteinrichtung: Installation der Runtime gestartet, erfolgreich oder fehlgeschlagen (mit grobem Grund), erste Flasche erstellt und erster Programmstart-Versuch. Es werden nie personenbezogene Daten, Dateinamen oder dir zuordenbare Kennungen gesendet. Du kannst das jederzeit in den Einstellungen \u00e4ndern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional and off by default. When enabled, Whisky sends five anonymous events covering the first-run funnel: runtime install started, succeeded, or failed (with a coarse reason), first bottle created, and first program launch attempt. No personal data, file names, or identifiers tied to you are ever sent. You can change this anytime in Settings."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional and off by default. When enabled, Whisky sends five anonymous events covering the first-run funnel: runtime install started, succeeded, or failed (with a coarse reason), first bottle created, and first program launch attempt. No personal data, file names, or identifiers tied to you are ever sent. You can change this anytime in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional y desactivado por omisi\u00f3n. Si lo activas, Whisky env\u00eda cinco eventos an\u00f3nimos sobre el primer uso: instalaci\u00f3n del runtime iniciada, correcta o fallida (con un motivo general), primera botella creada y primer intento de abrir un programa. Nunca se env\u00edan datos personales, nombres de archivo ni identificadores asociados a ti. Puedes cambiarlo cuando quieras en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valinnainen ja oletuksena pois k\u00e4yt\u00f6st\u00e4. Kun t\u00e4m\u00e4 on k\u00e4yt\u00f6ss\u00e4, Whisky l\u00e4hett\u00e4\u00e4 viisi nimet\u00f6nt\u00e4 tapahtumaa ensimm\u00e4isen k\u00e4ytt\u00f6kerran kulusta: ajoymp\u00e4rist\u00f6n asennus alkoi, onnistui tai ep\u00e4onnistui (karkealla syyll\u00e4), ensimm\u00e4inen pullo luotiin ja ensimm\u00e4inen ohjelman k\u00e4ynnistysyritys. Henkil\u00f6tietoja, tiedostonimi\u00e4 tai sinuun yhdistett\u00e4vi\u00e4 tunnisteita ei l\u00e4hetet\u00e4 koskaan. Voit muuttaa t\u00e4t\u00e4 milloin tahansa asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif et d\u00e9sactiv\u00e9 par d\u00e9faut. Lorsque cette option est activ\u00e9e, Whisky envoie cinq \u00e9v\u00e9nements anonymes couvrant le premier lancement : installation du runtime d\u00e9marr\u00e9e, r\u00e9ussie ou \u00e9chou\u00e9e (avec un motif g\u00e9n\u00e9ral), premi\u00e8re bouteille cr\u00e9\u00e9e et premi\u00e8re tentative de lancement d'un programme. Aucune donn\u00e9e personnelle, aucun nom de fichier ni identifiant vous concernant n'est envoy\u00e9. Vous pouvez modifier ce choix \u00e0 tout moment dans les R\u00e9glages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo e disattivato di default. Se attivo, Whisky invia cinque eventi anonimi relativi al primo utilizzo: installazione del runtime avviata, riuscita o non riuscita (con un motivo generico), prima bottiglia creata e primo tentativo di avvio di un programma. Non vengono mai inviati dati personali, nomi di file o identificativi collegati a te. Puoi modificare questa scelta in qualsiasi momento nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4efb\u610f\u3067\u3001\u521d\u671f\u8a2d\u5b9a\u3067\u306f\u30aa\u30d5\u3067\u3059\u3002\u6709\u52b9\u306b\u3059\u308b\u3068\u3001Whisky \u306f\u521d\u56de\u5229\u7528\u306e\u6d41\u308c\u306b\u95a2\u3059\u308b 5 \u7a2e\u985e\u306e\u533f\u540d\u30a4\u30d9\u30f3\u30c8 (\u30e9\u30f3\u30bf\u30a4\u30e0\u306e\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u306e\u958b\u59cb\u3001\u6210\u529f\u3001\u5931\u6557 (\u5927\u307e\u304b\u306a\u7406\u7531\u4ed8\u304d)\u3001\u6700\u521d\u306e Bottle \u306e\u4f5c\u6210\u3001\u6700\u521d\u306e\u30d7\u30ed\u30b0\u30e9\u30e0\u8d77\u52d5\u306e\u8a66\u884c) \u3092\u9001\u4fe1\u3057\u307e\u3059\u3002\u500b\u4eba\u60c5\u5831\u3084\u30d5\u30a1\u30a4\u30eb\u540d\u3001\u3042\u306a\u305f\u306b\u7d50\u3073\u4ed8\u304f\u8b58\u5225\u5b50\u304c\u9001\u4fe1\u3055\u308c\u308b\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u3053\u306e\u8a2d\u5b9a\u306f\u3044\u3064\u3067\u3082\u5909\u66f4\u3067\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc120\ud0dd \uc0ac\ud56d\uc774\uba70 \uae30\ubcf8\uc801\uc73c\ub85c \uaebc\uc838 \uc788\uc2b5\ub2c8\ub2e4. \ucf1c\uba74 Whisky\ub294 \uccab \uc2e4\ud589 \ud750\ub984\uc5d0 \uad00\ud55c \uc775\uba85 \uc774\ubca4\ud2b8 5\uac1c(\ub7f0\ud0c0\uc784 \uc124\uce58 \uc2dc\uc791, \uc131\uacf5, \uc2e4\ud328(\ub300\ub7b5\uc801\uc778 \uc774\uc720 \ud3ec\ud568), \uccab Bottle \uc0dd\uc131, \uccab \ud504\ub85c\uadf8\ub7a8 \uc2e4\ud589 \uc2dc\ub3c4)\ub97c \uc804\uc1a1\ud569\ub2c8\ub2e4. \uac1c\uc778 \uc815\ubcf4\ub098 \ud30c\uc77c \uc774\ub984, \uc0ac\uc6a9\uc790\ub97c \uc2dd\ubcc4\ud560 \uc218 \uc788\ub294 \uc815\ubcf4\ub294 \uc804\uc1a1\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc124\uc815\uc5d0\uc11c \uc5b8\uc81c\ub4e0\uc9c0 \ubcc0\uacbd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel en standaard uitgeschakeld. Wanneer dit is ingeschakeld, stuurt Whisky vijf anonieme gebeurtenissen over het eerste gebruik: installatie van de runtime gestart, geslaagd of mislukt (met een globale reden), eerste fles aangemaakt en eerste poging om een programma te starten. Er worden nooit persoonlijke gegevens, bestandsnamen of tot jou herleidbare kenmerken verstuurd. Je kunt dit altijd wijzigen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalne i domy\u015blnie wy\u0142\u0105czone. Po w\u0142\u0105czeniu Whisky wysy\u0142a pi\u0119\u0107 anonimowych zdarze\u0144 dotycz\u0105cych pierwszego uruchomienia: rozpocz\u0119cie instalacji silnika, jej powodzenie lub niepowodzenie (z og\u00f3ln\u0105 przyczyn\u0105), utworzenie pierwszej butelki oraz pierwsz\u0105 pr\u00f3b\u0119 uruchomienia programu. Dane osobowe, nazwy plik\u00f3w ani identyfikatory powi\u0105zane z Tob\u0105 nigdy nie s\u0105 wysy\u0142ane. Mo\u017cesz to zmieni\u0107 w ka\u017cdej chwili w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional e desativado por padr\u00e3o. Quando ativado, o Whisky envia cinco eventos an\u00f4nimos sobre o primeiro uso: instala\u00e7\u00e3o do runtime iniciada, conclu\u00edda ou com falha (com um motivo gen\u00e9rico), primeira Bottle criada e primeira tentativa de abrir um programa. Nunca s\u00e3o enviados dados pessoais, nomes de arquivos nem identificadores ligados a voc\u00ea. Voc\u00ea pode mudar isso quando quiser nas Configura\u00e7\u00f5es."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional e desativado por predefini\u00e7\u00e3o. Quando ativado, o Whisky envia cinco eventos an\u00f3nimos sobre a primeira utiliza\u00e7\u00e3o: instala\u00e7\u00e3o do runtime iniciada, conclu\u00edda ou falhada (com um motivo gen\u00e9rico), primeira Bottle criada e primeira tentativa de abrir um programa. Nunca s\u00e3o enviados dados pessoais, nomes de ficheiros nem identificadores associados a si. Pode alterar esta op\u00e7\u00e3o a qualquer momento nas Defini\u00e7\u00f5es."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Op\u021bional \u0219i dezactivat implicit. C\u00e2nd este activat, Whisky trimite cinci evenimente anonime despre prima utilizare: instalarea runtime-ului \u00eenceput\u0103, reu\u0219it\u0103 sau e\u0219uat\u0103 (cu un motiv general), prima sticl\u0103 creat\u0103 \u0219i prima \u00eencercare de lansare a unui program. Nu sunt trimise niciodat\u0103 date personale, nume de fi\u0219iere sau identificatori lega\u021bi de tine. Po\u021bi schimba oric\u00e2nd aceast\u0103 op\u021biune \u00een Set\u0103ri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0438 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u043e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u043e. \u0415\u0441\u043b\u0438 \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u044c, Whisky \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 \u043f\u044f\u0442\u044c \u0430\u043d\u043e\u043d\u0438\u043c\u043d\u044b\u0445 \u0441\u043e\u0431\u044b\u0442\u0438\u0439 \u043e \u043f\u0435\u0440\u0432\u043e\u043c \u0437\u0430\u043f\u0443\u0441\u043a\u0435: \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u0441\u0440\u0435\u0434\u044b \u043d\u0430\u0447\u0430\u043b\u0430\u0441\u044c, \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b\u0430\u0441\u044c \u0443\u0441\u043f\u0435\u0448\u043d\u043e \u0438\u043b\u0438 \u043d\u0435 \u0443\u0434\u0430\u043b\u0430\u0441\u044c (\u0441 \u043e\u0431\u0449\u0435\u0439 \u043f\u0440\u0438\u0447\u0438\u043d\u043e\u0439), \u0441\u043e\u0437\u0434\u0430\u043d\u0430 \u043f\u0435\u0440\u0432\u0430\u044f \u0431\u0443\u0442\u044b\u043b\u043a\u0430, \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0430 \u043f\u0435\u0440\u0432\u0430\u044f \u043f\u043e\u043f\u044b\u0442\u043a\u0430 \u0437\u0430\u043f\u0443\u0441\u043a\u0430 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b. \u041b\u0438\u0447\u043d\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435, \u0438\u043c\u0435\u043d\u0430 \u0444\u0430\u0439\u043b\u043e\u0432 \u0438 \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0435 \u0441 \u0432\u0430\u043c\u0438 \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440\u044b \u043d\u0435 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u043d\u0438\u043a\u043e\u0433\u0434\u0430. \u042d\u0442\u043e \u043c\u043e\u0436\u043d\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u0432 \u043b\u044e\u0431\u043e\u0439 \u043c\u043e\u043c\u0435\u043d\u0442 \u0432 \u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u0445."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valfritt och avst\u00e4ngt som standard. N\u00e4r det \u00e4r p\u00e5 skickar Whisky fem anonyma h\u00e4ndelser om det f\u00f6rsta f\u00f6rloppet: installation av runtime p\u00e5b\u00f6rjad, lyckad eller misslyckad (med en \u00f6vergripande orsak), f\u00f6rsta flaskan skapad och f\u00f6rsta f\u00f6rs\u00f6ket att starta ett program. Inga personuppgifter, filnamn eller identifierare som kan kopplas till dig skickas n\u00e5gonsin. Du kan \u00e4ndra detta n\u00e4r som helst i Inst\u00e4llningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130ste\u011fe ba\u011fl\u0131d\u0131r ve varsay\u0131lan olarak kapal\u0131d\u0131r. Etkinle\u015ftirildi\u011finde Whisky, ilk kullan\u0131m ak\u0131\u015f\u0131n\u0131 kapsayan be\u015f anonim olay g\u00f6nderir: \u00e7al\u0131\u015fma zaman\u0131 y\u00fcklemesinin ba\u015flamas\u0131, ba\u015far\u0131l\u0131 olmas\u0131 veya ba\u015far\u0131s\u0131z olmas\u0131 (genel bir nedenle birlikte), ilk \u015fi\u015fenin olu\u015fturulmas\u0131 ve ilk program ba\u015flatma denemesi. Ki\u015fisel veriler, dosya adlar\u0131 veya sizi tan\u0131mlayan bilgiler asla g\u00f6nderilmez. Bunu istedi\u011finiz zaman Ayarlar'dan de\u011fi\u015ftirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043e\u0431\u043e\u0432'\u044f\u0437\u043a\u043e\u0432\u043e \u0456 \u0442\u0438\u043f\u043e\u0432\u043e \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e. \u042f\u043a\u0449\u043e \u0443\u0432\u0456\u043c\u043a\u043d\u0443\u0442\u0438, Whisky \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u0454 \u043f'\u044f\u0442\u044c \u0430\u043d\u043e\u043d\u0456\u043c\u043d\u0438\u0445 \u043f\u043e\u0434\u0456\u0439 \u043f\u0440\u043e \u043f\u0435\u0440\u0448\u0438\u0439 \u0437\u0430\u043f\u0443\u0441\u043a: \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0440\u0443\u0448\u0456\u044f \u043f\u043e\u0447\u0430\u043b\u043e\u0441\u044f, \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b\u043e\u0441\u044f \u0443\u0441\u043f\u0456\u0448\u043d\u043e \u0430\u0431\u043e \u043d\u0435\u0432\u0434\u0430\u043b\u043e (\u0456\u0437 \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u043e\u044e \u043f\u0440\u0438\u0447\u0438\u043d\u043e\u044e), \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043e \u043f\u0435\u0440\u0448\u0443 \u043f\u043b\u044f\u0448\u043a\u0443, \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043e \u043f\u0435\u0440\u0448\u0443 \u0441\u043f\u0440\u043e\u0431\u0443 \u0437\u0430\u043f\u0443\u0441\u043a\u0443 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438. \u041e\u0441\u043e\u0431\u0438\u0441\u0442\u0456 \u0434\u0430\u043d\u0456, \u043d\u0430\u0437\u0432\u0438 \u0444\u0430\u0439\u043b\u0456\u0432 \u0456 \u043f\u043e\u0432'\u044f\u0437\u0430\u043d\u0456 \u0437 \u0432\u0430\u043c\u0438 \u0456\u0434\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0430\u0442\u043e\u0440\u0438 \u043d\u0435 \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u044e\u0442\u044c\u0441\u044f \u043d\u0456\u043a\u043e\u043b\u0438. \u0426\u0435 \u043c\u043e\u0436\u043d\u0430 \u0437\u043c\u0456\u043d\u0438\u0442\u0438 \u0431\u0443\u0434\u044c-\u043a\u043e\u043b\u0438 \u0432 \u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u0445."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00f9y ch\u1ecdn v\u00e0 m\u1eb7c \u0111\u1ecbnh t\u1eaft. Khi b\u1eadt, Whisky g\u1eedi n\u0103m s\u1ef1 ki\u1ec7n \u1ea9n danh v\u1ec1 qu\u00e1 tr\u00ecnh d\u00f9ng l\u1ea7n \u0111\u1ea7u: b\u1eaft \u0111\u1ea7u c\u00e0i runtime, c\u00e0i th\u00e0nh c\u00f4ng ho\u1eb7c th\u1ea5t b\u1ea1i (k\u00e8m l\u00fd do chung), t\u1ea1o bottle \u0111\u1ea7u ti\u00ean v\u00e0 l\u1ea7n \u0111\u1ea7u th\u1eed kh\u1edfi ch\u1ea1y ch\u01b0\u01a1ng tr\u00ecnh. Kh\u00f4ng bao gi\u1edd g\u1eedi d\u1eef li\u1ec7u c\u00e1 nh\u00e2n, t\u00ean t\u1ec7p hay th\u00f4ng tin nh\u1eadn d\u1ea1ng b\u1ea1n. B\u1ea1n c\u00f3 th\u1ec3 thay \u0111\u1ed5i b\u1ea5t c\u1ee9 l\u00fac n\u00e0o trong C\u00e0i \u0111\u1eb7t."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u9879\u4e3a\u53ef\u9009\uff0c\u9ed8\u8ba4\u5173\u95ed\u3002\u542f\u7528\u540e\uff0cWhisky \u4f1a\u53d1\u9001\u4e94\u4e2a\u4e0e\u9996\u6b21\u4f7f\u7528\u6d41\u7a0b\u76f8\u5173\u7684\u533f\u540d\u4e8b\u4ef6\uff1a\u8fd0\u884c\u65f6\u5b89\u88c5\u5f00\u59cb\u3001\u6210\u529f\u6216\u5931\u8d25\uff08\u9644\u5927\u81f4\u539f\u56e0\uff09\u3001\u9996\u6b21\u521b\u5efa Bottle\uff0c\u4ee5\u53ca\u9996\u6b21\u5c1d\u8bd5\u542f\u52a8\u7a0b\u5e8f\u3002\u4e0d\u4f1a\u53d1\u9001\u4efb\u4f55\u4e2a\u4eba\u6570\u636e\u3001\u6587\u4ef6\u540d\u6216\u4e0e\u4f60\u76f8\u5173\u7684\u6807\u8bc6\u7b26\u3002\u4f60\u53ef\u4ee5\u968f\u65f6\u5728\u8bbe\u7f6e\u4e2d\u66f4\u6539\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u9805\u70ba\u9078\u7528\uff0c\u9810\u8a2d\u70ba\u95dc\u9589\u3002\u555f\u7528\u5f8c\uff0cWhisky \u6703\u50b3\u9001\u4e94\u500b\u8207\u521d\u6b21\u4f7f\u7528\u6d41\u7a0b\u76f8\u95dc\u7684\u533f\u540d\u4e8b\u4ef6\uff1a\u57f7\u884c\u968e\u6bb5\u5b89\u88dd\u958b\u59cb\u3001\u6210\u529f\u6216\u5931\u6557\uff08\u9644\u5927\u81f4\u539f\u56e0\uff09\u3001\u9996\u6b21\u5efa\u7acb Bottle\uff0c\u4ee5\u53ca\u9996\u6b21\u5617\u8a66\u555f\u52d5\u7a0b\u5f0f\u3002\u4e0d\u6703\u50b3\u9001\u4efb\u4f55\u500b\u4eba\u8cc7\u6599\u3001\u6a94\u6848\u540d\u7a31\u6216\u8207\u4f60\u76f8\u95dc\u7684\u8b58\u5225\u78bc\u3002\u4f60\u53ef\u4ee5\u96a8\u6642\u5728\u8a2d\u5b9a\u4e2d\u66f4\u6539\u3002"
          }
        }
      }
    },
