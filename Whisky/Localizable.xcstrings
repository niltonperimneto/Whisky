    "controller.useButtonLabels.help": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u062d\u0627\u0641\u0638 \u0639\u0644\u0649 \u0627\u0644\u0645\u0648\u0627\u0636\u0639 \u0627\u0644\u0641\u0639\u0644\u064a\u0629 \u0644\u0644\u0623\u0632\u0631\u0627\u0631 \u0641\u064a \u0648\u062d\u062f\u0627\u062a \u062a\u062d\u0643\u0645 PlayStation"
