    "steam.patch.revert.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Steam's original files are restored and it will update itself again. Windows games will stop launching from Steam until you turn compatibility tools back on.\n\nSteam will be quit first."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Steam's original files are restored and it will update itself again. Windows games will stop launching from Steam until you turn compatibility tools back on.\n\nSteam will be quit first."
