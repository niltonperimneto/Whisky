    "gameConfig.preview.winetricksNote": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0639\u062f\u0651\u0644 \u0639\u0645\u0644\u064a\u0627\u062a \u062a\u062b\u0628\u064a\u062a Winetricks \u0628\u0627\u062f\u0626\u0629 Wine \u0648\u0644\u0627 \u064a\u0645\u0643\u0646 \u0627\u0644\u062a\u0631\u0627\u062c\u0639 \u0639\u0646\u0647\u0627"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalace p\u0159es winetricks m\u011bn\u00ed prefix Wine a nelze je vr\u00e1tit zp\u011bt"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Winetricks-installationer \u00e6ndrer Wine-pr\u00e6fikset og kan ikke fortrydes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Winetricks-Installationen ver\u00e4ndern das Wine-Pr\u00e4fix und k\u00f6nnen nicht r\u00fcckg\u00e4ngig gemacht werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Winetricks installations modify the Wine prefix and cannot be undone"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Winetricks installations modify the Wine prefix and cannot be undone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las instalaciones de Winetricks modifican el prefijo de Wine y no se pueden deshacer"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Winetricks-asennukset muuttavat Wine-etuliitett\u00e4 eik\u00e4 niit\u00e4 voi perua"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les installations Winetricks modifient le pr\u00e9fixe Wine et sont irr\u00e9versibles"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le installazioni di Winetricks modificano il prefisso Wine e non possono essere annullate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Winetricks \u3067\u306e\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u306f Wine \u30d7\u30ec\u30d5\u30a3\u30c3\u30af\u30b9\u3092\u5909\u66f4\u3059\u308b\u305f\u3081\u3001\u53d6\u308a\u6d88\u305b\u307e\u305b\u3093"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Winetricks \uc124\uce58\ub294 Wine \ud504\ub9ac\ud53d\uc2a4\ub97c \ubcc0\uacbd\ud558\uba70 \ub418\ub3cc\ub9b4 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Winetricks-installaties wijzigen de Wine-prefix en kunnen niet ongedaan worden gemaakt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalacje winetricks zmieniaj\u0105 prefiks Wine i nie mo\u017cna ich cofn\u0105\u0107"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As instala\u00e7\u00f5es do Winetricks alteram o prefixo do Wine e n\u00e3o podem ser desfeitas"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As instala\u00e7\u00f5es do Winetricks alteram o prefixo do Wine e n\u00e3o podem ser anuladas"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Instal\u0103rile Winetricks modific\u0103 prefixul Wine \u0219i nu pot fi anulate"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u0447\u0435\u0440\u0435\u0437 winetricks \u043c\u0435\u043d\u044f\u0435\u0442 \u043f\u0440\u0435\u0444\u0438\u043a\u0441 Wine, \u0438 \u044d\u0442\u043e \u043d\u0435\u043b\u044c\u0437\u044f \u043e\u0442\u043c\u0435\u043d\u0438\u0442\u044c"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Winetricks-installationer \u00e4ndrar Wine-prefixet och g\u00e5r inte att \u00e5ngra"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Winetricks y\u00fcklemeleri Wine \u00f6n ekini de\u011fi\u015ftirir ve geri al\u0131namaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0447\u0435\u0440\u0435\u0437 winetricks \u0437\u043c\u0456\u043d\u044e\u0454 \u043f\u0440\u0435\u0444\u0456\u043a\u0441 Wine, \u0456 \u0446\u0435 \u043d\u0435 \u043c\u043e\u0436\u043d\u0430 \u0441\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi\u1ec7c c\u00e0i \u0111\u1eb7t b\u1eb1ng Winetricks s\u1ebd thay \u0111\u1ed5i prefix Wine v\u00e0 kh\u00f4ng th\u1ec3 ho\u00e0n t\u00e1c"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Winetricks \u5b89\u88c5\u4f1a\u4fee\u6539 Wine \u524d\u7f00\uff0c\u4e14\u65e0\u6cd5\u64a4\u9500"
          }
        },
        "zh-Hant": {
          "stringUnit": {
