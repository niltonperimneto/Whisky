    "Enables automatic fixes for Steam, Rockstar, EA App, Epic Games, and other game launchers (frankea/Whisky#41)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0641\u0639\u0651\u0644 \u0627\u0644\u0625\u0635\u0644\u0627\u062d\u0627\u062a \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629 \u0644\u0640 Steam \u0648Rockstar \u0648EA App \u0648Epic Games \u0648\u063a\u064a\u0631\u0647\u0627 \u0645\u0646 \u0645\u0634\u063a\u0651\u0644\u0627\u062a \u0627\u0644\u0623\u0644\u0639\u0627\u0628 (frankea/Whisky#41)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zap\u00edn\u00e1 automatick\u00e9 opravy pro Steam, Rockstar, EA App, Epic Games a dal\u0161\u00ed hern\u00ed launchery (frankea/Whisky#41)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiverer automatiske l\u00f8sninger til Steam, Rockstar, EA App, Epic Games og andre spillaunchere (frankea/Whisky#41)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviert automatische Korrekturen f\u00fcr Steam, Rockstar, EA App, Epic Games und andere Spiele-Launcher (frankea/Whisky#41)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enables automatic fixes for Steam, Rockstar, EA App, Epic Games, and other game launchers (frankea/Whisky#41)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Enables automatic fixes for Steam, Rockstar, EA App, Epic Games, and other game launchers (frankea/Whisky#41)"
