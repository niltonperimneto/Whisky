    "process.confirm.forceStop.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0633\u064a\u0624\u062f\u064a \u0647\u0630\u0627 \u0625\u0644\u0649 \u0625\u0646\u0647\u0627\u0621 \u062c\u0645\u064a\u0639 \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0641\u0648\u0631\u064b\u0627 \u062f\u0648\u0646 \u062d\u0641\u0638."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u0161echny procesy budou okam\u017eit\u011b ukon\u010deny bez ulo\u017een\u00ed."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle processer bliver afbrudt med det samme uden at arkivere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle Prozesse sofort und ohne Sichern beendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will immediately terminate all processes without saving."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This will immediately terminate all processes without saving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cerrar\u00e1n de inmediato todos los procesos sin guardar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00e4m\u00e4 lopettaa kaikki prosessit v\u00e4litt\u00f6m\u00e4sti tallentamatta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les processus seront imm\u00e9diatement interrompus sans enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i processi verranno terminati immediatamente senza salvare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4fdd\u5b58\u305b\u305a\u306b\u3059\u3079\u3066\u306e\u30d7\u30ed\u30bb\u30b9\u3092\u305f\u3060\u3061\u306b\u7d42\u4e86\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc800\uc7a5\ud558\uc9c0 \uc54a\uace0 \ubaa8\ub4e0 \ud504\ub85c\uc138\uc2a4\ub97c \uc989\uc2dc \uc885\ub8cc\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden alle processen direct be\u00ebindigd zonder te bewaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie procesy zostan\u0105 natychmiast zako\u0144czone bez zapisywania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os processos ser\u00e3o encerrados imediatamente, sem salvar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os processos ser\u00e3o terminados de imediato, sem guardar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate procesele vor fi oprite imediat, f\u0103r\u0103 salvare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0441\u0435 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u044b \u0431\u0443\u0434\u0443\u0442 \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u044b \u0431\u0435\u0437 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla processer avslutas omedelbart utan att spara."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu i\u015flem, t\u00fcm i\u015flemleri kaydetmeden hemen sonland\u0131r\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0441\u0456 \u043f\u0440\u043e\u0446\u0435\u0441\u0438 \u0431\u0443\u0434\u0435 \u043d\u0435\u0433\u0430\u0439\u043d\u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043e \u0431\u0435\u0437 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao t\u00e1c n\u00e0y s\u1ebd k\u1ebft th\u00fac ngay m\u1ecdi ti\u1ebfn tr\u00ecnh m\u00e0 kh\u00f4ng l\u01b0u."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fd9\u5c06\u7acb\u5373\u7ec8\u6b62\u6240\u6709\u8fdb\u7a0b\uff0c\u4e14\u4e0d\u4f1a\u5b58\u50a8\u4efb\u4f55\u5185\u5bb9\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9019\u6703\u7acb\u5373\u7d42\u6b62\u6240\u6709\u7a0b\u5e8f\uff0c\u4e14\u4e0d\u6703\u5132\u5b58\u4efb\u4f55\u5167\u5bb9\u3002"
          }
        }
      }
    },
    "process.confirm.forceStop.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0647\u0644 \u062a\u0631\u064a\u062f \u0641\u0631\u0636 \u0625\u064a\u0642\u0627\u0641 \u0627\u0644\u0632\u062c\u0627\u062c\u0629\u061f"
          }
        },
        "cs": {
