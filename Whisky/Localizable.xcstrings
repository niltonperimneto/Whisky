        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud574\uc0c1\ub3c4\ub294 \ub2e4\uc74c \uc2e4\ud589 \uc2dc \uc801\uc6a9\ub429\ub2c8\ub2e4."
