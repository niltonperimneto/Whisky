        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usu\u0144 t\u0119 niedost\u0119pn\u0105 butelk\u0119 z listy"
          }
        },
        "pt-BR": {
          "stringUnit": {
