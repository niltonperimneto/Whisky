    "troubleshooting.resolved.description": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0645 \u0625\u0635\u0644\u0627\u062d \u0627\u0644\u0645\u0634\u0643\u0644\u0629. \u064a\u0645\u0643\u0646\u0643 \u062a\u0635\u062f\u064a\u0631 \u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u062c\u0644\u0633\u0629 \u0644\u0644\u0627\u062d\u062a\u0641\u0627\u0638 \u0628\u0647."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Probl\u00e9m byl vy\u0159e\u0161en. Pro sv\u00e9 z\u00e1znamy si m\u016f\u017eete exportovat zpr\u00e1vu o relaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Problemet er l\u00f8st. Du kan eksportere en sessionsrapport til dine egne noter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Problem wurde behoben. Du kannst einen Sitzungsbericht f\u00fcr deine Unterlagen exportieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The issue has been fixed. You can export a session report for your records."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The issue has been fixed. You can export a session report for your records."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El problema est\u00e1 resuelto. Puedes exportar un informe de la sesi\u00f3n para tus archivos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongelma on korjattu. Voit vied\u00e4 istunnon raportin muistiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le probl\u00e8me est r\u00e9solu. Vous pouvez exporter un rapport de session pour vos archives."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il problema \u00e8 stato risolto. Puoi esportare un report della sessione da conservare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u554f\u984c\u306f\u89e3\u6c7a\u3057\u307e\u3057\u305f\u3002\u8a18\u9332\u7528\u306b\u30bb\u30c3\u30b7\u30e7\u30f3\u30ec\u30dd\u30fc\u30c8\u3092\u66f8\u304d\u51fa\u305b\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubb38\uc81c\uac00 \ud574\uacb0\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uae30\ub85d\uc6a9\uc73c\ub85c \uc138\uc158 \ubcf4\uace0\uc11c\ub97c \ub0b4\ubcf4\ub0bc \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het probleem is opgelost. Je kunt een sessierapport exporteren voor je eigen administratie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Problem zosta\u0142 naprawiony. Mo\u017cesz wyeksportowa\u0107 raport sesji do w\u0142asnej dokumentacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O problema foi resolvido. Voc\u00ea pode exportar um relat\u00f3rio da sess\u00e3o para guardar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O problema foi resolvido. Pode exportar um relat\u00f3rio da sess\u00e3o para os seus registos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Problema a fost rezolvat\u0103. Po\u021bi exporta un raport al sesiunii pentru eviden\u021ba ta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0443\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0430. \u041f\u0440\u0438 \u0436\u0435\u043b\u0430\u043d\u0438\u0438 \u043c\u043e\u0436\u043d\u043e \u044d\u043a\u0441\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043e\u0442\u0447\u0451\u0442 \u0441\u0435\u0430\u043d\u0441\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Problemet \u00e4r l\u00f6st. Du kan exportera en sessionsrapport f\u00f6r egna anteckningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorun giderildi. Kay\u0131tlar\u0131n\u0131z i\u00e7in bir oturum raporu d\u0131\u015fa aktarabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0431\u043b\u0435\u043c\u0443 \u0443\u0441\u0443\u043d\u0435\u043d\u043e. \u0417\u0430 \u0431\u0430\u0436\u0430\u043d\u043d\u044f\u043c \u043c\u043e\u0436\u043d\u0430 \u0435\u043a\u0441\u043f\u043e\u0440\u0442\u0443\u0432\u0430\u0442\u0438 \u0437\u0432\u0456\u0442 \u0441\u0435\u0430\u043d\u0441\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u1ef1 c\u1ed1 \u0111\u00e3 \u0111\u01b0\u1ee3c kh\u1eafc ph\u1ee5c. B\u1ea1n c\u00f3 th\u1ec3 xu\u1ea5t b\u00e1o c\u00e1o phi\u00ean \u0111\u1ec3 l\u01b0u l\u1ea1i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u95ee\u9898\u5df2\u4fee\u590d\u3002\u4f60\u53ef\u4ee5\u5bfc\u51fa\u4f1a\u8bdd\u62a5\u544a\u4ee5\u5907\u5b58\u6863\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u554f\u984c\u5df2\u4fee\u6b63\u3002\u4f60\u53ef\u4ee5\u532f\u51fa\u5de5\u4f5c\u968e\u6bb5\u5831\u544a\u4ee5\u4f9b\u5b58\u67e5\u3002"
          }
        }
      }
    },
