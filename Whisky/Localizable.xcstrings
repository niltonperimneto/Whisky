    "config.sequoiaCompat.d3dmetalOnly": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0646\u0637\u0628\u0642 \u0641\u0642\u0637 \u0639\u0646\u062f \u0627\u062e\u062a\u064a\u0627\u0631 D3DMetal."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plat\u00ed jen p\u0159i zvolen\u00e9m D3DMetal."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00e6lder kun, n\u00e5r D3DMetal er valgt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur relevant, wenn D3DMetal ausgew\u00e4hlt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only applicable when D3DMetal is selected."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Only applicable when D3DMetal is selected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se aplica si est\u00e1 seleccionado D3DMetal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koskee vain, kun D3DMetal on valittuna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Applicable uniquement si D3DMetal est s\u00e9lectionn\u00e9."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si applica solo se \u00e8 selezionato D3DMetal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "D3DMetal \u3092\u9078\u629e\u3057\u3066\u3044\u308b\u5834\u5408\u306b\u306e\u307f\u9069\u7528\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "D3DMetal\uc744 \uc120\ud0dd\ud588\uc744 \ub54c\ub9cc \uc801\uc6a9\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen van toepassing wanneer D3DMetal is geselecteerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotyczy tylko wybranego D3DMetal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00f3 se aplica quando o D3DMetal est\u00e1 selecionado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00f3 se aplica quando o D3DMetal est\u00e1 selecionado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplic\u0103 doar c\u00e2nd este selectat D3DMetal."
