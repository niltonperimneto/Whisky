          }
        }
      }
    },
    "Recommended only when sharing privately": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u064f\u0646\u0635\u062d \u0628\u0647 \u0639\u0646\u062f \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0629 \u0627\u0644\u062e\u0627\u0635\u0629 \u0641\u0642\u0637"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Doporu\u010deno jen p\u0159i soukrom\u00e9m sd\u00edlen\u00ed"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anbefales kun ved privat deling"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur beim privaten Teilen empfohlen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomendado solo para compartir en privado"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suositellaan vain yksityisesti jaettaessa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommand\u00e9 uniquement pour un partage priv\u00e9"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consigliato solo per la condivisione privata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u975e\u516c\u958b\u3067\u5171\u6709\u3059\u308b\u5834\u5408\u306b\u306e\u307f\u63a8\u5968\u3055\u308c\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ube44\uacf5\uac1c\ub85c \uacf5\uc720\ud560 \ub54c\ub9cc \uad8c\uc7a5\ud569\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen aanbevolen bij priv\u00e9 delen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalecane tylko przy udost\u0119pnianiu prywatnym"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomendado apenas para compartilhar em privado"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomendado apenas para partilha privada"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomandat doar pentru partajare privat\u0103"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u0438 \u043b\u0438\u0447\u043d\u043e\u0439 \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0435"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekommenderas endast vid privat delning"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaln\u0131zca \u00f6zel olarak payla\u015f\u0131rken \u00f6nerilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u043e \u043b\u0438\u0448\u0435 \u0434\u043b\u044f \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u043e\u0433\u043e \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u043d\u043d\u044f"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u1ec9 n\u00ean d\u00f9ng khi chia s\u1ebb ri\u00eang t\u01b0"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ec5\u5efa\u8bae\u5728\u79c1\u4e0b\u5171\u4eab\u65f6\u4f7f\u7528"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u50c5\u5efa\u8b70\u5728\u79c1\u4e0b\u5206\u4eab\u6642\u4f7f\u7528"
          }
