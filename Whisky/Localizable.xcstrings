    "config.virtualDesktop.nextLaunch": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u064f\u0637\u0628\u064e\u0651\u0642 \u0627\u0644\u062f\u0642\u0629 \u0639\u0646\u062f \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u062a\u0627\u0644\u064a."
