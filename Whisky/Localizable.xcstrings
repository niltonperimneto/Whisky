    "settings.toggle.menubar.help": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0636\u064a\u0641 \u0639\u0646\u0635\u0631\u064b\u0627 \u0641\u064a \u0634\u0631\u064a\u0637 \u0627\u0644\u0642\u0648\u0627\u0626\u0645 \u0644\u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0628\u0631\u0627\u0645\u062c \u0627\u0644\u0645\u062b\u0628\u0651\u062a\u0629 \u0641\u064a \u0627\u0644\u0642\u0627\u0626\u0645\u0629\u060c \u0648\u064a\u064f\u0628\u0642\u064a Whisky \u064a\u0639\u0645\u0644 \u0628\u0639\u062f \u0625\u063a\u0644\u0627\u0642 \u0646\u0627\u0641\u0630\u062a\u0647."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "P\u0159id\u00e1 polo\u017eku do \u0159\u00e1dku nab\u00eddek pro spou\u0161t\u011bn\u00ed p\u0159ipnut\u00fdch program\u016f a nech\u00e1 Whisky b\u011b\u017eet i po zav\u0159en\u00ed okna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilf\u00f8jer et emne i menulinjen til at starte fastgjorte programmer og holder Whisky k\u00f8rende, efter at vinduet er lukket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00fcgt ein Men\u00fcleisten-Symbol zum Starten angehefteter Programme hinzu und h\u00e4lt Whisky nach dem Schlie\u00dfen des Fensters aktiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a menu-bar item for launching pinned programs, and keep Whisky running after its window is closed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a menu-bar item for launching pinned programs, and keep Whisky running after its window is closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A\u00f1ade un \u00edtem en la barra de men\u00fas para abrir programas anclados y mantiene Whisky activo tras cerrar su ventana."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lis\u00e4\u00e4 valikkoriville kohteen, josta voit k\u00e4ynnist\u00e4\u00e4 kiinnitettyj\u00e4 ohjelmia, ja pit\u00e4\u00e4 Whiskyn k\u00e4ynniss\u00e4 ikkunan sulkemisen j\u00e4lkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un \u00e9l\u00e9ment de barre des menus pour lancer les programmes \u00e9pingl\u00e9s et garde Whisky ouvert apr\u00e8s la fermeture de sa fen\u00eatre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge un elemento nella barra dei menu per avviare i programmi fissati e mantiene Whisky attivo dopo la chiusura della finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d4\u30f3\u7559\u3081\u3057\u305f\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u8d77\u52d5\u3067\u304d\u308b\u30e1\u30cb\u30e5\u30fc\u30d0\u30fc\u9805\u76ee\u3092\u8ffd\u52a0\u3057\u3001\u30a6\u30a4\u30f3\u30c9\u30a6\u3092\u9589\u3058\u305f\u3042\u3068\u3082 Whisky \u3092\u5b9f\u884c\u3057\u7d9a\u3051\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uace0\uc815\ub41c \ud504\ub85c\uadf8\ub7a8\uc744 \uc2e4\ud589\ud560 \uc218 \uc788\ub294 \uba54\ub274 \ub9c9\ub300 \ud56d\ubaa9\uc744 \ucd94\uac00\ud558\uace0, \uc708\ub3c4\uc6b0\ub97c \ub2eb\uc740 \ub4a4\uc5d0\ub3c4 Whisky\ub97c \uacc4\uc18d \uc2e4\ud589\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voegt een menubalksymbool toe voor het starten van vastgezette programma's en houdt Whisky actief nadat het venster is gesloten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje pozycj\u0119 na pasku menu do uruchamiania przypi\u0119tych program\u00f3w i utrzymuje Whisky po zamkni\u0119ciu okna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um item na barra de menus para abrir programas fixados e mant\u00e9m o Whisky em execu\u00e7\u00e3o depois que a janela \u00e9 fechada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um item na barra de menus para abrir programas fixados e mant\u00e9m o Whisky em execu\u00e7\u00e3o depois de fechar a janela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaug\u0103 un element \u00een bara de meniu pentru lansarea programelor fixate \u0219i men\u021bine Whisky pornit dup\u0103 \u00eenchiderea ferestrei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u0442 \u043e\u0431\u044a\u0435\u043a\u0442 \u0432 \u0441\u0442\u0440\u043e\u043a\u0443 \u043c\u0435\u043d\u044e \u0434\u043b\u044f \u0437\u0430\u043f\u0443\u0441\u043a\u0430 \u0437\u0430\u043a\u0440\u0435\u043f\u043b\u0451\u043d\u043d\u044b\u0445 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c \u0438 \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 Whisky \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u043f\u043e\u0441\u043b\u0435 \u0437\u0430\u043a\u0440\u044b\u0442\u0438\u044f \u043e\u043a\u043d\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00e4gger till ett objekt i menyraden f\u00f6r att starta f\u00e4sta program och h\u00e5ller Whisky ig\u00e5ng efter att f\u00f6nstret har st\u00e4ngts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabitlenmi\u015f programlar\u0131 ba\u015flatmak i\u00e7in bir men\u00fc \u00e7ubu\u011fu \u00f6gesi ekler ve penceresi kapat\u0131ld\u0131ktan sonra Whisky'yi \u00e7al\u0131\u015f\u0131r durumda tutar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043e\u0434\u0430\u0454 \u043e\u0431'\u0454\u043a\u0442 \u0443 \u0440\u044f\u0434\u043e\u043a \u043c\u0435\u043d\u044e \u0434\u043b\u044f \u0437\u0430\u043f\u0443\u0441\u043a\u0443 \u0437\u0430\u043a\u0440\u0456\u043f\u043b\u0435\u043d\u0438\u0445 \u043f\u0440\u043e\u0433\u0440\u0430\u043c \u0456 \u0437\u0430\u043b\u0438\u0448\u0430\u0454 Whisky \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u043f\u0456\u0441\u043b\u044f \u0437\u0430\u043a\u0440\u0438\u0442\u0442\u044f \u0432\u0456\u043a\u043d\u0430."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Th\u00eam m\u1ed9t m\u1ee5c tr\u00ean thanh menu \u0111\u1ec3 kh\u1edfi ch\u1ea1y c\u00e1c ch\u01b0\u01a1ng tr\u00ecnh \u0111\u00e3 ghim, v\u00e0 gi\u1eef Whisky ch\u1ea1y sau khi \u0111\u00f3ng c\u1eeda s\u1ed5."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6dfb\u52a0\u83dc\u5355\u680f\u9879\u4ee5\u542f\u52a8\u5df2\u56fa\u5b9a\u7684\u7a0b\u5e8f\uff0c\u5e76\u5728\u5173\u95ed\u7a97\u53e3\u540e\u8ba9 Whisky \u7ee7\u7eed\u8fd0\u884c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u52a0\u5165\u9078\u55ae\u5217\u9805\u76ee\u4ee5\u555f\u52d5\u91d8\u9078\u7684\u7a0b\u5f0f\uff0c\u4e26\u5728\u95dc\u9589\u8996\u7a97\u5f8c\u8b93 Whisky \u7e7c\u7e8c\u57f7\u884c\u3002"
          }
        }
      }
    },
