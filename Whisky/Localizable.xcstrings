    "bottle.registry.corrupt.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0639\u0630\u0651\u0631 \u0639\u0644\u0649 Whisky \u0642\u0631\u0627\u0621\u0629 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0632\u062c\u0627\u062c\u0627\u062a \u0627\u0644\u0645\u062d\u0641\u0648\u0638\u0629\u060c \u0644\u0630\u0627 \u062a\u0645 \u0625\u0646\u0634\u0627\u0621 \u0642\u0627\u0626\u0645\u0629 \u0641\u0627\u0631\u063a\u0629 \u062c\u062f\u064a\u062f\u0629. \u0646\u064f\u0642\u0644 \u0627\u0644\u0645\u0644\u0641 \u063a\u064a\u0631 \u0627\u0644\u0642\u0627\u0628\u0644 \u0644\u0644\u0642\u0631\u0627\u0621\u0629 \u0625\u0644\u0649 \u00ab%@\u00bb. \u0648\u0644\u0645 \u062a\u064f\u062d\u0630\u0641 \u0645\u062c\u0644\u062f\u0627\u062a \u0627\u0644\u0632\u062c\u0627\u062c\u0627\u062a \u0639\u0644\u0649 \u0627\u0644\u0642\u0631\u0635."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky nedok\u00e1zala p\u0159e\u010d\u00edst ulo\u017een\u00fd seznam lahv\u00ed, a proto vytvo\u0159ila nov\u00fd pr\u00e1zdn\u00fd. Ne\u010diteln\u00fd soubor byl p\u0159esunut do \u201e%@\u201c. Slo\u017eky lahv\u00ed na disku z\u016fstaly zachov\u00e1ny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky kunne ikke l\u00e6se den arkiverede liste over flasker og oprettede derfor en ny, tom liste. Den ul\u00e6selige fil blev flyttet til \u201c%@\u201d. Dine flaskemapper p\u00e5 disken blev ikke slettet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky konnte die gesicherte Flaschenliste nicht lesen und hat eine neue, leere Liste angelegt. Die unlesbare Datei wurde nach \u201e%@\u201c verschoben. Deine Flaschenordner auf der Festplatte wurden nicht gel\u00f6scht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky couldn't read its saved bottle list, so a fresh empty list was created. The unreadable file was moved to \u201c%@\u201d. Your bottle folders on disk were not deleted."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky couldn't read its saved bottle list, so a fresh empty list was created. The unreadable file was moved to \u201c%@\u201d. Your bottle folders on disk were not deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky no ha podido leer su lista de botellas guardada, as\u00ed que se ha creado una lista vac\u00eda. El archivo ilegible se ha movido a \u00ab%@\u00bb. Las carpetas de tus botellas en el disco no se han borrado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky ei voinut lukea tallennettua pulloluetteloa, joten tilalle luotiin tyhj\u00e4 luettelo. Lukukelvoton tiedosto siirrettiin sijaintiin \u201d%@\u201d. Levyll\u00e4 olevia pullokansioitasi ei poistettu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky n'a pas pu lire sa liste de bouteilles enregistr\u00e9e ; une nouvelle liste vide a \u00e9t\u00e9 cr\u00e9\u00e9e. Le fichier illisible a \u00e9t\u00e9 d\u00e9plac\u00e9 vers \u00ab %@ \u00bb. Vos dossiers de bouteilles sur le disque n'ont pas \u00e9t\u00e9 supprim\u00e9s."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky non \u00e8 riuscito a leggere l'elenco delle bottiglie salvato, perci\u00f2 ne \u00e8 stato creato uno nuovo e vuoto. Il file illeggibile \u00e8 stato spostato in \u00ab%@\u00bb. Le cartelle delle bottiglie sul disco non sono state eliminate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky \u306f\u4fdd\u5b58\u3055\u308c\u3066\u3044\u305f Bottle \u306e\u4e00\u89a7\u3092\u8aad\u307f\u8fbc\u3081\u306a\u304b\u3063\u305f\u305f\u3081\u3001\u7a7a\u306e\u4e00\u89a7\u3092\u65b0\u3057\u304f\u4f5c\u6210\u3057\u307e\u3057\u305f\u3002\u8aad\u307f\u8fbc\u3081\u306a\u304b\u3063\u305f\u30d5\u30a1\u30a4\u30eb\u306f\u300c%@\u300d\u306b\u79fb\u52d5\u3057\u307e\u3057\u305f\u3002\u30c7\u30a3\u30b9\u30af\u4e0a\u306e Bottle \u306e\u30d5\u30a9\u30eb\u30c0\u306f\u524a\u9664\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky\uac00 \uc800\uc7a5\ub41c Bottle \ubaa9\ub85d\uc744 \uc77d\uc9c0 \ubabb\ud574 \uc0c8 \ube48 \ubaa9\ub85d\uc744 \ub9cc\ub4e4\uc5c8\uc2b5\ub2c8\ub2e4. \uc77d\uc744 \uc218 \uc5c6\ub358 \ud30c\uc77c\uc740 \u201c%@\u201d(\uc73c)\ub85c \uc62e\uacbc\uc2b5\ub2c8\ub2e4. \ub514\uc2a4\ud06c\uc758 Bottle \ud3f4\ub354\ub294 \uc0ad\uc81c\ub418\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky kon de bewaarde flessenlijst niet lezen en heeft een nieuwe, lege lijst aangemaakt. Het onleesbare bestand is verplaatst naar \u201c%@\u201d. Je flesmappen op de schijf zijn niet verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky nie m\u00f3g\u0142 odczyta\u0107 zapisanej listy butelek, wi\u0119c utworzy\u0142 now\u0105, pust\u0105 list\u0119. Nieczytelny plik zosta\u0142 przeniesiony do \u201e%@\u201d. Foldery butelek na dysku nie zosta\u0142y usuni\u0119te."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Whisky n\u00e3o conseguiu ler a lista de Bottles salva, ent\u00e3o uma lista vazia foi criada. O arquivo ileg\u00edvel foi movido para \u201c%@\u201d. As pastas das suas Bottles no disco n\u00e3o foram apagadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Whisky n\u00e3o conseguiu ler a lista de Bottles guardada, por isso foi criada uma lista vazia. O ficheiro ileg\u00edvel foi movido para \u00ab%@\u00bb. As pastas das suas Bottles no disco n\u00e3o foram eliminadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky nu a putut citi lista de sticle salvat\u0103, a\u0219a c\u0103 a fost creat\u0103 o list\u0103 nou\u0103, goal\u0103. Fi\u0219ierul ilizibil a fost mutat \u00een \u201e%@\u201d. Folderele sticlelor de pe disc nu au fost \u0219terse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky \u043d\u0435 \u0441\u043c\u043e\u0433 \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u044c \u0441\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u044b\u0439 \u0441\u043f\u0438\u0441\u043e\u043a \u0431\u0443\u0442\u044b\u043b\u043e\u043a \u0438 \u0441\u043e\u0437\u0434\u0430\u043b \u043d\u043e\u0432\u044b\u0439 \u043f\u0443\u0441\u0442\u043e\u0439 \u0441\u043f\u0438\u0441\u043e\u043a. \u041d\u0435\u0447\u0438\u0442\u0430\u0435\u043c\u044b\u0439 \u0444\u0430\u0439\u043b \u043f\u0435\u0440\u0435\u043c\u0435\u0449\u0451\u043d \u0432 \u00ab%@\u00bb. \u041f\u0430\u043f\u043a\u0438 \u0431\u0443\u0442\u044b\u043b\u043e\u043a \u043d\u0430 \u0434\u0438\u0441\u043a\u0435 \u043d\u0435 \u0443\u0434\u0430\u043b\u0435\u043d\u044b."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky kunde inte l\u00e4sa den sparade listan \u00f6ver flaskor och skapade d\u00e4rf\u00f6r en ny, tom lista. Den ol\u00e4sbara filen flyttades till \u201d%@\u201d. Dina flaskmappar p\u00e5 disken raderades inte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky kay\u0131tl\u0131 \u015fi\u015fe listesini okuyamad\u0131, bu y\u00fczden yeni ve bo\u015f bir liste olu\u015fturuldu. Okunamayan dosya \u201c%@\u201d konumuna ta\u015f\u0131nd\u0131. Diskteki \u015fi\u015fe klas\u00f6rleriniz silinmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky \u043d\u0435 \u0437\u043c\u0456\u0433 \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u0438 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u0439 \u0441\u043f\u0438\u0441\u043e\u043a \u043f\u043b\u044f\u0448\u043e\u043a, \u0442\u043e\u043c\u0443 \u0441\u0442\u0432\u043e\u0440\u0438\u0432 \u043d\u043e\u0432\u0438\u0439 \u043f\u043e\u0440\u043e\u0436\u043d\u0456\u0439 \u0441\u043f\u0438\u0441\u043e\u043a. \u041d\u0435\u0447\u0438\u0442\u0430\u0431\u0435\u043b\u044c\u043d\u0438\u0439 \u0444\u0430\u0439\u043b \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0435\u043d\u043e \u0434\u043e \u00ab%@\u00bb. \u0422\u0435\u043a\u0438 \u043f\u043b\u044f\u0448\u043e\u043a \u043d\u0430 \u0434\u0438\u0441\u043a\u0443 \u043d\u0435 \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky kh\u00f4ng \u0111\u1ecdc \u0111\u01b0\u1ee3c danh s\u00e1ch bottle \u0111\u00e3 l\u01b0u n\u00ean \u0111\u00e3 t\u1ea1o danh s\u00e1ch tr\u1ed1ng m\u1edbi. T\u1ec7p kh\u00f4ng \u0111\u1ecdc \u0111\u01b0\u1ee3c \u0111\u00e3 chuy\u1ec3n t\u1edbi \u201c%@\u201d. C\u00e1c th\u01b0 m\u1ee5c bottle tr\u00ean \u1ed5 \u0111\u0129a kh\u00f4ng b\u1ecb x\u00f3a."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky \u65e0\u6cd5\u8bfb\u53d6\u5df2\u5b58\u50a8\u7684 Bottle \u5217\u8868\uff0c\u56e0\u6b64\u65b0\u5efa\u4e86\u4e00\u4e2a\u7a7a\u5217\u8868\u3002\u65e0\u6cd5\u8bfb\u53d6\u7684\u6587\u4ef6\u5df2\u79fb\u81f3\u201c%@\u201d\u3002\u78c1\u76d8\u4e0a\u7684 Bottle \u6587\u4ef6\u5939\u672a\u88ab\u5220\u9664\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisky \u7121\u6cd5\u8b80\u53d6\u5df2\u5132\u5b58\u7684 Bottle \u5217\u8868\uff0c\u56e0\u6b64\u5efa\u7acb\u4e86\u4e00\u500b\u65b0\u7684\u7a7a\u767d\u5217\u8868\u3002\u7121\u6cd5\u8b80\u53d6\u7684\u6a94\u6848\u5df2\u79fb\u81f3\u300c%@\u300d\u3002\u78c1\u789f\u4e0a\u7684 Bottle \u6a94\u6848\u593e\u4e26\u672a\u522a\u9664\u3002"
          }
        }
      }
    },
