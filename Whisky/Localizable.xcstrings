    "Analyze Wine crash output for troubleshooting guidance": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u062d\u0644\u064a\u0644 \u0645\u062e\u0631\u062c\u0627\u062a \u062a\u0639\u0637\u0644 Wine \u0644\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0625\u0631\u0634\u0627\u062f\u0627\u062a \u0627\u0633\u062a\u0643\u0634\u0627\u0641 \u0627\u0644\u0623\u062e\u0637\u0627\u0621"
