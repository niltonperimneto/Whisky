    "config.installVcRedist.info": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u0637\u0644\u0648\u0628 \u0644\u0623\u0644\u0639\u0627\u0628 Unity (\u064a\u0635\u0644\u062d \u0623\u062e\u0637\u0627\u0621 il2cpp)"
