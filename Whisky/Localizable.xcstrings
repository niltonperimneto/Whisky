    "config.cleanup.clipboardPolicy.clear": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0645\u0633\u062d \u062f\u0627\u0626\u0645\u064b\u0627 \u0639\u0646\u062f \u0627\u0644\u062a\u0634\u063a\u064a\u0644"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u017edy vymazat p\u0159i spu\u0161t\u011bn\u00ed"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryd altid ved start"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Start immer l\u00f6schen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always Clear on Launch"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Always Clear on Launch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaciar siempre al iniciar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyhjenn\u00e4 aina k\u00e4ynnistyksess\u00e4"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours vider au lancement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Svuota sempre all'avvio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8d77\u52d5\u6642\u306b\u5e38\u306b\u6d88\u53bb"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2e4\ud589 \uc2dc \ud56d\uc0c1 \uc9c0\uc6b0\uae30"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Altijd wissen bij starten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze czy\u015b\u0107 przy uruchomieniu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre limpar ao iniciar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpar sempre ao iniciar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gole\u0219te mereu la lansare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0441\u0435\u0433\u0434\u0430 \u043e\u0447\u0438\u0449\u0430\u0442\u044c \u043f\u0440\u0438 \u0437\u0430\u043f\u0443\u0441\u043a\u0435"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rensa alltid vid start"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba\u015flatmada Her Zaman Temizle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0432\u0436\u0434\u0438 \u043e\u0447\u0438\u0449\u0430\u0442\u0438 \u043f\u0440\u0438 \u0437\u0430\u043f\u0443\u0441\u043a\u0443"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lu\u00f4n x\u00f3a khi kh\u1edfi ch\u1ea1y"
          }
