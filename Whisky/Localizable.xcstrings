    "config.repairPrefix.help": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0639\u064a\u062f \u062a\u0647\u064a\u0626\u0629 \u0628\u0627\u062f\u0626\u0629 Wine \u0644\u0625\u0635\u0644\u0627\u062d \u0645\u062c\u0644\u062f\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0645\u0641\u0642\u0648\u062f\u0629"
